//============================================================================================================================================
//                                                           SLATEMATH.SYMBOLINDEX
//============================================================================================================================================
// 🧩 Symbol roll for SlateMath — A coordinate and the space it is a coordinate in — never a bare triple, and never an assumed encoding.

%format   symbolindex 1.0
%scope    layer
%path     Engine/SlateMath
%folders  36
%symbols  404

