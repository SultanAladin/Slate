//============================================================================================================================================
//                                                         SLATEDOCUMENT.SYMBOLINDEX
//============================================================================================================================================
// 🧩 Symbol roll for SlateDocument — Topology and imagery in, painted channels out — one contract, and intake that never repairs.

%format   symbolindex 1.0
%scope    layer
%path     Engine/SlateDocument
%folders  44
%symbols  877

