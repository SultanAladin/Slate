//============================================================================================================================================
//                                                         SLATEDOCUMENT.SYMBOLINDEX
//============================================================================================================================================
// 🧩 Symbol roll for SlateDocument — Which slots are enrolled in a named subset, compressed by interval rather than stored per occupant.

%format   symbolindex 1.0
%scope    layer
%path     Engine/SlateDocument
%folders  18
%symbols  234

