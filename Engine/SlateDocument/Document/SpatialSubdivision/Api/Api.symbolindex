    has   CornerVertices     std::vector<std::uint32_t>      [-]  ?
    has   DescribedRevision  std::uint64_t                   [-]  ?
    has   StructureBuilt     bool                            [-]  ?
    by    Source/ConsoleHost.cpp, Source/SpatialSubdivision.cpp
