    has   Rename             OutlinerIntent  [-]  ?
    has   Select             OutlinerIntent  [-]  ?
    has   ExcludeVisibility  OutlinerIntent  [-]  ?
    has   Isolate            OutlinerIntent  [-]  ?
    has   Lock               OutlinerIntent  [-]  ?
    has   Expand             OutlinerIntent  [-]  ?
    has   Retire             OutlinerIntent  [-]  ?
