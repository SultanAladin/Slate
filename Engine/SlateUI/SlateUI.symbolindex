//============================================================================================================================================
//                                                            SLATEUI.SYMBOLINDEX
//============================================================================================================================================
// 🧩 Symbol roll for SlateUI — One material's twenty channels made visible — every row read from `MaterialIndex`, nothing held here.

%format   symbolindex 1.0
%scope    layer
%path     Engine/SlateUI
%folders  24
%symbols  621

