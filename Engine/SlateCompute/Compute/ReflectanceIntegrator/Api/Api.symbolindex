    has   Orientation     SurfaceDirection  [-]  ?
    has   Basis           TangentBasis      [-]  ?
    has   DomainAlong     double            [-]  ?
    has   DomainAcross    double            [-]  ?
    has   DomainGradient  double[4]         [-]  ?
    has   Weights         double[3]         [-]  ?
    has   BasisDeclared   bool              [-]  ?
    has   Reconstructed   bool              [-]  ?
