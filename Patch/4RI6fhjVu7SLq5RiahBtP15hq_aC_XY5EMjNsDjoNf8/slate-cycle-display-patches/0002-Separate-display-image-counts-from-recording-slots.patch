 .../PaintHost/Source/PaintHost.cpp            |  8 +++---
 .../InterfaceExchange/Api/InterfaceExchange.h | 20 ++++++++-------
 .../Source/InterfaceExchange.cpp              | 25 +++++++++++++------
 .../ViewportSequence/Api/ViewportSequence.h   |  4 +--
 .../Source/ViewportSequence.cpp               |  4 +--
 .../DisplayScheduler/Api/DisplayScheduler.h   | 16 ++++++++----
 .../Source/DisplayScheduler.cpp               | 15 ++++++++---
 8 files changed, 67 insertions(+), 38 deletions(-)

