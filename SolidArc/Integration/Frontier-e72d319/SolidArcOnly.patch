+cmake -S Exhibits/GeometryProcessing/Code -B _ClaudeScratch/build/GeometryProcessing
+cmake --build _ClaudeScratch/build/GeometryProcessing --config RelWithDebInfo
+ctest --test-dir _ClaudeScratch/build/GeometryProcessing -C RelWithDebInfo
