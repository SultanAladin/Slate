+
+    std::vector<GateTally*> AllGates() { return { &ConnectorGate, &KindGate, &TreeGate, &MassGate, &InterferenceGate, &RefuseGate }; }
+
+    struct DetailRow
+    {
+        std::string Gate            = {};
+        std::string Name            = {};
