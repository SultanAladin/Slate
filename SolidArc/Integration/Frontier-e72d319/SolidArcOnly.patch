+++ b/Engine/GeometryProcessing/Containment/WindingNumber.h
@@ -0,0 +1,96 @@
+/*====================================================================================================================================
+                                                        WINDINGNUMBER.H
+====================================================================================================================================*/
+// 🧩 Generalized winding number of trimmed analytic faces: point-in-solid with precision-aware boundary detection
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Containment/FaceDomain.h"
+#include "Engine/GeometryProcessing/Precision/PrecisionSpecification.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+struct WindingSettings
+{
+    double Precision         = SessionPrecision;                                             // [len] - On-boundary distance
+    double OuterTolerance    = 1.0e-10;                                                      // [sr]  - Per Kronrod panel along loops
+    double InnerTolerance    = 1.0e-11;                                                      // [-]   - Per Kronrod panel along 𝑢
+    int    DepthLimit        = 40;                                                           // [-]   - Bisections per integral
+    double NearDistance      = 1.0e-4;                                                       // [len] - Nearest-normal shortcut reach
+};
+
+struct WindingTally
+{
+    int64_t Evaluations = 0;                                                                 // [-] - Surface evaluations
+};
+
+enum class ContainmentMethod : uint8_t
+{
+    Winding       = 0,                                                                       // Σ Ω_F / 4π decided
+    NearestNormal = 1,                                                                       // Nearest point is a face interior point
+    Proximity     = 2,                                                                       // Within precision of the boundary
+};
+
+struct SolidPointClass
+{
+    PointMembership Membership      = PointMembership::Outside;                              // [-] - Result
+    double          Winding         = 0.0;                                                   // [-] - Σ Ω_F / 4π (NaN when on the boundary)
+    double          IntegerResidual = 0.0;                                                   // [-] - |w − round(w)|
+    int             BoundaryFace    = -1;                                                    // [-] - Face index when on the boundary
+    int64_t         Evaluations     = 0;                                                     // [-] - Surface evaluations
+    ContainmentMethod Method        = ContainmentMethod::Winding;                            // [-] - What decided
+};
+
+// 📝 Prepared faces of a body (or of any face set — an open set gives the fractional winding of a leaky surface).
+struct BodyContainment
+{
+    std::vector<FaceDomain> Faces           = {};                                            // [-]   - One domain per face
+    Vector3                 BoundsLow       = { 1.0e300, 1.0e300, 1.0e300 };                 // [len] - Body box low
+    Vector3                 BoundsHigh      = { -1.0e300, -1.0e300, -1.0e300 };              // [len] - Body box high
+    bool                    ClosedCondition = false;                                         // [-]   - Certified closed solid shell(s)
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+[[nodiscard]] BodyContainment PrepareBodyContainment(const ModelPartition& Partition, BodyToken Body);
+[[nodiscard]] BodyContainment PrepareFaceContainment(const ModelPartition& Partition, const std::vector<FaceToken>& Faces);
+
+// 💡 Ω_F(P) = ∬_F (S − P)·(S_𝑢 × S_𝑣) / |S − P|³ d𝑢 d𝑣 = ∮_∂F G d𝑣 with G(𝑢, 𝑣) = ∫_{𝑢ref}^{𝑢} (…)(s, 𝑣) ds (Green in
+//    the chart; loop orientation carries the face sense, as in EnclosedVolume). Both integrals are adaptive Gauss–Kronrod
+//    7/15, split at the foot of P so the near-surface Lorentzian peak (width ≈ distance) is never straddled.
+[[nodiscard]] double MeasureFaceSolidAngle(const FaceDomain& Domain, Vector3 Position, const WindingSettings& Settings, WindingTally& Tally);
+
+// Σ Ω_F / 4π without boundary detection (fractional for open face sets).
+[[nodiscard]] double MeasureWindingNumber(const BodyContainment& Containment, Vector3 Position, const WindingSettings& Settings, WindingTally& Tally);
+
+// 💡 ① Proximity: Boundary when within Precision of any face.
+//    ② Nearest normal: when the nearest boundary point lies inside a face (closer than NearDistance and closer than every
+//       edge), the open segment to it crosses no boundary, so the outward-normal sign decides exactly — this replaces the
+//       near-singular quadrature (≈ 10⁸ evaluations at 1e-7) where it is not needed.
+//    ③ Otherwise Inside iff the generalized winding number rounds to a non-zero integer.
+[[nodiscard]] SolidPointClass ClassifySolidPoint(const BodyContainment& Containment, Vector3 Position, const WindingSettings& Settings = {});
+
+// 💡 Two-tier winding: membership needs only the nearest integer, so a coarse quadrature (10⁻⁵ sr / 10⁻⁶ per panel)
+//    screens first; a winding within 10⁻⁴ of an integer (5000× inside the ½ decision margin) is kept, anything else is
+//    recomputed at Settings, so an open face set still shows its true residual. Same membership as ClassifySolidPoint at
+//    a fraction of the cost: a strict winding near freeform or traced faces runs to ~10⁶ evaluations per point.
+[[nodiscard]] SolidPointClass ClassifySolidPointScreened(const BodyContainment& Containment, Vector3 Position, const WindingSettings& Settings = {});
+
+[[nodiscard]] const char* PointMembershipLabel(PointMembership Membership) noexcept;
+[[nodiscard]] const char* ContainmentMethodLabel(ContainmentMethod Method) noexcept;
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Diagnostics/OperationTrace.cpp b/Engine/GeometryProcessing/Diagnostics/OperationTrace.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8691407e10e940379a5eef4137487e483a61ae60
--- /dev/null
+++ b/Engine/GeometryProcessing/Diagnostics/OperationTrace.cpp
@@ -0,0 +1,192 @@
+/*====================================================================================================================================
+                                                       OPERATIONTRACE.CPP
+====================================================================================================================================*/
+// 🧩 Development trace of operations: what began, what it decided, how long it took (FRONTIER_DEVELOPMENT_TRACE builds)
+
+#include "Engine/GeometryProcessing/Diagnostics/OperationTrace.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <fstream>
+#include <mutex>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    constexpr size_t TailLimit     = 4000;                                                   // [-]  - Lines kept in memory
+    constexpr double SlowThreshold = 250.0;                                                  // [ms] - A ◀ line at or above this is flagged
+
+    struct TraceDivision
+    {
+        std::mutex                            Guard;                                         // [-] - Serialises file and tail
+        std::ofstream                         File;                                          // [-] - Open trace file (may be closed)
+        std::filesystem::path                 Path;                                          // [-] - Its path
+        std::deque<std::string>               Tail;                                          // [-] - Newest lines
+        std::atomic<size_t>                   Revision{ 0 };                                 // [-] - Lines written so far
+        std::atomic<int>                      Threads{ 0 };                                  // [-] - Thread numbers handed out
+        std::chrono::steady_clock::time_point Origin = std::chrono::steady_clock::now();     // [s] - Time zero of the elapsed column
+
+        TraceDivision()
+        {
+            if (const char* Env = std::getenv("FRONTIER_TRACE_PATH"); Env && *Env)
+            {
+                File.open(Env, std::ios::out | std::ios::trunc | std::ios::binary);
+                if (File.is_open()) Path = Env;
+            }
+        }
+    };
+
+    TraceDivision& Division()
+    {
+        static TraceDivision Instance;
+        return Instance;
+    }
+
+    thread_local int TraceDepth  = 0;                                                        // [-] - Open scopes on this thread
+    thread_local int TraceThread = -1;                                                       // [-] - Small number of this thread
+
+    int ThreadNumber()
+    {
+        if (TraceThread < 0) TraceThread = Division().Threads.fetch_add(1);
+        return TraceThread;
+    }
+
+    // "   12.345 s  T0  Blend      │ ▶ message": fixed columns so a long log reads as a tree.
+    std::string FormatLine(const char* Category, const std::string& Message, int Depth)
+    {
+        TraceDivision& Trace   = Division();
+        const double   Elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - Trace.Origin).count();
+        char           Prefix[64];
+        std::snprintf(Prefix, sizeof(Prefix), "%10.3f s  T%-2d %-10s ", Elapsed, ThreadNumber(), Category ? Category : "-");
+        std::string Line = Prefix;
+        for (int Level = 0; Level < Depth; ++Level) Line += "│ ";
+        Line += Message;
+        return Line;
+    }
+
+    void Commit(std::string Line, bool FlushCondition)
+    {
+        TraceDivision&              Trace = Division();
+        const std::lock_guard<std::mutex> Lock(Trace.Guard);
+        if (Trace.File.is_open())
+        {
+            Trace.File << Line << '\n';
+            if (FlushCondition) Trace.File.flush();
+        }
+        Trace.Tail.push_back(std::move(Line));
+        while (Trace.Tail.size() > TailLimit) Trace.Tail.pop_front();
+        Trace.Revision.fetch_add(1);
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+bool OpenOperationTrace(const std::filesystem::path& Path)
+{
+    TraceDivision&                    Trace = Division();
+    const std::lock_guard<std::mutex> Lock(Trace.Guard);
+    {
+        if (Trace.File.is_open()) Trace.File.close();
+        std::error_code Failure;
+        if (std::filesystem::exists(Path, Failure))
+        {
+            std::filesystem::path Previous = Path;
+            Previous.replace_extension();
+            Previous += ".previous";
+            Previous += Path.extension();
+            std::filesystem::remove(Previous, Failure);
+            std::filesystem::rename(Path, Previous, Failure);
+        }
+        Trace.File.open(Path, std::ios::out | std::ios::trunc | std::ios::binary);
+        Trace.Path = Trace.File.is_open() ? Path : std::filesystem::path();
+        if (Trace.File.is_open())
+        {
+            // Earlier lines (before the file existed) open the file, so start-up is not lost.
+            for (const std::string& Line : Trace.Tail) Trace.File << Line << '\n';
+            Trace.File.flush();
+        }
+    }
+    return Trace.File.is_open();
+}
+
+void CloseOperationTrace()
+{
+    TraceDivision&                    Trace = Division();
+    const std::lock_guard<std::mutex> Lock(Trace.Guard);
+    if (Trace.File.is_open()) Trace.File.close();
+    Trace.Path.clear();
+}
+
+std::filesystem::path OperationTracePath()
+{
+    TraceDivision&                    Trace = Division();
+    const std::lock_guard<std::mutex> Lock(Trace.Guard);
+    return Trace.Path;
+}
+
+void WriteOperationTrace(const char* Category, const std::string& Message)
+{
+    Commit(FormatLine(Category, "· " + Message, TraceDepth), TraceDepth == 0);
+}
+
+std::vector<std::string> RecentOperationTrace(size_t Count)
+{
+    TraceDivision&                    Trace = Division();
+    const std::lock_guard<std::mutex> Lock(Trace.Guard);
+    const size_t                      First = Trace.Tail.size() > Count ? Trace.Tail.size() - Count : 0;
+    return std::vector<std::string>(Trace.Tail.begin() + static_cast<std::ptrdiff_t>(First), Trace.Tail.end());
+}
+
+size_t OperationTraceRevision()
+{
+    return Division().Revision.load();
+}
+
+std::string TraceNumber(double Value)
+{
+    char Text[32];
+    std::snprintf(Text, sizeof(Text), "%.6g", Value);
+    return Text;
+}
+
+bool OperationTraceCompiledCondition()
+{
+#ifdef FRONTIER_DEVELOPMENT_TRACE
+    return true;
+#else
+    return false;
+#endif
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    CLASSES
+//------------------------------------------------------------------------------------------------------------------------
+
+OperationTraceScope::OperationTraceScope(const char* Category, std::string Message)
+    : Category(Category), Message(std::move(Message)), Start(std::chrono::steady_clock::now())
+{
+    Commit(FormatLine(this->Category, "▶ " + this->Message, TraceDepth), TraceDepth == 0);
+    ++TraceDepth;
+}
+
+OperationTraceScope::~OperationTraceScope()
+{
+    --TraceDepth;
+    const double Milliseconds = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - Start).count();
+    char         Duration[48];
+    std::snprintf(Duration, sizeof(Duration), " · %.3f ms", Milliseconds);
+    Commit(FormatLine(Category, "◀ " + Message + Duration + (Milliseconds >= SlowThreshold ? "  ⚠️ slow" : ""), TraceDepth),
+           TraceDepth == 0 || Milliseconds >= SlowThreshold);
+}
+
+} // namespace Frontier::GeometryProcessing
