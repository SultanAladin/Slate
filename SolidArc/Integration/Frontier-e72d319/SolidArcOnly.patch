+++ b/UI/SolidArc/Document/SolidArcDrawingSheet.h
@@ -0,0 +1,78 @@
+/*====================================================================================================================================
+                                                        SOLIDARCDRAWINGSHEET.H
+====================================================================================================================================*/
+// 🧩 Drawing sheet (Alt+D): the shown solid bodies of the document as an ISO drawing — the kernel's Drawing/DrawingSheet
+//    (views, hidden lines, automatic dimensions, title block) and its SVG / DXF R12 export; the settings are saved with
+//    the document
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "UI/SolidArc/Document/SolidArcMeasurement.h"
+
+#include "Engine/GeometryProcessing/Drawing/DrawingSheet.h"
+
+#include <cstdint>
+#include <string>
+
+namespace Frontier::SolidArc
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    CONSTANTS
+//------------------------------------------------------------------------------------------------------------------------
+
+inline constexpr double SolidArcModelUnitMillimetres = 1000.0;                               // [mm] - One model unit (metre) on paper
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TYPES
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 One composition: the kernel sheet of the shown solid bodies (hidden bodies and sheet bodies left out) in
+//    millimetres, cached by the document revision and the settings key.
+struct SolidArcDrawingSheet
+{
+    uint64_t                Revision     = 0;                                                // [-]  - Document revision drawn
+    std::string             SettingsKey  = {};                                               // [-]  - SolidArcDrawingSheetCacheKey drawn
+    GeometryProcessing::DrawingSheet  Sheet        = {};                                               // [-]  - Kernel sheet (millimetres)
+    int                     Bodies       = 0;                                                // [-]  - Solid bodies drawn
+    int                     Sheets       = 0;                                                // [-]  - Sheet bodies left out
+    double                  Milliseconds = 0.0;                                              // [ms] - Composition time
+    std::string             Refusal      = {};                                               // [-]  - Empty on success
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// The drawing sheet of the document's shown solid bodies.
+[[nodiscard]] SolidArcDrawingSheet ComposeSolidArcDrawingSheet(const SolidArcDocument& Document, const SolidArcDrawingSheetSettings& Settings);
+
+// Settings fingerprint (cache key and script readout).
+[[nodiscard]] std::string SolidArcDrawingSheetKey(const SolidArcDrawingSheetSettings& Settings);
+
+// Cache key of a composition: the settings key plus the hidden bodies (hiding is an appearance edit, not a revision).
+[[nodiscard]] std::string SolidArcDrawingSheetCacheKey(const SolidArcDocument& Document, const SolidArcDrawingSheetSettings& Settings);
+
+// True when the settings equal the defaults (the codec then writes no [DrawingSheet] table).
+[[nodiscard]] bool DefaultSolidArcDrawingSheetCondition(const SolidArcDrawingSheetSettings& Settings);
+
+// Kernel section frame of a Section-card plane: the card keeps its +normal side, the sheet keeps the −ZAxis side.
+[[nodiscard]] GeometryProcessing::OrthonormalFrame SolidArcSheetSectionFrame(const GeometryProcessing::OrthonormalFrame& Plane);
+
+// Where the sheet is exported: "Bracket.solidarc" → "Bracket.svg" / "Bracket.dxf" beside it; no document path →
+// "Untitled.svg" in the working folder. Extension includes the dot.
+[[nodiscard]] std::string SolidArcDrawingSheetExportPath(const std::string& DocumentPath, const std::string& Extension);
+
+// Writes the sheet as SVG or DXF R12 (by the path's extension); returns the refusal (empty on success).
+[[nodiscard]] std::string ExportSolidArcDrawingSheet(const SolidArcDrawingSheet& Sheet, const std::string& Path);
+
+// "A3", "First", "Y", … ↔ enums for the codec and scripts (false / empty for an unknown label).
+[[nodiscard]] const char* SolidArcProjectionAngleLabel(GeometryProcessing::DrawingProjectionAngle Angle) noexcept;
+[[nodiscard]] bool        ParseSolidArcPaperSize(const std::string& Label, GeometryProcessing::DrawingPaperSize& Paper) noexcept;
+[[nodiscard]] bool        ParseSolidArcProjectionAngle(const std::string& Label, GeometryProcessing::DrawingProjectionAngle& Angle) noexcept;
+
+} // namespace Frontier::SolidArc
diff --git a/UI/SolidArc/Document/SolidArcExchange.cpp b/UI/SolidArc/Document/SolidArcExchange.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3973cb2f9e23177f7398e80a3e389c6f2506acc9
--- /dev/null
+++ b/UI/SolidArc/Document/SolidArcExchange.cpp
@@ -0,0 +1,177 @@
+/*====================================================================================================================================
+                                                         SOLIDARCEXCHANGE.CPP
+====================================================================================================================================*/
+// 🧩 Document ↔ STEP / STL: kernel WriteStep / WriteStl (metres → millimetres) out, ReadStep + canonical WriteStep in
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "UI/SolidArc/Document/SolidArcExchange.h"
+
+#include "UI/SolidArc/Document/SolidArcDrawingSheet.h"
+
+#include "Engine/GeometryProcessing/Exchange/StepExchange.h"
+#include "Engine/GeometryProcessing/Exchange/StlExchange.h"
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <filesystem>
+
+namespace Frontier::SolidArc
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+
+[[nodiscard]] double ElapsedMilliseconds(std::chrono::steady_clock::time_point Start)
+{
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - Start).count();
+}
+
+// File name without folder and exchange / document extension ("Parts/Boss.step" → "Boss").
+[[nodiscard]] std::string FileStem(const std::string& Path)
+{
+    std::string Stem = std::filesystem::path(Path).filename().string();
+    for (const char* Suffix : { ".solidarc", ".drafting.toml", ".toml", ".step", ".stp", ".stl", ".STEP", ".STP", ".STL" })
+    {
+        const std::string Tail = Suffix;
+        if (Stem.size() > Tail.size() && Stem.compare(Stem.size() - Tail.size(), Tail.size(), Tail) == 0) { Stem.resize(Stem.size() - Tail.size()); break; }
+    }
+    return Stem.empty() ? std::string("Untitled") : Stem;
+}
+
+} // namespace
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+SolidArcExchangeFormat SolidArcExchangeFormatOf(const std::string& Path)
+{
+    std::string Extension = std::filesystem::path(Path).extension().string();
+    std::transform(Extension.begin(), Extension.end(), Extension.begin(), [](unsigned char Letter) { return static_cast<char>(std::tolower(Letter)); });
+    if (Extension == ".step" || Extension == ".stp") return SolidArcExchangeFormat::Step;
+    if (Extension == ".stl") return SolidArcExchangeFormat::Stl;
+    if (Extension == ".toml") return SolidArcExchangeFormat::Toml;
+    return SolidArcExchangeFormat::Unknown;
+}
+
+const char* SolidArcExchangeFormatLabel(SolidArcExchangeFormat Format) noexcept
+{
+    switch (Format)
+    {
+    case SolidArcExchangeFormat::Step:    return "STEP";
+    case SolidArcExchangeFormat::Stl:     return "STL";
+    case SolidArcExchangeFormat::Toml:    return "TOML";
+    case SolidArcExchangeFormat::Unknown: break;
+    }
+    return "unknown";
+}
+
+std::string SolidArcExportPath(const std::string& DocumentPath, const std::string& Extension)
+{
+    return SolidArcDrawingSheetExportPath(DocumentPath, Extension);
+}
+
+std::vector<std::string> SolidArcExportBodies(const SolidArcDocument& Document)
+{
+    std::vector<std::string> Keys;
+    for (const std::string& Key : Document.Selection.Bodies)
+    {
+        const bool Present = std::any_of(Document.Regeneration.Bodies.begin(), Document.Regeneration.Bodies.end(),
+                                         [&](const GeometryProcessing::RegeneratedBody& Body) { return Body.Key == Key && Body.Body.PresentCondition(); });
+        if (Present && std::find(Keys.begin(), Keys.end(), Key) == Keys.end()) Keys.push_back(Key);
+    }
+    if (!Keys.empty()) return Keys;
+    for (const GeometryProcessing::RegeneratedBody& Body : Document.Regeneration.Bodies)
+        if (Body.Body.PresentCondition() && !Document.Appearance.HiddenBodies.contains(Body.Key) && !Document.Appearance.LiveCutters.contains(Body.Key)) Keys.push_back(Body.Key);
+    return Keys;
+}
+
+SolidArcExportOutcome ExportSolidArcBodies(const SolidArcDocument& Document, const std::string& Path, const std::vector<std::string>& Keys)
+{
+    const auto Start = std::chrono::steady_clock::now();
+    SolidArcExportOutcome Outcome;
+    Outcome.Path   = Path;
+    Outcome.Format = SolidArcExchangeFormatOf(Path);
+    Outcome.Bodies = Keys.empty() ? SolidArcExportBodies(Document) : Keys;
+    const auto Refuse = [&](const std::string& Reason) { Outcome.Refusal = "Export: " + Reason; Outcome.Milliseconds = ElapsedMilliseconds(Start); return Outcome; };
+    if (Outcome.Format != SolidArcExchangeFormat::Step && Outcome.Format != SolidArcExchangeFormat::Stl) return Refuse(Path + " is neither .step / .stp nor .stl");
+    if (!Document.Partition) return Refuse("the document has not been regenerated");
+    if (Outcome.Bodies.empty()) return Refuse("no shown body to write");
+    std::vector<GeometryProcessing::BodyToken> Tokens;
+    for (const std::string& Key : Outcome.Bodies)
+    {
+        const auto Found = std::find_if(Document.Regeneration.Bodies.begin(), Document.Regeneration.Bodies.end(), [&](const GeometryProcessing::RegeneratedBody& Body) { return Body.Key == Key; });
+        if (Found == Document.Regeneration.Bodies.end() || !Found->Body.PresentCondition()) return Refuse("no body named " + Key);
+        Tokens.push_back(Found->Body);
+    }
+    std::error_code Error;
+    const std::filesystem::path Folder = std::filesystem::path(Path).parent_path();
+    if (!Folder.empty()) std::filesystem::create_directories(Folder, Error);                // Beside a document not saved yet
+    std::string Failure;
+    if (Outcome.Format == SolidArcExchangeFormat::Step)
+    {
+        GeometryProcessing::StepRequest Request;
+        Request.ModelUnitMillimetres = SolidArcModelUnitMillimetres;
+        Request.Name                 = FileStem(Path);
+        const GeometryProcessing::StepExport Export = GeometryProcessing::WriteStep(*Document.Partition, Tokens, Request);
+        if (!Export.Refusal.empty()) return Refuse(Export.Refusal);
+        Failure              = GeometryProcessing::ExportStepFile(Export, Path);
+        Outcome.Faces        = Export.Faces;
+        Outcome.Approximated = Export.ApproximatedSurfaces + Export.ApproximatedCurves;
+    }
+    else
+    {
+        GeometryProcessing::StlRequest Request;
+        Request.ModelUnitMillimetres = SolidArcModelUnitMillimetres;
+        Request.Name                 = FileStem(Path);
+        const GeometryProcessing::StlExport Export = GeometryProcessing::WriteStl(*Document.Partition, Tokens, Request);
+        if (!Export.Refusal.empty()) return Refuse(Export.Refusal);
+        Failure           = GeometryProcessing::ExportStlFile(Export, Path);
+        Outcome.Triangles = Export.Triangles;
+    }
+    if (!Failure.empty()) return Refuse(Failure);
+    Outcome.Bytes        = double(std::filesystem::file_size(Path, Error));
+    Outcome.Milliseconds = ElapsedMilliseconds(Start);
+    return Outcome;
+}
+
+SolidArcStepReading ReadSolidArcStepFile(const std::string& Path)
+{
+    const auto Start = std::chrono::steady_clock::now();
+    SolidArcStepReading Reading;
+    Reading.Stem = FileStem(Path);
+    const auto Refuse = [&](const std::string& Reason) { Reading.Refusal = Reason; Reading.Texts.clear(); Reading.Milliseconds = ElapsedMilliseconds(Start); return Reading; };
+    GeometryProcessing::ModelPartition    Scratch;
+    GeometryProcessing::StepImportRequest Request;
+    Request.ModelUnitMillimetres = SolidArcModelUnitMillimetres;
+    Request.Label                = "Import " + std::filesystem::path(Path).filename().string();
+    const GeometryProcessing::StepImport Imported = GeometryProcessing::ImportStepFile(Scratch, Path, Request);
+    if (!Imported.Refusal.empty()) return Refuse(Imported.Refusal);
+    if (Imported.Sheets > 0) return Refuse(Request.Label + ": the file holds " + std::to_string(Imported.Sheets) + " surface model(s) (🚧 solids only)");
+    Reading.Faces               = Imported.Faces;
+    Reading.FileUnitMillimetres = Imported.FileUnitMillimetres;
+    Reading.ReorientedFaces     = Imported.ReorientedFaces;
+    Reading.TolerantEdges       = Imported.TolerantEdges;
+    Reading.Notes               = Imported.Notes;
+    for (size_t Index = 0; Index < Imported.Bodies.size(); ++Index)
+    {
+        GeometryProcessing::StepRequest Canonical;
+        Canonical.ModelUnitMillimetres = SolidArcModelUnitMillimetres;
+        Canonical.Name                 = Imported.Bodies.size() == 1 ? Reading.Stem : Reading.Stem + "." + std::to_string(Index + 1);
+        const GeometryProcessing::StepExport Export = GeometryProcessing::WriteStep(Scratch, { Imported.Bodies[Index] }, Canonical);
+        if (!Export.Refusal.empty()) return Refuse(Request.Label + ": solid " + std::to_string(Index + 1) + " cannot be embedded: " + Export.Refusal);
+        Reading.Texts.push_back(Export.Bytes);
+    }
+    Reading.Milliseconds = ElapsedMilliseconds(Start);
+    return Reading;
+}
+
+} // namespace Frontier::SolidArc
diff --git a/UI/SolidArc/Document/SolidArcExchange.h b/UI/SolidArc/Document/SolidArcExchange.h
new file mode 100644
index 0000000000000000000000000000000000000000..8885196fb0740b00d9f0ca527e2f1a0e44711bb0
--- /dev/null
+++ b/UI/SolidArc/Document/SolidArcExchange.h
@@ -0,0 +1,87 @@
+/*====================================================================================================================================
+                                                          SOLIDARCEXCHANGE.H
+====================================================================================================================================*/
+// 🧩 STEP / STL exchange for the document (priority 4 X4): bodies out as STEP AP214 or binary STL in millimetres, STEP
+//    files in as one canonical single-body STEP text per solid, ready to embed in Import steps
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "UI/SolidArc/Document/SolidArcDocument.h"
+
+#include <string>
+#include <vector>
+
+namespace Frontier::SolidArc
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TYPES
+//------------------------------------------------------------------------------------------------------------------------
+
+enum class SolidArcExchangeFormat : uint8_t
+{
+    Unknown = 0,                                                                             // Extension not recognised
+    Step    = 1,                                                                             // .step / .stp — ISO 10303-21, AP214
+    Stl     = 2,                                                                             // .stl — binary STL
+    Toml    = 3,                                                                             // .toml — VehicleCurves (import) / document
+};
+
+// 📝 One export: which bodies went out, how big the file is and what the writer reported.
+struct SolidArcExportOutcome
+{
+    std::string              Path         = {};                                              // [-]  - File written
+    SolidArcExchangeFormat   Format       = SolidArcExchangeFormat::Unknown;                 // [-]  - By extension
+    std::vector<std::string> Bodies       = {};                                              // [-]  - Body keys written
+    double                   Bytes        = 0.0;                                             // [B]  - File size
+    int                      Faces        = 0;                                               // [-]  - STEP: ADVANCED_FACE written
+    int                      Triangles    = 0;                                               // [-]  - STL: facets written
+    int                      Approximated = 0;                                               // [-]  - STEP: cubic stand-ins (rolling-ball surfaces, traced curves)
+    double                   Milliseconds = 0.0;                                             // [ms]
+    std::string              Refusal      = {};                                              // [-]  - Empty on success (nothing written otherwise)
+};
+
+// 💡 A STEP file read for import: every solid is assembled and audited by the kernel (ReadStep), then written again
+//    on its own by the kernel's writer. The Import step embeds that canonical text, so the document needs neither the
+//    original file nor its quirks (another kernel's seams, loop directions, units) to replay: export → import → export
+//    is a byte fixed point (ExchangeValidation EX9).
+struct SolidArcStepReading
+{
+    std::vector<std::string> Texts               = {};                                       // [-]  - Canonical STEP text, one per solid, in file order
+    std::string              Stem                = {};                                       // [-]  - File name without folder and extension (captions)
+    int                      Faces               = 0;                                        // [-]  - Faces read
+    double                   FileUnitMillimetres = 1.0;                                      // [mm] - Length unit the file declared
+    int                      ReorientedFaces     = 0;                                        // [-]  - Loop directions repaired
+    int                      TolerantEdges       = 0;                                        // [-]  - Edges given a local precision
+    std::vector<std::string> Notes               = {};                                       // [-]  - Reader remarks
+    double                   Milliseconds        = 0.0;                                      // [ms] - Read + canonical rewrite
+    std::string              Refusal             = {};                                       // [-]  - Empty on success
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// Format from the extension (case-insensitive): .step / .stp, .stl, .toml.
+[[nodiscard]] SolidArcExchangeFormat SolidArcExchangeFormatOf(const std::string& Path);
+[[nodiscard]] const char*            SolidArcExchangeFormatLabel(SolidArcExchangeFormat Format) noexcept;
+
+// Default export path beside the document: <document stem>.step (Untitled.step before the first save).
+[[nodiscard]] std::string SolidArcExportPath(const std::string& DocumentPath, const std::string& Extension = ".step");
+
+// The bodies an export takes: the selected bodies when any are picked, else every shown body (hidden ones left out).
+[[nodiscard]] std::vector<std::string> SolidArcExportBodies(const SolidArcDocument& Document);
+
+// Writes Keys (empty: SolidArcExportBodies) to Path in the format of its extension, metres → millimetres. STEP refuses
+// sheet bodies (open panels) by name; STL tessellates them as they are. Nothing is written on a refusal.
+[[nodiscard]] SolidArcExportOutcome ExportSolidArcBodies(const SolidArcDocument& Document, const std::string& Path,
+                                                         const std::vector<std::string>& Keys = {});
+
+// Reads a STEP file in the document's unit (metres) and returns one canonical single-body STEP text per solid.
+// Surface models (sheets) are refused: 🚧 the writer takes solids only.
+[[nodiscard]] SolidArcStepReading ReadSolidArcStepFile(const std::string& Path);
+
+} // namespace Frontier::SolidArc
