+// 📝 HTML .sketch-toolbar (bottom 52, centred): #171717f5, #343434 hairline, radius 13, padding 5, gap 4; buttons
+//    padding 9 12, radius 8, gap 7, glyph 17, #aaa (active / hover #303030 / #fff), a 1 × 22 #3a3a3a divider after Select.
+//    Select ends Trim, Cut breaks sketch curves at the click (Plasticity curve cut; C still cuts a body by the focused
+//    sketch / picked curve), Trim opens the trim session (T). It keeps clear of the orientation cube and the hint lines:
+//    centred when the labelled bar fits beside the cube, else shifted left, else icons only (names in the tooltips),
+//    else the knife caption folds to its chevron too, else the icons tighten, else the bar rises above the cube's band.
+void DrawSketchToolbar(SolidArcWorkspaceState& State, ImVec2 Image, ImVec2 Extent, float HintTop)
+{
+    const bool SketchCondition = std::any_of(State.Document.Tree.Steps.begin(), State.Document.Tree.Steps.end(), [](const FeatureStep& Step) { return Step.Kind == FeatureStepKind::Sketch; });
+    const bool SplitCondition  = State.Trim.ActiveCondition && State.Trim.SplitCondition;
+    const bool InsertCondition = State.Trim.ActiveCondition && State.Trim.InsertCondition;
+    const bool TrimCondition   = State.Trim.ActiveCondition && !State.Trim.SplitCondition && !State.Trim.InsertCondition;
+    struct ToolButton
+    {
+        const char* Key;
+        IconSymbol  Glyph;
+        const char* Label;
+        bool        Active;
+        bool        Enabled;
+    };
+    const bool IdleSelectActive = !State.Trim.ActiveCondition && !State.Fill.ActiveCondition
+                               && !State.DimensionTool.ActiveCondition && !State.Knife.ActiveCondition
+                               && !State.Drawing.ActiveCondition && !State.Sweep.ActiveCondition;
+    const ToolButton Tools[] = { { "SketchSelect", IconSymbol::SolidArcSelect, "Select", IdleSelectActive, true },
+                                 { "SketchCut", IconSymbol::SolidArcCut, "Cut", SplitCondition, SketchCondition && !State.Bevel.ActiveCondition },
+                                 { "SketchInsert", IconSymbol::SolidArcPoints, "Point", InsertCondition, SketchCondition && !State.Bevel.ActiveCondition },
+                                 { "SketchTrim", IconSymbol::SolidArcTrim, "Trim", TrimCondition, SketchCondition },
+                                 { "SketchFill", IconSymbol::SolidArcFill, "Fill", State.Fill.ActiveCondition, SketchCondition },
+                                 { "SketchDimension", IconSymbol::SolidArcSelect, "Dim", State.DimensionTool.ActiveCondition, !State.Bevel.ActiveCondition },
+                                 { "SketchKnife", IconSymbol::SolidArcSubtract, "Knife", State.Knife.ActiveCondition, State.Document.Summary.PresentCondition && !State.Bevel.ActiveCondition },
+                                 { "SketchOffset", IconSymbol::SolidArcSelect, "Offset", State.Sweep.ActiveCondition && State.Sweep.Verb == SolidArcSweepVerb::Offset, SketchCondition && !State.Bevel.ActiveCondition },
+                                 { "SurfaceTraceTool", IconSymbol::SolidArcNurbs, "Surface", State.SurfaceTraceEnabled, !State.Drawing.ActiveCondition && !State.Knife.ActiveCondition && !State.Bevel.ActiveCondition } };
+    constexpr int DimIndex = 5, KnifeIndex = 6, OffsetIndex = 7, TraceIndex = 8;
+    const std::string ToolCaption = KnifeToolLabel(State);
+    // Small text-icon pill: no SVG + caption pairs and no tall card margins.
+    // Tooltips retain the full descriptions and keyboard shortcuts.
+    const char* TextIcons[] = {"Sel", "Cut", "+Pt", "Trim", "Fill", "Dim", "Knife", "Offset", "Surface"};
+    SolidArcSheet Probe; Probe.Begin();
+    constexpr float FontSize = 11.0f, ButtonHeight = 24.0f, Height = 30.0f, Padding = 7.0f;
+    float Widths[9], Total = 12.0f;
+    for (int i = 0; i < 9; ++i) Total += (Widths[i] = Probe.Measure(TextIcons[i], FontSize) + 2.0f * Padding) + 2.0f;
+    const float ToolWidth = 22.0f;
+    Total += ToolWidth;
+    // Keep the pill clear of the active view's orientation cube and hint text.
+    const float RoomLeft = Image.x + 8.0f;
+    const float RoomRight = Image.x + Extent.x - CubeExtent - 26.0f;
+    float Bottom = std::min(Image.y + Extent.y - 44.0f, HintTop - 4.0f);
+    const bool FitsBesideCube = Total <= RoomRight - RoomLeft;
+    if (!FitsBesideCube) Bottom = std::min(Bottom, Image.y + Extent.y - CubeExtent - 53.0f);
+    const float Right = FitsBesideCube ? RoomRight : Image.x + Extent.x - 8.0f;
+    const float X = std::max(RoomLeft, std::min(Image.x + .5f * (Extent.x - Total), Right - Total));
+    const ImVec2 Corner(X, Bottom - Height);
+    BeginSheetWindow("ViewportTools", Corner, ImVec2(Total, Height), true);
+    SolidArcSheet Sheet; Sheet.Begin();
+    const PlaneExtent Bar = Spanning(Corner.x, Corner.y, Total, Height);
+    const float Centre = .5f * (Bar.MinimumY + Bar.MaximumY);
+    Sheet.Box(Bar, SolidArcInk(0x171717, .91f), 15.0f, SolidArcInk(0x343434));
+    float Cursor = Bar.MinimumX + 6.0f;
+    for (int Index = 0; Index <= TraceIndex; ++Index)
+    {
+        const ToolButton& Tool = Tools[Index];
+        const PlaneExtent Box = Spanning(Cursor, Centre - .5f * ButtonHeight, Widths[Index], ButtonHeight);
+        const SolidArcPress Press = PressSolidArcRegion(State.Widgets, Tool.Key, Box, Tool.Enabled);
+        const bool Lit = Tool.Active || Press.HoveredCondition;
+        if (Lit) Sheet.Box(Box, SolidArcInk(0x303030), 12.0f);
+        const ColorQuad Ink = ControlKit::Faded(SolidArcInk(Lit ? 0xffffff : 0xbababa), Tool.Enabled ? 1.0f : .32f);
+        Sheet.Text(Box.MinimumX + Padding, Centre, FontSize, Ink, TextIcons[Index]);
+        if (Press.HoveredCondition)
+        {
+            const char* Tips[] = {"Select: close editing tools", "Cut: split a line, arc or circle", "Point (V): add a point to a curve",
+                "Trim (T): remove a curve segment", "Fill (F): fill a closed region", "Dimension (D): pick geometry, then place the dimension",
+                "Knife (Shift+K): cutter tools; arrow opens the cutter menu",
+                "Offset (O): select an arc/circle/sketch, then drag or type a distance in metres and Enter. Keeps the original; arcs/circles stay concentric. Use the opposite sign for the other side.",
+                "Surface tracing: only placed controls snap to the model. Ctrl: authored curve, then model edge. Toggle off for planar sketches."};
+            ImGui::BeginTooltip();
+            ImGui::PushTextWrapPos(ImGui::GetFontSize() * 28.0f);
+            ImGui::TextUnformatted(Tips[Index]);
+            ImGui::PopTextWrapPos();
+            ImGui::EndTooltip();
+        }
+        if (Press.ClickedCondition)
+        {
+            if (Index == 0)
+            {
+                if (State.Drawing.ActiveCondition) CancelDrawingSession(State);
+                if (State.Sweep.ActiveCondition) CancelSweepSession(State);
+                if (State.Trim.ActiveCondition) CloseTrimSession(State);
+                if (State.Fill.ActiveCondition) CloseFillSession(State);
+                if (State.DimensionTool.ActiveCondition) CloseDimensionSession(State, "Dimension tool closed");
+                if (State.Knife.ActiveCondition) CloseKnifeSession(State, "Knife closed");
+            }
+            if (Index == 1) SplitCondition ? CloseTrimSession(State) : OpenTrimSession(State, true);
+            if (Index == 2) InsertCondition ? CloseTrimSession(State) : OpenTrimSession(State, false, true);
+            if (Index == 3) TrimCondition ? CloseTrimSession(State) : OpenTrimSession(State);
+            if (Index == 4) State.Fill.ActiveCondition ? CloseFillSession(State) : OpenFillSession(State);
+            if (Index == DimIndex) ToggleDimensionSession(State);
+            if (Index == KnifeIndex) State.Knife.ActiveCondition ? CloseKnifeSession(State, "Knife closed") : OpenKnifeSession(State);
+            if (Index == OffsetIndex) OpenSweepSession(State, SolidArcSweepVerb::Offset);
+            if (Index == TraceIndex)
+            {
+                State.SurfaceTraceEnabled = !State.SurfaceTraceEnabled;
+                State.InspectorTab = SolidArcInspectorTab::Geometry;
+                Announce(State, State.SurfaceTraceEnabled ? "Surface tracing ON · Shift+S: Curve · Ctrl: model edge · Enter finishes" : "Surface tracing OFF · ordinary planar sketch tools");
+            }
+        }
+        Cursor = Box.MaximumX + 2.0f;
+    }
+
+    // Knife tool menu: the cutter the knife draws or places (sketch shapes, the boolean library, picked objects).
+    {
+        const bool          Enabled = Tools[KnifeIndex].Enabled;
+        const PlaneExtent   Box     = Spanning(Cursor - 2.0f, Centre - 0.5f * ButtonHeight, ToolWidth, ButtonHeight);
+        const SolidArcPress Press   = PressSolidArcRegion(State.Widgets, "SketchKnifeTool", Box, Enabled);
+        if (Press.HoveredCondition) Sheet.Box(Box, SolidArcInk(0x303030), 8.0f);
+        const ColorQuad Ink = ControlKit::Faded(SolidArcInk(Press.HoveredCondition || State.Knife.ActiveCondition ? 0xffffff : 0xaaaaaa), Enabled ? 1.0f : 0.32f);
+
+        SelectChevron(Sheet, Box.MaximumX - 12.0f, Centre, Ink);
+        if (Press.HoveredCondition) ImGui::SetTooltip("Knife cutter (now %s): surface outline + depth, shaped cutter, imprint only, library insert or picked objects",
+                                                      ToolCaption.c_str());
+        if (Press.ClickedCondition)
+        {
+            EnsureKnifeLibrary(State);
+            ImGui::OpenPopup("KnifeToolMenu");
+        }
+        if (BeginSelectList("KnifeToolMenu", ImVec2(Box.MinimumX, Bar.MinimumY - 6.0f), ImVec2(0.0f, 1.0f)))
+        {
+            const SolidArcKnifeSession& Knife = State.Knife;
+            const SolidArcKnifeMode     Mode  = Knife.ActiveCondition ? Knife.Mode : Knife.PreferredMode;
+            // One surface-cutter workflow: profiles + depth, plus non-extrudable
+            // shaped cutters. No duplicate Rectangle/Block, Circle/Cylinder or Polygon/Prism entries.
+            const bool Columns = ImGui::BeginTable("KnifeToolColumns", 3, ImGuiTableFlags_SizingFixedFit);
+            if (Columns) ImGui::TableNextColumn();
+            ImGui::TextDisabled("Imprint only");
+            if (ImGui::IsItemHovered()) ImGui::SetTooltip("Imprints the shape into the face: splits it, cuts nothing · then E on the new face pushes / pulls it");
+            static const struct { const char* Label; SolidArcDrawingKind Kind; bool PolylineCondition; } Flats[] = {
+                { "Rectangle###KnifeFlatRectangle", SolidArcDrawingKind::Rectangle, false }, { "Circle###KnifeFlatCircle", SolidArcDrawingKind::Circle, false },
+                { "Polygon###KnifeFlatPolygon", SolidArcDrawingKind::Polygon, false }, { "Slot###KnifeFlatSlot", SolidArcDrawingKind::Slot, false },
+                { "Line###KnifeFlatLine", SolidArcDrawingKind::Line, false }, { "Polyline###KnifeFlatPolyline", SolidArcDrawingKind::Line, true } };
+            for (const auto& Flat : Flats)
+            {
+                const bool Chosen = Mode == SolidArcKnifeMode::Sketch && !Knife.PreferredSolidCondition && Knife.PreferredImprintCondition && Knife.PreferredShape == Flat.Kind
+                                 && Knife.PreferredPolylineCondition == Flat.PolylineCondition;
+                if (SelectListEntry(State, Flat.Label, Chosen)) ChooseKnifeTool(State, SolidArcKnifeMode::Sketch, Flat.Kind, -1, Flat.PolylineCondition, true);
+            }
+            if (Columns) ImGui::TableNextColumn();
+            ImGui::TextDisabled("Surface cutters");
+            if (ImGui::IsItemHovered()) ImGui::SetTooltip("First click attaches to the surface, including in orthographic views. Draw the outline, then set depth inward; Q adds outward, T cuts through.");
+            static const SolidArcDrawingKind Shapes[] = { SolidArcDrawingKind::Circle, SolidArcDrawingKind::Rectangle, SolidArcDrawingKind::Polygon, SolidArcDrawingKind::Slot,
+                                                          SolidArcDrawingKind::Line };
+            for (SolidArcDrawingKind Shape : Shapes)
+            {
+                const std::string Label = std::string(SolidArcDrawingLabel(Shape)) + "###KnifeTool" + SolidArcDrawingLabel(Shape);
+                const bool Chosen = Mode == SolidArcKnifeMode::Sketch && !Knife.PreferredSolidCondition && !Knife.PreferredImprintCondition && Knife.PreferredShape == Shape
+                                 && !Knife.PreferredPolylineCondition;
+                if (SelectListEntry(State, Label, Chosen)) ChooseKnifeTool(State, SolidArcKnifeMode::Sketch, Shape, -1);
+            }
+            const bool PolylineChosen = Mode == SolidArcKnifeMode::Sketch && !Knife.PreferredSolidCondition && !Knife.PreferredImprintCondition && Knife.PreferredShape == SolidArcDrawingKind::Line
+                                     && Knife.PreferredPolylineCondition;
+            if (SelectListEntry(State, "Polyline###KnifeToolPolyline", PolylineChosen)) ChooseKnifeTool(State, SolidArcKnifeMode::Sketch, SolidArcDrawingKind::Line, -1, true);
+            ImGui::Separator();
+            ImGui::TextDisabled("Shaped cutters");
+            static const SolidArcConstructKind Solids[] = { SolidArcConstructKind::Cone, SolidArcConstructKind::Sphere, SolidArcConstructKind::Torus,
+                                                            SolidArcConstructKind::Wedge, SolidArcConstructKind::Tube };
+            for (SolidArcConstructKind Solid : Solids)
+            {
+                const std::string Label = std::string(SolidArcConstructLabel(Solid)) + "###KnifeTool" + SolidArcConstructLabel(Solid);
+                if (SelectListEntry(State, Label, Mode == SolidArcKnifeMode::Sketch && Knife.PreferredSolidCondition && Knife.PreferredSolid == Solid)) ChooseKnifeSolid(State, Solid);
+            }
+            if (Columns) ImGui::TableNextColumn();
+            ImGui::TextDisabled("Objects");
+            if (SelectListEntry(State, "Picked bodies###KnifeToolObject", Mode == SolidArcKnifeMode::Object)) ChooseKnifeTool(State, SolidArcKnifeMode::Object, Knife.PreferredShape, -1);
+            EnsureKnifeLibrary(State);
+            ImGui::TextDisabled("Boolean library");
+            for (int Index = 0; Index < SolidArcCompoundCutterCount; ++Index)
+            {
+                const std::string Name  = SolidArcCompoundCutterLabel(static_cast<SolidArcCompoundCutterKind>(Index));
+                const std::string Label = Name + "###KnifeToolInsert" + std::to_string(Index);
+                if (SelectListEntry(State, Label, Mode == SolidArcKnifeMode::Insert && Knife.Insert == Index))
+                    ChooseKnifeTool(State, SolidArcKnifeMode::Insert, Knife.PreferredShape, Index);
+            }
+            for (size_t UserIdx = 0; UserIdx < Knife.Library.Inserts.size(); ++UserIdx)
+            {
+                const int Index = SolidArcCompoundCutterCount + static_cast<int>(UserIdx);
+                const std::string Label = Knife.Library.Inserts[UserIdx].Name + "###KnifeToolInsert" + std::to_string(Index);
+                if (SelectListEntry(State, Label, Mode == SolidArcKnifeMode::Insert && Knife.Insert == Index))
+                    ChooseKnifeTool(State, SolidArcKnifeMode::Insert, Knife.PreferredShape, Index);
+            }
+            if (Columns) ImGui::EndTable();
+            EndSelectList();
+        }
+    }
+    EndSheetWindow();
+}
