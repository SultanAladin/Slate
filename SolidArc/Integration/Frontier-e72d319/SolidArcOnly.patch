+/*====================================================================================================================================
+                                                          EULEREDITS.H
+====================================================================================================================================*/
+// 🧩 Euler edits — the only topology mutations; each preserves V − E + 2F − L = 2(S − G)
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Topology/ModelPartition.h"
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TYPES
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 Either the edit's result, or a refusal reason; a refused edit leaves the partition untouched.
+template <typename Result>
+struct EditOutcome
+{
+    Result      Value   = {};                                                                // [-] - Edit result when it succeeded
+    const char* Refusal = nullptr;                                                           // [-] - Reason when refused
+
+    [[nodiscard]] bool SucceededCondition() const noexcept { return Refusal == nullptr; }
+};
+
+// 💡 A corner is a position in a loop: the fin that LEAVES the vertex there. A fin-less loop (isolated vertex) is
+//    addressed with an absent fin. Corners remove the ambiguity of "vertex v in loop L" when v occurs twice in L (seams).
+struct LoopCorner
+{
+    LoopToken Loop = {};                                                                     // [-] - Loop addressed
+    FinToken  Fin  = {};                                                                     // [-] - Fin leaving the vertex (absent: isolated loop)
+};
+
+struct AcornOutcome
+{
+    BodyToken       Body           = {};                                                     // [-] - New body
+    RegionToken     ExteriorRegion = {};                                                     // [-] - Infinite void region
+    RegionToken     SolidRegion    = {};                                                     // [-] - Region the shell bounds
+    SolidShellToken Shell          = {};                                                     // [-] - The single shell
+    FaceToken       Face           = {};                                                     // [-] - The single face
+    LoopToken       Loop           = {};                                                     // [-] - Its isolated-vertex loop
+    VertexToken     Vertex         = {};                                                     // [-] - The single vertex
+};
+
+struct EdgeVertexOutcome
+{
+    EdgeToken   Edge        = {};                                                            // [-] - New edge (corner vertex → new vertex)
+    VertexToken Vertex      = {};                                                            // [-] - New vertex
+    FinToken    OutboundFin = {};                                                            // [-] - Forward fin, corner → new vertex
+    FinToken    ReturnFin   = {};                                                            // [-] - Reversed fin, new vertex → corner
+};
+
+struct EdgeFaceOutcome
+{
+    EdgeToken Edge           = {};                                                           // [-] - New edge (From vertex → To vertex)
+    FaceToken Face           = {};                                                           // [-] - New face
+    LoopToken Loop           = {};                                                           // [-] - New face's loop
+    FinToken  RetainedFin    = {};                                                           // [-] - Forward fin, stays in the old loop
+    FinToken  TransferredFin = {};                                                           // [-] - Reversed fin, bounds the new face
+};
+
+struct EdgeRingOutcome
+{
+    EdgeToken Edge        = {};                                                              // [-] - New edge joining the two loops
+    FinToken  OutboundFin = {};                                                              // [-] - Forward fin
+    FinToken  ReturnFin   = {};                                                              // [-] - Reversed fin
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    CONSTRUCTIVE EDITS
+//------------------------------------------------------------------------------------------------------------------------
+
+// MVFS — a body with one vertex, one face, one shell (bounding a solid region) and an exterior void region.
+[[nodiscard]] EditOutcome<AcornOutcome> ConstructBodyFaceVertex(ModelPartition& Partition, Vector3 Position);
+
+// MEV — a new edge from the corner's vertex to a new vertex; both fins enter the corner's loop.
+[[nodiscard]] EditOutcome<EdgeVertexOutcome> ConstructEdgeVertex(ModelPartition& Partition, LoopCorner Corner, Vector3 Position);
+
+// MEF — a new edge between two corners of ONE loop, splitting it (the new face inherits a copy of the carrier surface). The old loop keeps the forward fin and the fins from
+//       To onwards; the new face receives the reversed fin and the fins from From onwards. Equal corners give a closed edge
+//       whose forward fin forms a loop on its own.
+[[nodiscard]] EditOutcome<EdgeFaceOutcome> ConstructEdgeFace(ModelPartition& Partition, LoopCorner From, LoopCorner To);
+
+// MEKR — a new edge between corners of TWO loops of one face, merging them (removes a ring).
+[[nodiscard]] EditOutcome<EdgeRingOutcome> ConstructEdgeCollapseRing(ModelPartition& Partition, LoopCorner From, LoopCorner To);
+
+// MFKRH — a new face taking over a ring loop of an existing face (inherits a copy of the carrier surface).
+[[nodiscard]] EditOutcome<FaceToken> ConstructFaceCollapseRing(ModelPartition& Partition, LoopToken Ring);
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    COLLAPSING EDITS
+//------------------------------------------------------------------------------------------------------------------------
+
+// KEMR — remove an edge whose two fins lie in one loop, splitting that loop into two (creates a ring).
+[[nodiscard]] EditOutcome<LoopToken> CollapseEdgeConstructRing(ModelPartition& Partition, EdgeToken Edge);
+
+// KFMRH — remove a single-loop face; its loop becomes a ring of the absorbing face (creates genus or a through hole).
+[[nodiscard]] EditOutcome<bool> CollapseFaceConstructRing(ModelPartition& Partition, FaceToken Absorbing, FaceToken Collapsing);
+
+// KEV — remove an edge and its end vertex of degree one.
+[[nodiscard]] EditOutcome<bool> CollapseEdgeVertex(ModelPartition& Partition, EdgeToken Edge, VertexToken Vertex);
+
+// KEF — remove an edge between two different faces, merging the faces.
+[[nodiscard]] EditOutcome<bool> CollapseEdgeFace(ModelPartition& Partition, EdgeToken Edge);
+
+// KVE — remove a degree-two vertex between Kept and Absorbed: Kept now ends at Absorbed's far vertex, Absorbed and the
+// vertex are reclaimed. Topology only; the caller extends Kept's interval and re-fits its SP-curves (same carrier).
+[[nodiscard]] EditOutcome<bool> CollapseVertexJoinEdges(ModelPartition& Partition, VertexToken Vertex, EdgeToken Kept, EdgeToken Absorbed);
+
+// KVFS — remove an acorn body (one vertex, one face, no edges).
+[[nodiscard]] EditOutcome<bool> CollapseBodyFaceVertex(ModelPartition& Partition, BodyToken Body);
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    SHELL EDITS
+//------------------------------------------------------------------------------------------------------------------------
+
+// Invert a shell: every face sense flips and every loop runs the other way (used for cavities and boolean tool bodies).
+void ReverseShellOrientation(ModelPartition& Partition, SolidShellToken Shell);
+
+// Move a shell into another region; a body left without shells is reclaimed with its regions.
+[[nodiscard]] EditOutcome<bool> TransferShell(ModelPartition& Partition, SolidShellToken Shell, RegionToken Destination);
+
+// Move a shell into a new body of its own (exterior void + one solid region); the inverse of absorbing a cavity.
+[[nodiscard]] EditOutcome<BodyToken> DetachShell(ModelPartition& Partition, SolidShellToken Shell);
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Topology/ModelPartition.cpp b/Engine/GeometryProcessing/Topology/ModelPartition.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..edf14c6ce1c6290a497e289482a258e7f1eefa52
--- /dev/null
+++ b/Engine/GeometryProcessing/Topology/ModelPartition.cpp
@@ -0,0 +1,161 @@
+/*====================================================================================================================================
+                                                       MODELPARTITION.CPP
+====================================================================================================================================*/
+// 🧩 B-rep topology (Body → Region → SolidShell → Face → Loop → Fin → Edge → Vertex) with attached exact geometry
+
+#include "Engine/GeometryProcessing/Topology/ModelPartition.h"
+
+#include <algorithm>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    FIN GEOMETRY OF USE
+//------------------------------------------------------------------------------------------------------------------------
+
+VertexToken ModelPartition::FinStart(FinToken Fin) const noexcept
+{
+    const FinProfile&  Use  = Fins.Resolve(Fin);
+    const EdgeProfile& Edge = Edges.Resolve(Use.Edge);
+    return Use.Sense == Orientation::Forward ? Edge.Start : Edge.End;
+}
+
+VertexToken ModelPartition::FinEnd(FinToken Fin) const noexcept
+{
+    const FinProfile&  Use  = Fins.Resolve(Fin);
+    const EdgeProfile& Edge = Edges.Resolve(Use.Edge);
+    return Use.Sense == Orientation::Forward ? Edge.End : Edge.Start;
+}
+
+double ModelPartition::FinParameterStart(FinToken Fin) const noexcept
+{
+    const FinProfile&  Use  = Fins.Resolve(Fin);
+    const EdgeProfile& Edge = Edges.Resolve(Use.Edge);
+    return Use.Sense == Orientation::Forward ? Edge.IntervalLow : Edge.IntervalHigh;
+}
+
+double ModelPartition::FinParameterEnd(FinToken Fin) const noexcept
+{
+    const FinProfile&  Use  = Fins.Resolve(Fin);
+    const EdgeProfile& Edge = Edges.Resolve(Use.Edge);
+    return Use.Sense == Orientation::Forward ? Edge.IntervalHigh : Edge.IntervalLow;
+}
+
+FinToken ModelPartition::RadialMate(FinToken Fin) const noexcept
+{
+    return Fins.Resolve(Fin).RadialSuccessor;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TRAVERSAL
+//------------------------------------------------------------------------------------------------------------------------
+
+void ModelPartition::EnumerateLoopFins(LoopToken Loop, const std::function<void(FinToken)>& Visitor) const
+{
+    const FinToken First = Loops.Resolve(Loop).FirstFin;                                     // [-] - Cycle entry
+    if (!First.PresentCondition()) return;
+    FinToken   Cursor     = First;                                                           // [-] - Walking fin
+    size_t     GuardCount = 0;                                                               // [-] - Breaks corrupt cycles
+    const size_t GuardLimit = Fins.OccupiedCount() + 1;                                      // [-] - Upper bound on a cycle
+    do
+    {
+        Visitor(Cursor);
+        Cursor = Fins.Resolve(Cursor).Successor;
+    } while (Cursor.PresentCondition() && !(Cursor == First) && ++GuardCount < GuardLimit);
+}
+
+FinToken ModelPartition::ResolveCorner(LoopToken Loop, VertexToken Vertex) const noexcept
+{
+    FinToken Corner = {};                                                                    // [-] - First fin leaving Vertex
+    EnumerateLoopFins(Loop, [&](FinToken Fin)
+    {
+        if (!Corner.PresentCondition() && FinStart(Fin) == Vertex) Corner = Fin;
+    });
+    return Corner;
+}
+
+BodyInventory ModelPartition::CollectInventory(BodyToken Body) const
+{
+    BodyInventory Inventory;
+    const auto AppendUnique = [](auto& Sequence, auto Token)
+    {
+        if (std::find(Sequence.begin(), Sequence.end(), Token) == Sequence.end()) Sequence.push_back(Token);
+    };
+    for (RegionToken Region : Bodies.Resolve(Body).Regions)
+    {
+        Inventory.Regions.push_back(Region);
+        for (SolidShellToken Shell : Regions.Resolve(Region).Shells)
+        {
+            Inventory.Shells.push_back(Shell);
+            for (FaceToken Face : Shells.Resolve(Shell).Faces)
+            {
+                Inventory.Faces.push_back(Face);
+                for (LoopToken Loop : Faces.Resolve(Face).Loops)
+                {
+                    Inventory.Loops.push_back(Loop);
+                    const LoopProfile& Cycle = Loops.Resolve(Loop);
+                    if (Cycle.IsolatedVertex.PresentCondition()) AppendUnique(Inventory.Vertices, Cycle.IsolatedVertex);
+                    EnumerateLoopFins(Loop, [&](FinToken Fin)
+                    {
+                        Inventory.Fins.push_back(Fin);
+                        const EdgeToken Edge = Fins.Resolve(Fin).Edge;
+                        AppendUnique(Inventory.Edges, Edge);
+                        AppendUnique(Inventory.Vertices, Edges.Resolve(Edge).Start);
+                        AppendUnique(Inventory.Vertices, Edges.Resolve(Edge).End);
+                    });
+                }
+            }
+        }
+    }
+    return Inventory;
+}
+
+BodyToken ModelPartition::EnclosingBody(FaceToken Face) const noexcept
+{
+    return Regions.Resolve(Shells.Resolve(Faces.Resolve(Face).Shell).Region).Body;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    GEOMETRY ATTACHMENT
+//------------------------------------------------------------------------------------------------------------------------
+
+CurveToken ModelPartition::AttachCurve(EdgeToken Edge, CurveGeometry Curve, double IntervalLow, double IntervalHigh)
+{
+    const CurveToken Carrier = Curves.Issue(std::move(Curve));                               // [-] - New curve record
+    EdgeProfile&     Profile = Edges.Resolve(Edge);
+    Profile.Curve        = Carrier;
+    Profile.IntervalLow  = IntervalLow;
+    Profile.IntervalHigh = IntervalHigh;
+    return Carrier;
+}
+
+SurfaceToken ModelPartition::AttachSurface(FaceToken Face, SurfaceGeometry Surface, Orientation Sense)
+{
+    const SurfaceToken Carrier = Surfaces.Issue(std::move(Surface));                         // [-] - New surface record
+    FaceProfile&       Profile = Faces.Resolve(Face);
+    Profile.Surface = Carrier;
+    Profile.Sense   = Sense;
+    return Carrier;
+}
+
+void ModelPartition::AttachSurfaceCurve(FinToken Fin, ParameterCurve Curve)
+{
+    Fins.Resolve(Fin).SurfaceCurve = std::move(Curve);
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TOLERANT MODELLING
+//------------------------------------------------------------------------------------------------------------------------
+
+void ModelPartition::AssignVertexPrecision(VertexToken Vertex, double Precision)
+{
+    Vertices.Resolve(Vertex).Precision = Precision;
+}
+
+void ModelPartition::AssignEdgePrecision(EdgeToken Edge, double Precision)
+{
+    Edges.Resolve(Edge).Precision = Precision;
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Topology/ModelPartition.h b/Engine/GeometryProcessing/Topology/ModelPartition.h
new file mode 100644
index 0000000000000000000000000000000000000000..3ef4cd57f01b6abcd8bc4fa02e6cb1678be0bd2c
--- /dev/null
+++ b/Engine/GeometryProcessing/Topology/ModelPartition.h
@@ -0,0 +1,206 @@
+/*====================================================================================================================================
+                                                        MODELPARTITION.H
+====================================================================================================================================*/
+// 🧩 B-rep topology (Body → Region → SolidShell → Face → Loop → Fin → Edge → Vertex) with attached exact geometry
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Geometry/CurveGeometry.h"
+#include "Engine/GeometryProcessing/Geometry/SurfaceGeometry.h"
+#include "Engine/GeometryProcessing/Precision/PrecisionSpecification.h"
+#include "Engine/GeometryProcessing/Topology/RecordStore.h"
+
+#include <functional>
+#include <optional>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TOKENS
+//------------------------------------------------------------------------------------------------------------------------
+
+struct BodyTag;   struct RegionTag;  struct SolidShellTag; struct FaceTag;
+struct LoopTag;   struct FinTag;     struct EdgeTag;       struct VertexTag;
+struct SurfaceTag; struct CurveTag;
+
+using BodyToken       = RecordToken<BodyTag>;
+using RegionToken     = RecordToken<RegionTag>;
+using SolidShellToken = RecordToken<SolidShellTag>;
+using FaceToken       = RecordToken<FaceTag>;
+using LoopToken       = RecordToken<LoopTag>;
+using FinToken        = RecordToken<FinTag>;
+using EdgeToken       = RecordToken<EdgeTag>;
+using VertexToken     = RecordToken<VertexTag>;
+using SurfaceToken    = RecordToken<SurfaceTag>;
+using CurveToken      = RecordToken<CurveTag>;
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TYPES
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 Parasolid body categories. Acorn = isolated vertices only; General = non-manifold or mixed dimension.
+enum class BodyCategory : uint8_t
+{
+    Acorn = 0,
+    Wire,
+    Sheet,
+    Solid,
+    General,
+};
+
+enum class RegionMaterial : uint8_t
+{
+    Void = 0,
+    Solid,
+};
+
+// 📝 Sense of a use relative to its geometry: a face whose outward normal equals the surface normal, or a fin that runs
+//    along its edge's increasing τ, is Forward.
+enum class Orientation : uint8_t
+{
+    Forward = 0,
+    Reversed,
+};
+
+[[nodiscard]] constexpr Orientation InvertOrientation(Orientation Sense) noexcept
+{
+    return Sense == Orientation::Forward ? Orientation::Reversed : Orientation::Forward;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TOPOLOGY PROFILES
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 Region and SolidShell are the bones SolidArc lacked: a cavity is a second shell bounding the same solid region,
+//    a multi-lump body has several solid regions, and Regions[0] is always the infinite exterior void.
+struct BodyProfile
+{
+    BodyCategory             Category = BodyCategory::Acorn;                                 // [-] - Parasolid body category
+    std::vector<RegionToken> Regions  = {};                                                  // [-] - [0] is the exterior void
+};
+
+struct RegionProfile
+{
+    BodyToken                    Body     = {};                                              // [-] - Enclosing body
+    RegionMaterial               Material = RegionMaterial::Void;                            // [-] - Void or solid
+    std::vector<SolidShellToken> Shells   = {};                                              // [-] - Boundary components
+};
+
+struct SolidShellProfile
+{
+    RegionToken            Region = {};                                                      // [-] - Region this shell bounds
+    std::vector<FaceToken> Faces  = {};                                                      // [-] - Faces of the shell
+};
+
+struct FaceProfile
+{
+    SolidShellToken        Shell   = {};                                                     // [-] - Enclosing shell
+    SurfaceToken           Surface = {};                                                     // [-] - Carrier surface (absent until attached)
+    Orientation            Sense   = Orientation::Forward;                                   // [-] - Outward normal vs surface normal
+    std::vector<LoopToken> Loops   = {};                                                     // [-] - Boundary loops (no outer/inner order)
+};
+
+// 📝 A loop is a cycle of fins, or — immediately after MVFS / KEMR — a single isolated vertex with no fins.
+struct LoopProfile
+{
+    FaceToken   Face           = {};                                                         // [-] - Enclosing face
+    FinToken    FirstFin       = {};                                                         // [-] - Any fin of the cycle
+    VertexToken IsolatedVertex = {};                                                         // [-] - Present only for a fin-less loop
+};
+
+// 💡 A fin is the oriented use of an edge by a loop (Parasolid). Fins of one edge form a radial ring, so a non-manifold
+//    edge is one ring of more than two fins rather than a special case. Each fin owns its SP-curve on the face surface.
+struct FinProfile
+{
+    LoopToken                     Loop            = {};                                      // [-] - Enclosing loop
+    EdgeToken                     Edge            = {};                                      // [-] - Edge used
+    Orientation                   Sense           = Orientation::Forward;                    // [-] - Direction along the edge
+    FinToken                      Successor       = {};                                      // [-] - Next fin in the loop
+    FinToken                      Predecessor     = {};                                      // [-] - Previous fin in the loop
+    FinToken                      RadialSuccessor = {};                                      // [-] - Next fin around the edge
+    std::optional<ParameterCurve> SurfaceCurve    = {};                                      // [-] - SP-curve, same τ as the edge
+};
+
+struct EdgeProfile
+{
+    CurveToken  Curve        = {};                                                           // [-]   - Carrier curve (absent until attached)
+    VertexToken Start        = {};                                                           // [-]   - Vertex at τ = IntervalLow
+    VertexToken End          = {};                                                           // [-]   - Vertex at τ = IntervalHigh
+    double      IntervalLow  = 0.0;                                                          // [-]   - Curve parameter at Start
+    double      IntervalHigh = 0.0;                                                          // [-]   - Curve parameter at End
+    double      Precision    = ExactPrecision;                                               // [len] - Local tube radius (NaN = exact)
+    FinToken    RadialFin    = {};                                                           // [-]   - Entry into the radial ring
+};
+
+struct VertexProfile
+{
+    Vector3 Position  = {};                                                                  // [len] - Point
+    double  Precision = ExactPrecision;                                                      // [len] - Local sphere radius (NaN = exact)
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TRAVERSAL RESULTS
+//------------------------------------------------------------------------------------------------------------------------
+
+// Deduplicated topology reachable from one body, in deterministic traversal order.
+struct BodyInventory
+{
+    std::vector<RegionToken>     Regions  = {};                                              // [-] - All regions
+    std::vector<SolidShellToken> Shells   = {};                                              // [-] - All shells
+    std::vector<FaceToken>       Faces    = {};                                              // [-] - All faces
+    std::vector<LoopToken>       Loops    = {};                                              // [-] - All loops
+    std::vector<FinToken>        Fins     = {};                                              // [-] - All fins
+    std::vector<EdgeToken>       Edges    = {};                                              // [-] - All edges
+    std::vector<VertexToken>     Vertices = {};                                              // [-] - All vertices
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PARTITION
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 A partition owns every topological and geometric record of the bodies modelled together (Parasolid term).
+//    Mutation goes through EulerEdits; geometry is attached through the Attach… functions; reads are free.
+class ModelPartition
+{
+public:
+    RecordStore<BodyTag, BodyProfile>             Bodies;
+    RecordStore<RegionTag, RegionProfile>         Regions;
+    RecordStore<SolidShellTag, SolidShellProfile> Shells;
+    RecordStore<FaceTag, FaceProfile>             Faces;
+    RecordStore<LoopTag, LoopProfile>             Loops;
+    RecordStore<FinTag, FinProfile>               Fins;
+    RecordStore<EdgeTag, EdgeProfile>             Edges;
+    RecordStore<VertexTag, VertexProfile>         Vertices;
+    RecordStore<SurfaceTag, SurfaceGeometry>      Surfaces;
+    RecordStore<CurveTag, CurveGeometry>          Curves;
+
+    // ---- fin geometry of use
+    [[nodiscard]] VertexToken FinStart(FinToken Fin) const noexcept;
+    [[nodiscard]] VertexToken FinEnd(FinToken Fin) const noexcept;
+    [[nodiscard]] double      FinParameterStart(FinToken Fin) const noexcept;
+    [[nodiscard]] double      FinParameterEnd(FinToken Fin) const noexcept;
+    [[nodiscard]] FinToken    RadialMate(FinToken Fin) const noexcept;
+
+    // ---- traversal
+    void                       EnumerateLoopFins(LoopToken Loop, const std::function<void(FinToken)>& Visitor) const;
+    [[nodiscard]] FinToken     ResolveCorner(LoopToken Loop, VertexToken Vertex) const noexcept;
+    [[nodiscard]] BodyInventory CollectInventory(BodyToken Body) const;
+    [[nodiscard]] BodyToken    EnclosingBody(FaceToken Face) const noexcept;
+
+    // ---- geometry attachment
+    CurveToken   AttachCurve(EdgeToken Edge, CurveGeometry Curve, double IntervalLow, double IntervalHigh);
+    SurfaceToken AttachSurface(FaceToken Face, SurfaceGeometry Surface, Orientation Sense);
+    void         AttachSurfaceCurve(FinToken Fin, ParameterCurve Curve);
+
+    // ---- tolerant modelling
+    void AssignVertexPrecision(VertexToken Vertex, double Precision);
+    void AssignEdgePrecision(EdgeToken Edge, double Precision);
+};
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Topology/RecordStore.h b/Engine/GeometryProcessing/Topology/RecordStore.h
new file mode 100644
index 0000000000000000000000000000000000000000..14dfb69d63944ee305fdbd31c8342b8fc87083fc
--- /dev/null
+++ b/Engine/GeometryProcessing/Topology/RecordStore.h
@@ -0,0 +1,108 @@
+/*====================================================================================================================================
+                                                         RECORDSTORE.H
+====================================================================================================================================*/
+// 🧩 Dense slot store with generation-checked tokens (TokenIssuer / TokenAuthentication) and a vacancy table
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    TOKENS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 A token is (slot, generation). Reclaiming a slot advances its generation, so a token held across a deletion is
+//    detected as stale instead of silently aliasing the slot's next occupant — the failure mode of bare indices
+//    (gap G7: a subtract renumbered 8 of 12 edges).
+template <typename Tag>
+struct RecordToken
+{
+    uint32_t Slot       = UINT32_MAX;                                                        // [idx] - Slot in the store
+    uint32_t Generation = 0;                                                                 // [-]   - Occupancy generation
+
+    [[nodiscard]] constexpr bool PresentCondition() const noexcept { return Slot != UINT32_MAX; }
+    constexpr bool operator==(const RecordToken&) const noexcept = default;
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STORE
+//------------------------------------------------------------------------------------------------------------------------
+
+template <typename Tag, typename Profile>
+class RecordStore
+{
+public:
+    using Token = RecordToken<Tag>;
+
+    // TokenIssuer: place a profile in a vacant slot (or append) and issue its token.
+    Token Issue(Profile Payload)
+    {
+        if (!VacancyTable.empty())
+        {
+            const uint32_t Slot = VacancyTable.back();                                       // [idx] - Recycled slot
+            VacancyTable.pop_back();
+            SlotTable[Slot].Payload       = std::move(Payload);
+            SlotTable[Slot].OccupiedState = true;
+            return { Slot, SlotTable[Slot].Generation };
+        }
+        SlotTable.push_back({ std::move(Payload), 0u, true });
+        return { static_cast<uint32_t>(SlotTable.size() - 1), 0u };
+    }
+
+    // TokenAuthentication: the token names a live occupant of the generation it was issued for.
+    [[nodiscard]] bool Authenticate(Token Candidate) const noexcept
+    {
+        return Candidate.Slot < SlotTable.size() && SlotTable[Candidate.Slot].OccupiedState &&
+               SlotTable[Candidate.Slot].Generation == Candidate.Generation;
+    }
+
+    // ⚠️ Callers must authenticate first when the token's provenance is external; internal links are audited instead.
+    [[nodiscard]] Profile&       Resolve(Token Target)       noexcept { return SlotTable[Target.Slot].Payload; }
+    [[nodiscard]] const Profile& Resolve(Token Target) const noexcept { return SlotTable[Target.Slot].Payload; }
+
+    // GarbageReclamation of one slot: advance the generation and record the vacancy.
+    void Reclaim(Token Target)
+    {
+        if (!Authenticate(Target)) return;
+        SlotTable[Target.Slot].OccupiedState = false;
+        SlotTable[Target.Slot].Generation   += 1;
+        SlotTable[Target.Slot].Payload       = Profile{};
+        VacancyTable.push_back(Target.Slot);
+    }
+
+    // Enumerate live tokens in slot order (deterministic).
+    void Enumerate(const std::function<void(Token)>& Visitor) const
+    {
+        for (uint32_t Slot = 0; Slot < SlotTable.size(); ++Slot)
+        {
+            if (SlotTable[Slot].OccupiedState) Visitor({ Slot, SlotTable[Slot].Generation });
+        }
+    }
+
+    // Token of the current occupant of a slot (persistent names are keyed by slot; the generation is re-attached here).
+    [[nodiscard]] Token TokenAt(uint32_t Slot) const noexcept { return { Slot, Slot < SlotTable.size() ? SlotTable[Slot].Generation : 0u }; }
+
+    [[nodiscard]] size_t OccupiedCount() const noexcept { return SlotTable.size() - VacancyTable.size(); }
+
+private:
+    struct SlotEntry
+    {
+        Profile  Payload       = {};                                                         // [-] - Occupant profile
+        uint32_t Generation    = 0;                                                          // [-] - Occupancy generation
+        bool     OccupiedState = false;                                                      // [-] - Slot holds a live occupant
+    };
+
+    std::vector<SlotEntry> SlotTable;                                                        // [-] - Dense slots
+    std::vector<uint32_t>  VacancyTable;                                                     // [idx] - Reclaimed slots
+};
+
+} // namespace Frontier::GeometryProcessing
