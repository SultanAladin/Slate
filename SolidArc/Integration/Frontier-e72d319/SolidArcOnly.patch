+    VkPipeline            EdgeIdentityPipeline = VK_NULL_HANDLE;                             // [-] - Stroke cores, identity only
+    VkPipeline            EdgeOccludedIdentityPipeline = VK_NULL_HANDLE;                     // [-] - X-ray ③′: hidden cores, identity only
+    VkPipeline            GridPipeline     = VK_NULL_HANDLE;
