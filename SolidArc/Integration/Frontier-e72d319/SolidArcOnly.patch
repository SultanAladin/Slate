+        const double PostDragJitterPx = (std::abs(Ui.State.Gizmo.Pose.Size - ExpectedPostSize) / std::max(1.0e-9, ExpectedPostSize)) * GizmoPixels;
+        Tally(GizmoZoomGate, PostDragJitterPx,
