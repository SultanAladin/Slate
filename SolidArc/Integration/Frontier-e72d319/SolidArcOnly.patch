+std::string Compose(const char* Pattern, ...)
+{
+    char    Buffer[512];
+    va_list Arguments;
+    va_start(Arguments, Pattern);
+    std::vsnprintf(Buffer, sizeof(Buffer), Pattern, Arguments);
+    va_end(Arguments);
+    return Buffer;
