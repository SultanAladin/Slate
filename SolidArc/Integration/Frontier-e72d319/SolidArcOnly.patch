+    std::printf("\n## Checks\n\n| | Gate | Check | Detail |\n|---|---|---|---|\n");
+    for (const DetailRow& Row : Details) std::printf("| %s | %s | %s | %s |\n", Row.PassedCondition ? "🟢" : "🔴", Row.Gate.c_str(), Row.Name.c_str(), Row.Detail.c_str());
