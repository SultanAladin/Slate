+        std::printf("| %s | %s | %d | %d × %d | %d | %.1e | %.1e | %s | %.9f | %s | %s |\n", Row.PassedCondition ? "🟢" : "🔴", Row.Name.c_str(), Row.Sections, Row.PolesU, Row.PolesV, Row.Edges,
+                    Row.SurfaceGap, Row.MergeGap, Scientific(Row.Analytic).c_str(),
