+frames 2
+click world -2.9938388 0.0 0.4969194
+frames 2
+expect drawing-on-face == 1
+expect drawing-normal-x ~ 0.4472135955
+expect drawing-normal-z ~ 0.894427191
+move world -2.9938388 0.3 0.4969194
+frames 2
