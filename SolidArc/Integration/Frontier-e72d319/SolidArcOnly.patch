+                const double  τ     = Own.Curve.Knots.front() + (Own.Curve.Knots.back() - Own.Curve.Knots.front()) * double(Index) / double(Same.size() - 1);
+                const Vector2 Exact = EvaluateSketchSpline(Own.Curve, τ).Position;
