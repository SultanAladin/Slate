+++ b/Engine/GeometryProcessing/Inspection/FaceOperationEncoding.h
@@ -0,0 +1,48 @@
+/*====================================================================================================================================
+                                                       FACEOPERATIONENCODING.H
+====================================================================================================================================*/
+// 🧩 Face-operation result → JSON: shown body geometry, applied steps, face provenance and the closed-form volume check
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Audit/ModelAudit.h"
+#include "Engine/GeometryProcessing/Local/FaceOperationCatalogue.h"
+#include "Engine/GeometryProcessing/Local/FaceOperations.h"
+
+#include <string>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+struct FaceOperationInspection
+{
+    std::vector<FaceOperationSettings> Applied                  = {};                      // [-]    - Steps actually run (Amount applied)
+    double                             Amount                   = 1.0;                       // [-]    - Multiplier on the last step
+    bool                               SourceShown              = false;                     // [-]    - Viewer asked for the body before
+    int                                CompletedSteps           = 0;                         // [-]    - Steps that succeeded
+    double                             SourceVolume             = 0.0;                       // [len³] - V before
+    double                             ShownVolume              = 0.0;                       // [len³] - V of the shown body (NaN: sheet)
+    double                             OperationMilliseconds    = 0.0;                       // [ms]   - Σ step wall time
+    double                             ConstructionMilliseconds = 0.0;                       // [ms]   - Specimen construction
+    double                             AuditMilliseconds        = 0.0;                       // [ms]   - Audit of the shown body
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 The shown body is the result, or the source when the viewer asks for it or a step refused (the refusal travels in
+//    FaceOperation.Refusal). V* is reported only at Amount = 1 — other amounts have no hand-derived closed form here.
+[[nodiscard]] std::string EncodeFaceOperation(const ModelPartition& Partition, const FaceOperationSpecimen& Specimen, const FaceOperationOutcome& Outcome,
+                                              BodyToken Shown, const AuditReport& Audit, const FaceOperationInspection& Inspection);
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Inspection/FeatureEncoding.cpp b/Engine/GeometryProcessing/Inspection/FeatureEncoding.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..209299d03e57c2fe340e8fe6e19075eb59bdf2f5
--- /dev/null
+++ b/Engine/GeometryProcessing/Inspection/FeatureEncoding.cpp
@@ -0,0 +1,399 @@
+/*====================================================================================================================================
+                                                      FEATUREENCODING.CPP
+====================================================================================================================================*/
+// 🧩 Sketch and feature-tree results → JSON: solved sketches, diagnosis, step reports, persistent names, body geometry
+
+#include "Engine/GeometryProcessing/Inspection/FeatureEncoding.h"
+
+#include "Engine/GeometryProcessing/Inspection/InspectionEncoding.h"
+#include "Engine/GeometryProcessing/Sketch/SketchSpline.h"
+
+#include <cmath>
+#include <numbers>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    [[nodiscard]] Vector3 PlacePoint(const OrthonormalFrame& Plane, Vector2 Position)
+    {
+        return Plane.Origin + Plane.XAxis * Position.X + Plane.YAxis * Position.Y;
+    }
+
+    // Curve polyline in the plane (arcs counter-clockwise from Start to End, splines per knot span).
+    void WriteSketchCurve(JsonWriter& Writer, const SketchModel& Sketch, const SketchCurve& Curve, const OrthonormalFrame& Plane)
+    {
+        Writer.OpenArray("Polyline");
+        for (const Vector2& Sample : SampleSketchCurve(Sketch, Curve)) Writer.Point(nullptr, PlacePoint(Plane, Sample));
+        Writer.CloseArray();
+    }
+
+    void WriteNames(JsonWriter& Writer, const char* Key, const char* Prefix, const std::map<uint32_t, std::string>& Names, auto TokenAt)
+    {
+        Writer.OpenArray(Key);
+        for (const auto& [Slot, Name] : Names)
+        {
+            Writer.OpenObject();
+            Writer.String("Token", LabelToken(Prefix, TokenAt(Slot)));
+            Writer.String("Name", Name);
+            Writer.CloseObject();
+        }
+        Writer.CloseArray();
+    }
+
+    void WriteDiagnosis(JsonWriter& Writer, const SketchModel& Sketch, const SketchSolveOutcome& Solve)
+    {
+        Writer.OpenObject("Diagnosis");
+        Writer.Boolean("Converged", Solve.Converged);
+        Writer.Integer("Iterations", Solve.Iterations);
+        Writer.Integer("Unknowns", Solve.Unknowns);
+        Writer.Integer("Equations", Solve.Equations);
+        Writer.Integer("Rank", Solve.Rank);
+        Writer.Integer("StructuralRank", Solve.StructuralRank);
+        Writer.Integer("DegreesOfFreedom", Solve.DegreesOfFreedom);
+        Writer.Boolean("Singular", Solve.SingularCondition);
+        Writer.Number("Conditioning", Solve.Conditioning);
+        Writer.Number("GenericConditioning", Solve.GenericConditioning);
+        Writer.Number("MaxResidual", Solve.MaxResidual);
+        Writer.Number("Milliseconds", Solve.Milliseconds);
+        Writer.OpenArray("Constraints");
+        for (size_t Index = 0; Index < Sketch.Constraints.size() && Index < Solve.Constraints.size(); ++Index)
+        {
+            const SketchConstraint&       Constraint = Sketch.Constraints[Index];
+            const SketchConstraintReport& Report     = Solve.Constraints[Index];
+            Writer.OpenObject();
+            Writer.String("Label", Constraint.Label.empty() ? std::string(SketchConstraintLabel(Constraint.Kind)) + std::to_string(Index) : Constraint.Label);
+            Writer.String("Kind", SketchConstraintLabel(Constraint.Kind));
+            if (EditableDimensionCondition(Constraint)) Writer.Number("Value", Constraint.Value);
+            if (!Constraint.Parameter.empty()) Writer.String("Parameter", Constraint.Parameter);
+            Writer.String("Status", SketchConstraintStatusLabel(Report.Status));
+            Writer.Number("Residual", Report.Residual);
+            Writer.CloseObject();
+        }
+        Writer.CloseArray();
+        Writer.OpenArray("ConflictGroups");
+        for (const std::vector<int>& Group : Solve.ConflictGroups)
+        {
+            Writer.OpenArray(nullptr);
+            for (int Index : Group) Writer.String(nullptr, Sketch.Constraints[Index].Label.empty() ? SketchConstraintLabel(Sketch.Constraints[Index].Kind) : Sketch.Constraints[Index].Label);
+            Writer.CloseArray();
+        }
+        Writer.CloseArray();
+        Writer.CloseObject();
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+bool EditableDimensionCondition(const SketchConstraint& Constraint)
+{
+    switch (Constraint.Kind)
+    {
+    case SketchConstraintKind::Distance:
+    case SketchConstraintKind::HorizontalDistance:
+    case SketchConstraintKind::VerticalDistance:
+    case SketchConstraintKind::Length:
+    case SketchConstraintKind::Radius:
+    case SketchConstraintKind::Angle: return true;
+    default:                          return false;
+    }
+}
+
+std::string EncodeFeature(const ModelPartition& Partition, const FeatureSpecimen& Specimen, const FeatureTree& Tree,
+                          const RegenerationOutcome& Outcome, const AuditReport& Audit, const FeatureInspection& Inspection)
+{
+    const bool Complete = Inspection.ShownSteps == Inspection.TotalSteps;
+    JsonWriter Writer;
+    Writer.OpenObject();
+    Writer.String("Kind", "Feature");
+    Writer.String("Specimen", Tree.Name);
+    Writer.String("Description", Tree.Description);
+    Writer.OpenObject("Parameters");
+    for (const FeatureParameter& Parameter : Tree.Parameters) Writer.Number(Parameter.Name.c_str(), Parameter.Value);
+    Writer.Integer("Upto", Inspection.ShownSteps);
+    Writer.CloseObject();
+
+    const BodyInventory Inventory = Outcome.Body.PresentCondition() ? Partition.CollectInventory(Outcome.Body) : BodyInventory{};
+    Writer.OpenObject("Summary");
+    Writer.OpenArray("Counts");
+    const std::pair<const char*, long> Counts[] = { { "Vertices", static_cast<long>(Inventory.Vertices.size()) }, { "Edges", static_cast<long>(Inventory.Edges.size()) },
+                                                    { "Faces", static_cast<long>(Inventory.Faces.size()) },       { "Genus", Audit.Genus } };
+    for (const auto& [Name, Count] : Counts)
+    {
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.Integer("Measured", Count);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.Integer("Fins", static_cast<long>(Inventory.Fins.size()));
+    Writer.Integer("Regions", static_cast<long>(Inventory.Regions.size()));
+    if (Outcome.Body.PresentCondition()) Writer.Number("Volume", Inspection.Volume);
+    if (Complete && Outcome.Body.PresentCondition())
+    {
+        const double Expected = Specimen.ExpectedVolume(Tree);
+        Writer.Number("ExpectedVolume", Expected);
+        Writer.Number("VolumeError", std::fabs(Inspection.Volume - Expected));
+        Writer.Number("VolumeAllowance", 1.0e-9 * std::max(1.0, std::fabs(Expected)));
+    }
+    Writer.Number("RegenerationMilliseconds", Outcome.Milliseconds);
+    Writer.Number("AuditMilliseconds", Inspection.AuditMilliseconds);
+    Writer.CloseObject();
+
+    Writer.OpenObject("Feature");
+    Writer.String("Oracle", Specimen.Oracle);
+    Writer.Integer("ShownSteps", Inspection.ShownSteps);
+    Writer.Integer("TotalSteps", Inspection.TotalSteps);
+    Writer.OpenArray("ExpectedRefusals");
+    if (Complete) for (const std::string& Label : Specimen.ExpectedRefusals(Tree)) Writer.String(nullptr, Label);
+    Writer.CloseArray();
+    Writer.OpenArray("Ranges");
+    for (const FeatureParameter& Parameter : Tree.Parameters)
+    {
+        Writer.OpenObject();
+        Writer.String("Name", Parameter.Name);
+        Writer.Number("Low", Parameter.Low);
+        Writer.Number("High", Parameter.High);
+        Writer.String("Description", Parameter.Description);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.OpenArray("Steps");
+    for (size_t Index = 0; Index < Outcome.Steps.size(); ++Index)
+    {
+        const FeatureStepReport& Report = Outcome.Steps[Index];
+        const FeatureStep&       Step   = Tree.Steps[Index];
+        Writer.OpenObject();
+        Writer.String("Label", Report.Label);
+        Writer.String("Kind", FeatureStepKindLabel(Report.Kind));
+        Writer.String("Status", Report.Status == FeatureStepStatus::Built ? "Built" : "Refused");
+        if (!Report.Refusal.empty()) Writer.String("Refusal", Report.Refusal);
+        Writer.Number("Milliseconds", Report.Milliseconds);
+        if (Report.Kind == FeatureStepKind::Extrude || Report.Kind == FeatureStepKind::Revolve)
+        {
+            Writer.String("Detail", Step.Profile + " · " + FeatureCombinationLabel(Step.Combination) +
+                                    (Report.Kind == FeatureStepKind::Extrude ? " · extent " + std::to_string(EvaluateFeatureValue(Tree, Step.Extent)).substr(0, 6) : std::string()));
+        }
+        if (Report.Kind == FeatureStepKind::Sketch)
+        {
+            Writer.String("Detail", "DOF " + std::to_string(Report.Solve.DegreesOfFreedom) + " · rank " + std::to_string(Report.Solve.Rank) + "/" +
+                                    std::to_string(Report.Solve.Unknowns) + (Report.Solve.SingularCondition ? " · singular" : ""));
+        }
+        if (Report.Kind == FeatureStepKind::Blend) Writer.String("Detail", std::string(Step.Shape == BlendProfile::Fillet ? "fillet " : "chamfer ") + std::to_string(EvaluateFeatureValue(Tree, Step.Size)).substr(0, 6));
+        if (Report.Kind == FeatureStepKind::FaceOperation) Writer.String("Detail", std::string(FaceOperationLabel(Step.Operation)) + " " + std::to_string(EvaluateFeatureValue(Tree, Step.Amount)).substr(0, 6));
+        if (Report.Kind == FeatureStepKind::SpaceCurve)
+        {
+            const auto Found = Outcome.Curves.find(Step.Label);
+            std::string Detail = std::to_string(Step.Points.size()) + " points";
+            if (Found != Outcome.Curves.end())
+            {
+                Detail += " → " + std::to_string(Found->second.Curve.Definition->Poles.size()) + " poles · worst " + std::to_string(Found->second.WorstDeviation * 1000.0).substr(0, 5) + " mm";
+            }
+            if (!Step.PoleEdits.empty()) Detail += " · " + std::to_string(Step.PoleEdits.size()) + " pole edits";
+            Writer.String("Detail", Detail);
+        }
+        if (Report.Kind == FeatureStepKind::Loft || Report.Kind == FeatureStepKind::Network)
+        {
+            std::string Detail;
+            for (size_t Section = 0; Section < Step.Sections.size(); ++Section) Detail += (Section ? " · " : "") + Step.Sections[Section];
+            if (Step.Continuity > 0) Detail += " · G" + std::to_string(Step.Continuity);
+            Writer.String("Detail", Detail);
+        }
+        if (Report.Kind == FeatureStepKind::Mirror)
+        {
+            const Vector3 Normal = Step.Plane.ZAxis;
+            Writer.String("Detail", "normal (" + std::to_string(Normal.X).substr(0, 5) + ", " + std::to_string(Normal.Y).substr(0, 5) + ", " + std::to_string(Normal.Z).substr(0, 5) + ")");
+        }
+        Writer.OpenArray("References");
+        for (size_t Reference = 0; Reference < Step.References.size(); ++Reference)
+        {
+            Writer.OpenObject();
+            Writer.String("Name", Step.References[Reference].Name);
+            if (Reference < Report.Resolutions.size())
+            {
+                const ResolvedReference& Resolved = Report.Resolutions[Reference];
+                Writer.String("Method", ResolutionMethodLabel(Resolved.Method));
+                if (!Resolved.Matched.empty()) Writer.String("Matched", Resolved.Matched);
+                if (Resolved.Method != ResolutionMethod::Refused)
+                {
+                    Writer.String("Token", Step.References[Reference].Kind == ReferenceKind::Face ? LabelToken("F", Partition.Faces.TokenAt(Resolved.Slot))
+                                                                                                  : LabelToken("E", Partition.Edges.TokenAt(Resolved.Slot)));
+                }
+            }
+            Writer.CloseObject();
+        }
+        Writer.CloseArray();
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+
+    // ---- sketches on their planes (construction curves flagged)
+    Writer.OpenArray("Sketches");
+    for (size_t Index = 0; Index < Outcome.Steps.size(); ++Index)
+    {
+        const FeatureStep& Step = Tree.Steps[Index];
+        if (Step.Kind != FeatureStepKind::Sketch) continue;
+        const auto Found = Outcome.Sketches.find(Step.Label);
+        if (Found == Outcome.Sketches.end()) continue;
+        OrthonormalFrame Plane = Step.Plane;
+        Plane.Origin = Step.Plane.Origin + Step.Plane.ZAxis * EvaluateFeatureValue(Tree, Step.Elevation);
+        Writer.OpenObject();
+        Writer.String("Label", Step.Label);
+        Writer.Boolean("Refused", Outcome.Steps[Index].Status == FeatureStepStatus::Refused);
+        Writer.OpenArray("Curves");
+        for (const SketchCurve& Curve : Found->second.Curves)
+        {
+            Writer.OpenObject();
+            Writer.String("Name", SketchCurveName(Curve));
+            Writer.Boolean("Construction", Curve.Construction);
+            WriteSketchCurve(Writer, Found->second, Curve, Plane);
+            Writer.CloseObject();
+        }
+        Writer.CloseArray();
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+
+    Writer.OpenObject("Names");
+    WriteNames(Writer, "Faces", "F", Outcome.Naming.Faces, [&](uint32_t Slot) { return Partition.Faces.TokenAt(Slot); });
+    WriteNames(Writer, "Edges", "E", Outcome.Naming.Edges, [&](uint32_t Slot) { return Partition.Edges.TokenAt(Slot); });
+    WriteNames(Writer, "Vertices", "V", Outcome.Naming.Vertices, [&](uint32_t Slot) { return Partition.Vertices.TokenAt(Slot); });
+    Writer.CloseObject();
+    Writer.CloseObject();
+
+    EncodeAuditSection(Writer, Audit);
+    if (Outcome.Body.PresentCondition()) EncodeBodyGeometry(Writer, Partition, Outcome.Body);
+    else
+    {
+        Writer.OpenObject("Tree"); Writer.String("Label", "no body yet"); Writer.OpenArray("Members"); Writer.CloseArray(); Writer.CloseObject();
+        Writer.OpenArray("Vertices"); Writer.CloseArray();
+        Writer.OpenArray("Edges"); Writer.CloseArray();
+        Writer.OpenArray("Faces"); Writer.CloseArray();
+    }
+    Writer.CloseObject();
+    return Writer.Result();
+}
+
+std::string EncodeSketch(const SketchSpecimen& Specimen, const SketchModel& Solved, const SketchSolveOutcome& Solve, const SketchProfile& Profile, bool EditedCondition)
+{
+    JsonWriter Writer;
+    Writer.OpenObject();
+    Writer.String("Kind", "Sketch");
+    Writer.String("Specimen", Specimen.Name);
+    Writer.String("Description", Specimen.Description);
+    Writer.OpenObject("Parameters");
+    for (const SketchConstraint& Constraint : Solved.Constraints) if (EditableDimensionCondition(Constraint) && !Constraint.Label.empty()) Writer.Number(Constraint.Label.c_str(), Constraint.Value);
+    Writer.CloseObject();
+
+    Writer.OpenObject("Summary");
+    Writer.Integer("ExpectedDegreesOfFreedom", Specimen.ExpectedDegreesOfFreedom);
+    Writer.Integer("ExpectedRedundant", Specimen.ExpectedRedundant);
+    Writer.Integer("ExpectedConflictGroups", Specimen.ExpectedConflictGroups);
+    Writer.Boolean("ExpectedSingular", Specimen.ExpectedSingular);
+    Writer.Boolean("ExpectedProfile", Specimen.ExpectedProfile);
+    if (std::isfinite(Specimen.ExpectedArea) && !EditedCondition) Writer.Number("ExpectedArea", Specimen.ExpectedArea);
+    Writer.Boolean("Edited", EditedCondition);
+    Writer.Number("Area", Profile.Area);
+    Writer.Integer("Loops", static_cast<long>(Profile.Loops.size()));
+    if (!Profile.Refusal.empty()) Writer.String("ProfileRefusal", Profile.Refusal);
+    Writer.CloseObject();
+
+    WriteDiagnosis(Writer, Solved, Solve);
+    Writer.OpenArray("Redundant");
+    for (int Index : Solve.Redundant) Writer.String(nullptr, Solved.Constraints[Index].Label.empty() ? SketchConstraintLabel(Solved.Constraints[Index].Kind) : Solved.Constraints[Index].Label);
+    Writer.CloseArray();
+
+    // ---- geometry in the viewer's body format: points as vertices, curves as edges, no faces
+    const OrthonormalFrame Plane{};
+    Writer.OpenObject("Audit"); Writer.Boolean("Sound", true); Writer.Integer("Genus", 0); Writer.OpenArray("Tallies"); Writer.CloseArray(); Writer.OpenArray("Findings"); Writer.CloseArray(); Writer.CloseObject();
+    Writer.OpenObject("Tree");
+    Writer.String("Label", Specimen.Name + " · " + std::to_string(Solved.Points.size()) + " points · " + std::to_string(Solved.Curves.size()) + " curves");
+    Writer.OpenArray("Members");
+    for (size_t Index = 0; Index < Solved.Curves.size(); ++Index)
+    {
+        Writer.OpenObject();
+        Writer.String("Token", SketchCurveName(Solved.Curves[Index]));
+        Writer.String("Label", SketchCurveName(Solved.Curves[Index]) + (Solved.Curves[Index].Construction ? " (construction)" : "") + (Index < Solve.CurveFixed.size() && Solve.CurveFixed[Index] ? " · fixed" : " · free"));
+        Writer.OpenArray("Members"); Writer.CloseArray();
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.CloseObject();
+    Writer.OpenArray("Vertices");
+    for (size_t Index = 0; Index < Solved.Points.size(); ++Index)
+    {
+        Writer.OpenObject();
+        Writer.String("Token", "P" + std::to_string(Index));
+        Writer.Point("Position", PlacePoint(Plane, Solved.Points[Index].Position));
+        Writer.Boolean("Fixed", Index < Solve.PointFixed.size() && Solve.PointFixed[Index]);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.OpenArray("Edges");
+    for (size_t Index = 0; Index < Solved.Curves.size(); ++Index)
+    {
+        const SketchCurve& Curve = Solved.Curves[Index];
+        Writer.OpenObject();
+        Writer.String("Token", SketchCurveName(Curve));
+        Writer.String("Curve", Curve.Kind == SketchCurveKind::Line ? "Line" : Curve.Kind == SketchCurveKind::Arc ? "Arc" : Curve.Kind == SketchCurveKind::Spline ? SketchSplineFormLabel(Curve.Form) : "Circle");
+        Writer.Boolean("Construction", Curve.Construction);
+        Writer.Boolean("Fixed", Index < Solve.CurveFixed.size() && Solve.CurveFixed[Index]);
+        WriteSketchCurve(Writer, Solved, Curve, Plane);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.OpenArray("Faces"); Writer.CloseArray();
+    Writer.CloseObject();
+    return Writer.Result();
+}
+
+void EncodeSolidArcCatalogue(JsonWriter& Writer)
+{
+    for (const SketchSpecimen& Specimen : BuildSketchCatalogue())
+    {
+        Writer.OpenObject();
+        Writer.String("Name", Specimen.Name);
+        Writer.String("Kind", "Sketch");
+        Writer.String("Description", Specimen.Description);
+        Writer.OpenObject("Parameters");
+        for (const SketchConstraint& Constraint : Specimen.Sketch.Constraints) if (EditableDimensionCondition(Constraint) && !Constraint.Label.empty()) Writer.Number(Constraint.Label.c_str(), Constraint.Value);
+        Writer.CloseObject();
+        Writer.CloseObject();
+    }
+    for (const std::string& Name : EnumerateFeatureSpecimens())
+    {
+        const FeatureSpecimen Specimen = BuildFeatureSpecimen(Name);
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.String("Kind", "Feature");
+        Writer.String("Description", Specimen.Tree.Description);
+        Writer.OpenObject("Parameters");
+        for (const FeatureParameter& Parameter : Specimen.Tree.Parameters) Writer.Number(Parameter.Name.c_str(), Parameter.Value);
+        Writer.Integer("Upto", static_cast<long>(Specimen.Tree.Steps.size()));
+        Writer.CloseObject();
+        Writer.OpenArray("Ranges");
+        for (const FeatureParameter& Parameter : Specimen.Tree.Parameters)
+        {
+            Writer.OpenObject();
+            Writer.String("Name", Parameter.Name);
+            Writer.Number("Low", Parameter.Low);
+            Writer.Number("High", Parameter.High);
+            Writer.String("Description", Parameter.Description);
+            Writer.CloseObject();
+        }
+        Writer.CloseArray();
+        Writer.OpenArray("Steps");
+        for (const FeatureStep& Step : Specimen.Tree.Steps) Writer.String(nullptr, Step.Label);
+        Writer.CloseArray();
+        Writer.CloseObject();
+    }
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Inspection/FeatureEncoding.h b/Engine/GeometryProcessing/Inspection/FeatureEncoding.h
new file mode 100644
index 0000000000000000000000000000000000000000..9c316af90e07aa4a07a61ca58c3759160da78198
--- /dev/null
+++ b/Engine/GeometryProcessing/Inspection/FeatureEncoding.h
@@ -0,0 +1,55 @@
+/*====================================================================================================================================
+                                                       FEATUREENCODING.H
+====================================================================================================================================*/
+// 🧩 Sketch and feature-tree results → JSON: solved sketches, diagnosis, step reports, persistent names, body geometry
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Audit/ModelAudit.h"
+#include "Engine/GeometryProcessing/Feature/FeatureCatalogue.h"
+#include "Engine/GeometryProcessing/Inspection/JsonWriter.h"
+#include "Engine/GeometryProcessing/Sketch/SketchCatalogue.h"
+#include "Engine/GeometryProcessing/Sketch/SketchProfile.h"
+
+#include <string>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+struct FeatureInspection
+{
+    int    ShownSteps        = 0;                                                            // [-]    - Steps replayed (Upto)
+    int    TotalSteps        = 0;                                                            // [-]    - Steps in the tree
+    double Volume            = 0.0;                                                          // [len³] - V of the shown body
+    double AuditMilliseconds = 0.0;                                                          // [ms]   - Audit of the shown body
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 The regenerated body with every face / edge / vertex token mapped to its persistent name, the step reports
+//    (status, refusal, how each reference resolved), and every solved sketch drawn on its plane.
+[[nodiscard]] std::string EncodeFeature(const ModelPartition& Partition, const FeatureSpecimen& Specimen, const FeatureTree& Tree,
+                                        const RegenerationOutcome& Outcome, const AuditReport& Audit, const FeatureInspection& Inspection);
+
+// 💡 A solved catalogue sketch: points, curves (plane z = 0), diagnosis, per-constraint status, profile.
+//    EditedCondition: the viewer changed a dimension, so the catalogue's closed-form area no longer applies.
+[[nodiscard]] std::string EncodeSketch(const SketchSpecimen& Specimen, const SketchModel& Solved, const SketchSolveOutcome& Solve, const SketchProfile& Profile,
+                                       bool EditedCondition);
+
+// Catalogue rows for the viewer (kinds "Sketch" and "Feature").
+void EncodeSolidArcCatalogue(JsonWriter& Writer);
+
+// Dimension constraints a viewer may edit: label → value (Distance, Horizontal/VerticalDistance, Length, Radius, Angle).
+[[nodiscard]] bool EditableDimensionCondition(const SketchConstraint& Constraint);
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Inspection/InspectionEncoding.cpp b/Engine/GeometryProcessing/Inspection/InspectionEncoding.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..02bdeed575bd068ca0c95f83e862fc298aac21e8
--- /dev/null
+++ b/Engine/GeometryProcessing/Inspection/InspectionEncoding.cpp
@@ -0,0 +1,444 @@
+/*====================================================================================================================================
+                                                    INSPECTIONENCODING.CPP
+====================================================================================================================================*/
+// 🧩 One-line JSON description of a body for the HTML inspection viewport (topology tree, exact samples, audit)
+
+#include "Engine/GeometryProcessing/Inspection/InspectionEncoding.h"
+
+#include "Engine/GeometryProcessing/Blend/BlendCatalogue.h"
+#include "Engine/GeometryProcessing/Boolean/BooleanCatalogue.h"
+#include "Engine/GeometryProcessing/Inspection/IntersectionCatalogue.h"
+#include "Engine/GeometryProcessing/Inspection/JsonWriter.h"
+#include "Engine/GeometryProcessing/Local/FaceOperationCatalogue.h"
+#include "Engine/GeometryProcessing/Inspection/FeatureEncoding.h"
+#include "Engine/GeometryProcessing/Topology/ModelPartition.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    constexpr int ArcSampleCount   = 64;                                                     // [-] - Samples per circular edge
+    constexpr int HatchLineCount   = 9;                                                      // [-] - Iso-lines per direction
+    constexpr int HatchSampleCount = 97;                                                     // [-] - Samples per iso-line
+
+    // Parameter-space polygon of every loop of a face (SP-curves sampled; gaps close implicitly).
+    [[nodiscard]] std::vector<std::vector<Vector2>> SampleFaceBoundary(const ModelPartition& Partition, FaceToken Face)
+    {
+        std::vector<std::vector<Vector2>> Polygons;
+        for (LoopToken Loop : Partition.Faces.Resolve(Face).Loops)
+        {
+            std::vector<Vector2> Polygon;
+            Partition.EnumerateLoopFins(Loop, [&](FinToken Fin)
+            {
+                const FinProfile& Use = Partition.Fins.Resolve(Fin);
+                if (!Use.SurfaceCurve.has_value()) return;
+                const int    SampleCount = std::holds_alternative<ParameterLine>(*Use.SurfaceCurve) ? 2 : ArcSampleCount;
+                const double Start = Partition.FinParameterStart(Fin);                       // [-] - τ at fin start
+                const double End   = Partition.FinParameterEnd(Fin);                         // [-] - τ at fin end
+                for (int SampleIndex = 0; SampleIndex < SampleCount; ++SampleIndex)
+                {
+                    const double τ = Start + (End - Start) * SampleIndex / (SampleCount - 1);
+                    Polygon.push_back(EvaluateParameterCurve(*Use.SurfaceCurve, τ).Position);
+                }
+            });
+            if (Polygon.size() >= 3) Polygons.push_back(std::move(Polygon));
+        }
+        return Polygons;
+    }
+
+    // Even–odd containment against all loop polygons.
+    [[nodiscard]] bool InsideCondition(const std::vector<std::vector<Vector2>>& Polygons, Vector2 Probe)
+    {
+        bool Inside = false;                                                                 // [-] - Parity of crossings
+        for (const auto& Polygon : Polygons)
+        {
+            for (size_t Index = 0, Previous = Polygon.size() - 1; Index < Polygon.size(); Previous = Index++)
+            {
+                const Vector2 First  = Polygon[Index];                                       // [-] - Segment end
+                const Vector2 Second = Polygon[Previous];                                    // [-] - Segment start
+                if ((First.Y > Probe.Y) != (Second.Y > Probe.Y) &&
+                    Probe.X < (Second.X - First.X) * (Probe.Y - First.Y) / (Second.Y - First.Y) + First.X)
+                {
+                    Inside = !Inside;
+                }
+            }
+        }
+        return Inside;
+    }
+
+    void EncodeTree(JsonWriter& Writer, const ModelPartition& Partition, BodyToken Body)
+    {
+        const auto PrecisionSuffix = [](double Precision) -> std::string
+        {
+            if (!TolerantCondition(Precision)) return "";
+            char Buffer[32];
+            std::snprintf(Buffer, sizeof(Buffer), " \xC2\xB7 tol %.1e", Precision);
+            return Buffer;
+        };
+        Writer.OpenObject("Tree");
+        const BodyProfile& Profile = Partition.Bodies.Resolve(Body);
+        constexpr const char* Categories[] = { "Acorn", "Wire", "Sheet", "Solid", "General" };
+        Writer.String("Label", LabelToken("B", Body) + " Body \xC2\xB7 " + Categories[static_cast<int>(Profile.Category)]);
+        Writer.String("Token", LabelToken("B", Body));
+        Writer.OpenArray("Members");
+        for (RegionToken Region : Profile.Regions)
+        {
+            const RegionProfile& Space = Partition.Regions.Resolve(Region);
+            Writer.OpenObject();
+            Writer.String("Label", LabelToken("R", Region) + " Region \xC2\xB7 " + (Space.Material == RegionMaterial::Solid ? "Solid" : "Void"));
+            Writer.String("Token", LabelToken("R", Region));
+            Writer.OpenArray("Members");
+            for (SolidShellToken Shell : Space.Shells)
+            {
+                Writer.OpenObject();
+                Writer.String("Label", LabelToken("S", Shell) + " SolidShell \xC2\xB7 " + std::to_string(Partition.Shells.Resolve(Shell).Faces.size()) + " faces");
+                Writer.String("Token", LabelToken("S", Shell));
+                Writer.OpenArray("Members");
+                for (FaceToken Face : Partition.Shells.Resolve(Shell).Faces)
+                {
+                    const FaceProfile& Patch = Partition.Faces.Resolve(Face);
+                    const char* Surface = Patch.Surface.PresentCondition() ? SurfaceCategoryLabel(Partition.Surfaces.Resolve(Patch.Surface)) : "none";
+                    Writer.OpenObject();
+                    Writer.String("Label", LabelToken("F", Face) + " Face \xC2\xB7 " + Surface + (Patch.Sense == Orientation::Forward ? " \xC2\xB7 +" : " \xC2\xB7 \xE2\x88\x92"));
+                    Writer.String("Token", LabelToken("F", Face));
+                    Writer.OpenArray("Members");
+                    for (LoopToken Loop : Patch.Loops)
+                    {
+                        const LoopProfile& Cycle = Partition.Loops.Resolve(Loop);
+                        Writer.OpenObject();
+                        Writer.String("Label", LabelToken("L", Loop) + " Loop" + (Cycle.IsolatedVertex.PresentCondition() ? " \xC2\xB7 isolated " + LabelToken("V", Cycle.IsolatedVertex) : ""));
+                        Writer.String("Token", LabelToken("L", Loop));
+                        Writer.OpenArray("Members");
+                        Partition.EnumerateLoopFins(Loop, [&](FinToken Fin)
+                        {
+                            const FinProfile&  Use  = Partition.Fins.Resolve(Fin);
+                            const EdgeProfile& Edge = Partition.Edges.Resolve(Use.Edge);
+                            const char* Curve = Edge.Curve.PresentCondition() ? CurveCategoryLabel(Partition.Curves.Resolve(Edge.Curve)) : "none";
+                            Writer.OpenObject();
+                            Writer.String("Label", LabelToken("Fn", Fin) + " Fin " + (Use.Sense == Orientation::Forward ? "+" : "\xE2\x88\x92") + LabelToken("E", Use.Edge) +
+                                                   " \xC2\xB7 " + Curve + " \xC2\xB7 " + LabelToken("V", Partition.FinStart(Fin)) + "\xE2\x86\x92" + LabelToken("V", Partition.FinEnd(Fin)) +
+                                                   PrecisionSuffix(Edge.Precision));
+                            Writer.String("Token", LabelToken("E", Use.Edge));
+                            Writer.CloseObject();
+                        });
+                        Writer.CloseArray();
+                        Writer.CloseObject();
+                    }
+                    Writer.CloseArray();
+                    Writer.CloseObject();
+                }
+                Writer.CloseArray();
+                Writer.CloseObject();
+            }
+            Writer.CloseArray();
+            Writer.CloseObject();
+        }
+        Writer.CloseArray();
+        Writer.CloseObject();
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+void EncodeAuditSection(JsonWriter& Writer, const AuditReport& Audit)
+{
+    Writer.OpenObject("Audit");
+    Writer.Boolean("Sound", Audit.SoundCondition());
+    Writer.OpenArray("Tallies");
+    for (const AuditTally& Tally : Audit.Tallies)
+    {
+        Writer.OpenObject();
+        Writer.String("Code", Tally.Code);
+        Writer.String("Description", Tally.Description);
+        Writer.Integer("Examined", Tally.Examined);
+        Writer.Integer("Failed", Tally.Failed);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.OpenArray("Findings");
+    for (const AuditFinding& Finding : Audit.Findings)
+    {
+        Writer.OpenObject();
+        Writer.String("Code", Finding.Code);
+        Writer.String("Subject", Finding.Subject);
+        Writer.String("Detail", Finding.Detail);
+        Writer.Number("Measured", Finding.Measured);
+        Writer.Number("Allowed", Finding.Allowed);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.CloseObject();
+
+}
+
+void EncodeBodyGeometry(JsonWriter& Writer, const ModelPartition& Partition, BodyToken Body)
+{
+    const BodyInventory Inventory = Partition.CollectInventory(Body);
+    EncodeTree(Writer, Partition, Body);
+
+    // ---- vertices
+    Writer.OpenArray("Vertices");
+    for (VertexToken Vertex : Inventory.Vertices)
+    {
+        const VertexProfile& Point = Partition.Vertices.Resolve(Vertex);
+        Writer.OpenObject();
+        Writer.String("Token", LabelToken("V", Vertex));
+        Writer.Point("Position", Point.Position);
+        Writer.Number("Precision", Point.Precision);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+
+    // ---- edges sampled from their exact curves
+    Writer.OpenArray("Edges");
+    for (EdgeToken Edge : Inventory.Edges)
+    {
+        const EdgeProfile& Profile = Partition.Edges.Resolve(Edge);
+        if (!Profile.Curve.PresentCondition()) continue;
+        const CurveGeometry& Curve = Partition.Curves.Resolve(Profile.Curve);
+        const int SampleCount = std::holds_alternative<StraightLine>(Curve) ? 2 : ArcSampleCount;
+        Writer.OpenObject();
+        Writer.String("Token", LabelToken("E", Edge));
+        Writer.String("Curve", CurveCategoryLabel(Curve));
+        Writer.Number("Precision", Profile.Precision);
+        Writer.OpenArray("Polyline");
+        for (int SampleIndex = 0; SampleIndex < SampleCount; ++SampleIndex)
+        {
+            const double τ = Profile.IntervalLow + (Profile.IntervalHigh - Profile.IntervalLow) * SampleIndex / (SampleCount - 1);
+            Writer.Point(nullptr, EvaluateCurve(Curve, τ).Position);
+        }
+        Writer.CloseArray();
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+
+    // ---- faces: trimmed iso-parameter hatching and one outward normal
+    Writer.OpenArray("Faces");
+    for (FaceToken Face : Inventory.Faces)
+    {
+        const FaceProfile& Patch = Partition.Faces.Resolve(Face);
+        if (!Patch.Surface.PresentCondition()) continue;
+        const SurfaceGeometry& Surface  = Partition.Surfaces.Resolve(Patch.Surface);
+        const auto             Polygons = SampleFaceBoundary(Partition, Face);
+        Vector2 Low  = {  std::numeric_limits<double>::max(),  std::numeric_limits<double>::max() };   // [-] - Chart box minimum
+        Vector2 High = { -std::numeric_limits<double>::max(), -std::numeric_limits<double>::max() };   // [-] - Chart box maximum
+        for (const auto& Polygon : Polygons)
+        {
+            for (Vector2 Sample : Polygon)
+            {
+                Low  = { std::min(Low.X, Sample.X),  std::min(Low.Y, Sample.Y) };
+                High = { std::max(High.X, Sample.X), std::max(High.Y, Sample.Y) };
+            }
+        }
+        Writer.OpenObject();
+        Writer.String("Token", LabelToken("F", Face));
+        Writer.String("Surface", SurfaceCategoryLabel(Surface));
+        Writer.String("Sense", Patch.Sense == Orientation::Forward ? "Forward" : "Reversed");
+        Writer.OpenArray("Hatch");
+        Vector2 Anchor        = { (Low.X + High.X) * 0.5, (Low.Y + High.Y) * 0.5 };          // [-] - Normal-arrow chart point
+        bool    AnchorInside  = !Polygons.empty() && InsideCondition(Polygons, Anchor);       // [-] - Anchor lies on the face
+        for (int Direction = 0; Direction < 2 && !Polygons.empty(); ++Direction)
+        {
+            for (int LineIndex = 0; LineIndex < HatchLineCount; ++LineIndex)
+            {
+                const double Fraction = (LineIndex + 0.5) / HatchLineCount;                  // [0-1] - Iso-line position
+                std::vector<Vector3> Run;
+                const auto FlushRun = [&]()
+                {
+                    if (Run.size() >= 2)
+                    {
+                        Writer.OpenArray();
+                        for (Vector3 Position : Run) Writer.Point(nullptr, Position);
+                        Writer.CloseArray();
+                    }
+                    Run.clear();
+                };
+                for (int SampleIndex = 0; SampleIndex < HatchSampleCount; ++SampleIndex)
+                {
+                    const double  Along = static_cast<double>(SampleIndex) / (HatchSampleCount - 1);   // [0-1] - Along the iso-line
+                    const Vector2 Chart = Direction == 0
+                        ? Vector2{ Low.X + (High.X - Low.X) * Fraction, Low.Y + (High.Y - Low.Y) * Along }
+                        : Vector2{ Low.X + (High.X - Low.X) * Along,    Low.Y + (High.Y - Low.Y) * Fraction };
+                    if (InsideCondition(Polygons, Chart))
+                    {
+                        Run.push_back(EvaluateSurface(Surface, Chart).Position);
+                        if (!AnchorInside) { Anchor = Chart; AnchorInside = true; }
+                    }
+                    else
+                    {
+                        FlushRun();
+                    }
+                }
+                FlushRun();
+            }
+        }
+        Writer.CloseArray();
+        if (AnchorInside)
+        {
+            const double  Sign   = Patch.Sense == Orientation::Forward ? 1.0 : -1.0;         // [-] - Outward normal sign
+            Writer.OpenObject("Normal");
+            Writer.Point("Origin", EvaluateSurface(Surface, Anchor).Position);
+            Writer.Point("Direction", EvaluateSurfaceNormal(Surface, Anchor) * Sign);
+            Writer.CloseObject();
+        }
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+}
+
+std::string EncodeInspection(const ModelPartition&   Partition,
+                             const std::string&      SpecimenName,
+                             const SpecimenOutcome&  Specimen,
+                             const AuditReport&      Audit,
+                             double                  Volume,
+                             const InspectionTiming& Timing)
+{
+    const BodyInventory Inventory = Partition.CollectInventory(Specimen.Body);
+    JsonWriter Writer;
+    Writer.OpenObject();
+    Writer.String("Kind", "Model");
+    Writer.String("Specimen", SpecimenName);
+    Writer.String("Description", Specimen.Description);
+    Writer.OpenObject("Parameters");
+    for (const auto& [Key, Magnitude] : Specimen.Parameters) Writer.Number(Key.c_str(), Magnitude);
+    Writer.CloseObject();
+
+    // ---- summary against independent expectations
+    const SpecimenExpectation& Expected = Specimen.Expectation;
+    Writer.OpenObject("Summary");
+    const std::pair<const char*, std::pair<long, long>> Counts[] = {
+        { "Vertices", { static_cast<long>(Inventory.Vertices.size()), Expected.Vertices } },
+        { "Edges",    { static_cast<long>(Inventory.Edges.size()),    Expected.Edges } },
+        { "Faces",    { static_cast<long>(Inventory.Faces.size()),    Expected.Faces } },
+        { "Loops",    { static_cast<long>(Inventory.Loops.size()),    Expected.Loops } },
+        { "Shells",   { static_cast<long>(Inventory.Shells.size()),   Expected.Shells } },
+        { "Genus",    { Audit.Genus,                                   Expected.Genus } },
+    };
+    Writer.OpenArray("Counts");
+    for (const auto& [Name, Pair] : Counts)
+    {
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.Integer("Measured", Pair.first);
+        Writer.Integer("Expected", Pair.second);
+        Writer.CloseObject();
+    }
+    Writer.CloseArray();
+    Writer.Integer("Fins", static_cast<long>(Inventory.Fins.size()));
+    Writer.Integer("Regions", static_cast<long>(Inventory.Regions.size()));
+    Writer.Number("Volume", Volume);
+    Writer.Number("ExpectedVolume", Expected.Volume);
+    Writer.Number("RelativeVolumeError", std::fabs(Volume - Expected.Volume) / std::max(1.0e-300, std::fabs(Expected.Volume)));
+    Writer.Number("ConstructionMilliseconds", Timing.ConstructionMilliseconds);
+    Writer.Number("AuditMilliseconds", Timing.AuditMilliseconds);
+    Writer.Number("VolumeMilliseconds", Timing.VolumeMilliseconds);
+    Writer.CloseObject();
+
+    EncodeAuditSection(Writer, Audit);
+    EncodeBodyGeometry(Writer, Partition, Specimen.Body);
+    Writer.CloseObject();
+    return Writer.Result();
+}
+
+std::string EncodeRefusal(const std::string& SpecimenName, const std::string& Refusal)
+{
+    JsonWriter Writer;
+    Writer.OpenObject();
+    Writer.String("Specimen", SpecimenName);
+    Writer.String("Refusal", Refusal);
+    Writer.CloseObject();
+    return Writer.Result();
+}
+
+std::string EncodeCatalogue()
+{
+    JsonWriter Writer;
+    Writer.OpenObject();
+    Writer.OpenArray("Specimens");
+    for (const std::string& Name : EnumerateSpecimens())
+    {
+        ModelPartition  Scratch;
+        SpecimenOutcome Defaults = ConstructSpecimen(Scratch, Name, {});
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.String("Kind", "Model");
+        Writer.String("Description", Defaults.Description);
+        Writer.OpenObject("Parameters");
+        for (const auto& [Key, Magnitude] : Defaults.Parameters) Writer.Number(Key.c_str(), Magnitude);
+        Writer.CloseObject();
+        Writer.CloseObject();
+    }
+    for (const std::string& Name : EnumerateIntersectionScenes())
+    {
+        const IntersectionScene Defaults = ConstructIntersectionScene(Name, {});
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.String("Kind", "Intersection");
+        Writer.String("Description", Defaults.Description);
+        Writer.OpenObject("Parameters");
+        for (const auto& [Key, Magnitude] : Defaults.Parameters) Writer.Number(Key.c_str(), Magnitude);
+        Writer.CloseObject();
+        Writer.CloseObject();
+    }
+    for (const std::string& Name : EnumerateBlendSpecimens())
+    {
+        ModelPartition      Scratch;
+        const BlendSpecimen Defaults = ConstructBlendSpecimen(Scratch, Name);
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.String("Kind", "Blend");
+        Writer.String("Family", Defaults.Family);
+        Writer.String("Description", Defaults.Description);
+        Writer.OpenObject("Parameters");
+        Writer.Number("Size", Defaults.Settings.Size);
+        Writer.Number("Source", 0.0);
+        Writer.CloseObject();
+        Writer.CloseObject();
+    }
+    for (const std::string& Name : EnumerateFaceOperationSpecimens())
+    {
+        ModelPartition              Scratch;
+        const FaceOperationSpecimen Defaults = ConstructFaceOperationSpecimen(Scratch, Name);
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.String("Kind", "FaceOperation");
+        Writer.String("Family", Defaults.Family);
+        Writer.String("Description", Defaults.Description);
+        Writer.OpenObject("Parameters");
+        Writer.Number("Amount", 1.0);
+        Writer.Number("Source", 0.0);
+        Writer.CloseObject();
+        Writer.CloseObject();
+    }
+    for (const std::string& Name : EnumerateBooleanScenes())
+    {
+        ModelPartition     Scratch;
+        const BooleanScene Defaults = ConstructBooleanScene(Scratch, Name);
+        Writer.OpenObject();
+        Writer.String("Name", Name);
+        Writer.String("Kind", "Boolean");
+        Writer.String("Description", Defaults.Description);
+        Writer.OpenObject("Parameters");
+        Writer.Number("Operation", 0.0);
+        Writer.CloseObject();
+        Writer.CloseObject();
+    }
+    EncodeSolidArcCatalogue(Writer);
+    Writer.CloseArray();
+    Writer.CloseObject();
+    return Writer.Result();
+}
+
+} // namespace Frontier::GeometryProcessing
