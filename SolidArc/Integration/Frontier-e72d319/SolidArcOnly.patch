+//------------------------------------------------------------------------------------------------------------------------
+//                                                    BEVEL SESSION
+//------------------------------------------------------------------------------------------------------------------------
+
+[[nodiscard]] std::vector<std::string> SelectedSketchLabels(const SolidArcDocument& Document);
+[[nodiscard]] bool FocusedSketchCondition(const SolidArcWorkspaceState& State);
+
+// B on sketches (Plasticity fillet-curve): the picked mode-1 points of one sketch, else every corner of the picked
+// sketches, else of the focused sketch.
+[[nodiscard]] SolidArcCornerRequest CornerTargets(const SolidArcWorkspaceState& State)
+{
+    SolidArcCornerRequest Request;
+    if (!State.SketchPoints.Sketch.empty() && !State.SketchPoints.Points.empty())
+    {
+        Request.Sketches = { State.SketchPoints.Sketch };
+        Request.Points   = State.SketchPoints.Points;
+        return Request;
+    }
+    Request.Sketches = SelectedSketchLabels(State.Document);
+    if (Request.Sketches.empty() && FocusedSketchCondition(State)) Request.Sketches = { State.FocusedStep };
+    return Request;
+}
+
+// The corner request the session would apply.
+[[nodiscard]] SolidArcCornerRequest ComposeCornerRequest(const SolidArcBevelSession& Bevel)
+{
+    SolidArcCornerRequest Request = Bevel.Corner;
+    Request.Size  = Bevel.Size;
+    Request.Shape = Bevel.Shape == BlendProfile::Fillet ? SketchCornerShape::Fillet : SketchCornerShape::Chamfer;
+    return Request;
+}
+
+void WriteBevelText(SolidArcBevelSession& Bevel)
+{
+    std::snprintf(Bevel.SizeText.data(), Bevel.SizeText.size(), "%.4g", Bevel.Size);
+    Bevel.SizeTypedCondition = false;
+    std::snprintf(Bevel.EndSizeText.data(), Bevel.EndSizeText.size(), "%.4g", Bevel.EndSize);
+    std::snprintf(Bevel.DepthText.data(), Bevel.DepthText.size(), "%.4g", Bevel.Depth);
+}
+
+// The blend the session would apply (variable sizes and the flip only when V is on).
+[[nodiscard]] SolidArcBlendRequest ComposeBlendRequest(const SolidArcBevelSession& Bevel)
+{
+    SolidArcBlendRequest Request;
+    Request.Shape = Bevel.Shape;
+    Request.Size  = Bevel.Size;
+    if (Bevel.VariableEnabled)
+    {
+        Request.EndSize           = Bevel.EndSize;
+        Request.ReversedCondition = Bevel.ReversedCondition;
+    }
+    for (size_t Index = 1; Index < Bevel.Handles.size() && Index < Bevel.CornerSizes.size(); ++Index)
+        if (Bevel.CornerSizes[Index] > 0.0) Request.VertexSizes.push_back({ Bevel.Handles[Index].Vertex, Bevel.CornerSizes[Index] });
+    return Request;
+}
+
+// 📝 Handles: re-measured when the picked edges change (a corner keeps its size while its vertex stays picked).
+void RefreshBevelHandles(SolidArcWorkspaceState& State, bool ForceCondition)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    if (!Bevel.ActiveCondition || Bevel.Verb != SolidArcSessionVerb::Blend)
+    {
+        Bevel.Handles.clear();
+        Bevel.CornerSizes.clear();
+        return;
+    }
+    if (!ForceCondition && Bevel.HandleEdges == State.Document.Selection.Edges) return;
+    std::map<std::string, double> Kept;
+    for (size_t Index = 1; Index < Bevel.Handles.size() && Index < Bevel.CornerSizes.size(); ++Index)
+        if (Bevel.CornerSizes[Index] > 0.0) Kept[Bevel.Handles[Index].Vertex] = Bevel.CornerSizes[Index];
+    Bevel.HandleEdges = State.Document.Selection.Edges;
+    Bevel.Handles     = MeasureSolidArcBlendHandles(State.Document, Bevel.HandleEdges);
+    Bevel.CornerSizes.assign(Bevel.Handles.size(), 0.0);
+    for (size_t Index = 1; Index < Bevel.Handles.size(); ++Index)
+        if (const auto Found = Kept.find(Bevel.Handles[Index].Vertex); Found != Kept.end()) Bevel.CornerSizes[Index] = Found->second;
+    Bevel.HoverHandle   = -1;
+    Bevel.DragHandle    = -1;
+    Bevel.GoodCondition = false;
+}
+
+// Size a handle stands for: its corner size, or the uniform size.
+[[nodiscard]] double BevelHandleSize(const SolidArcBevelSession& Bevel, int Index)
+{
+    return Index > 0 && Index < int(Bevel.CornerSizes.size()) && Bevel.CornerSizes[Index] > 0.0 ? Bevel.CornerSizes[Index] : Bevel.Size;
+}
+
+constexpr float BevelHandleLead  = 26.0f;                                                    // [px] - Handle stick standing off the bevel
+constexpr float BevelMergeBand   = 9.0f;                                                     // [px] - Grip travel caught by a merge size
+constexpr float BevelHandleReach = 11.0f;                                                    // [px] - Pointer distance that grabs a handle
+
+// 📝 Handles follow the bevel (the report "the blue + white controls for the bevel / chamfer … should follow the edges /
+//    vertices"): they stood at the old sharp edge and reached out by the size, so a large bevel left them floating far
+//    off in space. Each now stands on the bevel itself — on the bisector, where the blend's mid-line crosses it: a fillet
+//    of radius r lies r (1 / Spread − 1) in from the sharp edge (90°: 0.41 r), a chamfer of setback s at s √(1 − Spread²)
+//    (90°: 0.71 s) — the uniform ring at mid-edge, each diamond where the blend meets its vertex (at that corner's own
+//    size). A short stick (the lead) stands out from there to the grip.
+[[nodiscard]] double BevelHandleDepthRate(const SolidArcBevelSession& Bevel, int Index)
+{
+    const double Spread = Bevel.Handles[size_t(Index)].Spread;                               // [-]   - cos ½φ
+    if (!(Spread > 0.05) || !(Spread < 0.999)) return 1.0;                                   // Folded or flat: stands for the size itself
+    const double Rate = Bevel.Shape == BlendProfile::Chamfer ? std::sqrt(1.0 - Spread * Spread) : 1.0 / Spread - 1.0;
+    return std::max(Rate, 0.05);                                                             // [-]   - Depth per unit size
+}
+
+// Where the handle stands: on the bevel's mid-line, in from the sharp edge / vertex along the bisector.
+[[nodiscard]] Vector3 BevelHandleBase(const SolidArcBevelSession& Bevel, int Index)
+{
+    const SolidArcBlendHandle& Handle = Bevel.Handles[size_t(Index)];
+    return Handle.Position - Handle.Direction * (BevelHandleDepthRate(Bevel, Index) * BevelHandleSize(Bevel, Index));
+}
+
+// Handle tip (the grip): the lead out from the bevel along the bisector.
+[[nodiscard]] Vector3 BevelHandleTip(const SolidArcBevelSession& Bevel, int Index, double Lead)
+{
+    return BevelHandleBase(Bevel, Index) + Bevel.Handles[size_t(Index)].Direction * Lead;
+}
+
+[[nodiscard]] int CountBevelCorners(const SolidArcBevelSession& Bevel)
+{
+    int Count = 0;
+    for (size_t Index = 1; Index < Bevel.CornerSizes.size(); ++Index) Count += Bevel.CornerSizes[Index] > 0.0 ? 1 : 0;
+    return Count;
+}
+
+// V: variable size on / off; the far size starts at half the current size so the taper is visible at once (a typed far
+//    size is kept when V is pressed again).
+void ToggleBevelVariable(SolidArcWorkspaceState& State)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    if (!Bevel.ActiveCondition || Bevel.Verb != SolidArcSessionVerb::Blend) return;
+    Bevel.VariableEnabled = !Bevel.VariableEnabled;
+    if (Bevel.VariableEnabled && !(Bevel.EndSize > 0.0)) Bevel.EndSize = std::round(0.5 * Bevel.Size * 1.0e4) * 1.0e-4;
+    WriteBevelText(Bevel);
+    Announce(State, Bevel.VariableEnabled ? Compose("Variable size: %s m at the anchor corner → %s m (F flips the anchor)", FormatLength(Bevel.Size).c_str(), FormatLength(Bevel.EndSize).c_str())
+                                          : std::string("Constant size"));
+}
+
+// F: anchor each edge at its other end (the start size moves to the opposite corner).
+void FlipBevelAnchor(SolidArcWorkspaceState& State)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    if (!Bevel.ActiveCondition || Bevel.Verb != SolidArcSessionVerb::Blend || !Bevel.VariableEnabled) return;
+    Bevel.ReversedCondition = !Bevel.ReversedCondition;
+    Announce(State, Bevel.ReversedCondition ? "Anchor flipped: the start size is at each edge's end corner" : "Anchor: the start size is at each edge's start corner");
+}
+
+void OpenBevelSession(SolidArcWorkspaceState& State, BlendProfile Shape)
+{
+    if (State.Document.Selection.Edges.empty())
+    {
+        // 2D: sketch corners (picked points in mode 1, or whole sketches).
+        SolidArcCornerRequest Corner = CornerTargets(State);
+        if (Corner.Sketches.empty())
+        {
+            Announce(State, "Bevel needs selected edges (mode 2), sketch corner points (mode 1) or a picked sketch");
+            return;
+        }
+        const double Previous = State.Bevel.Verb == SolidArcSessionVerb::Corner ? State.Bevel.Size : 0.0;
+        State.Bevel                 = {};
+        State.Bevel.ActiveCondition = true;
+        State.Bevel.Verb            = SolidArcSessionVerb::Corner;
+        State.Bevel.Shape           = Shape;
+        State.Bevel.Size            = Previous > 0.0 ? Previous : 0.1;
+        State.Bevel.Corner          = std::move(Corner);
+        State.Bevel.PinnedCondition = true;                                                  // Plasticity: drag anywhere / type; the card stays usable
+        WriteBevelText(State.Bevel);
+        Announce(State, std::string(Shape == BlendProfile::Fillet ? "Fillet" : "Chamfer") + " sketch corners (B): drag anywhere to size (it stops at the largest that fits) · type a size · D fillet · C chamfer · Enter / right-click applies · Esc aborts");
+        return;
+    }
+    const double Previous = State.Bevel.Verb == SolidArcSessionVerb::Blend ? State.Bevel.Size : 0.0;
+    State.Bevel                 = {};
+    State.Bevel.ActiveCondition = true;
+    State.Bevel.Verb            = SolidArcSessionVerb::Blend;
+    State.Bevel.Shape           = Shape;
+    State.Bevel.Size            = Previous > 0.0 ? Previous : 0.25;
+    // 💡 The start size fits the picked edges: the remembered size (or 0.25) when it is under 35 % of what the edges
+    //    allow, else a round 15 % — so the first preview shows at once instead of a refusal of a size too large.
+    State.Bevel.Fit = MeasureSolidArcBlendFit(State.Document, State.Document.Selection.Edges);
+    const bool Refitted = State.Bevel.Fit.Span > 0.0 && State.Bevel.Size > 0.35 * State.Bevel.Fit.Span;
+    if (Refitted) State.Bevel.Size = State.Bevel.Fit.Fitted;
+    // 💡 Plasticity: the size changes only by a drag (anywhere, or on a handle) or a typed value, so the pointer can reach the
+    //    corner handles and the Bevel card without the size chasing it (Mouse adjust in the card follows the pointer again).
+    State.Bevel.PinnedCondition = true;
+    RefreshBevelHandles(State, true);
+    WriteBevelText(State.Bevel);
+    Announce(State, std::string(Shape == BlendProfile::Fillet ? "Fillet" : "Chamfer") + " (B): drag anywhere or the ring handle to size (it stops at the largest that fits) · drag a corner diamond for a variable size · type in the card · D fillet · C chamfer · V taper · Alt+click an edge loop, Ctrl+Alt+click a ring (Shift adds) · Enter / right-click applies · Esc aborts"
+                    + (Refitted ? " · starts at " + FormatLength(State.Bevel.Size) + " m to fit the edges" : std::string{}));
+}
+
+// 📝 Blender's extrude axis: the faces' outward normals averaged through the centre of their feet (face E, inset depth),
+//    or the sketch's +𝑧 through its profile centroid (sketch E). Opposed normals (no common direction) leave no axis, and
+//    the pointer's x drives the distance as before.
+void ResolveExtrudeAxis(SolidArcWorkspaceState& State)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    Bevel.AxisCondition       = false;
+    Bevel.AxisAnchorCondition = false;
+    Vector3 Centre = {}, Direction = {};
+    int     Count  = 0;
+    if (Bevel.Verb == SolidArcSessionVerb::Profile)
+    {
+        const auto Found = std::find_if(State.Document.Tree.Steps.begin(), State.Document.Tree.Steps.end(),
+                                        [&](const FeatureStep& Step) { return Step.Label == Bevel.ProfileLabel && Step.Kind == FeatureStepKind::Sketch; });
+        if (Found == State.Document.Tree.Steps.end()) return;
+        OrthonormalFrame Plane = Found->Plane;
+        Plane.Origin           = Plane.Origin + Plane.ZAxis * EvaluateFeatureValue(State.Document.Tree, Found->Elevation);
+        const auto          Solved  = State.Document.Regeneration.Sketches.find(Bevel.ProfileLabel);
+        const SketchProfile Profile = ExtractSketchProfile(Solved != State.Document.Regeneration.Sketches.end() ? Solved->second : Found->Sketch);
+        const Vector2       Middle  = Profile.Refusal.empty() ? Profile.Centroid : Vector2{};
+        Centre    = Plane.Origin + Plane.XAxis * Middle.X + Plane.YAxis * Middle.Y;
+        Direction = Plane.ZAxis;
+        Count     = 1;
+    }
+    else
+    {
+        for (const std::string& Name : State.Document.Selection.Faces)
+        {
+            const SolidArcJointOrigin Origin = ResolveSolidArcJointOrigin(State.Document, SolidArcSelectionKind::Face, Name);
+            if (!Origin.Refusal.empty()) continue;
+            const SolidArcFaceFoot Foot = ProjectOntoSolidArcFace(State.Document, Name, Origin.Frame.Origin);
+            if (!Foot.FoundCondition) continue;
+            Centre    = Centre + Foot.Position;
+            Direction = Direction + Foot.Normal;
+            ++Count;
+        }
+    }
+    if (Count == 0 || !(Length(Direction) > 0.5 * Count)) return;                            // Opposed faces: no common axis
+    Bevel.AxisCondition = true;
+    Bevel.AxisOrigin    = Centre * (1.0 / Count);
+    Bevel.AxisDirection = Normalize(Direction);
+}
+
+// Plasticity E: extrude the selected faces; the pointer sets the signed distance like the fillet size.
+void OpenExtrudeSession(SolidArcWorkspaceState& State)
+{
+    if (State.Document.Selection.Faces.empty())
+    {
+        Announce(State, "Extrude needs selected faces (mode 3)");
+        return;
+    }
+    const double Remembered = State.LastCommand.Kind == SolidArcRepeatKind::Face && State.LastCommand.Operation == FaceOperationKind::Extrude ? State.LastCommand.Amount : 0.5;
+    State.Bevel                 = {};
+    State.Bevel.ActiveCondition = true;
+    State.Bevel.Verb            = SolidArcSessionVerb::Extrude;
+    State.Bevel.Size            = Remembered;
+    ResolveExtrudeAxis(State);
+    WriteBevelText(State.Bevel);
+    Announce(State, std::string(State.Bevel.AxisCondition ? "Extrude (E): the face follows the pointer along its normal (Blender)" : "Extrude (E): move horizontally") +
+                    " · out adds, in pushes / cuts a pocket (extrude manifold) · click edits the faces · Enter / right-click applies · Esc aborts");
+}
+
+// Plasticity O on faces (offset-curve of the face boundary) · Blender I: inset the selected planar faces. The pointer sets
+// the inset distance (D) or the depth of the inner face (H: + boss, − pocket); Tab-free, the card fields take typed values.
+void OpenInsetSession(SolidArcWorkspaceState& State)
+{
+    if (State.Document.Selection.Faces.empty())
+    {
+        Announce(State, "Inset needs selected planar faces (mode 3)");
+        return;
+    }
+    const bool Remembered = State.LastCommand.Kind == SolidArcRepeatKind::Face && State.LastCommand.Operation == FaceOperationKind::Inset;
+    State.Bevel                 = {};
+    State.Bevel.ActiveCondition = true;
+    State.Bevel.Verb            = SolidArcSessionVerb::Inset;
+    State.Bevel.Size            = Remembered ? State.LastCommand.Amount : 0.1;
+    State.Bevel.Depth           = Remembered ? State.LastCommand.Depth : 0.0;
+    ResolveExtrudeAxis(State);                                                               // H (depth) follows the pointer along the normal
+    WriteBevelText(State.Bevel);
+    Announce(State, "Inset (O / I): move horizontally · D distance · H depth (− pocket) · click edits the faces · Enter / right-click applies · Esc aborts");
+}
+
+// Profile extrude start: a Union pointing out of the curved face the sketch is tangent to starts sunk into it.
+// A cut into the material its sketch lies on starts a hair outside it, so the tool's cap never sits on the face it cuts
+// (coincident Boolean faces).
+[[nodiscard]] double ProfileStart(const SolidArcBevelSession& Bevel)
+{
+    constexpr double CutLead = 1.0e-3;                                                       // [len] - Cutter start outside the face
+    if (Bevel.Combination == FeatureCombination::Difference && Bevel.ProfileMaterial != 0 && Bevel.Size * Bevel.ProfileMaterial > 0.0)
+        return Bevel.Size > 0.0 ? -CutLead : CutLead;
+    return Bevel.Combination == FeatureCombination::Union && Bevel.Size > 0.0 ? -Bevel.ProfileSink : 0.0;
+}
+
+// Extrude manifold: an automatic Boolean cuts when the drag runs into the material, adds otherwise.
+void ResolveProfileCombination(SolidArcBevelSession& Bevel)
+{
+    if (Bevel.Verb != SolidArcSessionVerb::Profile || !Bevel.AutoCombinationCondition || Bevel.ProfileMaterial == 0) return;
+    Bevel.Combination = Bevel.Size * Bevel.ProfileMaterial > 0.0 ? FeatureCombination::Difference : FeatureCombination::Union;
+}
+
+// The staged preview shows the session as it stands (every parameter the command reads).
+[[nodiscard]] bool BevelStagedCurrent(const SolidArcBevelSession& Bevel)
+{
+    return Bevel.StagedSize == Bevel.Size && Bevel.StagedShape == Bevel.Shape && Bevel.PreviewVerb == Bevel.Verb &&
+           Bevel.StagedVariable == Bevel.VariableEnabled && Bevel.StagedEndSize == Bevel.EndSize && Bevel.StagedReversed == Bevel.ReversedCondition &&
+           Bevel.StagedCombination == Bevel.Combination && Bevel.StagedDepth == Bevel.Depth && Bevel.StagedCorners == Bevel.CornerSizes;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    BEVEL BOUNDS
+//------------------------------------------------------------------------------------------------------------------------
+
+// Everything a bound depends on except the bounded parameter itself (shape, variable taper, flip, edges, other corners).
+[[nodiscard]] std::string ComposeBevelLimitKey(const SolidArcWorkspaceState& State, int Parameter)
+{
+    const SolidArcBevelSession& Bevel = State.Bevel;
+    std::string Key = Compose("%d|%d|%d|%.9g|%d|%llu|", int(Bevel.Verb), int(Bevel.Shape), Bevel.VariableEnabled ? 1 : 0, Bevel.EndSize, Bevel.ReversedCondition ? 1 : 0,
+                              static_cast<unsigned long long>(State.Document.Revision));
+    if (Parameter != 0) Key += Compose("s%.9g|", Bevel.Size);
+    for (size_t Index = 1; Index < Bevel.CornerSizes.size(); ++Index)
+        if (int(Index) != Parameter) Key += Compose("c%d=%.9g|", int(Index), Bevel.CornerSizes[Index]);
+    for (const std::string& Edge : State.Document.Selection.Edges) Key += Edge + ";";
+    for (const std::string& Sketch : Bevel.Corner.Sketches) Key += Sketch + ";";
+    for (const int Point : Bevel.Corner.Points) Key += Compose("p%d;", Point);
+    return Key;
+}
+
+[[nodiscard]] bool BevelBoundedCondition(const SolidArcBevelSession& Bevel)
+{
+    return Bevel.Verb == SolidArcSessionVerb::Blend || Bevel.Verb == SolidArcSessionVerb::Corner;
+}
+
+// The largest size known to work for Parameter (0: none known in the current state).
+[[nodiscard]] double BevelLimitOf(const SolidArcWorkspaceState& State, int Parameter)
+{
+    const SolidArcBevelSession& Bevel = State.Bevel;
+    if (!BevelBoundedCondition(Bevel) || Bevel.LimitParameter != Parameter || !(Bevel.LimitCeiling > 0.0) || !(Bevel.LimitGood > 0.0)) return 0.0;
+    return Bevel.LimitKey == ComposeBevelLimitKey(State, Parameter) ? Bevel.LimitGood : 0.0;
+}
+
+// 💡 A requested value at or past a known refusal is held at the largest accepted one (the pointer / handle stops there).
+//    Before any refusal is known, a blend never exceeds its reach (the fit measure): a setback of the body's diagonal
+//    leaves nothing, so a size past it must not reach the modeller at all. The face width (Span) is no limit — the report
+//    "it suppose to go longer even if i put a value greater it refuses … this is a cube": past it the blend runs on over
+//    the next face (overflow), and at an obtuse edge a fillet's radius is far larger than its setback.
+[[nodiscard]] double BoundBevelValue(SolidArcWorkspaceState& State, int Parameter, double Value)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    const double Reach = Bevel.Shape == BlendProfile::Chamfer ? Bevel.Fit.ChamferReach : Bevel.Fit.FilletReach;   // [len] - Body-eating size
+    if (Bevel.Verb == SolidArcSessionVerb::Blend && Reach > 0.0 && Value > Reach)
+    {
+        ++Bevel.LimitStops;
+        Value = Reach;
+    }
+    if (!BevelBoundedCondition(Bevel) || Bevel.LimitParameter != Parameter || !(Bevel.LimitCeiling > 0.0) || !(Bevel.LimitGood > 0.0)) return Value;
+    if (Value < Bevel.LimitCeiling || Bevel.LimitKey != ComposeBevelLimitKey(State, Parameter)) return Value;
+    if (Value != Bevel.LimitGood) ++Bevel.LimitStops;
+    return Bevel.LimitGood;
+}
+
+// The parameter the user changed since the last preview: a corner handle whose size moved, else the size.
+[[nodiscard]] int ChangedBevelParameter(const SolidArcBevelSession& Bevel)
+{
+    if (Bevel.Verb != SolidArcSessionVerb::Blend || Bevel.StagedSize != Bevel.Size) return 0;
+    for (size_t Index = 1; Index < Bevel.CornerSizes.size(); ++Index)
+    {
+        const double Staged = Index < Bevel.StagedCorners.size() ? Bevel.StagedCorners[Index] : 0.0;
+        if (Bevel.CornerSizes[Index] > 0.0 && Bevel.CornerSizes[Index] != Staged) return int(Index);
+    }
+    return Bevel.LimitParameter > 0 && Bevel.LimitParameter < int(Bevel.CornerSizes.size()) && Bevel.CornerSizes[size_t(Bevel.LimitParameter)] > 0.0 ? Bevel.LimitParameter : 0;
+}
+
+// 📝 After each preview: an accepted value raises the floor, a refused one above it lowers the ceiling; while the gap is
+//    over 0.2 % (≥ 0.1 mm) the next preview tries the middle, then the value settles on the floor (the bound).
+void ConfineBevelLimit(SolidArcWorkspaceState& State, int Parameter, bool AcceptedCondition)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    if (!BevelBoundedCondition(Bevel)) return;
+    if (Parameter > 0 && Parameter >= int(Bevel.CornerSizes.size())) return;
+    double&           Value = Parameter == 0 ? Bevel.Size : Bevel.CornerSizes[size_t(Parameter)];
+    const std::string Key   = ComposeBevelLimitKey(State, Parameter);
+    if (Key != Bevel.LimitKey || Parameter != Bevel.LimitParameter)
+    {
+        Bevel.LimitKey            = Key;
+        Bevel.LimitParameter      = Parameter;
+        Bevel.LimitGood           = 0.0;
+        Bevel.LimitCeiling        = 0.0;
+        Bevel.LimitProbeCondition = false;
+    }
+    if (AcceptedCondition)
+    {
+        Bevel.LimitGood = std::max(Bevel.LimitGood, Value);
+        if (Bevel.LimitCeiling > 0.0 && Value >= Bevel.LimitCeiling) Bevel.LimitCeiling = 0.0;
+    }
+    else if (Bevel.LimitGood > 0.0 && Value > Bevel.LimitGood) Bevel.LimitCeiling = Bevel.LimitCeiling > 0.0 ? std::min(Bevel.LimitCeiling, Value) : Value;
+    if (!(Bevel.LimitCeiling > 0.0) || !(Bevel.LimitGood > 0.0) || (AcceptedCondition && !Bevel.LimitProbeCondition)) return;
+    const double Gap    = Bevel.LimitCeiling - Bevel.LimitGood;                              // [len] - Unknown band
+    const double RelTol = Bevel.StageMs > 200.0 ? 5.0e-2 : Bevel.StageMs > 50.0 ? 2.0e-2 : 2.0e-3;
+    const double AbsTol = Bevel.StageMs > 50.0 ? 5.0e-4 : 1.0e-4;
+    if (Gap > std::max(AbsTol, RelTol * Bevel.LimitGood))
+    {
+        Value                     = std::round(0.5 * (Bevel.LimitGood + Bevel.LimitCeiling) * 1.0e6) * 1.0e-6;
+        Bevel.LimitProbeCondition = true;
+    }
+    else
+    {
+        const bool Settling       = Bevel.LimitProbeCondition || Value != Bevel.LimitGood;
+        Value                     = Bevel.LimitGood;
+        Bevel.LimitProbeCondition = false;
+        if (Settling)
+        {
+            ++Bevel.LimitStops;
+            Announce(State, Parameter == 0 ? Compose("Bevel: %s m is the largest size these edges take · it stops there", FormatLength(Value).c_str())
+                                           : Compose("Corner %d: %s m is the largest it takes · it stops there", Parameter, FormatLength(Value).c_str()));
+        }
+    }
+    WriteBevelText(Bevel);
+    if (Parameter > 0 && Parameter == Bevel.FocusCorner) std::snprintf(Bevel.CornerText.data(), Bevel.CornerText.size(), "%.4g", Value);
+}
+
+void StageBevelPreview(SolidArcWorkspaceState& State)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    if (!Bevel.ActiveCondition) return;
+    ResolveProfileCombination(Bevel);
+    if (BevelStagedCurrent(Bevel)) return;
+    // 💡 A slow preview (a blend along a cylinder–cylinder junction takes seconds) is rebuilt once the pointer rests
+    //    (one size held for 0.15 s and 6 frames: a slow frame alone is no rest), not on every pixel of mouse adjust: the
+    //    last preview stays up meanwhile. A typed (pinned) size, a new shape, verb or Boolean, and every fast preview
+    //    still restage at once.
+    const double Now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    const bool SizeOnly = Bevel.Preview && Bevel.StagedShape == Bevel.Shape && Bevel.PreviewVerb == Bevel.Verb && Bevel.StagedVariable == Bevel.VariableEnabled &&
+                          Bevel.StagedEndSize == Bevel.EndSize && Bevel.StagedReversed == Bevel.ReversedCondition && Bevel.StagedCombination == Bevel.Combination &&
+                          Bevel.StagedDepth == Bevel.Depth;
+    const bool Dragging = Bevel.DragHandle >= 0 || Bevel.PointerDragCondition;               // A handle / empty-space drag is mouse adjust too
+    if (SizeOnly && (!Bevel.PinnedCondition || Dragging) && Bevel.StageMs > 40.0)
+    {
+        if (Bevel.PendingSize != Bevel.Size) { Bevel.PendingSize = Bevel.Size; Bevel.PendingSince = Now; Bevel.PendingFrame = State.FrameNumber; return; }
+        if (State.FrameNumber < Bevel.PendingFrame + 6 || Now - Bevel.PendingSince < 0.15) return;
+    }
+    const int Parameter = ChangedBevelParameter(Bevel);                                      // [idx] - What the bound applies to
+    Bevel.StagedDepth       = Bevel.Depth;
+    Bevel.StagedCombination = Bevel.Combination;
+    Bevel.StagedSize     = Bevel.Size;
+    Bevel.StagedShape    = Bevel.Shape;
+    Bevel.PreviewVerb    = Bevel.Verb;
+    Bevel.StagedVariable = Bevel.VariableEnabled;
+    Bevel.StagedEndSize  = Bevel.EndSize;
+    Bevel.StagedReversed = Bevel.ReversedCondition;
+    Bevel.StagedCorners  = Bevel.CornerSizes;
+    static const char* Verbs[] = { "Blend", "Extrude", "Profile", "Inset", "Corner" };
+    FRONTIER_TRACE_SCOPE("Preview", std::string("StageBevelPreview · ") + Verbs[std::clamp(int(Bevel.Verb), 0, 4)] + " · size " + TraceNumber(Bevel.Size));
+    SolidArcPhaseClock StageClock(State.Profile, "bevel preview · stage");
+    Bevel.Preview     = std::make_unique<SolidArcDocument>(CloneSolidArcDocument(State.Document));
+    const SolidArcCommandOutcome Outcome = Bevel.Verb == SolidArcSessionVerb::Profile ? ExtrudeSolidArcSketch(*Bevel.Preview, Bevel.ProfileLabel, Bevel.Size, Bevel.Combination, BooleanTarget(State), ProfileStart(Bevel), true)
+                                         : Bevel.Verb == SolidArcSessionVerb::Extrude ? ChangeSolidArcSelection(*Bevel.Preview, FaceOperationKind::Extrude, Bevel.Size)
+                                         : Bevel.Verb == SolidArcSessionVerb::Inset   ? InsetSolidArcSelection(*Bevel.Preview, Bevel.Size, Bevel.Depth)
+                                         : Bevel.Verb == SolidArcSessionVerb::Corner  ? CutSolidArcSketchCorners(*Bevel.Preview, ComposeCornerRequest(Bevel))
+                                                                                      : BlendSolidArcSelection(*Bevel.Preview, ComposeBlendRequest(Bevel));
+    Bevel.PreviewOutcome  = Outcome;
+    Bevel.PreviewRevision = State.Document.Revision;
+    if (Outcome.AcceptedCondition)
+    {
+        Bevel.PreviewScene = BuildSolidArcScene(*Bevel.Preview);
+        Bevel.Refusal      = Legible(Bevel.PreviewScene.Refusal);
+        if (Bevel.Refusal.empty())
+        {
+            Bevel.GoodScene     = Bevel.PreviewScene;
+            Bevel.GoodSize      = Bevel.Size;
+            Bevel.GoodCondition = true;
+        }
+    }
+    else
+    {
+        Bevel.Refusal = Legible(Outcome.Refusal);
+    }
+    Bevel.StageMs = (std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count() - Now) * 1.0e3;
+    ++Bevel.StageCount;
+    ConfineBevelLimit(State, Parameter, Outcome.AcceptedCondition && Bevel.Refusal.empty());
+}
+
+void ApplyBevelSession(SolidArcWorkspaceState& State)
+{
+    // A refusal of a stale preview (the pointer moved on while a slow preview waited) does not block: the kernel decides.
+    if (!State.Bevel.ActiveCondition) return;
+    // A size typed in the field but not entered (right-click straight after typing) is the size the user means.
+    SolidArcBevelSession& Typed = State.Bevel;
+    double TypedSize = 0.0;
+    if (Typed.SizeTypedCondition && ParseSolidArcLength(Typed.SizeText.data(), TypedSize) && TypedSize != 0.0)
+    {
+        const bool Signed = Typed.Verb == SolidArcSessionVerb::Extrude || Typed.Verb == SolidArcSessionVerb::Profile;
+        if (TypedSize < 0.0 && (Typed.Verb == SolidArcSessionVerb::Blend || Typed.Verb == SolidArcSessionVerb::Corner)) Typed.Shape = BlendProfile::Chamfer;
+        Typed.Size            = Signed ? TypedSize : std::abs(TypedSize);
+        Typed.PinnedCondition = true;
+    }
+    Typed.SizeTypedCondition = false;
+    if (Typed.LimitProbeCondition && Typed.LimitGood > 0.0)                                  // Applied mid-search: the largest accepted value
+    {
+        if (Typed.LimitParameter == 0) Typed.Size = Typed.LimitGood;
+        else if (Typed.LimitParameter < int(Typed.CornerSizes.size())) Typed.CornerSizes[size_t(Typed.LimitParameter)] = Typed.LimitGood;
+        Typed.LimitProbeCondition = false;
+    }
+    if (TypedSize != 0.0) Typed.Size = BoundBevelValue(State, 0, Typed.Size);
+    ResolveProfileCombination(Typed);
+    if (!State.Bevel.Refusal.empty() && State.Bevel.StagedSize == State.Bevel.Size)
+    {
+        Announce(State, "Not applied: " + State.Bevel.Refusal + " · change the size, or Esc");
+        return;
+    }
+    const BlendProfile         Shape   = State.Bevel.Shape;
+    const double               Size    = State.Bevel.Size;
+    const SolidArcBlendRequest Request = ComposeBlendRequest(State.Bevel);
+    // 💡 The preview on screen is the result: when it was staged from this document with every parameter as it stands,
+    //    it is adopted (one undo entry, its display arrays reused) instead of running the command a second time.
+    std::unique_ptr<SolidArcDocument> Staged     = std::move(State.Bevel.Preview);
+    const bool                        Adoptable  = Staged && State.Bevel.PreviewOutcome.AcceptedCondition && State.Bevel.PreviewRevision == State.Document.Revision &&
+                                                   BevelStagedCurrent(State.Bevel) && State.Bevel.Refusal.empty();
+    if (Adoptable) State.ReadyScene = std::move(State.Bevel.PreviewScene);
+    const auto Run = [&](auto&& Direct) -> SolidArcCommandOutcome
+    {
+        return Adoptable ? AdoptSolidArcPreview(State.Document, std::move(*Staged), State.Bevel.PreviewOutcome) : Direct();
+    };
+    State.Bevel.ActiveCondition = false;
+    if (State.Bevel.Verb == SolidArcSessionVerb::Corner)
+    {
+        const SolidArcCommandOutcome Outcome = Run([&] { return CutSolidArcSketchCorners(State.Document, ComposeCornerRequest(State.Bevel)); });
+        if (Outcome.AcceptedCondition) State.SketchPoints.Points.clear();
+        Conclude(State, Outcome);
+        return;
+    }
+    if (State.Bevel.Verb == SolidArcSessionVerb::Profile)
+    {
+        const SolidArcCommandOutcome Outcome = Run([&] { return ExtrudeSolidArcSketch(State.Document, State.Bevel.ProfileLabel, Size, State.Bevel.Combination, BooleanTarget(State),
+                                                                     ProfileStart(State.Bevel), true); });
+        if (Outcome.AcceptedCondition) State.FocusedStep = {};
+        Conclude(State, Outcome);
+        return;
+    }
+    if (State.Bevel.Verb == SolidArcSessionVerb::Inset)
+    {
+        const double                 Depth   = State.Bevel.Depth;
+        const SolidArcCommandOutcome Outcome = Run([&] { return InsetSolidArcSelection(State.Document, Size, Depth); });
+        if (Outcome.AcceptedCondition) State.LastCommand = { SolidArcRepeatKind::Face, Shape, 0.0, FaceOperationKind::Inset, Size, {}, {}, Depth };
+        Conclude(State, Outcome);
+        return;
+    }
+    if (State.Bevel.Verb == SolidArcSessionVerb::Extrude)
+    {
+        const SolidArcCommandOutcome Outcome = Run([&] { return ChangeSolidArcSelection(State.Document, FaceOperationKind::Extrude, Size); });
+        if (Outcome.AcceptedCondition)
+        {
+            SolidArcRepeat Rep{};
+            Rep.Kind      = SolidArcRepeatKind::Face;
+            Rep.Shape     = Shape;
+            Rep.Operation = FaceOperationKind::Extrude;
+            Rep.Amount    = Size;
+            State.LastCommand = std::move(Rep);
+        }
+        Conclude(State, Outcome);
+        return;
+    }
+    const SolidArcCommandOutcome Outcome = Run([&] { return BlendSolidArcSelection(State.Document, Request); });
+    if (Outcome.AcceptedCondition)
+    {
+        SolidArcRepeat Rep{};
+        Rep.Kind  = SolidArcRepeatKind::Blend;
+        Rep.Shape = Shape;
+        Rep.Size  = Size;
+        Rep.Blend = Request;
+        State.LastCommand = std::move(Rep);
+    }
+    Conclude(State, Outcome);
+}
+
+void CancelBevelSession(SolidArcWorkspaceState& State)
+{
+    if (!State.Bevel.ActiveCondition) return;
+    State.Bevel.ActiveCondition = false;
+    State.Bevel.Preview.reset();
+    Announce(State, "Bevel cancelled (document untouched)");
+}
+
+// Positive signed size = fillet radius, negative = chamfer setback (SolidArc pointer convention).
+void AdjustBevelSize(SolidArcWorkspaceState& State, double Delta)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    if (Bevel.Verb == SolidArcSessionVerb::Inset)
+    {
+        if (Bevel.DepthEnabled) Bevel.Depth = std::round((Bevel.Depth + Delta) * 1.0e4) * 1.0e-4;          // [len] - Signed: + boss, − pocket
+        else Bevel.Size = std::round(std::max(1.0e-3, Bevel.Size + Delta) * 1.0e4) * 1.0e-4;             // [len] - Inset distance > 0
+        WriteBevelText(Bevel);
+        return;
+    }
+    if (Bevel.Verb == SolidArcSessionVerb::Extrude || Bevel.Verb == SolidArcSessionVerb::Profile)
+    {
+        double Distance = Bevel.Size + Delta;                                                // [len] - Signed extrusion
+        if (std::abs(Distance) < 1.0e-3) Distance = Distance < 0.0 ? -1.0e-3 : 1.0e-3;
+        Bevel.Size = std::round(Distance * 1.0e4) * 1.0e-4;
+        WriteBevelText(Bevel);
+        return;
+    }
+    // 📝 The pointer only sizes the blend; it stops at 1 mm instead of crossing 0 into the other shape (that flip turned
+    //    fillets into chamfers whenever the pointer wandered left). D / C pick the shape.
+    Bevel.Size = BoundBevelValue(State, 0, std::round(std::max(1.0e-3, Bevel.Size + Delta) * 1.0e4) * 1.0e-4);
+    WriteBevelText(Bevel);
+}
