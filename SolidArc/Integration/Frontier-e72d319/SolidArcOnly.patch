+                        Copy.EdgeGroup = Grp.Name;
+                        Edited         = true;
+                    }
+                ImGui::EndCombo();
+            }
+            if (Copy.LimitMode == BevelLimitMode::Angle)
+                Edited |= DrawModifierValueRow(State, "Crease Angle (rad)", ModLabel + ":Angle", Copy.Angle);
+            if (Copy.LimitMode == BevelLimitMode::Picked && !State.Document.Selection.Edges.empty())
+            {
+                if (PressButton(State, ("Use Picked Edges###ModPickEdges:" + ModLabel).c_str(), RowSpan()))
+                {
+                    Copy.References.clear();
+                    for (const std::string& EdgeName : State.Document.Selection.Edges) Copy.References.push_back({ ReferenceKind::Edge, EdgeName, {} });
+                    Edited = true;
+                }
+            }
+        }
+        else if (Copy.Kind == ModifierKind::Boolean)
+        {
+            ImGui::Text("Cutter: %s", SolidArcBodyCaption(State.Document, Copy.Tool).c_str());
+            static const struct { const char* Name; FeatureCombination Comb; } Combs[] = {
+                { "Cut", FeatureCombination::Difference }, { "Union", FeatureCombination::Union }, { "Intersect", FeatureCombination::Intersection } };
+            for (int Cb = 0; Cb < 3; ++Cb)
+            {
+                if (Cb > 0) ImGui::SameLine();
+                if (ToggleButton(State, (std::string(Combs[Cb].Name) + "###ModComb:" + ModLabel + Combs[Cb].Name).c_str(), Copy.Combination == Combs[Cb].Comb, RowSpan(3)))
+                {
+                    Copy.Combination = Combs[Cb].Comb;
+                    Edited = true;
+                }
+            }
+            Edited |= DrawModifierValueRow(State, "Offset (m)", ModLabel + ":Offset", Copy.Offset);
+            if (!Copy.Tool.empty())
+            {
+                const bool Wire = State.Document.Appearance.LiveCutters.contains(Copy.Tool);
+                if (ToggleButton(State, (std::string(Wire ? "Wireframe Cutter" : "Shaded Cutter") + "###ModWire:" + ModLabel).c_str(), Wire, RowSpan()))
+                {
+                    Conclude(State, ToggleSolidArcLiveCutter(State.Document, Copy.Tool));
+                    break;
+                }
+            }
+        }
+
+        if (Edited)
+        {
+            Conclude(State, UpdateSolidArcModifier(State.Document, ModLabel, Copy));
+            break;
+        }
+    }
+    EndCard();
+}
