+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+StlExport WriteStl(const ModelPartition& Partition, const std::vector<BodyToken>& Bodies, const StlRequest& Request)
+{
+    const auto Start = std::chrono::steady_clock::now();
+    StlExport Out;
+    const auto Finish = [&]() -> StlExport
+    {
+        Out.Milliseconds = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - Start).count();
+        return Out;
+    };
+    if (Bodies.empty()) { Out.Refusal = "STL: no body to export"; return Finish(); }
+    if (!(Request.ModelUnitMillimetres > 0.0) || !std::isfinite(Request.ModelUnitMillimetres)) { Out.Refusal = "STL: the model unit must be a positive length"; return Finish(); }
+
+    std::vector<std::array<FloatCorner, 3>> Facets;
+    for (const BodyToken Body : Bodies)
+    {
+        if (!Partition.Bodies.Authenticate(Body)) { Out.Refusal = "STL: a body is not in the partition"; return Finish(); }
+        const TessellationOutcome Tessellation = TessellateBody(Partition, Body, Request.Tessellation);
+        if (!Tessellation.Refusal.empty()) { Out.Refusal = "STL: tessellation refused (" + Tessellation.Refusal + ")"; return Finish(); }
+        Out.Sag = std::max(Out.Sag, Tessellation.Sag);
+        const PolygonComplex& Complex = Tessellation.Complex;
+        std::vector<FloatCorner> Corners(Complex.Positions.size());
+        for (size_t Index = 0; Index < Complex.Positions.size(); ++Index)
+        {
+            const Vector3 Point = Complex.Positions[Index] * Request.ModelUnitMillimetres;
+            Corners[Index].Coordinates = { static_cast<float>(Point.X), static_cast<float>(Point.Y), static_cast<float>(Point.Z) };
+        }
+        for (const std::array<int, 3>& Triangle : Complex.Triangles) Facets.push_back({ Corners[Triangle[0]], Corners[Triangle[1]], Corners[Triangle[2]] });
+        Out.Bodies += 1;
+    }
+    if (Facets.size() > 0xFFFFFFFFull) { Out.Refusal = "STL: more facets than a binary count can hold"; return Finish(); }
+    Out.Triangles = static_cast<int>(Facets.size());
+
+    if (Request.BinaryEnabled)
+    {
+        Out.Bytes.reserve(StlHeaderBytes + 4 + StlFacetBytes * Facets.size());
+        std::string Header = "Frontier GeometryProcessing STL (mm) " + Request.Name;
+        Header.resize(StlHeaderBytes, ' ');
+        if (Header.compare(0, 5, "solid") == 0) Header[0] = 'S';                             // Never mistaken for ASCII
+        Out.Bytes += Header;
+        const uint32_t Count = static_cast<uint32_t>(Facets.size());
+        for (int Shift = 0; Shift < 32; Shift += 8) Out.Bytes.push_back(static_cast<char>((Count >> Shift) & 0xFFu));
+        for (const std::array<FloatCorner, 3>& Facet : Facets)
+        {
+            for (const float Component : FacetNormal(Facet)) AppendFloat(Out.Bytes, Component);
+            for (const FloatCorner& Corner : Facet)
+                for (const float Coordinate : Corner.Coordinates) AppendFloat(Out.Bytes, Coordinate);
+            Out.Bytes.push_back('\0');
+            Out.Bytes.push_back('\0');
+        }
+        return Finish();
+    }
+    std::string Name = Request.Name;
+    std::replace_if(Name.begin(), Name.end(), [](char Character) { return Character == '\n' || Character == '\r'; }, ' ');
+    Out.Bytes.reserve(64 + 260 * Facets.size());
+    Out.Bytes += "solid " + Name + "\n";
+    for (const std::array<FloatCorner, 3>& Facet : Facets)
+    {
+        Out.Bytes += "  facet normal";
+        for (const float Component : FacetNormal(Facet)) { Out.Bytes += ' '; AppendAsciiNumber(Out.Bytes, Component); }
+        Out.Bytes += "\n    outer loop\n";
+        for (const FloatCorner& Corner : Facet)
+        {
+            Out.Bytes += "      vertex";
+            for (const float Coordinate : Corner.Coordinates) { Out.Bytes += ' '; AppendAsciiNumber(Out.Bytes, Coordinate); }
+            Out.Bytes += '\n';
+        }
+        Out.Bytes += "    endloop\n  endfacet\n";
+    }
+    Out.Bytes += "endsolid " + Name + "\n";
+    return Finish();
+}
+
+StlReading ReadStl(const std::string& Bytes)
+{
+    StlReading Reading;
+    CornerWelder Welder;
+    Welder.Reading = &Reading;
+    if (Bytes.size() >= StlHeaderBytes + 4)
+    {
+        const uint64_t Count = ReadCount(Bytes, StlHeaderBytes);
+        if (StlHeaderBytes + 4 + StlFacetBytes * Count == Bytes.size())
+        {
+            Reading.BinaryCondition = true;
+            Reading.Name = Bytes.substr(0, StlHeaderBytes);
+            Reading.Name.erase(Reading.Name.find_last_not_of(std::string(" \0", 2)) + 1);
+            for (uint64_t Facet = 0; Facet < Count; ++Facet)
+            {
+                const size_t At = StlHeaderBytes + 4 + StlFacetBytes * Facet;
+                Reading.Normals.push_back({ ReadFloat(Bytes, At), ReadFloat(Bytes, At + 4), ReadFloat(Bytes, At + 8) });
+                std::array<int, 3> Triangle{};
+                for (int Corner = 0; Corner < 3; ++Corner)
+                {
+                    const size_t Base = At + 12 + 12 * Corner;
+                    Triangle[Corner] = Welder.Weld({ ReadFloat(Bytes, Base), ReadFloat(Bytes, Base + 4), ReadFloat(Bytes, Base + 8) });
+                }
+                Reading.Triangles.push_back(Triangle);
+            }
+            return Reading;
+        }
+    }
+    std::istringstream Stream(Bytes);
+    std::string Word;
+    if (!(Stream >> Word) || Word != "solid") { Reading.Refusal = "STL: neither a binary layout (84 + 50 · count bytes) nor ASCII \"solid\""; return Reading; }
+    std::getline(Stream, Reading.Name);
+    Reading.Name.erase(0, Reading.Name.find_first_not_of(' '));
+    while (!Reading.Name.empty() && (Reading.Name.back() == '\r' || Reading.Name.back() == ' ')) Reading.Name.pop_back();
+    bool Ended = false;
+    while (Stream >> Word)
+    {
+        if (Word == "endsolid") { Ended = true; break; }
+        if (Word != "facet") { Reading.Refusal = "STL: expected \"facet\", found \"" + Word + "\""; return Reading; }
+        std::string Keyword;
+        Vector3 Normal{};
+        if (!(Stream >> Keyword >> Normal.X >> Normal.Y >> Normal.Z) || Keyword != "normal") { Reading.Refusal = "STL: malformed facet normal"; return Reading; }
+        std::string Outer, Loop;
+        if (!(Stream >> Outer >> Loop) || Outer != "outer" || Loop != "loop") { Reading.Refusal = "STL: expected \"outer loop\""; return Reading; }
+        std::array<int, 3> Triangle{};
+        for (int Corner = 0; Corner < 3; ++Corner)
+        {
+            std::string Vertex;
+            std::array<float, 3> Coordinates{};
+            if (!(Stream >> Vertex >> Coordinates[0] >> Coordinates[1] >> Coordinates[2]) || Vertex != "vertex") { Reading.Refusal = "STL: a facet needs three vertices"; return Reading; }
+            Triangle[Corner] = Welder.Weld(Coordinates);
+        }
+        std::string EndLoop, EndFacet;
+        if (!(Stream >> EndLoop >> EndFacet) || EndLoop != "endloop" || EndFacet != "endfacet") { Reading.Refusal = "STL: expected \"endloop endfacet\""; return Reading; }
+        Reading.Normals.push_back(Normal);
+        Reading.Triangles.push_back(Triangle);
+    }
+    if (!Ended) Reading.Refusal = "STL: missing \"endsolid\"";
+    return Reading;
+}
+
+StlSoundness MeasureStlSoundness(const StlReading& Reading)
+{
+    StlSoundness Out;
+    std::map<std::pair<int, int>, std::array<int, 2>> Uses;                                  // (low, high) → uses low→high, high→low
+    std::vector<int> Parent(Reading.Positions.size());
+    std::iota(Parent.begin(), Parent.end(), 0);
+    const auto Root = [&](int Vertex) { while (Parent[Vertex] != Vertex) Vertex = Parent[Vertex] = Parent[Parent[Vertex]]; return Vertex; };
+    std::vector<char> Used(Reading.Positions.size(), 0);
+    for (const std::array<int, 3>& Triangle : Reading.Triangles)
+    {
+        const Vector3 A = Reading.Positions[Triangle[0]], B = Reading.Positions[Triangle[1]], C = Reading.Positions[Triangle[2]];
+        const double  Twice = Length(Cross(B - A, C - A));
+        if (Triangle[0] == Triangle[1] || Triangle[1] == Triangle[2] || Triangle[2] == Triangle[0] || !(Twice > 0.0)) Out.DegenerateTriangles += 1;
+        Out.Area   += 0.5 * Twice;
+        Out.Volume += Dot(A, Cross(B, C)) / 6.0;
+        for (int Corner = 0; Corner < 3; ++Corner)
+        {
+            const int From = Triangle[Corner], To = Triangle[(Corner + 1) % 3];
+            Used[From] = 1;
+            if (From == To) continue;
+            std::array<int, 2>& Count = Uses[{ std::min(From, To), std::max(From, To) }];
+            Count[From < To ? 0 : 1] += 1;
+            Parent[Root(From)] = Root(To);
+        }
+    }
+    for (const auto& [Side, Count] : Uses)
+    {
+        const int Total = Count[0] + Count[1];
+        if (Total == 1) Out.OpenSides += 1;
+        else if (Total > 2) Out.NonManifoldSides += 1;
+        else if (Count[0] != 1) Out.MisorientedSides += 1;
+    }
+    int Vertices = 0;
+    for (size_t Vertex = 0; Vertex < Used.size(); ++Vertex)
+    {
+        if (!Used[Vertex]) continue;
+        Vertices += 1;
+        if (Root(static_cast<int>(Vertex)) == static_cast<int>(Vertex)) Out.Components += 1;
+    }
+    Out.Sides               = static_cast<int>(Uses.size());
+    Out.EulerCharacteristic = Vertices - Out.Sides + static_cast<int>(Reading.Triangles.size());
+    Out.WatertightCondition = !Reading.Triangles.empty() && Out.OpenSides == 0 && Out.NonManifoldSides == 0 && Out.MisorientedSides == 0;
+    return Out;
+}
+
+std::string ExportStlFile(const StlExport& Export, const std::string& Path)
+{
+    if (!Export.Refusal.empty()) return Export.Refusal;
+    std::ofstream Stream(ResolveUtf8Path(Path), std::ios::binary | std::ios::trunc);
+    if (!Stream) return "STL: cannot open " + Path + " for writing";
+    Stream.write(Export.Bytes.data(), static_cast<std::streamsize>(Export.Bytes.size()));
+    return Stream.good() ? std::string() : "STL: writing " + Path + " failed";
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Exchange/StlExchange.h b/Engine/GeometryProcessing/Exchange/StlExchange.h
new file mode 100644
index 0000000000000000000000000000000000000000..bbdff7fc58b2f77893e8a89682dd5f534b8c01f8
--- /dev/null
+++ b/Engine/GeometryProcessing/Exchange/StlExchange.h
@@ -0,0 +1,92 @@
+/*====================================================================================================================================
+                                                        STLEXCHANGE.H
+====================================================================================================================================*/
+// 🧩 STL exchange: bodies → watertight PolygonComplex → binary / ASCII STL in millimetres, and the reader that welds a file
+//    back into shared vertices and measures its soundness (open / non-manifold / misoriented sides, Euler χ, volume)
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Tessellation/BodyTessellation.h"
+
+#include <array>
+#include <string>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 STL carries no units; millimetres are the convention every slicer and CAD reader assumes, so model coordinates
+//    are multiplied by ModelUnitMillimetres. Sag 0 takes Tessellation.SagRatio × each body's own diagonal.
+struct StlRequest
+{
+    bool                 BinaryEnabled        = true;                                        // [-]  - Binary (else ASCII)
+    double               ModelUnitMillimetres = 1.0;                                         // [mm] - Length of one model unit
+    TessellationSettings Tessellation         = {};                                          // [-]  - Chordal bound and limits
+    std::string          Name                 = "Frontier";                                  // [-]  - Header / solid name (ASCII)
+};
+
+struct StlExport
+{
+    std::string Bytes        = {};                                                           // [-]   - File content
+    int         Triangles    = 0;                                                            // [-]   - Facets written
+    int         Bodies       = 0;                                                            // [-]   - Bodies tessellated
+    double      Sag          = 0.0;                                                          // [len] - Largest chordal bound used (model units)
+    double      Milliseconds = 0.0;                                                          // [ms]
+    std::string Refusal      = {};                                                           // [-]   - Empty on success
+};
+
+// 💡 A file read back: corners welded where their 32-bit coordinates are bit-identical (the writer emits each shared
+//    complex vertex as the same floats, so a watertight complex welds watertight again).
+struct StlReading
+{
+    std::vector<Vector3>            Positions       = {};                                    // [mm] - Welded vertices
+    std::vector<std::array<int, 3>> Triangles       = {};                                    // [-]  - Counter-clockwise from outside
+    std::vector<Vector3>            Normals         = {};                                    // [-]  - Facet normals as stored
+    std::string                     Name            = {};                                    // [-]  - Header / solid name
+    bool                            BinaryCondition = false;                                 // [-]  - Binary layout detected
+    std::string                     Refusal         = {};                                    // [-]  - Empty on success
+};
+
+// 📝 Soundness of a triangle set: every side shared by exactly two triangles running it in opposite directions makes
+//    it closed and consistently oriented; then χ = V − E + F = 2 · (components − genus) and the divergence volume is
+//    the enclosed volume.
+struct StlSoundness
+{
+    int    OpenSides           = 0;                                                          // [-]   - Sides used once
+    int    NonManifoldSides    = 0;                                                          // [-]   - Sides used three times or more
+    int    MisorientedSides    = 0;                                                          // [-]   - Two uses in the same direction
+    int    DegenerateTriangles = 0;                                                          // [-]   - Repeated corner or zero area
+    int    Components          = 0;                                                          // [-]   - Connected through sides
+    int    Sides               = 0;                                                          // [-]   - Distinct sides E
+    int    EulerCharacteristic = 0;                                                          // [-]   - V − E + F
+    double Volume              = 0.0;                                                        // [mm³] - Σ (a · (b × c)) / 6
+    double Area                = 0.0;                                                        // [mm²] - Σ triangle areas
+    bool   WatertightCondition = false;                                                      // [-]   - No open / non-manifold / misoriented side
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 Tessellates every body (one shared sag) and writes them as one STL. Binary: 80-byte header (Name), little-endian
+//    uint32 count, 50 bytes per facet (normal, three corners, zero attribute). ASCII: "solid Name" … "endsolid Name"
+//    with 9 significant digits, enough to reproduce every 32-bit float exactly, so both forms read back identically.
+[[nodiscard]] StlExport WriteStl(const ModelPartition& Partition, const std::vector<BodyToken>& Bodies, const StlRequest& Request);
+
+// Reads binary or ASCII STL (binary when 84 + 50·count equals the size, else ASCII starting with "solid").
+[[nodiscard]] StlReading ReadStl(const std::string& Bytes);
+
+[[nodiscard]] StlSoundness MeasureStlSoundness(const StlReading& Reading);
+
+// Writes the export to Path; returns an empty string or the refusal.
+[[nodiscard]] std::string ExportStlFile(const StlExport& Export, const std::string& Path);
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Feature/BodyCut.cpp b/Engine/GeometryProcessing/Feature/BodyCut.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..03b75ced4a85408350c40c408d77d8ffec098a8c
--- /dev/null
+++ b/Engine/GeometryProcessing/Feature/BodyCut.cpp
@@ -0,0 +1,213 @@
+/*====================================================================================================================================
+                                                          BODYCUT.CPP
+====================================================================================================================================*/
+// 🧩 Cut (Plasticity C): a solid or sheet split by a sketch profile or an open curve swept through it, into two bodies
+
+#include "Engine/GeometryProcessing/Feature/BodyCut.h"
+
+#include "Engine/GeometryProcessing/Diagnostics/OperationTrace.h"
+
+#include "Engine/GeometryProcessing/Geometry/NurbsCarrier.h"
+#include "Engine/GeometryProcessing/Tessellation/BodyTessellation.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    [[nodiscard]] Vector2 UnitTangent(const ProfileSegment& Segment, double Fraction) noexcept
+    {
+        const Vector2 Tangent = EvaluateProfileTangent(Segment, Fraction);
+        const double  Size    = std::hypot(Tangent.X, Tangent.Y);
+        return Size > 0.0 ? Vector2{ Tangent.X / Size, Tangent.Y / Size } : Vector2{ 1.0, 0.0 };
+    }
+
+    [[nodiscard]] ProfileSegment StraightSegment(Vector2 Start, Vector2 End, const std::string& Name)
+    {
+        ProfileSegment Segment;
+        Segment.Kind  = ProfileSegmentKind::Line;
+        Segment.Start = Start;
+        Segment.End   = End;
+        Segment.Name  = Name;
+        return Segment;
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+double MeasureCutReach(const ModelPartition& Partition, BodyToken Body, const OrthonormalFrame& Plane)
+{
+    TessellationSettings Settings;
+    Settings.SagRatio        = 1.0e-2;
+    Settings.EdgeLengthRatio = 0.5;
+    const TessellationOutcome Tessellation = TessellateBody(Partition, Body, Settings);
+    double Reach = 0.0;
+    for (const Vector3& Position : Tessellation.Complex.Positions) Reach = std::max(Reach, Length(Position - Plane.Origin));
+    // Curved faces bulge past their chords by at most the sag; pad generously (the tool only has to overshoot).
+    return 1.1 * Reach + 2.0 * Tessellation.Sag + 0.05 * Tessellation.Diagonal + 1.0e-6;
+}
+
+SketchProfile CloseCutChain(std::vector<ProfileSegment> Chain, double Reach)
+{
+    SketchProfile Profile;
+    if (Chain.empty()) { Profile.Refusal = "Cut: the cutting curve is empty"; return Profile; }
+    const Vector2 Start = Chain.front().Start, End = Chain.back().End;
+    const Vector2 StartTangent = UnitTangent(Chain.front(), 0.0), EndTangent = UnitTangent(Chain.back(), 1.0);
+    // ① Tangent extensions end at least 2·Reach from the plane origin (the body lies within Reach of it).
+    const double  StartExtension = 2.0 * Reach + Length(Start), EndExtension = 2.0 * Reach + Length(End);
+    const Vector2 StartFar = Start - StartTangent * StartExtension;
+    const Vector2 EndFar   = End + EndTangent * EndExtension;
+    // ② Far box on the left of the chord between the extended ends, deeper than the body.
+    const Vector2 Chord = EndFar - StartFar;
+    const double  ChordSize = Length(Chord);
+    if (!(ChordSize > 0.0)) { Profile.Refusal = "Cut: the cutting curve closes on itself without a profile"; return Profile; }
+    // 💡 The box first runs outward along the chord, so its sides never fold back onto the extensions (a U-shaped
+    //    chain has its chord ⟂ to both legs).
+    const Vector2 Along = Chord * (1.0 / ChordSize);
+    const Vector2 Left  = Vector2{ -Along.Y, Along.X };
+    const double  Depth = 4.0 * Reach + Length(StartFar) + Length(EndFar);
+    const Vector2 EndOut = EndFar + Along * Depth, StartOut = StartFar - Along * Depth;
+    const Vector2 EndCorner = EndOut + Left * Depth, StartCorner = StartOut + Left * Depth;
+
+    ProfileLoop Loop;
+    Loop.Segments.push_back(StraightSegment(StartFar, Start, "ExtensionStart"));
+    for (ProfileSegment& Segment : Chain) Loop.Segments.push_back(std::move(Segment));
+    Loop.Segments.push_back(StraightSegment(End, EndFar, "ExtensionEnd"));
+    Loop.Segments.push_back(StraightSegment(EndFar, EndOut, "ReachEndOut"));
+    Loop.Segments.push_back(StraightSegment(EndOut, EndCorner, "ReachEnd"));
+    Loop.Segments.push_back(StraightSegment(EndCorner, StartCorner, "ReachFar"));
+    Loop.Segments.push_back(StraightSegment(StartCorner, StartOut, "ReachStart"));
+    Loop.Segments.push_back(StraightSegment(StartOut, StartFar, "ReachStartOut"));
+    Profile.Loops.push_back(std::move(Loop));
+    Profile.Scale = 4.0 * Depth;
+    ArrangeProfileLoops(Profile);
+    if (!Profile.Refusal.empty()) Profile.Refusal = "Cut: the curve cannot be closed on one side (" + Profile.Refusal + ")";
+    return Profile;
+}
+
+SketchProfile BuildSketchCutProfile(const SketchModel& Sketch, double Reach)
+{
+    // ① A closed profile cuts out its own interior.
+    SketchProfile Closed = ExtractSketchProfile(Sketch);
+    if (Closed.Refusal.empty()) return Closed;
+
+    // ② Otherwise exactly one open chain: segments joined end to end, chained from the start of the first curve.
+    std::vector<ProfileSegment> Segments;
+    double Scale = 0.0;
+    for (const SketchPoint& Point : Sketch.Points) Scale = std::max(Scale, Length(Point.Position));
+    const double Join = 1.0e-9 * std::max(Scale, 1.0e-300);
+    for (int Index = 0; Index < static_cast<int>(Sketch.Curves.size()); ++Index)
+    {
+        if (Sketch.Curves[Index].Construction) continue;
+        std::string Refusal;
+        ProfileSegment Segment = ResolveSketchCurveSegment(Sketch, Index, Join, Refusal);
+        if (!Refusal.empty()) { SketchProfile Profile; Profile.Refusal = "Cut: " + Refusal; return Profile; }
+        if (Segment.Kind == ProfileSegmentKind::Circle) { SketchProfile Profile; Profile.Refusal = "Cut: " + Closed.Refusal; return Profile; }
+        Segments.push_back(std::move(Segment));
+    }
+    if (Segments.empty()) { SketchProfile Profile; Profile.Refusal = "Cut: the sketch has no cutting curves"; return Profile; }
+    std::vector<ProfileSegment> Chain{ Segments.front() };
+    std::vector<bool> Used(Segments.size(), false);
+    Used[0] = true;
+    for (bool Grown = true; Grown;)
+    {
+        Grown = false;
+        for (size_t Index = 0; Index < Segments.size(); ++Index)
+        {
+            if (Used[Index]) continue;
+            ProfileSegment Segment = Segments[Index];
+            if (Distance(Segment.End, Chain.back().End) <= Join) ReverseProfileSegment(Segment);
+            if (Distance(Segment.Start, Chain.back().End) <= Join) { Chain.push_back(Segment); Used[Index] = Grown = true; continue; }
+            if (Distance(Segment.Start, Chain.front().Start) <= Join) ReverseProfileSegment(Segment);
+            if (Distance(Segment.End, Chain.front().Start) <= Join) { Chain.insert(Chain.begin(), Segment); Used[Index] = Grown = true; }
+        }
+    }
+    if (std::find(Used.begin(), Used.end(), false) != Used.end())
+    {
+        SketchProfile Profile;
+        Profile.Refusal = "Cut: the sketch curves do not form one chain (" + Closed.Refusal + ")";
+        return Profile;
+    }
+    return CloseCutChain(std::move(Chain), Reach);
+}
+
+std::optional<ProfileSegment> ProjectCutCurve(const NurbsCurve& Curve, const OrthonormalFrame& Plane, const std::string& Name)
+{
+    if (!Curve.Definition) return std::nullopt;
+    const NurbsCurveDefinition& Definition = *Curve.Definition;
+    if (Definition.Period != 0.0) return std::nullopt;
+    for (double Weight : Definition.Weights) if (std::fabs(Weight - 1.0) > 1.0e-12) return std::nullopt;
+    ProfileSegment Segment;
+    Segment.Kind          = ProfileSegmentKind::Spline;
+    Segment.Name          = Name;
+    Segment.Spline.Degree = Definition.Degree;
+    Segment.Spline.Knots  = Definition.Knots;
+    for (const Vector3& Pole : Definition.Poles)
+    {
+        const Vector3 Offset = Pole - Plane.Origin;
+        Segment.Spline.Poles.push_back({ Dot(Offset, Plane.XAxis), Dot(Offset, Plane.YAxis) });
+    }
+    Segment.Start = Segment.Spline.Poles.front();
+    Segment.End   = Segment.Spline.Poles.back();
+    return Segment;
+}
+
+static BodyCutOutcome CutBodyUntraced(ModelPartition& Partition, BodyToken Body, const SketchProfile& Profile, const OrthonormalFrame& Plane, double Reach)
+{
+    BodyCutOutcome Outcome;
+    Outcome.Profile        = Profile;
+    Outcome.SheetCondition = Partition.Bodies.Resolve(Body).Category == BodyCategory::Sheet;
+    Outcome.Reach          = Reach > 0.0 ? Reach : MeasureCutReach(Partition, Body, Plane);
+    if (!Profile.Refusal.empty()) { Outcome.Refusal = Profile.Refusal.rfind("Cut:", 0) == 0 ? Profile.Refusal : "Cut: " + Profile.Refusal; return Outcome; }
+
+    // ① Tool: the profile swept from −2·Reach to +2·Reach along the plane normal.
+    OrthonormalFrame Floor = Plane;
+    Floor.Origin = Plane.Origin - Plane.ZAxis * (2.0 * Outcome.Reach);
+    Outcome.Tool = ExtrudeProfile(Partition, Profile, Floor, 4.0 * Outcome.Reach);
+    if (!Outcome.Tool.Refusal.empty()) { Outcome.Refusal = "Cut: " + Outcome.Tool.Refusal; return Outcome; }
+
+    // ② Pieces: solids take the tool caps (closed halves); sheets keep only their own fragments.
+    GeneralFuseSettings Settings;
+    BooleanOperation Within = BooleanOperation::Intersection, Without = BooleanOperation::Difference;
+    if (Outcome.SheetCondition)
+    {
+        Settings.SecondClassificationEnabled = false;
+        Within  = BooleanOperation::FirstInside;
+        Without = BooleanOperation::FirstOutside;
+    }
+    Outcome.Inside = ComputeBoolean(Partition, Body, Outcome.Tool.Body, Within, Settings);
+    if (!Outcome.Inside.Refusal.empty())
+    {
+        Outcome.Refusal = Outcome.Inside.Refusal == "Boolean: empty result" ? "Cut: the cut misses the body (nothing on the inside)" : "Cut: " + Outcome.Inside.Refusal;
+        return Outcome;
+    }
+    Outcome.Outside = ComputeBoolean(Partition, Body, Outcome.Tool.Body, Without, Settings);
+    if (!Outcome.Outside.Refusal.empty())
+    {
+        Outcome.Refusal = Outcome.Outside.Refusal == "Boolean: empty result" ? "Cut: the cut misses the body (nothing on the outside)" : "Cut: " + Outcome.Outside.Refusal;
+        return Outcome;
+    }
+    return Outcome;
+}
+
+// 📝 Traced entry (Diagnostics/OperationTrace.h): the request on entry, the outcome before the duration line.
+
+BodyCutOutcome CutBody(ModelPartition& Partition, BodyToken Body, const SketchProfile& Profile, const OrthonormalFrame& Plane, double Reach)
+{
+    FRONTIER_TRACE_SCOPE("Cut", "CutBody · body " + std::to_string(Body.Slot) + " · " + std::to_string(Profile.Loops.size()) + " loop(s)");
+    BodyCutOutcome Outcome = CutBodyUntraced(Partition, Body, Profile, Plane, Reach);
+    FRONTIER_TRACE("Cut", Outcome.Refusal.empty() ? std::string("built") : "refused: " + Outcome.Refusal);
+    return Outcome;
+}
+
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Feature/BodyCut.h b/Engine/GeometryProcessing/Feature/BodyCut.h
new file mode 100644
index 0000000000000000000000000000000000000000..7301e985510d3722ad4da1dac01f052c2ffae068
--- /dev/null
+++ b/Engine/GeometryProcessing/Feature/BodyCut.h
@@ -0,0 +1,64 @@
+/*====================================================================================================================================
+                                                           BODYCUT.H
+====================================================================================================================================*/
+// 🧩 Cut (Plasticity C): a solid or sheet split by a sketch profile or an open curve swept through it, into two bodies
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Boolean/GeneralFuse.h"
+#include "Engine/GeometryProcessing/Feature/ProfileSweep.h"
+#include "Engine/GeometryProcessing/Geometry/CurveGeometry.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 The two pieces of a cut. The tool is the cut profile swept along the plane normal from −2·Reach to +2·Reach, so
+//    it passes through the whole body. Inside = body ∩ tool (closed profile: within it; open curve: on its left);
+//    Outside = body − tool. Sheets keep only their own faces: no tool caps, so the pieces stay open sheets.
+struct BodyCutOutcome
+{
+    SketchProfile  Profile        = {};                                                      // [-]   - Tool profile on the plane
+    SweepOutcome   Tool           = {};                                                      // [-]   - Prism through the body
+    BooleanOutcome Inside         = {};                                                      // [-]   - Piece within / left of the cut
+    BooleanOutcome Outside        = {};                                                      // [-]   - The rest
+    double         Reach          = 0.0;                                                     // [len] - Body radius about the plane origin
+    bool           SheetCondition = false;                                                   // [-]   - The body is a sheet
+    std::string    Refusal        = {};                                                      // [-]   - "Cut: …" when refused
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// Radius about Plane.Origin that holds the whole body (coarse tessellation, padded for chordal sag).
+[[nodiscard]] double MeasureCutReach(const ModelPartition& Partition, BodyToken Body, const OrthonormalFrame& Plane);
+
+// 💡 Open chain (segments in traversal order, end to start joined) closed on its LEFT side: tangent extensions past
+//    the reach, then a far box. The result is the profile of a half-plane bounded by the chain within the reach;
+//    refused (Profile.Refusal) when the closing box crosses the chain.
+[[nodiscard]] SketchProfile CloseCutChain(std::vector<ProfileSegment> Chain, double Reach);
+
+// Cut profile of a solved sketch: its closed profile when it has one, otherwise its single open chain closed on the
+// left (chained from the start of its first curve).
+[[nodiscard]] SketchProfile BuildSketchCutProfile(const SketchModel& Sketch, double Reach);
+
+// SpaceCurve projected along Plane.ZAxis onto the plane: the poles project exactly (parallel projection is affine), so
+// a polynomial NURBS stays exact. Rational or periodic curves are refused (empty).
+[[nodiscard]] std::optional<ProfileSegment> ProjectCutCurve(const NurbsCurve& Curve, const OrthonormalFrame& Plane, const std::string& Name);
+
+// Cuts Body with Profile (plane coordinates of Plane). Reach ≤ 0 → MeasureCutReach.
+[[nodiscard]] BodyCutOutcome CutBody(ModelPartition& Partition, BodyToken Body, const SketchProfile& Profile, const OrthonormalFrame& Plane, double Reach = 0.0);
+
+} // namespace Frontier::GeometryProcessing
