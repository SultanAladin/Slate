+void DrawSolidArcInterface(SolidArcWorkspaceState& State, ImTextureID ViewportTexture, double DeltaSeconds)
+{
+    const double Entered = SteadySeconds();
+    SolidArcFrameProfile& Profile = State.Profile;
+    State.Widgets.Clear();
+    State.Style.GridPlane = ViewGridPlane(State.Camera);                                     // Orbiting off a 90° view: the ground again
+    { SolidArcPhaseClock Clock(Profile, "matcaps"); RefreshSolidArcMatcaps(State); }
+    const ImVec2 Frame = ImGui::GetIO().DisplaySize;
+    { SolidArcPhaseClock Clock(Profile, "bevel preview"); StageBevelPreview(State); }
+    { SolidArcPhaseClock Clock(Profile, "measure"); RefreshMeasure(State); }
+    { SolidArcPhaseClock Clock(Profile, "section"); RefreshSection(State); }
+    // 📝 HTML grid at 1600 px: columns 300 | 1fr | 330 (gap 10, margin 12), status bar 31. The HTML app header and
+    //    document bar are gone (less chrome): their file actions are the Outliner ☰ menu and Ctrl+N / O / S / Shift+S / I / E.
+    const float Top    = FrameMargin;
+    const float Height = std::max(100.0f, Frame.y - Top - StatusHeight);
+    const float Middle = std::max(100.0f, Frame.x - 2 * FrameMargin - 2 * ColumnGap - OutlinerWidth - InspectorWidth);
+    if (State.ViewportMaximizedEnabled)
+    {
+        // HTML maximize: the scene panel takes the whole row (Outliner and Inspector step aside).
+        SolidArcPhaseClock Clock(Profile, "viewport");
+        DrawViewport(State, ViewportTexture, ImVec2(FrameMargin, Top), ImVec2(Frame.x - 2 * FrameMargin, Height));
+    }
+    else
+    {
+        { SolidArcPhaseClock Clock(Profile, "outliner"); DrawOutliner(State, ImVec2(FrameMargin, Top), ImVec2(OutlinerWidth, Height)); }
+        { SolidArcPhaseClock Clock(Profile, "viewport"); DrawViewport(State, ViewportTexture, ImVec2(FrameMargin + OutlinerWidth + ColumnGap, Top), ImVec2(Middle, Height)); }
+        { SolidArcPhaseClock Clock(Profile, "inspector"); DrawInspector(State, ImVec2(FrameMargin + OutlinerWidth + ColumnGap + Middle + ColumnGap, Top), ImVec2(InspectorWidth, Height)); }
+    }
+    { SolidArcPhaseClock Clock(Profile, "status bar"); DrawStatusBar(State, Frame); }
+    DrawDrawingOptions(State);
+    DrawWorkspacePopups(State);
+    DrawMatcapPicker(State);
+    DrawWelcome(State);
+    { SolidArcPhaseClock Clock(Profile, "trace panel"); DrawTracePanel(State); }
+    const OrbitCamera CamBeforeShortcuts  = State.Camera;
+    const bool        XformBefore         = State.Transform.ActiveCondition;
+    const int         XformAxisBefore     = State.Transform.Axis;
+    const bool        XformPlaneBefore    = State.Transform.PlaneCondition;
+    const auto        XformVerbBefore     = State.Transform.Verb;
+    { SolidArcPhaseClock Clock(Profile, "shortcuts"); ApplyShortcuts(State); }
+    const bool CamShortcutChanged = State.Camera.Distance != CamBeforeShortcuts.Distance
+                                 || State.Camera.Azimuth != CamBeforeShortcuts.Azimuth
+                                 || State.Camera.Elevation != CamBeforeShortcuts.Elevation
+                                 || State.Camera.OrthographicEnabled != CamBeforeShortcuts.OrthographicEnabled
+                                 || State.Camera.Target != CamBeforeShortcuts.Target;
+    const bool XformShortcutChanged = State.Transform.ActiveCondition != XformBefore
+                                   || State.Transform.Axis != XformAxisBefore
+                                   || State.Transform.PlaneCondition != XformPlaneBefore
+                                   || State.Transform.Verb != XformVerbBefore;
+    if (CamShortcutChanged || XformShortcutChanged)
+    {
+        // Keep gizmo geometry & widget hit-boxes synchronized with any shortcut-driven camera zoom/view/transform change on this same frame.
+        const OrbitCameraFrame LatestFrame = ViewportFrame(State);
+        if (State.Transform.ActiveCondition)
+        {
+            SolidArcGizmoHandle ActiveH = SolidArcGizmoHandle::None;
+            const SolidArcGizmoPose ModalPose = MakeTransformSessionGizmoPose(State.Transform, LatestFrame, ActiveH);
+            const SolidArcGizmoGeometry ModalGeo = BuildSolidArcGizmo(ModalPose, LatestFrame, SolidArcGizmoHandle::None, ActiveH);
+            State.Style.Gizmo = ModalGeo;
+            uint32_t Drawn = 0;
+            for (const SolidArcGizmoVertex& Vertex : ModalGeo.Vertices) Drawn |= 1u << Vertex.Handle;
+            static const char* Keys[] = { "", "GizmoTranslateX", "GizmoTranslateY", "GizmoTranslateZ", "GizmoPlaneYZ", "GizmoPlaneXZ", "GizmoPlaneXY",
+                                          "GizmoRotateX", "GizmoRotateY", "GizmoRotateZ", "GizmoScaleX", "GizmoScaleY", "GizmoScaleZ", "GizmoCentre" };
+            for (int Code = 1; Code <= 13; ++Code)
+            {
+                if (!(Drawn & (1u << Code))) continue;
+                const int Axis = (Code - 1) % 3, U = (Axis + 1) % 3, V = (Axis + 2) % 3;
+                Vector3 LocalOff;
+                if (Code <= 3)       LocalOff = ModalPose.Axes[Axis] * 0.95;
+                else if (Code <= 6)  LocalOff = ModalPose.Axes[U] * 0.92 + ModalPose.Axes[V] * 0.82;
+                else if (Code <= 9)  LocalOff = (ModalPose.Axes[U] + ModalPose.Axes[V]) * (0.62 * 0.95 / std::numbers::sqrt2);
+                else if (Code <= 12) LocalOff = ModalPose.Axes[Axis] * 0.67;
+                else                 LocalOff = Vector3{ LatestFrame.Right[0], LatestFrame.Right[1], LatestFrame.Right[2] } * 0.16;
+                ImVec2 Pixel;
+                if (ProjectWorldPoint(State, LatestFrame, ModalPose.Origin + LocalOff * ModalPose.Size, Pixel))
+                    State.Widgets.Record(Keys[Code], ImVec2(Pixel.x - 2.0f, Pixel.y - 2.0f), ImVec2(Pixel.x + 2.0f, Pixel.y + 2.0f));
+            }
+        }
+        else if (GizmoAvailableCondition(State) && !State.Gizmo.DragCondition)
+        {
+            ResolveGizmoTarget(State);
+            FitGizmoToView(State);
+            if (State.Gizmo.Target != SolidArcGizmoTarget::None)
+            {
+                State.Gizmo.Pose.Modes = State.Gizmo.Modes;
+                State.Gizmo.Pose.Size  = MeasureGizmoSize(LatestFrame, State.Gizmo.Pose.Origin, GizmoPixels);
+                State.Gizmo.Geometry   = BuildSolidArcGizmo(State.Gizmo.Pose, LatestFrame, State.Gizmo.Hover, SolidArcGizmoHandle::None);
+                State.Style.Gizmo      = State.Gizmo.Geometry;
+                RecordGizmoWidgets(State, LatestFrame);
+            }
+        }
+    }
+    { SolidArcPhaseClock Clock(Profile, "autosave"); AdvanceAutosave(State, DeltaSeconds); }
+    { SolidArcPhaseClock Clock(Profile, "bevel preview"); StageBevelPreview(State); }
+    State.FrameNumber += 1;
+    Profile.InterfaceMs = (SteadySeconds() - Entered) * 1.0e3;
+}
+
+const SolidArcScene& DisplayedSolidArcScene(const SolidArcWorkspaceState& State)
+{
+    if (State.Bevel.ActiveCondition && State.Bevel.Preview && State.Bevel.Refusal.empty()) return State.Bevel.PreviewScene;
+    if (State.Bevel.ActiveCondition && State.Bevel.GoodCondition && State.Bevel.Verb == SolidArcSessionVerb::Blend) return State.Bevel.GoodScene;   // Refused: the last size that worked
+    if (State.Transform.ActiveCondition && (State.Transform.Preview || State.Transform.RigidCondition) && State.Transform.Refusal.empty()
+        && !(State.Transform.SketchCondition && State.Transform.DuplicateCondition)) return State.Transform.PreviewScene;
+    if (State.Sweep.ActiveCondition && State.Sweep.Preview && State.Sweep.Refusal.empty()) return State.Sweep.PreviewScene;
+    if (State.Knife.ActiveCondition && ((State.Knife.Preview && (State.Knife.Refusal.empty() || !State.Knife.Blends.empty())) || State.Knife.RigidCondition)) return State.Knife.PreviewScene;
+    if (State.Joint.ActiveCondition && State.Joint.Preview && State.Joint.Refusal.empty()) return State.Joint.PreviewScene;
+    if (State.ParameterDrag.Preview) return State.ParameterDrag.PreviewScene;
+    if (State.Gizmo.DragCondition && (State.Gizmo.Preview || State.Gizmo.RigidCondition) && State.Gizmo.Refusal.empty()) return State.Gizmo.PreviewScene;
+    if (State.SketchPoints.DragCondition && State.SketchPoints.Preview && State.SketchPoints.Refusal.empty()) return State.SketchPoints.PreviewScene;
+    return State.Scene;
+}
