+    for (const TreeRow& Row : TreeRows) std::printf("| %s | %s | %s |\n", Row.PassedCondition ? "🟢" : "🔴", Row.Name.c_str(), Row.Detail.c_str());
+    return PassedCondition ? 0 : 1;
+}
