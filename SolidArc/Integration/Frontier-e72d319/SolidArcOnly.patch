+
+    [[nodiscard]] std::string Scientific(double Value)
+    {
+        char Text[32];
+        std::snprintf(Text, sizeof Text, "%.3e", Value);
+        return Text;
+    }
+
+    [[nodiscard]] std::string Fixed(double Value)
