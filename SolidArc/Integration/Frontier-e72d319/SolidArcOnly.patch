+frames 2
+move world 0.4 -1.5 1.0
+frames 2
+expect drawing-lift ~ 0.5
+capture 258CylinderOnFrontFace
+click world 0.4 -1.5 1.0
+frames 3
+expect refused == 0
+expect bodies == 2
+expect volume ~ 8.75398223686155
+expect plane-normal-y ~ -1
+expect scene-low-y ~ -1.5
+
+# ④ a wedge on the ground left of the cube (its slope faces +x), then a cylinder on its slope: the solid stands square to the slanted face
+click @ConstructLauncher
+frames 2
+click @ConstructWedge
+frames 2
+move world -4.0 -1.0 0.0
+frames 2
+click world -4.0 -1.0 0.0
+frames 2
+move world -2.0 1.0 0.0
+frames 2
+click world -2.0 1.0 0.0
+frames 2
+move world -2.0 1.0 1.0
+frames 2
+click world -2.0 1.0 1.0
+frames 3
+expect refused == 0
+expect bodies == 3
