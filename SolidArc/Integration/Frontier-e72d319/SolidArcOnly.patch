+        }
+        else if (Copy.Kind == ModifierKind::Bevel)
+        {
+            if (ToggleButton(State, ("Fillet###ModFillet:" + ModLabel).c_str(), Copy.Shape == BlendProfile::Fillet, RowSpan(2)))
