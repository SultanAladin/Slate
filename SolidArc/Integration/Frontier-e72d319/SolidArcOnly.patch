+            for (const SheetPolyline& Line : Sheet.Lines)
+            {
+                if (Line.Layer != SheetLayer::Hatch || Line.Points.size() != 2) continue;
+                const double Length = std::hypot(Line.Points[1].X - Line.Points[0].X, Line.Points[1].Y - Line.Points[0].Y);
