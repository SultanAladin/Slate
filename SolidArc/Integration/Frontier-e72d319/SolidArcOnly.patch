--- /dev/null
+++ b/Engine/GeometryProcessing/Intersection/CurveSurfaceIntersection.cpp
@@ -0,0 +1,263 @@
+/*====================================================================================================================================
+                                                 CURVESURFACEINTERSECTION.CPP
+====================================================================================================================================*/
+// 🧩 Bézier clipping candidates, signed-distance Newton polishing, tolerant tangency merge
+
+#include "Engine/GeometryProcessing/Intersection/CurveSurfaceIntersection.h"
+#include "Engine/GeometryProcessing/Intersection/ImplicitSurface.h"
+#include "Engine/GeometryProcessing/Intersection/IntersectionCurve.h"
+#include "Engine/GeometryProcessing/Geometry/NurbsCarrier.h"
+#include "Engine/GeometryProcessing/Geometry/RollingBallCarrier.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    constexpr int    NewtonLimit        = 40;                                                // [-] - Polishing iterations
+    constexpr double TangentSine        = 1.0e-7;                                            // [-] - |N·Ĉ′| below this is a touch
+    constexpr double CoincidentFraction = 1.0e-13;                                           // [-] - Coefficients ≤ this × L^d vanish
+
+    struct DistanceProbe
+    {
+        double Distance = 0.0;                                                               // [len] - d(τ)
+        double Slope    = 0.0;                                                               // [len] - d′(τ) = N·C′(τ)
+        double Speed    = 0.0;                                                               // [len] - |C′(τ)|
+    };
+
+    [[nodiscard]] DistanceProbe ProbeDistance(const CurveGeometry& Curve, const SurfaceGeometry& Surface, double τ)
+    {
+        const CurveSample     Sample  = EvaluateCurve(Curve, τ);
+        const SurfaceDistance Measure = MeasureSurfaceDistance(Surface, Sample.Position);
+        return { Measure.Distance, Dot(Measure.Normal, Sample.Derivative), Length(Sample.Derivative) };
+    }
+
+    // Newton on d(τ) = 0 — quadratic at transversal roots. Moves are confined to [Low, High].
+    [[nodiscard]] double PolishTransversal(const CurveGeometry& Curve, const SurfaceGeometry& Surface, double τ, double Low, double High)
+    {
+        for (int Iteration = 0; Iteration < NewtonLimit; ++Iteration)
+        {
+            const DistanceProbe Probe = ProbeDistance(Curve, Surface, τ);
+            if (std::fabs(Probe.Slope) <= 1.0e-14 * Probe.Speed) break;
+            const double Step = Probe.Distance / Probe.Slope;                                // [-] - Newton correction
+            if (!std::isfinite(Step)) break;                                                 // Probe left the carrier's range
+            const double Previous = τ;                                                       // [-] - τ before the move
+            τ = std::clamp(τ - Step, Low, High);
+            // 💡 Pinned at a bound: every later iteration repeats this one exactly (deterministic probes), so stopping
+            //    changes no bit — it saves the remaining NewtonLimit probes (a clipped edge ending on the face).
+            if (τ == Previous) break;
+            if (std::fabs(Step) <= 1.0e-16 * (1.0 + std::fabs(τ))) break;
+        }
+        return τ;
+    }
+
+    // Newton on d′(τ) = 0 (central-difference d″): the extremum of the distance, where a touch lives.
+    [[nodiscard]] double PolishExtremum(const CurveGeometry& Curve, const SurfaceGeometry& Surface, double τ, double Low, double High)
+    {
+        const double Increment = 1.0e-6 * std::max(1.0, High - Low);                         // [-] - Difference step
+        for (int Iteration = 0; Iteration < NewtonLimit; ++Iteration)
+        {
+            const double Slope     = ProbeDistance(Curve, Surface, τ).Slope;
+            const double Curvature = (ProbeDistance(Curve, Surface, τ + Increment).Slope - ProbeDistance(Curve, Surface, τ - Increment).Slope) / (2.0 * Increment);
+            if (std::fabs(Curvature) <= 1.0e-300) break;
+            const double Step = Slope / Curvature;                                           // [-] - Newton correction
+            if (!std::isfinite(Step)) break;                                                 // A difference probe left the range
+            const double Previous = τ;                                                       // [-] - τ before the move
+            τ = std::clamp(τ - Step, Low, High);
+            if (τ == Previous) break;                                                        // Pinned: see PolishTransversal
+            if (std::fabs(Step) <= 1.0e-15 * (1.0 + std::fabs(τ))) break;
+        }
+        return τ;
+    }
+
+    // Curve parameter of a point produced by a rational segment (arcs fold into the segment's own interval).
+    [[nodiscard]] double SegmentParameter(const CurveGeometry& Curve, const RationalSegment& Segment, double 𝑡)
+    {
+        // Lines and Bézier pieces of a NURBS curve are linear in 𝑡 (extraction keeps the parameterisation).
+        if (std::holds_alternative<StraightLine>(Curve) || std::holds_alternative<NurbsCurve>(Curve)) return Segment.CurveLow + 𝑡 * (Segment.CurveHigh - Segment.CurveLow);
+        return ProjectOntoCurve(Curve, EvaluateRationalSegment(Segment, 𝑡), Segment.CurveLow - 1.0e-9);
+    }
+
+    struct Candidate
+    {
+        double τ             = 0.0;                                                          // [-] - Curve parameter
+        bool   TouchCondition = false;                                                       // [-] - From a root of F′
+    };
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+CurveSurfaceOutcome IntersectCurveSurface(const CurveGeometry& Curve, double Low, double High, const SurfaceGeometry& Surface, const CurveSurfaceSettings& Settings)
+{
+    CurveSurfaceOutcome    Outcome;
+    std::vector<Candidate> Candidates;
+    // 💡 No rational form on one side (traced curve, contact rail) or no implicit form on the other (rolling-ball or
+    //    NURBS carrier): scan the exact signed distance instead of composing a polynomial.
+    const bool ScanCondition = std::holds_alternative<IntersectionCurve>(Curve) || std::holds_alternative<ContactCurve>(Curve)
+                            || ProceduralSurfaceCondition(Surface);
+    if (ScanCondition && !std::holds_alternative<IntersectionCurve>(Curve))
+    {
+        // 📝 Spacing ≤ r/10 on a rolling-ball carrier (d is near-linear across a fraction of the tube radius) and ≤ 1/256
+        //    of the curve's chord length; rails also take 16 samples per spine guide knot.
+        double Chord = 0.0;                                                                  // [len] - Chord length of the interval
+        Vector3 Previous = EvaluateCurve(Curve, Low).Position;
+        for (int Index = 1; Index <= 64; ++Index)
+        {
+            const Vector3 Next = EvaluateCurve(Curve, Low + (High - Low) * Index / 64).Position;
+            Chord += Length(Next - Previous);
+            Previous = Next;
+        }
+        double Spacing = Chord / 256.0;                                                      // [len] - Target sample spacing
+        if (const auto* Carrier = std::get_if<RollingBallSurface>(&Surface)) Spacing = std::min(Spacing, 0.1 * Carrier->Definition->Radius);
+        // 📝 On a NURBS carrier the distance is near-linear across a fraction of the smallest curvature radius.
+        if (const NurbsSurface* Spline = ResolveNurbsChart(Surface)) Spacing = std::min(Spacing, 1.0e-2 * Spline->Definition->Extent);
+        const int Knots = static_cast<int>(CollectCurveBreakpoints(Curve, Low, High).size());
+        const int Floor = Settings.ScanSpacing > 0.0 ? 8 : 64;                               // [-] - Fewest samples
+        if (Settings.ScanSpacing > 0.0) Spacing = Settings.ScanSpacing;
+        const int Count = std::clamp(std::max(static_cast<int>(std::ceil(Chord / std::max(Spacing, 1.0e-300))), 16 * Knots), Floor, 16384);
+        std::vector<double> Values(Count + 1);
+        for (int Index = 0; Index <= Count; ++Index) Values[Index] = ProbeDistance(Curve, Surface, Low + (High - Low) * Index / Count).Distance;
+        for (int Index = 0; Index <= Count; ++Index)
+        {
+            const double τ = Low + (High - Low) * Index / Count;
+            if (Index < Count && Values[Index] * Values[Index + 1] < 0.0) Candidates.push_back({ τ + 0.5 * (High - Low) / Count, false });
+            const bool Minimum = (Index == 0 || std::fabs(Values[Index]) <= std::fabs(Values[Index - 1])) && (Index == Count || std::fabs(Values[Index]) <= std::fabs(Values[Index + 1]));
+            if (Minimum) Candidates.push_back({ τ, true });
+        }
+    }
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve))
+    {
+        // 📝 An intersection curve has no rational form: the exact signed distance is scanned at 16 samples per guide
+        //    segment (the guide turns ≤ 0.1 rad per segment, so d is near-linear between samples). Sign changes become
+        //    transversal candidates and local minima of |d| touch candidates; ③ polishes both on the exact distance.
+        const TracedIntersection& Trace = *Traced->Trace;
+        const double KnotSpan = Trace.Knots.back() - Trace.Knots.front();                    // [-] - τ per guide
+        const int    Count    = std::clamp(static_cast<int>(16.0 * static_cast<double>(Trace.Knots.size()) * (High - Low) / std::max(KnotSpan, 1.0e-300)), 64, 8192);
+        std::vector<double> Values(Count + 1);
+        for (int Index = 0; Index <= Count; ++Index) Values[Index] = ProbeDistance(Curve, Surface, Low + (High - Low) * Index / Count).Distance;
+        for (int Index = 0; Index <= Count; ++Index)
+        {
+            const double τ = Low + (High - Low) * Index / Count;
+            if (Index < Count && Values[Index] * Values[Index + 1] < 0.0) Candidates.push_back({ τ + 0.5 * (High - Low) / Count, false });
+            const bool Minimum = (Index == 0 || std::fabs(Values[Index]) <= std::fabs(Values[Index - 1])) && (Index == Count || std::fabs(Values[Index]) <= std::fabs(Values[Index + 1]));
+            if (Minimum) Candidates.push_back({ τ, true });
+        }
+    }
+    for (const RationalSegment& Segment : ScanCondition ? std::vector<RationalSegment>{} : ConvertToRationalSegments(Curve, Low, High))
+    {
+        // ---- ① Composed implicit equation; an identically vanishing one means the segment lies in the surface.
+        const BernsteinPolynomial Equation  = ComposeImplicitEquation(Surface, Segment);
+        const double              Magnitude = ImplicitMagnitude(Surface, Segment);           // [len^d] - L^d
+        double Largest = 0.0;                                                                // [len^d] - max |cᵢ|
+        for (double Coefficient : Equation.Coefficients) Largest = std::max(Largest, std::fabs(Coefficient));
+        if (Largest <= CoincidentFraction * Magnitude)
+        {
+            if (!Outcome.Coincidences.empty() && std::fabs(Outcome.Coincidences.back().High - Segment.CurveLow) <= 1.0e-12) Outcome.Coincidences.back().High = Segment.CurveHigh;
+            else Outcome.Coincidences.push_back({ Segment.CurveLow, Segment.CurveHigh });
+            continue;
+        }
+
+        // ---- ② Sign changes of F by Bézier clipping; extrema of F (roots of F′) as touch candidates.
+        const RootIsolation Crossings = IsolateBernsteinRoots(Equation, Settings.ParameterTolerance);
+        // ⚠️ A constant F (line parallel to a cylinder axis, circle coaxial with a surface of revolution) has a derivative
+        //    made of rounding noise; clipping it would chase noise, so its extremum search is skipped.
+        const BernsteinPolynomial Slope = DifferentiateBernstein(Equation);
+        double SlopeLargest = 0.0;                                                           // [len^d] - max |c′ᵢ|
+        for (double Coefficient : Slope.Coefficients) SlopeLargest = std::max(SlopeLargest, std::fabs(Coefficient));
+        const RootIsolation Extrema   = SlopeLargest <= CoincidentFraction * Magnitude ? RootIsolation{} : IsolateBernsteinRoots(Slope, Settings.ParameterTolerance);
+        Outcome.ClipSteps    += Crossings.ClipSteps + Extrema.ClipSteps;
+        Outcome.Subdivisions += Crossings.Subdivisions + Extrema.Subdivisions;
+        for (double Root : Crossings.Roots) Candidates.push_back({ SegmentParameter(Curve, Segment, Root), false });
+        for (double Root : Extrema.Roots)   Candidates.push_back({ SegmentParameter(Curve, Segment, Root), true });
+        // 📝 Segment end points are touch candidates too: a touch exactly at a joint has F′ ≠ 0 on either side.
+        Candidates.push_back({ Segment.CurveLow, true });
+        Candidates.push_back({ Segment.CurveHigh, true });
+    }
+    Outcome.Candidates = static_cast<int>(Candidates.size());
+
+    // ---- ③ Polish on the exact signed distance and accept within precision.
+    std::vector<CurveSurfaceCrossing> Transversals;
+    std::vector<CurveSurfaceCrossing> Touches;
+    const auto Accept = [&](double τ, bool TouchCondition)
+    {
+        const CurveSample     Sample  = EvaluateCurve(Curve, τ);
+        const SurfaceDistance Measure = MeasureSurfaceDistance(Surface, Sample.Position);
+        if (!(std::fabs(Measure.Distance) <= Settings.Precision)) return;                    // NaN-safe: never accept a non-finite probe
+        for (const CoincidentInterval& Interval : Outcome.Coincidences) if (τ >= Interval.Low - 1.0e-12 && τ <= Interval.High + 1.0e-12) return;
+        const double Sine = std::fabs(Dot(Measure.Normal, Sample.Derivative)) / std::max(Length(Sample.Derivative), 1.0e-300);
+        CurveSurfaceCrossing Crossing{ τ, ProjectOntoSurface(Surface, Measure.Foot, { 0.0, 0.0 }), Sample.Position,
+                                       TouchCondition || Sine <= TangentSine ? CrossingCategory::Tangent : CrossingCategory::Transversal, std::fabs(Measure.Distance) };
+        (Crossing.Category == CrossingCategory::Tangent ? Touches : Transversals).push_back(Crossing);
+    };
+    for (const Candidate& Entry : Candidates)
+    {
+        if (Entry.TouchCondition) Accept(PolishExtremum(Curve, Surface, Entry.τ, Low, High), true);
+        else                      Accept(PolishTransversal(Curve, Surface, Entry.τ, Low, High), false);
+    }
+
+    // ---- ④ Merge: duplicates collapse; crossings joined to a touch by a stretch within precision become that touch.
+    const auto ByParameter = [](const CurveSurfaceCrossing& First, const CurveSurfaceCrossing& Second) { return First.CurveParameter < Second.CurveParameter; };
+    std::sort(Transversals.begin(), Transversals.end(), ByParameter);
+    std::sort(Touches.begin(), Touches.end(), ByParameter);
+    const auto StretchWithinPrecision = [&](double From, double To)
+    {
+        for (int Sample = 1; Sample < 8; ++Sample)
+        {
+            if (std::fabs(ProbeDistance(Curve, Surface, From + (To - From) * Sample / 8.0).Distance) > Settings.Precision) return false;
+        }
+        return true;
+    };
+    std::vector<CurveSurfaceCrossing> Merged;
+    for (const CurveSurfaceCrossing& Touch : Touches)
+    {
+        if (!Merged.empty() && (Distance(Merged.back().Position, Touch.Position) <= 2.0 * Settings.Precision || StretchWithinPrecision(Merged.back().CurveParameter, Touch.CurveParameter)))
+        {
+            // ⚠️ At a touch |d| is flat to second order: a point 5·10⁻⁹ along a line tangent to a cylinder still reads
+            //    |d| ≈ 3·10⁻¹⁷, so comparing residuals picks by rounding. The extremum condition d′ = 0 is first order —
+            //    keep the duplicate with the smaller |d′| / |C′| (it moved a tangent cap foot by 4.9·10⁻⁹).
+            const auto Flatness = [&](const CurveSurfaceCrossing& Crossing)
+            {
+                const DistanceProbe Probe = ProbeDistance(Curve, Surface, Crossing.CurveParameter);
+                return std::fabs(Probe.Slope) / std::max(Probe.Speed, 1.0e-300);
+            };
+            if (Flatness(Touch) < Flatness(Merged.back())) Merged.back() = Touch;
+            continue;
+        }
+        Merged.push_back(Touch);
+    }
+    // 📝 A genuine touch has an extremum of |d| below precision; reject "touches" that sit on a transversal crossing
+    //    (the extremum of F′ near a steep crossing polishes onto the crossing itself) — keep the transversal.
+    std::vector<CurveSurfaceCrossing> Accepted;
+    for (const CurveSurfaceCrossing& Crossing : Transversals)
+    {
+        if (!Accepted.empty() && Distance(Accepted.back().Position, Crossing.Position) <= 2.0 * Settings.Precision) continue;
+        Accepted.push_back(Crossing);
+    }
+    for (const CurveSurfaceCrossing& Touch : Merged)
+    {
+        const double Slope = std::fabs(ProbeDistance(Curve, Surface, Touch.CurveParameter).Slope) / std::max(ProbeDistance(Curve, Surface, Touch.CurveParameter).Speed, 1.0e-300);
+        bool Absorbed = false;                                                               // [-] - Touch joins nearby crossings
+        for (auto Crossing = Accepted.begin(); Crossing != Accepted.end();)
+        {
+            const bool Near = Distance(Crossing->Position, Touch.Position) <= 2.0 * Settings.Precision;
+            if (Near && Slope > TangentSine) { Absorbed = true; ++Crossing; continue; }      // Steep: it IS the crossing
+            if (Near || StretchWithinPrecision(Crossing->CurveParameter, Touch.CurveParameter)) { Crossing = Accepted.erase(Crossing); continue; }
+            ++Crossing;
+        }
+        if (!Absorbed) Accepted.push_back(Touch);
+    }
+    std::sort(Accepted.begin(), Accepted.end(), ByParameter);
+    Outcome.Crossings = std::move(Accepted);
+    return Outcome;
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Intersection/CurveSurfaceIntersection.h b/Engine/GeometryProcessing/Intersection/CurveSurfaceIntersection.h
new file mode 100644
index 0000000000000000000000000000000000000000..235ca68fed00e6cf46e89e16124e9c344a16086e
--- /dev/null
+++ b/Engine/GeometryProcessing/Intersection/CurveSurfaceIntersection.h
@@ -0,0 +1,78 @@
+/*====================================================================================================================================
+                                                  CURVESURFACEINTERSECTION.H
+====================================================================================================================================*/
+// 🧩 Curve ∩ surface for lines/arcs against the analytic surfaces: all crossings, tangencies and coincident stretches
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Geometry/CurveGeometry.h"
+#include "Engine/GeometryProcessing/Geometry/SurfaceGeometry.h"
+#include "Engine/GeometryProcessing/Precision/PrecisionSpecification.h"
+
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+enum class CrossingCategory
+{
+    Transversal = 0,                                                                         // Curve passes through the surface
+    Tangent     = 1,                                                                         // Curve touches (within precision)
+};
+
+struct CurveSurfaceCrossing
+{
+    double           CurveParameter   = 0.0;                                                 // [-]   - τ on the curve
+    Vector2          SurfaceParameter = {};                                                  // [-]   - (𝑢, 𝑣) on the surface
+    Vector3          Position         = {};                                                  // [len] - C(τ)
+    CrossingCategory Category         = CrossingCategory::Transversal;                       // [-]   - Through or touching
+    double           Residual         = 0.0;                                                 // [len] - |signed distance| at C(τ)
+};
+
+struct CoincidentInterval
+{
+    double Low  = 0.0;                                                                       // [-] - τ where the curve joins the surface
+    double High = 0.0;                                                                       // [-] - τ where it leaves
+};
+
+struct CurveSurfaceOutcome
+{
+    std::vector<CurveSurfaceCrossing> Crossings    = {};                                     // [-] - Ascending τ
+    std::vector<CoincidentInterval>   Coincidences = {};                                     // [-] - Curve lies in the surface
+    int                               Candidates   = 0;                                      // [-] - Roots of F and F′ examined
+    int                               ClipSteps    = 0;                                      // [-] - Bézier clips
+    int                               Subdivisions = 0;                                      // [-] - Halvings
+};
+
+struct CurveSurfaceSettings
+{
+    double Precision          = SessionPrecision;                                            // [len] - Touch / accept distance
+    double ParameterTolerance = 1.0e-13;                                                     // [-]   - Bézier-clip width on [0, 1]
+    double ScanSpacing        = 0.0;                                                         // [len] - Fixed scan spacing (0 = automatic; set when
+                                                                                             //         a caller clips the interval, so clipping keeps
+                                                                                             //         the density of the whole curve)
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 Algorithm (research § E): exact rational Bézier form of the curve → implicit equation composed into a Bernstein
+//    polynomial (degree ≤ 8) → Bézier clipping for every sign change, roots of F′ for touches → Newton polishing on the
+//    EXACT signed distance d(τ) with d′ = N·C′ → tolerant merge: crossings joined by a stretch within precision of the
+//    surface become one Tangent crossing. The surface is untrimmed; callers filter by parameter boxes.
+[[nodiscard]] CurveSurfaceOutcome IntersectCurveSurface(const CurveGeometry&        Curve,
+                                                        double                      Low,
+                                                        double                      High,
+                                                        const SurfaceGeometry&      Surface,
+                                                        const CurveSurfaceSettings& Settings = {});
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Intersection/ImplicitSurface.cpp b/Engine/GeometryProcessing/Intersection/ImplicitSurface.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2d317fe38789e5ec1eb2ccb1852e754c0fd6de5c
--- /dev/null
+++ b/Engine/GeometryProcessing/Intersection/ImplicitSurface.cpp
@@ -0,0 +1,278 @@
+/*====================================================================================================================================
+                                                      IMPLICITSURFACE.CPP
+====================================================================================================================================*/
+// 🧩 Signed distances, rational Bézier conversion of lines and arcs, homogeneous implicit composition
+
+#include "Engine/GeometryProcessing/Intersection/ImplicitSurface.h"
+
+#include "Engine/GeometryProcessing/Geometry/NurbsCarrier.h"
+#include "Engine/GeometryProcessing/Geometry/ParallelCarrier.h"
+#include "Engine/GeometryProcessing/Geometry/RollingBallCarrier.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+#include <optional>
+#include <type_traits>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    [[nodiscard]] Vector3 LocalCoordinates(const OrthonormalFrame& Frame, Vector3 Position) noexcept
+    {
+        const Vector3 Offset = Position - Frame.Origin;                                      // [len] - From the origin
+        return { Dot(Offset, Frame.XAxis), Dot(Offset, Frame.YAxis), Dot(Offset, Frame.ZAxis) };
+    }
+
+    [[nodiscard]] const OrthonormalFrame& FrameOf(const SurfaceGeometry& Surface) noexcept
+    {
+        return std::visit([](const auto& Typed) -> const OrthonormalFrame&
+        {
+            using Kind = std::decay_t<decltype(Typed)>;
+            if constexpr (std::is_same_v<Kind, RollingBallSurface> || std::is_same_v<Kind, NurbsSurface> || std::is_same_v<Kind, ParallelSurface>) { static const OrthonormalFrame Unused{}; return Unused; }   // No frame: handled first
+            else return Typed.Frame;
+        }, Surface);
+    }
+
+    // Unit radial direction of a local point; on the axis any perpendicular direction is a valid gradient choice.
+    [[nodiscard]] Vector3 RadialDirection(const OrthonormalFrame& Frame, Vector3 Local, double ρ) noexcept
+    {
+        return ρ > 0.0 ? (Frame.XAxis * Local.X + Frame.YAxis * Local.Y) * (1.0 / ρ) : Frame.XAxis;
+    }
+
+    // 📝 Homogeneous local coordinates of a rational segment as Bernstein polynomials: x(𝑡)·W, y(𝑡)·W, z(𝑡)·W and W.
+    struct HomogeneousCoordinates
+    {
+        BernsteinPolynomial X = {};                                                          // [len] - Σ wᵢ·xᵢ·Bᵢ
+        BernsteinPolynomial Y = {};                                                          // [len] - Σ wᵢ·yᵢ·Bᵢ
+        BernsteinPolynomial Z = {};                                                          // [len] - Σ wᵢ·zᵢ·Bᵢ
+        BernsteinPolynomial W = {};                                                          // [-]   - Σ wᵢ·Bᵢ
+    };
+
+    [[nodiscard]] HomogeneousCoordinates ComposeHomogeneous(const OrthonormalFrame& Frame, const RationalSegment& Segment)
+    {
+        HomogeneousCoordinates Coordinates;
+        for (size_t Index = 0; Index < Segment.ControlPoints.size(); ++Index)
+        {
+            const Vector3 Local  = LocalCoordinates(Frame, Segment.ControlPoints[Index]);
+            const double  Weight = Segment.Weights[Index];                                    // [-] - wᵢ
+            Coordinates.X.Coefficients.push_back(Local.X * Weight);
+            Coordinates.Y.Coefficients.push_back(Local.Y * Weight);
+            Coordinates.Z.Coefficients.push_back(Local.Z * Weight);
+            Coordinates.W.Coefficients.push_back(Weight);
+        }
+        return Coordinates;
+    }
+
+    [[nodiscard]] BernsteinPolynomial Square(const BernsteinPolynomial& Polynomial) { return MultiplyBernstein(Polynomial, Polynomial); }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+SurfaceDistance MeasureSurfaceDistance(const SurfaceGeometry& Surface, Vector3 Position) noexcept
+{
+    if (const auto* Carrier = std::get_if<RollingBallSurface>(&Surface))
+    {
+        const RollingBallDistance Measure = MeasureRollingBallDistance(*Carrier, Position);   // |X − C(𝑢*)| − r, exact
+        return { Measure.Distance, Measure.Normal, Measure.Foot };
+    }
+    if (const auto* Offset = std::get_if<ParallelSurface>(&Surface))
+    {
+        // 📝 Same normal line as the basis: the signed distance drops by d and the foot moves out by d·N.
+        const SurfaceDistance Basis = MeasureSurfaceDistance(SurfaceGeometry{ Offset->Definition->Basis }, Position);
+        return { Basis.Distance - Offset->Definition->Distance, Basis.Normal, Basis.Foot + Basis.Normal * Offset->Definition->Distance };
+    }
+    if (const auto* Spline = std::get_if<NurbsSurface>(&Surface))
+    {
+        // 📝 Foot by global inversion; d = (X − S)·n is the signed distance (exact at interior feet, where X − S ∥ n).
+        const NurbsDomain U = MeasureNurbsSurfaceDomain(*Spline->Definition, true), V = MeasureNurbsSurfaceDomain(*Spline->Definition, false);
+        const Vector2 Parameter = ProjectOntoNurbsSurface(*Spline, Position, { 0.5 * (U.Low + U.High), 0.5 * (V.Low + V.High) });
+        const Vector3 Foot      = EvaluateNurbsSurface(*Spline, Parameter).Position;
+        const Vector3 Normal    = EvaluateNurbsNormal(*Spline, Parameter);
+        return { Dot(Position - Foot, Normal), Normal, Foot };
+    }
+    const OrthonormalFrame& Frame = FrameOf(Surface);
+    const Vector3           Local = LocalCoordinates(Frame, Position);                       // [len] - Frame coordinates
+    const double            ρ     = std::hypot(Local.X, Local.Y);                            // [len] - Distance from the axis
+    SurfaceDistance         Measure;
+    if (std::holds_alternative<PlaneSurface>(Surface))
+    {
+        Measure.Distance = Local.Z;
+        Measure.Normal   = Frame.ZAxis;
+    }
+    else if (const auto* Cylinder = std::get_if<CylinderSurface>(&Surface))
+    {
+        Measure.Distance = ρ - Cylinder->Radius;
+        Measure.Normal   = RadialDirection(Frame, Local, ρ);
+    }
+    else if (const auto* Cone = std::get_if<ConeSurface>(&Surface))
+    {
+        // 📝 Meridian half-plane (ρ, z): the cone is the line ρ = r₀ + s·z and its mirror ρ = −r₀ − s·z (second nappe);
+        //    the nearer line gives the distance. Natural normal (1, −s)/√(1+s²) on the first nappe.
+        const double  s       = Cone->RadialSlope;                                           // [-] - dr/d𝑣
+        const double  Norm    = std::sqrt(1.0 + s * s);                                      // [-] - Line normaliser
+        const double  First   = (ρ - Cone->OriginRadius - s * Local.Z) / Norm;                 // [len] - To the first nappe
+        const double  Second  = (ρ + Cone->OriginRadius + s * Local.Z) / Norm;                 // [len] - To the mirror nappe
+        const Vector3 Radial  = RadialDirection(Frame, Local, ρ);
+        if (std::fabs(First) <= std::fabs(Second))
+        {
+            Measure.Distance = First;
+            Measure.Normal   = (Radial - Frame.ZAxis * s) * (1.0 / Norm);
+        }
+        else
+        {
+            Measure.Distance = Second;
+            Measure.Normal   = (Radial + Frame.ZAxis * s) * (1.0 / Norm);
+        }
+    }
+    else if (const auto* Sphere = std::get_if<SphereSurface>(&Surface))
+    {
+        const double Radius = Length(Local);                                                 // [len] - From the centre
+        Measure.Distance = Radius - Sphere->Radius;
+        Measure.Normal   = Radius > 0.0 ? (Position - Frame.Origin) * (1.0 / Radius) : Frame.ZAxis;
+    }
+    else
+    {
+        const auto&  Torus  = std::get<TorusSurface>(Surface);
+        const double Δρ     = ρ - Torus.MajorRadius;                                           // [len] - From the tube axis, radially
+        const double Radius = std::hypot(Δρ, Local.Z);                                        // [len] - From the tube axis
+        Measure.Distance = Radius - Torus.MinorRadius;
+        Measure.Normal   = Radius > 0.0 ? (RadialDirection(Frame, Local, ρ) * Δρ + Frame.ZAxis * Local.Z) * (1.0 / Radius) : Frame.ZAxis;
+    }
+    Measure.Foot = Position - Measure.Normal * Measure.Distance;
+    return Measure;
+}
+
+SurfaceDistance MeasureSurfaceDistanceNear(const SurfaceGeometry& Surface, Vector3 Position, Vector2& Hint) noexcept
+{
+    if (const auto* Carrier = std::get_if<RollingBallSurface>(&Surface))
+    {
+        const RollingBallDistance Measure = MeasureRollingBallDistanceNear(*Carrier, Position, Hint);
+        return { Measure.Distance, Measure.Normal, Measure.Foot };
+    }
+    const auto*         Offset = std::get_if<ParallelSurface>(&Surface);
+    const NurbsSurface* Spline = Offset ? &Offset->Definition->Basis : std::get_if<NurbsSurface>(&Surface);
+    if (Spline == nullptr) return MeasureSurfaceDistance(Surface, Position);
+    std::optional<Vector2> Parameter;
+    if (std::isfinite(Hint.X) && std::isfinite(Hint.Y)) Parameter = PolishNurbsFootLocally(*Spline, Position, Hint);
+    if (!Parameter)
+    {
+        const NurbsDomain U = MeasureNurbsSurfaceDomain(*Spline->Definition, true), V = MeasureNurbsSurfaceDomain(*Spline->Definition, false);
+        Parameter = ProjectOntoNurbsSurface(*Spline, Position, { 0.5 * (U.Low + U.High), 0.5 * (V.Low + V.High) });
+    }
+    Hint = *Parameter;
+    const Vector3 Foot     = EvaluateNurbsSurface(*Spline, *Parameter).Position;
+    const Vector3 Normal   = EvaluateNurbsNormal(*Spline, *Parameter);
+    const double  Distance = Dot(Position - Foot, Normal);                                   // [len] - Signed, basis
+    if (Offset) return { Distance - Offset->Definition->Distance, Normal, Foot + Normal * Offset->Definition->Distance };
+    return { Distance, Normal, Foot };
+}
+
+std::vector<RationalSegment> ConvertToRationalSegments(const CurveGeometry& Curve, double Low, double High)
+{
+    std::vector<RationalSegment> Segments;
+    if (const auto* Line = std::get_if<StraightLine>(&Curve))
+    {
+        Segments.push_back({ { Line->Origin + Line->Direction * Low, Line->Origin + Line->Direction * High }, { 1.0, 1.0 }, Low, High });
+        return Segments;
+    }
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve))
+    {
+        // 📝 Bézier extraction is exact and keeps τ linear in 𝑡 on every piece.
+        for (NurbsBezierPiece& Piece : DecomposeNurbsCurve(*Spline->Definition, Low, High))
+            Segments.push_back({ std::move(Piece.Poles), std::move(Piece.Weights), Piece.PieceLow, Piece.PieceHigh });
+        return Segments;
+    }
+    // 📝 Arc of sweep Δ ≤ π/2: P₀, P₂ on the circle, P₁ at the tangent intersection, w₁ = cos(Δ/2) — exact conic.
+    //    An ellipse is the affine image of a circle and rational Bézier form is affine invariant: same weights.
+    const ConicForm Conic   = *ResolveConicForm(Curve);
+    const int    PieceCount = std::max(1, static_cast<int>(std::ceil((High - Low) / (0.5 * std::numbers::pi) - 1.0e-12)));
+    const double Sweep      = (High - Low) / PieceCount;                                     // [rad] - Δ per piece
+    const auto   Point      = [&](double Angle, double Scale)
+    {
+        return Conic.Centre + (Conic.CosineAxis * std::cos(Angle) + Conic.SineAxis * std::sin(Angle)) * Scale;
+    };
+    for (int PieceIndex = 0; PieceIndex < PieceCount; ++PieceIndex)
+    {
+        const double Start  = Low + PieceIndex * Sweep;                                      // [rad] - Piece start
+        const double Middle = Start + 0.5 * Sweep;                                           // [rad] - Piece middle
+        const double Weight = std::cos(0.5 * Sweep);                                         // [-]   - Middle weight
+        Segments.push_back({ { Point(Start, 1.0), Point(Middle, 1.0 / Weight), Point(Start + Sweep, 1.0) }, { 1.0, Weight, 1.0 }, Start, Start + Sweep });
+    }
+    return Segments;
+}
+
+Vector3 EvaluateRationalSegment(const RationalSegment& Segment, double 𝑡)
+{
+    const int Degree = static_cast<int>(Segment.ControlPoints.size()) - 1;                   // [-] - Any degree
+    if (Degree == 1) return Segment.ControlPoints[0] * (1.0 - 𝑡) + Segment.ControlPoints[1] * 𝑡;
+    // de Casteljau on the homogeneous points (wᵢPᵢ, wᵢ).
+    std::vector<Vector3> Points(Segment.ControlPoints.size());
+    std::vector<double>  Weights = Segment.Weights;
+    for (size_t Index = 0; Index < Points.size(); ++Index) Points[Index] = Segment.ControlPoints[Index] * Segment.Weights[Index];
+    for (int Level = 1; Level <= Degree; ++Level)
+        for (int Index = 0; Index + Level <= Degree; ++Index)
+        {
+            Points[Index]  = Points[Index] * (1.0 - 𝑡) + Points[Index + 1] * 𝑡;
+            Weights[Index] = Weights[Index] * (1.0 - 𝑡) + Weights[Index + 1] * 𝑡;
+        }
+    return Points[0] * (1.0 / Weights[0]);
+}
+
+BernsteinPolynomial ComposeImplicitEquation(const SurfaceGeometry& Surface, const RationalSegment& Segment)
+{
+    // ⚠️ The rolling-ball and NURBS carriers have no polynomial implicit form; IntersectCurveSurface scans their distance instead.
+    if (ProceduralSurfaceCondition(Surface)) return BernsteinPolynomial{ { 1.0 } };
+    const HomogeneousCoordinates H = ComposeHomogeneous(FrameOf(Surface), Segment);
+    if (std::holds_alternative<PlaneSurface>(Surface)) return H.Z;                             // z
+    const BernsteinPolynomial Planar = AddBernstein(Square(H.X), Square(H.Y));               // x² + y²
+    const BernsteinPolynomial W2     = Square(H.W);                                          // W²
+    if (const auto* Cylinder = std::get_if<CylinderSurface>(&Surface))                       // x² + y² − r²W²
+    {
+        return AddBernstein(Planar, ScaleBernstein(W2, -Cylinder->Radius * Cylinder->Radius));
+    }
+    if (const auto* Cone = std::get_if<ConeSurface>(&Surface))                               // x² + y² − (r₀W + s·z)²
+    {
+        const BernsteinPolynomial Radius = AddBernstein(ScaleBernstein(H.W, Cone->OriginRadius), ScaleBernstein(H.Z, Cone->RadialSlope));
+        return AddBernstein(Planar, ScaleBernstein(Square(Radius), -1.0));
+    }
+    const BernsteinPolynomial Spatial = AddBernstein(Planar, Square(H.Z));                   // x² + y² + z²
+    if (const auto* Sphere = std::get_if<SphereSurface>(&Surface))                           // x² + y² + z² − r²W²
+    {
+        return AddBernstein(Spatial, ScaleBernstein(W2, -Sphere->Radius * Sphere->Radius));
+    }
+    // 📝 Torus: (x² + y² + z² + (R² − r²)W²)² − 4R²·W²·(x² + y²)
+    const auto&  Torus = std::get<TorusSurface>(Surface);
+    const double R2    = Torus.MajorRadius * Torus.MajorRadius;                               // [len²] - R²
+    const double r2    = Torus.MinorRadius * Torus.MinorRadius;                               // [len²] - r²
+    const BernsteinPolynomial Inner = AddBernstein(Spatial, ScaleBernstein(W2, R2 - r2));
+    return AddBernstein(Square(Inner), ScaleBernstein(MultiplyBernstein(W2, Planar), -4.0 * R2));
+}
+
+double ImplicitMagnitude(const SurfaceGeometry& Surface, const RationalSegment& Segment)
+{
+    // 📝 Characteristic length L (control points + radii); the composed coefficients scale as L^d.
+    const OrthonormalFrame& Frame = FrameOf(Surface);
+    double Scale = 0.0;                                                                      // [len] - L
+    for (const Vector3& Control : Segment.ControlPoints) Scale = std::max(Scale, Length(LocalCoordinates(Frame, Control)));
+    std::visit([&](const auto& Typed)
+    {
+        using Kind = std::decay_t<decltype(Typed)>;
+        if constexpr (std::is_same_v<Kind, CylinderSurface> || std::is_same_v<Kind, SphereSurface>) Scale = std::max(Scale, Typed.Radius);
+        if constexpr (std::is_same_v<Kind, ConeSurface>) Scale = std::max(Scale, std::fabs(Typed.OriginRadius));
+        if constexpr (std::is_same_v<Kind, TorusSurface>) Scale = std::max(Scale, Typed.MajorRadius + Typed.MinorRadius);
+    }, Surface);
+    if (ProceduralSurfaceCondition(Surface)) return 1.0;                                    // Scanned, never composed
+    const int Degree = std::holds_alternative<PlaneSurface>(Surface) ? 1 : std::holds_alternative<TorusSurface>(Surface) ? 4 : 2;
+    return std::pow(std::max(Scale, 1.0e-300), Degree);
+}
+
+} // namespace Frontier::GeometryProcessing
