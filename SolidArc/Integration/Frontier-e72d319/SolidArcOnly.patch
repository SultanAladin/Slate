+frames 2
+click @BevelSize
+key A Ctrl
+type 1
+key Enter
+frames 2
+key Enter
+frames 2
+expect refused == 0
+expect bodies == 1
+expect volume ~ 8.502654824574368
+expect scene-high-x ~ 2
+
+# ③ Shift+X Construct cylinder on the −y face: base on the face, the height lifts along −y
+key X Shift
+frames 2
+expect drawing-solid-kind == 1
+move world 0.0 -1.0 1.0
+frames 2
+click world 0.0 -1.0 1.0
+frames 2
+expect drawing-on-face == 1
+expect drawing-normal-y ~ -1
+move world 0.4 -1.0 1.0
+frames 2
