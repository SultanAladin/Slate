+            return FromBoolean(P, Rod(P, { 6, 22, 0 }, 0.5, 4.0, { 1, 0, 0 }), Rod(P, { 8, 20, 0 }, 0.5, 4.0, { 0, 1, 0 }), Operation, Expected);
