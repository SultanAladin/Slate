+
+void PickCurve(SolidArcWorkspaceState& State, const std::string& Label, SolidArcPickIntent Intent)
+{
+    if (Intent == SolidArcPickIntent::Remove && CurveOrder(State, Label) == 0) return;
+    State.SplineSpans = {};
+    State.PoleDrag.PickedPoles.clear();
+    State.PoleDrag.PickedLabel.clear();
+    if (Intent != SolidArcPickIntent::Replace || State.SketchPoints.Sketch != Label)
+    {
+        State.SketchPoints.Points.clear();
+        State.SketchPoints.Sketch.clear();
+    }
+    const bool        Member  = CurveOrder(State, Label) > 0;
+    const std::string Caption = CaptionOf(State.Document, Label);
+    switch (Intent)
+    {
+    case SolidArcPickIntent::Replace:
+        SelectSolidArcCurve(State.Document, Label, false);
+        State.FocusedStep = Label;
+        State.Outliner.AnchorKey = Label;
+        break;
+    case SolidArcPickIntent::Add:
+    case SolidArcPickIntent::Loop:
+    case SolidArcPickIntent::LoopToggle:
+    case SolidArcPickIntent::Ring:
+    case SolidArcPickIntent::RingToggle:
+    case SolidArcPickIntent::Chain:
+        if (!Member) SelectSolidArcCurve(State.Document, Label, true);
+        if (State.Outliner.AnchorKey.empty()) State.Outliner.AnchorKey = Label;
+        break;
+    case SolidArcPickIntent::Remove:
+        if (Member) SelectSolidArcCurve(State.Document, Label, true);
+        break;
+    }
+    const CurveFitOutcome* Fit = FindFittedCurve(State.Document, Label);
+    if (!Fit)
+    {
+        Announce(State, Compose("%s sketch %s · %d selected · L lofts the picks in order · the gizmo moves / turns them",
+                                (Intent == SolidArcPickIntent::Remove && Member) ? "Removed" : "Selected",
+                                Caption.c_str(), int(State.Document.Selection.Curves.size())));
+        return;
+    }
+    Announce(State, Compose("%s curve %s · %d poles · fit %.3f mm · %d selected",
+                            (Intent == SolidArcPickIntent::Remove && Member) ? "Removed" : "Selected", Caption.c_str(),
+                            Fit ? int(Fit->Curve.Definition->Poles.size()) : 0, Fit ? Fit->WorstDeviation * 1000.0 : 0.0, int(State.Document.Selection.Curves.size())));
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    VIEWPORT PICKING
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 The grid (and the drawing plane a new sketch takes) follows the camera: looking straight along a world axis
+//    (Front / Back → XZ, Right / Left → YZ, Top / Bottom → XY, perspective or parallel) shows the plane facing the view;
+//    every other view (perspective orbit, Isometric, any angle off the 90° steps) shows the ground grid XY only.
+int ViewGridPlane(const OrbitCamera& Camera) noexcept
+{
+    constexpr double Tolerance = 1.0e-2;                                                     // [rad] - As CurrentViewLabel
+    constexpr double HalfPi    = 0.5 * std::numbers::pi;
+    if (std::abs(Camera.Elevation) > Tolerance) return 0;                                    // Above / below: ground (Top / Bottom too)
+    const double Quarter = std::remainder(Camera.Azimuth, HalfPi);                           // Off a 90° step → ground
+    if (std::abs(Quarter) > Tolerance) return 0;
+    const double Turn = std::remainder(Camera.Azimuth, std::numbers::pi);                    // 0: ±x (Right / Left), ±½π: ±y
+    return std::abs(Turn) < Tolerance ? 2 : 1;
+}
+
+void PresentView(SolidArcWorkspaceState& State, OrbitViewPreset Preset)
+{
+    PresentOrbitView(State.Camera, Preset);
+    State.Style.GridPlane = ViewGridPlane(State.Camera);
+}
+
+OrbitCameraFrame ViewportFrame(const SolidArcWorkspaceState& State)
+{
+    return FrameOrbitCamera(State.Camera, std::max(1.0f, State.ViewportRect[2]), std::max(1.0f, State.ViewportRect[3]));
+}
+
+// 💡 The GPU identity under the pointer is primary (identity target readback); modes 2 / 3 retarget it with the
+//    exact CPU ray pick so an edge stroke never blocks a face click and a face never blocks a nearby edge.
+// 💡 Blender's loop / ring clicks (edit-mode select_loop): Alt loops, Ctrl+Alt rings — the selection becomes the walk;
+//    with Shift the walk joins, or leaves when the clicked edge is already picked (toggle). Face mode: the face loop
+//    across the quads of the edge's ring. Double-click: the tangent chain (smoothly joined edges) joins.
+void PickEdgeWalk(SolidArcWorkspaceState& State, SolidArcSelectionKind Kind, const std::string& Name, SolidArcPickIntent Intent, const std::string& Body)
+{
+    const bool RingCondition   = Intent == SolidArcPickIntent::Ring || Intent == SolidArcPickIntent::RingToggle;
+    const bool ToggleCondition = Intent == SolidArcPickIntent::LoopToggle || Intent == SolidArcPickIntent::RingToggle;
+    const SolidArcSelectionKind Picked = Kind == SolidArcSelectionKind::Face ? SolidArcSelectionKind::Face : SolidArcSelectionKind::Edge;
+    const auto Member = [&](const std::string& Candidate)
+    {
+        const std::vector<std::string>& Names = Picked == SolidArcSelectionKind::Edge ? State.Document.Selection.Edges : State.Document.Selection.Faces;
+        return std::find(Names.begin(), Names.end(), Candidate) != Names.end();
+    };
+    if (Kind == SolidArcSelectionKind::Face && Intent == SolidArcPickIntent::Chain)
+    {
+        SelectSolidArcName(State.Document, Kind, Name, false, Body);                          // A double-click on a face picks it
+        Announce(State, "Selected " + Name);
+        return;
+    }
+    std::vector<std::string> Walk;
+    const char*              Caption = "Edge loop";
+    if (Kind == SolidArcSelectionKind::Face)
+    {
+        Walk    = { Name };                                                                  // A face hit without an edge: just the face
+        Caption = "Face";
+    }
+    else if (Intent == SolidArcPickIntent::Chain) { Walk = SolidArcTangentChain(State.Document, Name); Caption = "Tangent chain"; }
+    else if (RingCondition) { Walk = SolidArcEdgeRing(State.Document, Name, Body); Caption = "Edge ring"; }
+    else Walk = SolidArcEdgeLoop(State.Document, Name, Body);
+    const bool Leave = ToggleCondition && Member(Name);
+    if (!ToggleCondition && Intent != SolidArcPickIntent::Chain)
+    {
+        State.Document.Selection.Edges.clear();
+        State.Document.Selection.Faces.clear();
+    }
+    if (!Body.empty()) State.Document.Selection.PickedBody = Body;
+    for (const std::string& Link : Walk)
+    {
+        if (Leave ? Member(Link) : !Member(Link)) SelectSolidArcName(State.Document, Picked, Link, true);
+    }
+    ++State.RingPicks;
+    Announce(State, Compose("%s: %d %s %s · Alt loop · Ctrl+Alt ring · Shift toggles · double-click tangent chain", Caption, int(Walk.size()),
+                            Picked == SolidArcSelectionKind::Edge ? "edge(s)" : "face(s)", Leave ? "removed" : ToggleCondition || Intent == SolidArcPickIntent::Chain ? "added" : "selected"));
+}
+
+// 📝 Edge path: the picked edges become PathBase + the path From … To (To last, so a further Ctrl+click goes on from it).
+//    A refused path leaves PathBase picked and says why (Along loop never leaves the loop: Shortest takes any edges).
+void ApplyEdgePath(SolidArcWorkspaceState& State)
+{
+    std::vector<std::string>& Edges = State.Document.Selection.Edges;
+    const auto Member = [&](const std::string& Candidate) { return std::find(Edges.begin(), Edges.end(), Candidate) != Edges.end(); };
+    const auto Based  = [&](const std::string& Candidate) { return std::find(State.PathBase.begin(), State.PathBase.end(), Candidate) != State.PathBase.end(); };
+    for (const std::string& Picked : std::vector<std::string>(Edges)) if (!Based(Picked)) SelectSolidArcName(State.Document, SolidArcSelectionKind::Edge, Picked, true);
+    for (const std::string& Kept : State.PathBase) if (!Member(Kept)) SelectSolidArcName(State.Document, SolidArcSelectionKind::Edge, Kept, true, State.PathBody);
+    State.PathLast = SolidArcEdgePathBetween(State.Document, State.PathFrom, State.PathTo, State.PathMode, State.PathOtherSideCondition, State.PathBody);
+    if (!State.PathLast.Refusal.empty())
+    {
+        State.PathSelection = Edges;
+        Announce(State, "Edge path (" + std::string(SolidArcEdgePathModeLabel(State.PathMode)) + "): " + State.PathLast.Refusal);
+        return;
+    }
+    for (const std::string& Link : State.PathLast.Edges) if (!Member(Link)) SelectSolidArcName(State.Document, SolidArcSelectionKind::Edge, Link, true, State.PathBody);
+    if (Member(State.PathTo) && Edges.back() != State.PathTo)
+    {
+        Edges.erase(std::find(Edges.begin(), Edges.end(), State.PathTo));                    // To is the active (last) edge
+        Edges.push_back(State.PathTo);
+    }
+    if (!State.PathBody.empty()) State.Document.Selection.PickedBody = State.PathBody;
+    State.PathSelection = Edges;
+    Announce(State, Compose("Edge path %s: %d edge(s) along %s, %.4g long%s · Inspector › Edge path: Along loop · Whole loop · Shortest", SolidArcEdgePathModeLabel(State.PathMode),
+                            int(State.PathLast.Edges.size()), State.PathLast.Carrier.c_str(), State.PathLast.Length,
+                            State.PathLast.ClosedCondition && State.PathMode == SolidArcEdgePathMode::AlongLoop ? (State.PathOtherSideCondition ? " (far side)" : " (near side · Other side flips)") : ""));
+}
+
+// Ctrl+click on an unpicked edge with edges picked (Blender's pick shortest path): the path from the active edge to it.
+void PickEdgePath(SolidArcWorkspaceState& State, const std::string& Name, const std::string& Body)
+{
+    State.PathFrom               = State.Document.Selection.Edges.back();
+    State.PathTo                 = Name;
+    State.PathBody               = Body.empty() ? State.Document.Selection.PickedBody : Body;
+    State.PathBase               = State.Document.Selection.Edges;
+    State.PathOtherSideCondition = false;
+    ++State.PathPicks;
+    ApplyEdgePath(State);
+}
+
+// Inspector › Edge path: a new mode / side redoes the last pick while the selection is still the one it made.
+void ChangeEdgePath(SolidArcWorkspaceState& State, SolidArcEdgePathMode Mode, bool OtherSideCondition)
+{
+    State.PathMode               = Mode;
+    State.PathOtherSideCondition = OtherSideCondition;
+    if (!State.PathTo.empty() && State.Document.Selection.Edges == State.PathSelection) ApplyEdgePath(State);
+    else Announce(State, Compose("Edge path: %s (Ctrl+click an edge with an edge picked)", SolidArcEdgePathModeLabel(Mode)));
+}
+
+// Face-mode Alt+click: Blender's face loop through the edge nearest the pointer.
+void PickFaceLoop(SolidArcWorkspaceState& State, const std::string& Edge, SolidArcPickIntent Intent, const std::string& Body)
+{
+    const std::vector<std::string> Faces = SolidArcFaceLoop(State.Document, Edge, Body);
+    if (Faces.empty()) { Announce(State, "Face loop: no four-sided face beside " + Edge); return; }
+    const bool ToggleCondition = Intent != SolidArcPickIntent::Loop && Intent != SolidArcPickIntent::Ring;
+    const std::vector<std::string>& Selected = State.Document.Selection.Faces;
+    const bool Leave = ToggleCondition && std::all_of(Faces.begin(), Faces.end(), [&](const std::string& Face) { return std::find(Selected.begin(), Selected.end(), Face) != Selected.end(); });
+    if (!ToggleCondition)
+    {
+        State.Document.Selection.Edges.clear();
+        State.Document.Selection.Faces.clear();
+    }
+    if (!Body.empty()) State.Document.Selection.PickedBody = Body;
+    for (const std::string& Face : Faces)
+    {
+        const bool Member = std::find(State.Document.Selection.Faces.begin(), State.Document.Selection.Faces.end(), Face) != State.Document.Selection.Faces.end();
+        if (Leave ? Member : !Member) SelectSolidArcName(State.Document, SolidArcSelectionKind::Face, Face, true);
+    }
+    ++State.RingPicks;
+    Announce(State, Compose("Face loop: %d face(s) %s", int(Faces.size()), Leave ? "removed" : ToggleCondition ? "added" : "selected"));
+}
+
+void PickAtPointer(SolidArcWorkspaceState& State, ImVec2 Local, SolidArcPickIntent Intent)
+{
+    const OrbitCameraFrame Frame = ViewportFrame(State);
+    const OrbitRay         Ray   = CastOrbitRay(Frame, Local.x, Local.y);
+    uint32_t                  Identity = State.HoverIdentity;
+    if (State.PickMode == SolidArcPickMode::ControlPoint || State.PickMode == SolidArcPickMode::Edge || State.PickMode == SolidArcPickMode::Any || State.PickMode==SolidArcPickMode::Curve)
+    {
+        // Curves are overlays: within CurveReach they win over the face / edge underneath.
+        const std::string Curve = FindCurveNear(State, Frame, ImVec2(State.ViewportRect[0] + Local.x, State.ViewportRect[1] + Local.y));
+        if (!Curve.empty())
+        {
+            PickCurve(State, Curve, Intent);
+            return;
+        }
+        if(State.PickMode==SolidArcPickMode::Curve) {
+            if(Intent==SolidArcPickIntent::Replace) ClearSolidArcSelection(State.Document);
+            return;
+        }
+        if (State.PickMode == SolidArcPickMode::ControlPoint)
+        {
+            // Body vertices (direct reshape) under the curves.
+            const int Vertex = FindBodyVertexNear(State, Frame, ImVec2(State.ViewportRect[0] + Local.x, State.ViewportRect[1] + Local.y));
+            if (Vertex >= 0) { PickBodyVertex(State, Vertex, Intent); return; }
+            if (Intent == SolidArcPickIntent::Replace && (!State.Document.Selection.Curves.empty() || !State.Document.Selection.Vertices.empty()))
+            {
+                ClearSolidArcSelection(State.Document);
+                Announce(State, "Selection cleared");
+            }
+            return;
+        }
+    }
+    if (State.PickMode == SolidArcPickMode::Edge && (Identity == 0 || !(Identity & IdentityEdgeBit)))
+    {
+        const std::optional<SolidArcPick> Nearby = PickSolidArcScene(State.Scene, Ray, 8.0 * Frame.WorldPerPixel, State.Style.XRayEnabled, ActiveSectionClip(State));
+        Identity = Nearby && (Nearby->Identity & IdentityEdgeBit) ? Nearby->Identity : 0;
+    }
+    // Blender's loop / ring clicks take the edge nearest the pointer even over a face (face mode: its face loop).
+    const bool WalkCondition = Intent == SolidArcPickIntent::Loop || Intent == SolidArcPickIntent::LoopToggle || Intent == SolidArcPickIntent::Ring || Intent == SolidArcPickIntent::RingToggle;
+    if (Intent == SolidArcPickIntent::Chain && State.PickMode != SolidArcPickMode::Edge && State.PickMode != SolidArcPickMode::Any) Intent = SolidArcPickIntent::Replace;
+    if (WalkCondition && State.PickMode != SolidArcPickMode::Solid)
+    {
+        uint32_t Edge = (Identity & IdentityEdgeBit) ? Identity : 0u;
+        if (Edge == 0)
+        {
+            const std::optional<SolidArcPick> Nearby = PickSolidArcScene(State.Scene, Ray, 12.0 * Frame.WorldPerPixel, State.Style.XRayEnabled, ActiveSectionClip(State));
+            if (Nearby && (Nearby->Identity & IdentityEdgeBit)) Edge = Nearby->Identity;
+        }
+        const uint32_t Index  = (Edge & ~IdentityEdgeBit) - 1u;
+        const uint32_t BodyAt = Edge != 0 && Index < State.Scene.Edges.size() ? State.Scene.Edges[Index].Body : ~0u;
+        const bool     Locked = BodyAt < State.Scene.Bodies.size() && SolidArcLockedCondition(State.Document, State.Scene.Bodies[BodyAt].Key);
+        if (Edge != 0 && !Locked && State.PickMode == SolidArcPickMode::Face) { PickFaceLoop(State, NameSolidArcIdentity(State.Scene, Edge), Intent, State.Scene.Bodies[BodyAt].Key); return; }
+        if (Edge != 0) Identity = Edge;
+    }
+    if (State.PickMode == SolidArcPickMode::Face && (Identity & IdentityEdgeBit))
+    {
+        const std::optional<SolidArcPick> Behind = PickSolidArcScene(State.Scene, Ray, 0.0, false, ActiveSectionClip(State));
+        Identity = Behind ? Behind->Identity : 0;
+    }
+    if (Identity == IdentitySectionCap) Identity = 0;                                        // The section cap is no entity
+    if (Identity != 0)
+    {
+        // A locked body (Outliner lock) stays in view but takes no pick.
+        const uint32_t Index  = (Identity & ~IdentityEdgeBit) - 1u;
+        const uint32_t BodyAt = (Identity & IdentityEdgeBit) ? (Index < State.Scene.Edges.size() ? State.Scene.Edges[Index].Body : ~0u)
+                                                             : (Index < State.Scene.Faces.size() ? State.Scene.Faces[Index].Body : ~0u);
+        if (BodyAt < State.Scene.Bodies.size() && SolidArcLockedCondition(State.Document, State.Scene.Bodies[BodyAt].Key))
+        {
+            Announce(State, State.Scene.Bodies[BodyAt].Caption + " is locked (Outliner lock to unlock)");
+            return;
+        }
+    }
+    if (Identity == 0)
+    {
+        if (Intent == SolidArcPickIntent::Replace && (!State.Document.Selection.Faces.empty() || !State.Document.Selection.Edges.empty()
+                                                      || !State.Document.Selection.Curves.empty() || !State.Document.Selection.Bodies.empty()))
+        {
+            ClearSolidArcSelection(State.Document);
+            Announce(State, "Selection cleared");
+        }
+        return;
+    }
+    if (State.PickMode == SolidArcPickMode::Solid)
+    {
+        // Mode 4 (solid): the body under the pointer, by its key. Shift adds (pick order = Boolean order), Ctrl removes.
+        const uint32_t Index   = (Identity & ~IdentityEdgeBit) - 1u;
+        const uint32_t BodyAt  = (Identity & IdentityEdgeBit) ? (Index < State.Scene.Edges.size() ? State.Scene.Edges[Index].Body : ~0u)
+                                                              : (Index < State.Scene.Faces.size() ? State.Scene.Faces[Index].Body : ~0u);
+        if (BodyAt >= State.Scene.Bodies.size()) return;
+        const SolidArcSceneBody&        Body     = State.Scene.Bodies[BodyAt];
+        const std::vector<std::string>& Picked   = State.Document.Selection.Bodies;
+        const bool                      Member   = std::find(Picked.begin(), Picked.end(), Body.Key) != Picked.end();
+        if (Intent == SolidArcPickIntent::Replace)
+        {
+            SelectSolidArcName(State.Document, SolidArcSelectionKind::Body, Body.Key, false);
+            State.Outliner.AnchorKey = Body.Key;
+            Announce(State, Compose("Selected %s (%d faces)", Body.Caption.c_str(), int(Body.FaceCount)));
+        }
+        else if (Intent == SolidArcPickIntent::Add)
+        {
+            if (!Member) SelectSolidArcName(State.Document, SolidArcSelectionKind::Body, Body.Key, true);
+            if (State.Outliner.AnchorKey.empty()) State.Outliner.AnchorKey = Body.Key;
+            Announce(State, Compose("Added %s · %d bodies picked", Body.Caption.c_str(), int(State.Document.Selection.Bodies.size())));
+        }
+        else
+        {
+            SelectSolidArcName(State.Document, SolidArcSelectionKind::Body, Body.Key, true);
+            if (!Member && State.Outliner.AnchorKey.empty()) State.Outliner.AnchorKey = Body.Key;
+            Announce(State, Member ? ("Removed " + Body.Caption) : Compose("Added %s · %d bodies picked", Body.Caption.c_str(), int(State.Document.Selection.Bodies.size())));
+        }
+        return;
+    }
+    const std::string           Name = NameSolidArcIdentity(State.Scene, Identity);
+    const SolidArcSelectionKind Kind = SolidArcIdentityKind(Identity);
+    // The body under the pointer: a cut's two pieces carry the same names, so the pick remembers which one it was.
+    const uint32_t    PickIndex = (Identity & ~IdentityEdgeBit) - 1u;
+    const uint32_t    PickBody  = (Identity & IdentityEdgeBit) ? (PickIndex < State.Scene.Edges.size() ? State.Scene.Edges[PickIndex].Body : ~0u)
+                                                               : (PickIndex < State.Scene.Faces.size() ? State.Scene.Faces[PickIndex].Body : ~0u);
+    const std::string PickKey   = PickBody < State.Scene.Bodies.size() ? State.Scene.Bodies[PickBody].Key : std::string{};
+    const auto Member = [&](const std::string& Candidate)
+    {
+        const std::vector<std::string>& Names = Kind == SolidArcSelectionKind::Edge ? State.Document.Selection.Edges : State.Document.Selection.Faces;
+        return std::find(Names.begin(), Names.end(), Candidate) != Names.end();
+    };
+    switch (Intent)
+    {
+    case SolidArcPickIntent::Replace:
+        SelectSolidArcName(State.Document, Kind, Name, false, PickKey);
+        if (!PickKey.empty()) State.Outliner.AnchorKey = PickKey;
+        Announce(State, "Selected " + Name);
+        break;
+    case SolidArcPickIntent::Add:
+        if (!Member(Name)) SelectSolidArcName(State.Document, Kind, Name, true, PickKey);
+        if (State.Outliner.AnchorKey.empty() && !PickKey.empty()) State.Outliner.AnchorKey = PickKey;
+        Announce(State, "Added " + Name);
+        break;
+    case SolidArcPickIntent::Remove:
+        // Ctrl on an unpicked edge with edges picked (same body): Blender's path pick; on a picked one: Plasticity's remove.
+        if (Kind == SolidArcSelectionKind::Edge && !Member(Name) && !State.Document.Selection.Edges.empty()
+            && (State.Document.Selection.PickedBody.empty() || PickKey.empty() || State.Document.Selection.PickedBody == PickKey))
+        {
+            PickEdgePath(State, Name, PickKey);
+            break;
+        }
+        if (Member(Name))
+        {
+            SelectSolidArcName(State.Document, Kind, Name, true);
+            Announce(State, "Removed " + Name);
+        }
+        else
+        {
+            SelectSolidArcName(State.Document, Kind, Name, true, PickKey);
+            if (State.Outliner.AnchorKey.empty() && !PickKey.empty()) State.Outliner.AnchorKey = PickKey;
+            Announce(State, "Added " + Name);
+        }
+        break;
+    case SolidArcPickIntent::Loop:
+    case SolidArcPickIntent::LoopToggle:
+    case SolidArcPickIntent::Ring:
+    case SolidArcPickIntent::RingToggle:
+    case SolidArcPickIntent::Chain:
+        PickEdgeWalk(State, Kind, Name, Intent, PickKey);
+        break;
+    }
+}
+
+// Curves wholly inside the screen box, appended in feature-tree order (the import order of sections).
+void SelectInBox(SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, ImVec2 Corner, ImVec2 Opposite, SolidArcPickIntent Intent)
+{
+    const ImVec2 Low(std::min(Corner.x, Opposite.x), std::min(Corner.y, Opposite.y));
+    const ImVec2 High(std::max(Corner.x, Opposite.x), std::max(Corner.y, Opposite.y));
+    if (Intent == SolidArcPickIntent::Replace) ClearSolidArcSelection(State.Document);
+    int Count = 0;
+    for (const FeatureStep& Step : State.Document.Tree.Steps)
+    {
+        const CurveFitOutcome* Fit = Step.Kind == FeatureStepKind::SpaceCurve ? FindFittedCurve(State.Document, Step.Label) : nullptr;
+        if (!Fit || !CurveReachableCondition(State.Document, Step.Label)) continue;
+        const std::vector<ImVec2> Pixels = ProjectFittedCurve(State, Frame, *Fit->Curve.Definition);
+        if (int(Pixels.size()) != CurveSamples + 1) continue;                               // Partly off screen / behind the eye
+        const bool Inside = std::all_of(Pixels.begin(), Pixels.end(), [&](ImVec2 Pixel) { return Pixel.x >= Low.x && Pixel.x <= High.x && Pixel.y >= Low.y && Pixel.y <= High.y; });
+        if (!Inside) continue;
+        const bool Member = CurveOrder(State, Step.Label) > 0;
+        if (Intent == SolidArcPickIntent::Remove ? Member : !Member) SelectSolidArcCurve(State.Document, Step.Label, true);
+        ++Count;
+    }
+    // B-rep edges (modes 2 / 5): wholly inside the box; hidden ones only in x-ray.
+    State.Box.Edges = 0;
+    if (State.PickMode != SolidArcPickMode::ControlPoint && State.PickMode!=SolidArcPickMode::Curve)
+    {
+        const std::array<double, 2> LocalLow{ Low.x - State.ViewportRect[0], Low.y - State.ViewportRect[1] };
+        const std::array<double, 2> LocalHigh{ High.x - State.ViewportRect[0], High.y - State.ViewportRect[1] };
+        for (const uint32_t Index : EncloseSolidArcEdges(State.Scene, Frame, LocalLow, LocalHigh, State.Style.XRayEnabled, ActiveSectionClip(State)))
+        {
+            const std::string& Name = State.Scene.Edges[Index].Name;
+            const uint32_t     Body = State.Scene.Edges[Index].Body;
+            if (Body < State.Scene.Bodies.size() && SolidArcLockedCondition(State.Document, State.Scene.Bodies[Body].Key)) continue;   // Locked body
+            const std::vector<std::string>& Edges = State.Document.Selection.Edges;
+            const bool Member = std::find(Edges.begin(), Edges.end(), Name) != Edges.end();
+            if (Intent == SolidArcPickIntent::Remove ? Member : !Member) SelectSolidArcName(State.Document, SolidArcSelectionKind::Edge, Name, true, Body < State.Scene.Bodies.size() ? State.Scene.Bodies[Body].Key : std::string{});
+            ++State.Box.Edges;
+        }
+    }
+    ++State.Box.Commits;
+    const char* Verb = Intent == SolidArcPickIntent::Remove ? "removed" : "selected";
+    if (State.Box.Edges > 0)
+        Announce(State, Compose("Box %s %d curve(s) + %d edge(s)%s · %d edge(s) selected", Verb, Count, State.Box.Edges, State.Style.XRayEnabled ? " (x-ray)" : "",
+                                int(State.Document.Selection.Edges.size())));
+    else
+        Announce(State, Compose("Box %s %d curve(s) · %d selected", Verb, Count, int(State.Document.Selection.Curves.size())));
+}
+
+SolidArcPickIntent PickIntentOf(const ImGuiIO& Io)
+{
+    if (Io.KeyAlt && Io.KeyCtrl) return Io.KeyShift ? SolidArcPickIntent::RingToggle : SolidArcPickIntent::Ring;     // Blender: Ctrl+Alt ring
+    if (Io.KeyAlt) return Io.KeyShift ? SolidArcPickIntent::LoopToggle : SolidArcPickIntent::Loop;                   // Blender: Alt loop
+    if (Io.KeyCtrl) return SolidArcPickIntent::Remove;
+    if (!Io.KeyShift && Io.MouseClickedLastCount[ImGuiMouseButton_Left] >= 2) return SolidArcPickIntent::Chain;     // Double-click: tangent chain
+    if (Io.KeyShift) return SolidArcPickIntent::Add;
+    return SolidArcPickIntent::Replace;
+}
