+type 0.25
+key Enter
+frames 8
+expect bevel-size ~ 0.25
+expect bevel-pinned == 1
+drag left @BevelHandle1 by 30 -30 6
+frames 8
+expect bevel-corners == 1
+expect bevel-variable == 0
+expect bevel-corner-1 != 0.25
+expect bevel-corner-2 ~ 0.25
+expect bevel-refusal == 0
+capture 277BevelCornerDragged
+
+# ⑤ the card's corner field: Corner 1 typed 0.4 → the 0.4 → 0.25 variable fillet (the V taper's body)
+click @BevelCornerSize
+key A Ctrl
+type 0.4
+key Enter
+frames 8
+expect bevel-corners == 1
+expect bevel-corner-1 ~ 0.4
+expect bevel-refusal == 0
+capture 278BevelCornerTyped
+key Enter
+frames 3
+expect bevel-active == 0
+expect refused == 0
+expect sound == 1
+expect status contains corner size
+
+# ⑥ a 0.2 m cube: the last size (0.25) would not fit, so B starts at the fitted 0.02 and shows it at once
+key N Ctrl
+frames 3
+click @ConstructLauncher
+frames 2
+click @ConstructBlock
+frames 2
+move world -0.1 -0.1 0.0
+frames 2
+click world -0.1 -0.1 0.0
+frames 2
+move world 0.1 0.1 0.0
+frames 2
+click world 0.1 0.1 0.0
+frames 2
