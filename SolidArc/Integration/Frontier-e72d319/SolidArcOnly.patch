+_ClaudeScratch/build/GeometryProcessing/PatternStressValidation --export _ClaudeScratch/tmp/meshes
+python Exhibits/GeometryProcessing/Code/Tooling/ShowcaseComposer.py --meshes _ClaudeScratch/tmp/meshes
