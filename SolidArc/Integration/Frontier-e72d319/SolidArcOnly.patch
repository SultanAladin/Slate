+              Format("Perspective gizmo drag moved %.2f m along X with depth-compensated Riding.Size (post-drag scale error = %.4f px)",
+                     Length(Ui.State.Gizmo.Pose.Origin - GizmoOrigin), PostDragJitterPx));
+    }
