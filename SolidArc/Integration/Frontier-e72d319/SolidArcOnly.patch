+constexpr float CardSpacing   = 10.0f;                                                       // [px] - .inspector-card margin-bottom
+constexpr float CardRounding  = 22.0f;                                                       // [px] - .inspector-card border-radius
+constexpr float CardInset     = 18.0f;                                                       // [px] - .inspector-card padding
