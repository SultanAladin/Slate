+    if (Pressed(ImGuiKey_5) || Pressed(ImGuiKey_Tab)) State.PickMode = SolidArcPickMode::Any;
+    if (Pressed(ImGuiKey_B)) OpenBevelSession(State, BlendProfile::Fillet);
