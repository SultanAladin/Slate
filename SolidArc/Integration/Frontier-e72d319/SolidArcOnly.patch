+void DrawTransformSessionCard(SolidArcWorkspaceState& State)
+{
+    SolidArcTransformSession& Transform = State.Transform;
+    const char* Heading = Transform.DuplicateCondition ? "Duplicate + Move"
+                        : Transform.Verb == SolidArcTransformVerb::Move ? "Move (G)"
+                        : Transform.Verb == SolidArcTransformVerb::Rotate ? "Rotate (R)" : "Scale (S)";
+    BeginCard(Heading);
+
+    // Verb switcher: Move (G) · Rotate (R) · Scale (S)
+    const float Third = (ImGui::GetContentRegionAvail().x - 16.0f) / 3.0f;
+    if (ToggleButton(State, "Move (G)###TransVerbG", Transform.Verb == SolidArcTransformVerb::Move, ImVec2(Third, 0)))
+    {
+        Transform.Verb            = SolidArcTransformVerb::Move;
+        Transform.StagedCondition = false;
+    }
+    ImGui::SameLine();
+    if (ToggleButton(State, "Rotate (R)###TransVerbR", Transform.Verb == SolidArcTransformVerb::Rotate, ImVec2(Third, 0)))
+    {
+        Transform.Verb            = SolidArcTransformVerb::Rotate;
+        Transform.PlaneCondition  = false;
+        Transform.StagedCondition = false;
+    }
+    ImGui::SameLine();
+    if (ToggleButton(State, "Scale (S)###TransVerbS", Transform.Verb == SolidArcTransformVerb::Scale, ImVec2(Third, 0)))
+    {
+        Transform.Verb            = SolidArcTransformVerb::Scale;
+        Transform.StagedCondition = false;
+    }
+
+    // Single-axis lock buttons (isolates that axis gizmo handle + viewport guide line).
+    const float Quarter = (ImGui::GetContentRegionAvail().x - 24.0f) / 4.0f;
+    if (ToggleButton(State, "Free###TransAxisFree", Transform.Axis < 0, ImVec2(Quarter, 0)))
+    {
+        Transform.Axis            = -1;
+        Transform.PlaneCondition  = false;
+        Transform.StagedCondition = false;
+    }
+    static const char* AxisLabels[3] = { "X###TransAxisX", "Y###TransAxisY", "Z###TransAxisZ" };
+    for (int Axis = 0; Axis < 3; ++Axis)
+    {
+        ImGui::SameLine();
+        if (ToggleButton(State, AxisLabels[Axis], Transform.Axis == Axis && !Transform.PlaneCondition, ImVec2(Quarter, 0)))
+        {
+            if (Transform.Axis == Axis && !Transform.PlaneCondition) Transform.Axis = -1;
+            else { Transform.Axis = Axis; Transform.PlaneCondition = false; }
+            Transform.StagedCondition = false;
+        }
+    }
+
+    // Sync editable numeric field from either Typed string or live mouse-dragged CurrentValue when not actively typing in the widget.
+    const ImGuiID InputId = ImGui::GetID("###TransformAmount");
+    if (ImGui::GetActiveID() != InputId)
+    {
+        const std::string Shown = !Transform.Typed.empty() ? Transform.Typed : FormatLength(Transform.CurrentValue);
+        std::snprintf(Transform.ValueText.data(), Transform.ValueText.size(), "%s", Shown.c_str());
+    }
+    const char* FieldCaption = Transform.Verb == SolidArcTransformVerb::Move ? "Distance (m)###TransformAmount"
+                             : Transform.Verb == SolidArcTransformVerb::Rotate ? "Angle (deg)###TransformAmount"
+                             : "Factor###TransformAmount";
+    ImGui::SetNextItemWidth(115.0f);
+    const bool CommittedEnter = ImGui::InputText(FieldCaption, Transform.ValueText.data(), Transform.ValueText.size(), ImGuiInputTextFlags_EnterReturnsTrue);
+    if (ImGui::IsItemEdited() || CommittedEnter)
+    {
+        double Parsed = 0.0;
+        if (ParseSolidArcLength(Transform.ValueText.data(), Parsed))
+        {
+            char Clean[48];
+            std::snprintf(Clean, sizeof(Clean), "%.8g", std::abs(Parsed) < 1.0e-12 ? 0.0 : Parsed);
+            Transform.Typed = Clean;
+            if (Transform.Axis < 0 && Transform.Verb == SolidArcTransformVerb::Move) Transform.Axis = 0;
+            Transform.StagedCondition = false;
+        }
+    }
+    RegisterWidget(State, "TransformAmount");
+    ImGui::SameLine();
+    if (PressButton(State, "Mouse###TransformMouse", ImVec2(0, 0), !Transform.Typed.empty()))
+    {
+        Transform.Typed.clear();
+        Transform.StagedCondition = false;
+    }
+
+    if (PressButton(State, "Apply (Enter)###TransformApply", RowSpan()))
+    {
+        ApplyTransformSession(State);
+        EndCard();
+        return;
+    }
+    ImGui::SameLine();
+    if (PressButton(State, "Cancel (Esc)###TransformCancel", RowSpan()))
+    {
+        CancelTransformSession(State);
+        EndCard();
+        return;
+    }
+    if (CommittedEnter)
+    {
+        // Re-evaluate map immediately from the newly committed Typed value before applying.
+        const OrbitCameraFrame CurFrame = FrameOrbitCamera(State.Camera, std::max(1.0f, State.ViewportRect[2]), std::max(1.0f, State.ViewportRect[3]));
+        DriveTransformSession(State, CurFrame, ImVec2(0.0f, 0.0f));
+        ApplyTransformSession(State);
+    }
+    EndCard();
+}
+
+void DrawBevelCard(SolidArcWorkspaceState& State)
+{
+    SolidArcBevelSession& Bevel   = State.Bevel;
+    const bool            Profile = Bevel.Verb == SolidArcSessionVerb::Profile;
+    const bool            Inset   = Bevel.Verb == SolidArcSessionVerb::Inset;
+    const bool            Extrude = Bevel.Verb == SolidArcSessionVerb::Extrude || Profile || Inset;
+    const bool            Corner  = Bevel.Verb == SolidArcSessionVerb::Corner;
+    BeginCard(Inset ? "Inset" : Profile ? "Extrude sketch" : Extrude ? "Extrude" : Corner ? "Sketch corners" : "Bevel");
+    if (Inset)
+    {
+        // The pointer drives one value: D the inset distance, H the depth of the inner face (+ boss, − pocket).
+        if (ToggleButton(State, "Distance  (D)###InsetDistance", !Bevel.DepthEnabled, RowSpan())) Bevel.DepthEnabled = false;
+        ImGui::SameLine();
+        if (ToggleButton(State, "Depth  (H)###InsetDepth", Bevel.DepthEnabled, RowSpan())) Bevel.DepthEnabled = true;
+    }
+    if (Profile)
+    {
+        // Plasticity extrude Boolean keys: q union · w difference · e intersect · r new body.
+        static const struct { const char* Label; FeatureCombination Combination; } Choices[] = {
+            { "Union (Q)###ProfileUnion", FeatureCombination::Union }, { "Difference (W)###ProfileDifference", FeatureCombination::Difference },
+            { "Intersect (E)###ProfileIntersect", FeatureCombination::Intersection }, { "New body (R)###ProfileNew", FeatureCombination::Separate } };
+        for (int Index = 0; Index < 4; ++Index)
+        {
+            if (Index % 2 == 1) ImGui::SameLine();
+            if (ToggleButton(State, Choices[Index].Label, !Bevel.AutoCombinationCondition && Bevel.Combination == Choices[Index].Combination, RowSpan()))
+                ChooseProfileCombination(State, Choices[Index].Combination);
+        }
+        if (Bevel.ProfileMaterial != 0)
+        {
+            // Blender's extrude manifold: the drag direction picks the Boolean (in = cut, out = add).
+            if (ToggleButton(State, "Auto: in cuts, out adds (A)###ProfileAuto", Bevel.AutoCombinationCondition, ImVec2(-1, 0))) ChooseProfileAutomatic(State);
+            RegisterWidget(State, "ProfileAuto");
+        }
+    }
+    if (!Extrude)
+    {
+        if (ToggleButton(State, "Fillet  (D)###BevelFillet", Bevel.Shape == BlendProfile::Fillet, RowSpan())) Bevel.Shape = BlendProfile::Fillet;
+        ImGui::SameLine();
+        if (ToggleButton(State, "Chamfer  (C)###BevelChamfer", Bevel.Shape == BlendProfile::Chamfer, RowSpan())) Bevel.Shape = BlendProfile::Chamfer;
+    }
+    ImGui::SetNextItemWidth(110);
+    if (ImGui::InputText(Extrude ? "Distance###BevelSize" : Bevel.Shape == BlendProfile::Fillet ? "Radius###BevelSize" : "Setback###BevelSize", Bevel.SizeText.data(),
+                         Bevel.SizeText.size(), ImGuiInputTextFlags_EnterReturnsTrue))
+    {
+        double Parsed = 0.0;
+        if (ParseSolidArcLength(Bevel.SizeText.data(), Parsed) && Parsed != 0.0)
+        {
+            if (Parsed < 0.0 && !Extrude) Bevel.Shape = BlendProfile::Chamfer;
+            const double Wanted   = Extrude && !Inset ? Parsed : std::max(1.0e-3, std::abs(Parsed));
+            Bevel.Size            = Extrude ? Wanted : BoundBevelValue(State, 0, Wanted);
+            Bevel.PinnedCondition = true;
+            if (Bevel.Size != Wanted) Announce(State, Compose("Bevel size %s m is past the largest these edges take: held at %s m", FormatLength(Wanted).c_str(), FormatLength(Bevel.Size).c_str()));
+            else Announce(State, Compose(Inset ? "Inset distance %s m (pinned)" : "Bevel size %s m (pinned)", FormatLength(Bevel.Size).c_str()));
+        }
+        else
+        {
+            Announce(State, std::string("Unreadable size: ") + Bevel.SizeText.data());
+        }
+        WriteBevelText(Bevel);
+    }
+    else if (ImGui::IsItemEdited()) Bevel.SizeTypedCondition = true;
+    RegisterWidget(State, "BevelSize");
+    ImGui::SameLine();
+    if (PressButton(State, "Mouse adjust###BevelMouse", ImVec2(0, 0), Bevel.PinnedCondition)) Bevel.PinnedCondition = false;
+    if (Inset)
+    {
+        ImGui::SetNextItemWidth(110);
+        if (ImGui::InputText("Depth###InsetDepthText", Bevel.DepthText.data(), Bevel.DepthText.size(), ImGuiInputTextFlags_EnterReturnsTrue))
+        {
+            double Parsed = 0.0;
+            if (ParseSolidArcLength(Bevel.DepthText.data(), Parsed))
+            {
+                Bevel.Depth = Parsed;
+                Announce(State, Compose("Inset depth %s m", FormatLength(Bevel.Depth).c_str()));
+            }
+            else
+            {
+                Announce(State, std::string("Unreadable depth: ") + Bevel.DepthText.data());
+            }
+            WriteBevelText(Bevel);
+        }
+        RegisterWidget(State, "InsetDepthText");
+        ImGui::PushStyleColor(ImGuiCol_Text, Tint(MutedColour));
+        ImGui::TextWrapped("Border ring %s m wide · inner face %s m along the normal (0 = flat split, − pocket)", FormatLength(Bevel.Size).c_str(), FormatLength(Bevel.Depth).c_str());
+        ImGui::PopStyleColor();
+    }
+    if (!Extrude && !Corner)
+    {
+        // Variable size (V): the end size field and the anchor flip (F).
+        if (ToggleButton(State, "Variable  (V)###BevelVariable", Bevel.VariableEnabled, RowSpan())) ToggleBevelVariable(State);
+        if (Bevel.VariableEnabled)
+        {
+            ImGui::SameLine();
+            if (PressButton(State, "Flip anchor  (F)###BevelFlip", RowSpan())) FlipBevelAnchor(State);
+            ImGui::SetNextItemWidth(110);
+            if (ImGui::InputText("End size###BevelEndSize", Bevel.EndSizeText.data(), Bevel.EndSizeText.size(), ImGuiInputTextFlags_EnterReturnsTrue))
+            {
+                double Parsed = 0.0;
+                if (ParseSolidArcLength(Bevel.EndSizeText.data(), Parsed) && Parsed > 0.0)
+                {
+                    Bevel.EndSize = Parsed;
+                    Announce(State, Compose("Bevel end size %s m", FormatLength(Bevel.EndSize).c_str()));
+                }
+                else
+                {
+                    Announce(State, std::string("Unreadable end size: ") + Bevel.EndSizeText.data());
+                }
+                WriteBevelText(Bevel);
+            }
+            RegisterWidget(State, "BevelEndSize");
+            ImGui::PushStyleColor(ImGuiCol_Text, Tint(MutedColour));
+            ImGui::TextWrapped("%s m at each edge's %s corner → %s m at the other", FormatLength(Bevel.Size).c_str(), Bevel.ReversedCondition ? "end" : "start",
+                               FormatLength(Bevel.EndSize).c_str());
+            ImGui::PopStyleColor();
+        }
+    }
+    if (!Extrude && !Corner && Bevel.Handles.size() > 1)
+    {
+        // Handles: the ring sets the size, each diamond its corner's own size (variable); the last dragged corner can be typed.
+        const int Corners = CountBevelCorners(Bevel);
+        ImGui::PushStyleColor(ImGuiCol_Text, Tint(MutedColour));
+        if (Corners == 0) ImGui::TextWrapped("Handles: drag the ring for the size, a diamond for that corner's own size (variable fillet / chamfer)");
+        else ImGui::TextWrapped("Variable: %d of %d corner(s) sized · the others follow %s m", Corners, int(Bevel.Handles.size()) - 1, FormatLength(Bevel.Size).c_str());
+        ImGui::PopStyleColor();
+        if (Bevel.FocusCorner > 0 && Bevel.FocusCorner < int(Bevel.CornerSizes.size()))
+        {
+            ImGui::SetNextItemWidth(110);
+            if (ImGui::InputText(Compose("Corner %d###BevelCornerSize", Bevel.FocusCorner).c_str(), Bevel.CornerText.data(), Bevel.CornerText.size(), ImGuiInputTextFlags_EnterReturnsTrue))
+            {
+                double Parsed = 0.0;
+                if (ParseSolidArcLength(Bevel.CornerText.data(), Parsed) && Parsed > 0.0)
+                {
+                    Parsed = BoundBevelValue(State, Bevel.FocusCorner, std::max(1.0e-3, Parsed));
+                    Bevel.CornerSizes[size_t(Bevel.FocusCorner)] = Parsed;
+                    Bevel.PinnedCondition = true;
+                    Announce(State, Compose("Corner %d: %s m", Bevel.FocusCorner, FormatLength(Parsed).c_str()));
+                }
+                else Announce(State, std::string("Unreadable corner size: ") + Bevel.CornerText.data());
+            }
+            RegisterWidget(State, "BevelCornerSize");
+        }
+        if (Corners > 0)
+        {
+            if (Bevel.FocusCorner > 0) ImGui::SameLine();
+            if (PressButton(State, "Even out###BevelCornersReset", ImVec2(0, 0)))
+            {
+                std::fill(Bevel.CornerSizes.begin(), Bevel.CornerSizes.end(), 0.0);
+                Bevel.FocusCorner = -1;
+                Announce(State, "Corner sizes cleared: one size again");
+            }
+        }
+    }
+    ImGui::PushStyleColor(ImGuiCol_Text, Tint(MutedColour));
+    const std::vector<std::string>& Operands = Extrude ? State.Document.Selection.Faces : State.Document.Selection.Edges;
+    if (Profile)
+    {
+        const auto Caption = State.Document.Captions.find(Bevel.ProfileLabel);
+        ImGui::TextWrapped("Profile: %s (%s)", Caption != State.Document.Captions.end() ? Caption->second.c_str() : "-", Bevel.ProfileLabel.c_str());
+        if (ProfileStart(Bevel) < 0.0)
+            ImGui::TextWrapped("On a curved face: starts %s inside it, so the union closes", FormatLength(Bevel.ProfileSink).c_str());
+    }
+    else if (Corner)
+    {
+        std::string Owners;
+        for (const std::string& Sketch : Bevel.Corner.Sketches)
+        {
+            const auto Caption = State.Document.Captions.find(Sketch);
+            Owners += (Owners.empty() ? "" : ", ") + (Caption != State.Document.Captions.end() ? Caption->second : Sketch);
+        }
+        ImGui::TextWrapped("%s of %s · lines meeting at a corner get a %s", Bevel.Corner.Points.empty() ? "Every corner" : Compose("%d picked corner(s)", int(Bevel.Corner.Points.size())).c_str(),
+                           Owners.c_str(), Bevel.Shape == BlendProfile::Fillet ? "tangent arc" : "straight cut");
+    }
+    else ImGui::TextWrapped("%d %s: %s", int(Operands.size()), Extrude ? "face(s)" : "edge(s)", Operands.empty() ? "-" : Operands.front().c_str());
+    ImGui::TextUnformatted("Units: 250mm, -25cm, 0.25m, 1in, 1ft");
+    ImGui::PopStyleColor();
+    if (BevelBoundedCondition(Bevel) && (Bevel.LimitProbeCondition || BevelLimitOf(State, Bevel.LimitParameter) > 0.0))
+    {
+        ImGui::PushStyleColor(ImGuiCol_Text, Tint(MutedColour));
+        const std::string Subject = Bevel.LimitParameter == 0 ? std::string("size") : Compose("corner %d", Bevel.LimitParameter);
+        if (Bevel.LimitProbeCondition) ImGui::TextWrapped("Finding the largest %s these edges take (%s … %s m)", Subject.c_str(), FormatLength(Bevel.LimitGood).c_str(), FormatLength(Bevel.LimitCeiling).c_str());
+        else ImGui::TextWrapped("Max %s %s m · dragging and typing stop there", Subject.c_str(), FormatLength(Bevel.LimitGood).c_str());
+        ImGui::PopStyleColor();
+    }
+    if (!Bevel.Refusal.empty() && !Bevel.LimitProbeCondition)
+    {
+        ImGui::PushStyleColor(ImGuiCol_Text, Tint(RefusalColour));
+        ImGui::TextWrapped("Refused: %s", Bevel.Refusal.c_str());
+        ImGui::PopStyleColor();
+    }
+    else if (Bevel.Preview)
+    {
+        // Staged from the document's checkpoints: only the new blend replays ("replayed 1/9").
+        const int PreviewSteps = static_cast<int>(Bevel.Preview->Tree.Steps.size());
+        ImGui::Text("Preview: %d faces · %.4f m³ · replayed %d/%d", Bevel.Preview->Summary.Faces, Bevel.Preview->Summary.Volume,
+                    PreviewSteps - std::min(PreviewSteps, Bevel.Preview->Regeneration.Resumed), PreviewSteps);
+    }
+    if (PressButton(State, "Apply###BevelApply", RowSpan(), Bevel.Refusal.empty())) ApplyBevelSession(State);
+    ImGui::SameLine();
+    if (PressButton(State, "Cancel###BevelCancel", RowSpan())) CancelBevelSession(State);
+    EndCard();
+}
