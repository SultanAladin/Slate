+// Box of one scene body's facets; false when the scene does not show it.
+bool MeasureSceneBody(const SolidArcScene& Scene, const std::string& Key, Vector3& Low, Vector3& High)
+{
+    const auto Body = std::find_if(Scene.Bodies.begin(), Scene.Bodies.end(), [&](const SolidArcSceneBody& Each) { return Each.Key == Key; });
+    if (Body == Scene.Bodies.end() || Body->FaceCount == 0) return false;
+    Low  = { 1.0e300, 1.0e300, 1.0e300 };
+    High = { -1.0e300, -1.0e300, -1.0e300 };
+    for (uint32_t Face = Body->FirstFace; Face < Body->FirstFace + Body->FaceCount; ++Face)
+        for (uint32_t Corner = Scene.Faces[Face].FirstCorner; Corner < Scene.Faces[Face].FirstCorner + Scene.Faces[Face].CornerCount; ++Corner)
+        {
+            const float* Point = Scene.Corners[Corner].Position;
+            Low  = { std::min(Low.X, double(Point[0])), std::min(Low.Y, double(Point[1])), std::min(Low.Z, double(Point[2])) };
+            High = { std::max(High.X, double(Point[0])), std::max(High.Y, double(Point[1])), std::max(High.Z, double(Point[2])) };
+        }
+    return true;
+}
+
+// The body key of the face a scene pick landed on ("" for edges, caps and background).
+[[nodiscard]] std::string PickedSceneBody(const SolidArcScene& Scene, const std::optional<SolidArcPick>& Pick)
+{
+    if (!Pick || Pick->Identity == 0 || Pick->Identity == IdentitySectionCap || (Pick->Identity & IdentityEdgeBit)) return {};
+    const uint32_t Face = Pick->Identity - 1u;
+    if (Face >= Scene.Faces.size() || Scene.Faces[Face].Body >= Scene.Bodies.size()) return {};
+    return Scene.Bodies[Scene.Faces[Face].Body].Key;
+}
+
+// 📝 Lift of a cutter top above its plane: 1 % of the target's size (≥ 1 mm) so a flush face is cleared, never touched.
+[[nodiscard]] double KnifeLift(const SolidArcScene& Scene, const std::string& Target)
+{
+    Vector3 Low, High;
+    if (!MeasureSceneBody(Scene, Target, Low, High)) return 1.0e-3;
+    return std::max(1.0e-3, 0.01 * std::max({ High.X - Low.X, High.Y - Low.Y, High.Z - Low.Z }));
+}
+
+// 💡 The body a sketch cutter cuts: the owner of the face it was drawn on, else the first body met by a ray down the
+//    sketch normal through the middle of its curves (from just above the plane, then from outside the scene), else the
+//    first picked body, else the only body.
+[[nodiscard]] std::string KnifeSketchTarget(const SolidArcWorkspaceState& State, const std::string& Label)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    if (!Knife.Face.empty())
+    {
+        const std::string Owner = SolidArcBodyOfName(State.Document, SolidArcSelectionKind::Face, Knife.Face);
+        if (!Owner.empty()) return Owner;
+    }
+    const auto Step   = std::find_if(State.Document.Tree.Steps.begin(), State.Document.Tree.Steps.end(), [&](const FeatureStep& Each) { return Each.Label == Label; });
+    const auto Solved = State.Document.Regeneration.Sketches.find(Label);
+    if (Step != State.Document.Tree.Steps.end() && Solved != State.Document.Regeneration.Sketches.end())
+    {
+        Vector2 Sum{};
+        int     Count = 0;
+        for (const SketchCurve& Curve : Solved->second.Curves)
+        {
+            if (Curve.Construction) continue;
+            for (const Vector2& Sample : SampleSketchCurve(Solved->second, Curve)) { Sum = Sum + Sample; ++Count; }
+        }
+        if (Count > 0)
+        {
+            const OrthonormalFrame Plane  = ElevatedSketchPlane(State.Document, *Step);
+            const Vector3          Middle = PlacePlanePoint(Plane, Sum * (1.0 / Count));
+            const double           Reach  = 2.0 * std::hypot(State.Scene.BoundsHigh[0] - State.Scene.BoundsLow[0], State.Scene.BoundsHigh[1] - State.Scene.BoundsLow[1],
+                                                             State.Scene.BoundsHigh[2] - State.Scene.BoundsLow[2]) + 1.0;
+            for (const double Height : { 1.0e-3, Reach })
+            {
+                const Vector3 Start = Middle + Plane.ZAxis * Height;
+                OrbitRay      Ray;
+                Ray.Origin    = { Start.X, Start.Y, Start.Z };
+                Ray.Direction = { -Plane.ZAxis.X, -Plane.ZAxis.Y, -Plane.ZAxis.Z };
+                const std::string Owner = PickedSceneBody(State.Scene, PickSolidArcScene(State.Scene, Ray, 0.0, false, nullptr));
+                if (!Owner.empty()) return Owner;
+            }
+        }
+    }
+    if (!BooleanTarget(State).empty()) return BooleanTarget(State);
+    return State.Scene.Bodies.size() == 1 ? State.Scene.Bodies.front().Key : std::string{};
+}
+
+// 💡 A knife line (an open chain: a segment or polyline drawn across a face, edge to edge) has no inside to pocket: it
+//    slices. The body splits along the sheet the chain sweeps through it (Plasticity C, CutSolidArcBody): two bodies,
+//    through, whatever the depth or the Boolean says. Only a branching chain still refuses.
+[[nodiscard]] bool KnifeSliceCondition(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.Mode != SolidArcKnifeMode::Sketch || Knife.Sketch.empty()) return false;
+    const auto Solved = State.Document.Regeneration.Sketches.find(Knife.Sketch);
+    if (Solved == State.Document.Regeneration.Sketches.end()) return false;
+    return ExtractSketchProfile(Solved->second).Refusal.rfind("open profile", 0) == 0;
+}
+
+// Sketch cutter span along the plane normal: Cut / Intersect / Separate from a lift above the plane down to the depth
+// (through: past both sides of the target); Add rises from just inside the face up to the depth (a boss). A slice
+// spans the body (through).
+void KnifeSketchSpan(const SolidArcWorkspaceState& State, const std::string& Target, double& Top, double& Bottom)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    const double Lift  = KnifeLift(State.Scene, Target);
+    const bool   Slice = KnifeSliceCondition(State);
+    Top    = Lift;
+    Bottom = -Knife.Depth;
+    if (Knife.Combination == FeatureCombination::Union && !Slice) { Top = Knife.Depth; Bottom = -Lift; return; }
+    if (!Knife.ThroughCondition && !Slice) return;
+    const auto Step = std::find_if(State.Document.Tree.Steps.begin(), State.Document.Tree.Steps.end(), [&](const FeatureStep& Each) { return Each.Label == Knife.Sketch; });
+    const auto Body = std::find_if(State.Scene.Bodies.begin(), State.Scene.Bodies.end(), [&](const SolidArcSceneBody& Each) { return Each.Key == Target; });
+    if (Step == State.Document.Tree.Steps.end() || Body == State.Scene.Bodies.end()) return;
+    const OrthonormalFrame Plane = ElevatedSketchPlane(State.Document, *Step);
+    double Above = 0.0, Below = 0.0;                                                         // [len] - Body reach either side of the plane
+    for (uint32_t Face = Body->FirstFace; Face < Body->FirstFace + Body->FaceCount; ++Face)
+        for (uint32_t Corner = State.Scene.Faces[Face].FirstCorner; Corner < State.Scene.Faces[Face].FirstCorner + State.Scene.Faces[Face].CornerCount; ++Corner)
+        {
+            const float*  Point = State.Scene.Corners[Corner].Position;
+            const double  Along = Dot(Vector3{ Point[0], Point[1], Point[2] } - Plane.Origin, Plane.ZAxis);
+            Above = std::max(Above, Along);
+            Below = std::min(Below, Along);
+        }
+    const double Margin = Lift + 0.02 * (Above - Below);
+    Top    = Above + Margin;
+    Bottom = Below - Margin;
+}
+
+// 📝 Knife with a 3D cutter (a Construct primitive drawn as the Construct menu draws it: base on the face, then the height
+//    with live dimension lines). Started on a body face (an upward one lifts the floor, any other carries its frame),
+//    a cut / intersect goes into the body and an add stands out of it (the lift is held on that side), and the end on
+//    the face is carried past it by the knife lift so no cutter face is flush.
+[[nodiscard]] bool KnifeSolidCondition(const SolidArcWorkspaceState& State)
+{
+    return State.Knife.ActiveCondition && State.Knife.DrawPendingCondition && State.Drawing.ActiveCondition && State.Drawing.SolidCondition;
+}
+
+// The body a 3D cutter cuts: the owner of the face under its first click, else the active body, else the only body.
+[[nodiscard]] std::string KnifeSolidTarget(const SolidArcWorkspaceState& State)
+{
+    const SolidArcDrawingSession& Drawing = State.Drawing;
+    if (!Drawing.StartFace.empty())
+    {
+        const std::string Owner = SolidArcBodyOfName(State.Document, SolidArcSelectionKind::Face, Drawing.StartFace);
+        if (!Owner.empty()) return Owner;
+    }
+    if (!BooleanTarget(State).empty()) return BooleanTarget(State);
+    return State.Scene.Bodies.size() == 1 ? State.Scene.Bodies.front().Key : std::string{};
+}
+
+// Height stage on a face: a cut / intersect keeps the lift below the face, an add above it (as the 2D knife's depth).
+void BoundKnifeSolidLift(SolidArcWorkspaceState& State)
+{
+    SolidArcDrawingSession& Drawing = State.Drawing;
+    if (!KnifeSolidCondition(State) || Drawing.StartFace.empty() || !SolidLiftedCondition(Drawing.Solid)) return;
+    const FeatureCombination Combination = State.Knife.Combination;
+    if (Combination == FeatureCombination::Separate) return;
+    const double Least = GridSnapCondition(State) ? DrawingSnap : 1.0e-3;                     // [len] - Shallowest cutter
+    Drawing.Lift = Combination == FeatureCombination::Union ? std::max(Drawing.Lift, Least) : std::min(Drawing.Lift, -Least);
+}
+
+// The drawn primitive as the knife's cutter (with the pointer standing in for a missing click when PointerCondition):
+// its request, the face-side end carried past the face, and the body it cuts. Empty text when complete.
+[[nodiscard]] std::string ComposeKnifeSolid(const SolidArcWorkspaceState& State, bool PointerCondition, SolidArcConstructRequest& Request, std::string& Target)
+{
+    const SolidArcDrawingSession& Drawing = State.Drawing;
+    if (const std::string Refusal = ComposeSolidRequest(Drawing, PointerCondition, Request); !Refusal.empty()) return Refusal;
+    Target = KnifeSolidTarget(State);
+    if (Drawing.StartFace.empty() || State.Knife.Combination == FeatureCombination::Separate) return {};
+    const double Margin = KnifeLift(State.Scene, Target);                                     // [len] - Past the face
+    const double Lift   = Drawing.Lift;
+    switch (Request.Kind)
+    {
+    case SolidArcConstructKind::Block:
+    case SolidArcConstructKind::Wedge:
+    case SolidArcConstructKind::Cylinder:
+    case SolidArcConstructKind::Prism:
+    case SolidArcConstructKind::Tube:
+        if (Lift > 0.0) Request.Position.Z -= Margin;                                        // Standing out: the foot sinks in
+        Request.Height += Margin;                                                            // Sunk in: the top clears the face
+        break;
+    case SolidArcConstructKind::Cone:
+        if (std::abs(Lift) > 1.0e-12)
+        {
+            // The same cone surface with its base moved Margin away from the apex (radius grows in proportion).
+            const double Sign = Lift > 0.0 ? 1.0 : -1.0;
+            Request.Position.Z -= Sign * Margin;
+            Request.Radius     *= (std::abs(Lift) + Margin) / std::abs(Lift);
+            Request.Height      = Lift + Sign * Margin;
+        }
+        break;
+    case SolidArcConstructKind::Sphere:
+    case SolidArcConstructKind::Torus:
+        break;                                                                               // Centred on the face: they cross it
+    }
+    return {};
+}
+
+[[nodiscard]] std::string KnifeSolidKey(const SolidArcWorkspaceState& State, const SolidArcConstructRequest& Request, const std::string& Target)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    return Compose("solid|%d|%d|%d|%s|%.17g,%.17g,%.17g|%.17g|%.17g|%.17g|%.17g|%.17g|%.17g|%.17g|%d|%.17g|%d|%.17g,%.17g,%.17g|%.17g,%.17g,%.17g|%.17g,%.17g,%.17g|%llu",
+                   int(Request.Kind), int(Knife.Combination), Knife.KeepCondition ? 1 : 0, Target.c_str(), Request.Position.X, Request.Position.Y, Request.Position.Z,
+                   Request.Width, Request.Depth, Request.Height, Request.Radius, Request.Major, Request.Minor, Request.Inner, Request.Sides, Request.Angle,
+                   Request.PlaneCondition ? 1 : 0, Request.Plane.Origin.X, Request.Plane.Origin.Y, Request.Plane.Origin.Z, Request.Plane.XAxis.X, Request.Plane.XAxis.Y,
+                   Request.Plane.XAxis.Z, Request.Plane.ZAxis.X, Request.Plane.ZAxis.Y, Request.Plane.ZAxis.Z, static_cast<unsigned long long>(State.Document.Revision));
+}
+
+// 📝 Knife placement (Object with one picked body, KitOps cutter object): the picked body is the cutter. Its box centre
+//    rides on the face under the pointer (faces of the cutter itself are skipped); Ctrl turns its z onto the face
+//    normal, [ / ] turn it about the normal, and once placed (click / right-click) the pointer along the normal sets
+//    how far it sinks in (Sink > 0) or stands out (< 0).
+[[nodiscard]] bool KnifePlacementCondition(const SolidArcWorkspaceState& State)
+{
+    return State.Knife.Mode == SolidArcKnifeMode::Object && State.Document.Selection.Bodies.size() == 1;
+}
+
+// v turned by Angle about the unit Axis (Rodrigues).
+[[nodiscard]] Vector3 TurnAbout(Vector3 Vector, Vector3 Axis, double Angle)
+{
+    const double Cosine = std::cos(Angle), Sine = std::sin(Angle);
+    return Vector * Cosine + Cross(Axis, Vector) * Sine + Axis * (Dot(Axis, Vector) * (1.0 - Cosine));
+}
+
+[[nodiscard]] AffineMap KnifePlacementMap(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    AffineMap Map;
+    if (!KnifePlacementCondition(State)) return Map;
+    Vector3 Low, High;
+    if (!MeasureSceneBody(State.Scene, State.Document.Selection.Bodies.front(), Low, High)) return Map;
+    const Vector3 Pivot  = (Low + High) * 0.5;                                                // [len] - Cutter box centre
+    const Vector3 Normal = Normalize(Knife.Spot.ZAxis);
+    const auto    Turned = [&](Vector3 Axis)
+    {
+        if (Knife.AlignCondition)
+        {
+            // Minimal rotation of ẑ onto the face normal (a half turn about x̂ when they oppose).
+            const Vector3 Up{ 0.0, 0.0, 1.0 };
+            const double  Cosine = Dot(Up, Normal);
+            const Vector3 Hinge  = Cross(Up, Normal);
+            if (Cosine < -1.0 + 1.0e-12) Axis = { Axis.X, -Axis.Y, -Axis.Z };
+            else if (Length(Hinge) > 1.0e-12) Axis = TurnAbout(Axis, Normalize(Hinge), std::atan2(Length(Hinge), Cosine));
+        }
+        return Knife.Turn != 0.0 ? TurnAbout(Axis, Normal, Knife.Turn) : Axis;
+    };
+    Map.ColumnX = Turned({ 1.0, 0.0, 0.0 });
+    Map.ColumnY = Turned({ 0.0, 1.0, 0.0 });
+    Map.ColumnZ = Turned({ 0.0, 0.0, 1.0 });
+    const Vector3 Carried = Map.ColumnX * Pivot.X + Map.ColumnY * Pivot.Y + Map.ColumnZ * Pivot.Z;
+    Map.Shift = Knife.Spot.Origin - Normal * Knife.Sink - Carried;
+    return Map;
+}
+
+// Face under the pointer on any body but the cutter: the hit and the (interpolated, outward) normal there.
+[[nodiscard]] bool PickKnifeTargetFace(const SolidArcScene& Scene, const OrbitRay& Ray, const std::string& Skipped, Vector3& Hit, Vector3& Normal, std::string& Body)
+{
+    uint32_t SkippedIndex = UINT32_MAX;
+    for (uint32_t Index = 0; Index < Scene.Bodies.size(); ++Index) if (Scene.Bodies[Index].Key == Skipped) SkippedIndex = Index;
+    const Vector3 Origin{ Ray.Origin[0], Ray.Origin[1], Ray.Origin[2] }, Direction{ Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+    double Nearest = std::numeric_limits<double>::infinity();
+    for (const SolidArcSceneFace& Face : Scene.Faces)
+    {
+        if (Face.Body == SkippedIndex || Face.Body >= Scene.Bodies.size()) continue;
+        for (uint32_t Corner = Face.FirstCorner; Corner + 2 < Face.FirstCorner + Face.CornerCount + 1 && Corner + 2 < Scene.Corners.size(); Corner += 3)
+        {
+            const auto    At = [&](uint32_t Index) { const float* P = Scene.Corners[Index].Position; return Vector3{ P[0], P[1], P[2] }; };
+            const Vector3 A = At(Corner), B = At(Corner + 1), C = At(Corner + 2);
+            // Möller–Trumbore.
+            const Vector3 EdgeB = B - A, EdgeC = C - A, Lever = Cross(Direction, EdgeC);
+            const double  Determinant = Dot(EdgeB, Lever);
+            if (std::abs(Determinant) < 1.0e-18) continue;
+            const Vector3 Offset = Origin - A;
+            const double  U = Dot(Offset, Lever) / Determinant;
+            if (U < 0.0 || U > 1.0) continue;
+            const Vector3 Turn = Cross(Offset, EdgeB);
+            const double  V = Dot(Direction, Turn) / Determinant;
+            if (V < 0.0 || U + V > 1.0) continue;
+            const double Distance = Dot(EdgeC, Turn) / Determinant;
+            if (!(Distance > 0.0) || Distance >= Nearest) continue;
+            Nearest = Distance;
+            const auto Bent = [&](uint32_t Index) { const float* N = Scene.Corners[Index].Normal; return Vector3{ N[0], N[1], N[2] }; };
+            Normal = Bent(Corner) * (1.0 - U - V) + Bent(Corner + 1) * U + Bent(Corner + 2) * V;
+            if (!(Length(Normal) > 1.0e-12)) Normal = Cross(EdgeB, EdgeC);
+            Normal = Normalize(Normal);
+            Hit    = Origin + Direction * Distance;
+            Body   = Scene.Bodies[Face.Body].Key;
+        }
+    }
+    return std::isfinite(Nearest);
+}
+
+[[nodiscard]] SolidArcCommandOutcome RefusedKnife(const std::string& Reason)
+{
+    SolidArcCommandOutcome Outcome;
+    Outcome.Refusal = Reason;
+    return Outcome;
+}
+
+[[nodiscard]] bool KnifeCompoundCondition(const SolidArcKnifeSession& Knife) noexcept
+{
+    return Knife.Insert >= 0 && Knife.Insert < SolidArcCompoundCutterCount;
+}
+
+[[nodiscard]] int KnifeLibraryCount(const SolidArcKnifeSession& Knife) noexcept
+{
+    return SolidArcCompoundCutterCount + static_cast<int>(Knife.Library.Inserts.size());
+}
+
+[[nodiscard]] std::string KnifeLibraryEntryName(const SolidArcKnifeSession& Knife, int Index)
+{
+    if (Index >= 0 && Index < SolidArcCompoundCutterCount)
+        return SolidArcCompoundCutterLabel(static_cast<SolidArcCompoundCutterKind>(Index));
+    const int UserIndex = Index - SolidArcCompoundCutterCount;
+    if (UserIndex >= 0 && UserIndex < static_cast<int>(Knife.Library.Inserts.size()))
+        return Knife.Library.Inserts[static_cast<size_t>(UserIndex)].Name;
+    return "Compound cutter";
+}
+
+// The picked user STEP insert (nullptr when a built-in Compound Cutter is selected or index is out of range).
+[[nodiscard]] const SolidArcInsert* KnifeInsert(const SolidArcKnifeSession& Knife)
+{
+    const int UserIndex = Knife.Insert - SolidArcCompoundCutterCount;
+    return UserIndex >= 0 && UserIndex < int(Knife.Library.Inserts.size()) ? &Knife.Library.Inserts[size_t(UserIndex)] : nullptr;
+}
+
+[[nodiscard]] double KnifeThroughSpan(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    Vector3 Low, High;
+    if (MeasureSceneBody(State.Scene, Knife.SpotBody, Low, High))
+    {
+        const Vector3 Normal = Normalize(Knife.Spot.ZAxis);
+        double        Far    = 0.0;
+        for (int Corner = 0; Corner < 8; ++Corner)
+        {
+            const Vector3 Point = { (Corner & 1) ? High.X : Low.X, (Corner & 2) ? High.Y : Low.Y, (Corner & 4) ? High.Z : Low.Z };
+            Far = std::max(Far, Dot(Knife.Spot.Origin - Point, Normal));
+        }
+        return Far + 0.02 * Distance(Low, High) + 1.0e-3;
+    }
+    return 0.0;
+}
+
+// Insert depth [len] below the face (height above it for Q): the dragged / typed one, or with T straight through the
+// target — the farthest corner of its box behind the face, plus 2 % of its diagonal.
+[[nodiscard]] double KnifeInsertDepth(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    if (KnifeCompoundCondition(Knife))
+    {
+        if (Knife.InsertThroughCondition && Knife.Combination != FeatureCombination::Union)
+        {
+            const double Span = KnifeThroughSpan(State);
+            if (Span > Knife.OuterDepth + 1.0e-3) return Span;
+        }
+        return Knife.OuterDepth + Knife.InnerDepth;
+    }
+    if (Knife.InsertThroughCondition && Knife.Combination != FeatureCombination::Union)
+    {
+        const double Span = KnifeThroughSpan(State);
+        if (Span > 0.0) return Span;
+    }
+    return Knife.InsertDepth;
+}
+
+[[nodiscard]] SolidArcCompoundCutterSpec ComposeKnifeCompoundSpec(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    SolidArcCompoundCutterSpec Spec;
+    Spec.Kind          = static_cast<SolidArcCompoundCutterKind>(std::clamp(Knife.Insert, 0, SolidArcCompoundCutterCount - 1));
+    Spec.Spot          = Knife.Spot;
+    Spec.Turn          = Knife.Turn;
+    Spec.OuterRadius   = std::max(0.002, Knife.OuterRadius);
+    Spec.OuterDepth    = std::max(0.001, Knife.OuterDepth);
+    Spec.InnerRadius   = std::clamp(Knife.InnerRadius, 0.001, 0.94 * Spec.OuterRadius);
+    const double Total = KnifeInsertDepth(State);
+    Spec.InnerDepth    = std::max(0.002, Total - Spec.OuterDepth);
+    Spec.Combination   = Knife.Combination;
+    Spec.Target        = Knife.SpotBody;
+    Spec.LiveCondition = Knife.LiveCondition;
+    return Spec;
+}
+
+// Least insert depth [len] at the current width (for user STEP inserts).
+[[nodiscard]] double KnifeInsertShallow(const SolidArcKnifeSession& Knife)
+{
+    const SolidArcInsert* Insert = KnifeInsert(Knife);
+    return std::max(1.0e-3, Insert ? (Insert->Shallow + 0.005) * Knife.Size : 0.0);
+}
+
+// The knife as it stands, applied to Document (the workspace document or a preview clone).
+[[nodiscard]] SolidArcCommandOutcome RunKnife(const SolidArcWorkspaceState& State, SolidArcDocument& Document)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    switch (Knife.Mode)
+    {
+    case SolidArcKnifeMode::Sketch:
+    {
+        if (Knife.Sketch.empty()) return RefusedKnife("draw a closed shape for the knife (Circle / Rectangle / Polygon / Slot / Line) or focus a closed sketch");
+        const std::string Target = KnifeSketchTarget(State, Knife.Sketch);
+        if (KnifeSliceCondition(State))
+        {
+            SolidArcCutRequest Request;
+            Request.Target = Target;
+            Request.Cutter = Knife.Sketch;
+            SolidArcCommandOutcome Sliced = CutSolidArcBody(Document, Request);
+            if (!Sliced.AcceptedCondition || Knife.Blends.empty()) return Sliced;
+            // The edge treatments picked on the pieces: one blend step each, on the piece it was picked on.
+            for (size_t Index = 0; Index < Knife.Blends.size(); ++Index)
+            {
+                const SolidArcKnifeBlend& Blend = Knife.Blends[Index];
+                Document.Selection            = {};
+                Document.Selection.Edges      = { Blend.Edge };
+                Document.Selection.LastKind   = SolidArcSelectionKind::Edge;
+                Document.Selection.PickedBody = Blend.Body;
+                const SolidArcCommandOutcome Blended = BlendSolidArcSelection(Document, Blend.Shape, Blend.Size);
+                if (!Blended.AcceptedCondition)
+                {
+                    SolidArcCommandOutcome Refused = Blended;
+                    Refused.Refusal = Compose("edge blend %d (%s %s m): ", int(Index) + 1, Blend.Shape == BlendProfile::Fillet ? "fillet" : "chamfer", FormatLength(Blend.Size).c_str()) + Blended.Refusal;
+                    return Refused;
+                }
+                Sliced.Milliseconds += Blended.Milliseconds;
+            }
+            Document.Selection = {};
+            Sliced.Label += Compose(" + %d edge blend(s)", int(Knife.Blends.size()));
+            return Sliced;
+        }
+        double Top = 0.0, Bottom = 0.0;
+        KnifeSketchSpan(State, Target, Top, Bottom);
+        return KnifeSolidArcSketch(Document, Knife.Sketch, Top, Bottom, Knife.Combination, Target);
+    }
+    case SolidArcKnifeMode::Insert:
+    {
+        if (Knife.Insert < 0 || Knife.Insert >= KnifeLibraryCount(Knife)) return RefusedKnife("pick a compound cutter from the library");
+        if (!Knife.PlacedCondition && !Knife.HoverCondition) return RefusedKnife("point at a body face to place the cutter");
+        if (KnifeCompoundCondition(Knife)) return KnifeSolidArcCompoundCutter(Document, ComposeKnifeCompoundSpec(State));
+        const SolidArcInsert* Insert = KnifeInsert(Knife);
+        if (!Insert) return RefusedKnife("pick a cutter from the library");
+        const SolidArcInsertReach Reach  = ReachSolidArcInsert(*Insert, KnifeInsertDepth(State) / std::max(1.0e-9, Knife.Size));
+        if (!Reach.Refusal.empty()) return RefusedKnife(Reach.Refusal);
+        SolidArcInsertPlacement Placement;
+        Placement.Name        = Insert->Name;
+        Placement.Exchange    = Reach.Exchange;
+        Placement.Map         = PlaceSolidArcInsert(Knife.Spot, Knife.Size, Knife.Turn, Knife.Combination == FeatureCombination::Union, Reach.Stretch, 1.0);
+        Placement.Combination = Knife.Combination;
+        Placement.Target      = Knife.SpotBody;
+        if (Knife.LiveCondition && Knife.Combination != FeatureCombination::Separate) return KnifeSolidArcLiveInsert(Document, Placement);
+        return KnifeSolidArcInsert(Document, Placement);
+    }
+    case SolidArcKnifeMode::Object:
+    {
+        const std::vector<std::string>& Picked = State.Document.Selection.Bodies;
+        if (Knife.Combination == FeatureCombination::Separate) return RefusedKnife("Separate is for sketch and insert cutters (Q / W / E here)");
+        if (Picked.size() == 1)
+        {
+            if (!Knife.PlacedCondition && !Knife.HoverCondition) return RefusedKnife("point at a face of the body to cut: the picked body follows the pointer");
+            if (Knife.LiveCondition)
+            {
+                const SolidArcCommandOutcome Moved = TransformSolidArcBodies(Document, { Picked.front() }, KnifePlacementMap(State), "Place Live Cutter");
+                if (!Moved.AcceptedCondition) return Moved;
+                return AddSolidArcLiveBoolean(Document, Knife.SpotBody, Picked.front(), Knife.Combination, Knife.Spot.ZAxis);
+            }
+            return KnifeSolidArcPlacedBody(Document, Knife.SpotBody, Picked.front(), KnifePlacementMap(State), Knife.Combination, Knife.KeepCondition);
+        }
+        if (Picked.size() < 2) return RefusedKnife("pick the cutter body (it follows the pointer), or the body to cut then Shift-pick the cutters (mode 4)");
+        if (Knife.LiveCondition)
+        {
+            SolidArcCommandOutcome LastOutcome;
+            for (size_t Index = 1; Index < Picked.size(); ++Index)
+            {
+                LastOutcome = AddSolidArcLiveBoolean(Document, Picked.front(), Picked[Index], Knife.Combination);
+                if (!LastOutcome.AcceptedCondition) return LastOutcome;
+            }
+            return LastOutcome;
+        }
+        return KnifeSolidArcBodies(Document, Picked.front(), std::vector<std::string>(Picked.begin() + 1, Picked.end()), Knife.Combination, Knife.KeepCondition);
+    }
+    }
+    return RefusedKnife("unknown knife mode");
+}
+
+void EnsureKnifeLibrary(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.LibraryCondition) return;
+    FRONTIER_TRACE_SCOPE("Knife", "library");
+    Knife.Library          = AssembleSolidArcUserInserts(State.Options.InsertFolder);
+    Knife.LibraryCondition = true;
+    Knife.Insert           = std::clamp(Knife.Insert, 0, std::max(0, KnifeLibraryCount(Knife) - 1));
+    Knife.Aspect           = 1.0;
+    for (const std::string& Note : Knife.Library.Notes) FRONTIER_TRACE("Knife", "insert skipped: " + Note);
+}
+
+// Everything the knife preview depends on (a slice ignores the depth, through and the Boolean: moving the pointer for
+// a depth then never restages it).
+[[nodiscard]] std::string KnifeStageKey(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    std::string Picked;
+    for (const std::string& Key : State.Document.Selection.Bodies) Picked += Key + ",";
+    const bool Slice = KnifeSliceCondition(State);
+    return Compose("%d|%d|%s|%.17g|%d|%d|%d|%d|%.17g,%.17g,%.17g|%.17g,%.17g,%.17g|%.17g|%.17g|%d|%s|%s|%llu|%d", int(Knife.Mode), Slice ? 0 : int(Knife.Combination),
+                   Knife.Sketch.c_str(), Slice ? 0.0 : Knife.Depth, Knife.ThroughCondition && !Slice ? 1 : 0, Knife.Insert, Knife.HoverCondition ? 1 : 0, Knife.PlacedCondition ? 1 : 0,
+                   Knife.Spot.Origin.X, Knife.Spot.Origin.Y, Knife.Spot.Origin.Z, Knife.Spot.ZAxis.X, Knife.Spot.ZAxis.Y, Knife.Spot.ZAxis.Z, Knife.Size, Knife.Turn,
+                   Knife.KeepCondition ? 1 : 0, Knife.SpotBody.c_str(), Picked.c_str(), static_cast<unsigned long long>(State.Document.Revision), Slice ? 1 : 0) +
+           Compose("|%.17g|%d|%d|%.17g|%.17g|%.17g|%.17g", Knife.Sink, Knife.AlignCondition ? 1 : 0, Knife.LiveCondition ? 1 : 0,
+                   Knife.OuterRadius, Knife.OuterDepth, Knife.InnerRadius, Knife.InnerDepth) +
+           (Knife.Mode == SolidArcKnifeMode::Insert ? Compose("|%.17g|%d", KnifeInsertDepth(State), Knife.InsertThroughCondition ? 1 : 0) : std::string{}) +
+           [&]() { std::string Blends; for (const SolidArcKnifeBlend& Blend : Knife.Blends) Blends += Compose("|%s@%s:%d:%.17g", Blend.Edge.c_str(), Blend.Body.c_str(), int(Blend.Shape), Blend.Size); return Blends; }();
+}
+
+void DropKnifePreview(SolidArcKnifeSession& Knife)
+{
+    Knife.Preview.reset();
+    Knife.StagedKey.clear();
+    Knife.Refusal.clear();
+    Knife.RigidCondition = false;
+    Knife.GhostKey.clear();
+}
+
+void ChooseKnifeMode(SolidArcWorkspaceState& State, SolidArcKnifeMode Mode)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.Mode = Mode;
+    DropKnifePreview(Knife);
+    if (Mode != SolidArcKnifeMode::Sketch && Knife.DrawPendingCondition)
+    {
+        Knife.DrawPendingCondition    = false;
+        State.Drawing.ActiveCondition = false;
+    }
+    if (Mode == SolidArcKnifeMode::Insert)
+    {
+        EnsureKnifeLibrary(State);
+        Knife.PlacedCondition      = false;
+        Knife.SizingCondition      = false;
+        Knife.DepthChosenCondition = false;
+        Knife.CompoundStage        = 0;
+        Knife.Aspect               = 1.0;
+        Knife.Typed.clear();
+        Announce(State, Compose("Knife · %s · click face for centre → Stage 1 circle/size → Stage 1 extrude → Stage 2 circle/size → Stage 2 extrude (T through · L live boolean)",
+                                KnifeLibraryEntryName(Knife, Knife.Insert).c_str()));
+        return;
+    }
+    if (Mode == SolidArcKnifeMode::Object)
+    {
+        if (Knife.Combination == FeatureCombination::Separate) Knife.Combination = FeatureCombination::Difference;
+        Knife.PlacedCondition = false;
+        Knife.HoverCondition  = false;
+        Knife.Typed.clear();
+        if (KnifePlacementCondition(State))
+            Announce(State, "Knife · " + SolidArcBodyCaption(State.Document, State.Document.Selection.Bodies.front()) +
+                                " follows the pointer onto a face (Ctrl: along its normal · [ / ] turn) · click / right-click places it · then in / out along the normal · click / right-click / Enter cuts");
+        else
+            Announce(State, "Knife · Object · the first picked body is cut by the others (Shift-pick cutters) · K keeps the cutters · click / right-click / Enter applies");
+        return;
+    }
+    Announce(State, Knife.Sketch.empty() ? "Knife · Sketch · draw a closed shape on a face (card: Circle / Rectangle / Polygon / Slot / Line)"
+                                         : "Knife · Sketch " + CaptionOf(State.Document, Knife.Sketch) + " · pull along the face normal for the depth (as Construct heights) · T through");
+}
+
+void ChooseKnifeCombination(SolidArcWorkspaceState& State, FeatureCombination Combination)
+{
+    if (State.Knife.Mode == SolidArcKnifeMode::Object && Combination == FeatureCombination::Separate) return;
+    State.Knife.Combination = Combination;
+    if (KnifeSolidCondition(State)) State.Drawing.Combination = Combination;                  // A 3D cutter being drawn follows
+    Announce(State, std::string("Knife: ") + KnifeCombinationLabel(Combination));
+}
+
+// Starts a drawing for the knife: the shape is filled, and once finished becomes the knife's cutter on that face.
+// Caption of a sketch cutter: a knife line drawn as a polyline reads "Polyline".
+[[nodiscard]] const char* KnifeShapeLabel(SolidArcDrawingKind Kind, bool PolylineCondition)
+{
+    return Kind == SolidArcDrawingKind::Line && PolylineCondition ? "Polyline" : SolidArcDrawingLabel(Kind);
+}
+
+void ImprintKnifeSketch(SolidArcWorkspaceState& State, const std::string& Sketch);
+
+void AnnounceImprintShape(SolidArcWorkspaceState& State);
+
+void DrawKnifeShape(SolidArcWorkspaceState& State, SolidArcDrawingKind Kind, bool PolylineCondition = false)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.Mode = SolidArcKnifeMode::Sketch;
+    Knife.Sketch.clear();
+    Knife.Face.clear();
+    Knife.Typed.clear();
+    DropKnifePreview(Knife);
+    State.Picker.Lock = SolidArcSnapLockKind::None; // A previous drawing's axis lock must not pin a new cutter to its grid.
+    OpenDrawingSession(State, Kind);
+    // A knife line is one cut across the face: it finishes on its second click (edge to edge), no Enter needed. A knife
+    // polyline takes clicks until Enter / right-click (the open chain slices along every segment; clicking the first
+    // point closes it into a pocket outline instead).
+    if (Kind == SolidArcDrawingKind::Line) State.Drawing.SegmentCondition = !PolylineCondition;
+    Knife.DrawPendingCondition = State.Drawing.ActiveCondition;
+}
+
+// Starts a 3D cutter for the knife: a Construct primitive drawn on a face (base, then the height into the body).
+void DrawKnifeSolid(SolidArcWorkspaceState& State, SolidArcConstructKind Kind)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.Mode = SolidArcKnifeMode::Sketch;
+    Knife.Sketch.clear();
+    Knife.Face.clear();
+    Knife.Typed.clear();
+    DropKnifePreview(Knife);
+    State.Picker.Lock = SolidArcSnapLockKind::None;
+    OpenSolidSession(State, Kind);
+    State.Drawing.Combination  = Knife.Combination;
+    Knife.DrawPendingCondition = State.Drawing.ActiveCondition;
+    if (!Knife.DrawPendingCondition) return;
+    Announce(State, std::string("Knife · ") + SolidArcConstructLabel(Kind) + " cutter · " + SolidPrompt(State.Drawing) +
+                        " on a face (live dimensions) · the height goes into the body (Q: out of it) · the cut shows as you pull · Q / W / E / R · K keep · Esc cancels");
+}
+
+void OpenKnifeSession(SolidArcWorkspaceState& State)
+{
+    if (State.Bevel.ActiveCondition) { Announce(State, "Knife: finish the bevel first"); return; }
+    if (!State.Document.Summary.PresentCondition) { Announce(State, "Knife needs a body to cut: make one first (Shift+C box, E extrude …)"); return; }
+    SolidArcKnifeSession& Knife = State.Knife;
+    const int  Commits = Knife.Commits;
+    const int  Insert  = Knife.Insert;
+    const bool Through = Knife.ThroughCondition;
+    SolidArcInsertLibrary Library   = std::move(Knife.Library);
+    const bool            Assembled = Knife.LibraryCondition;
+    const SolidArcKnifeMode   PreferredMode  = Knife.PreferredMode;
+    const SolidArcDrawingKind PreferredShape = Knife.PreferredShape;
+    const bool                  PreferredSolidCondition = Knife.PreferredSolidCondition;
+    const SolidArcConstructKind PreferredSolid          = Knife.PreferredSolid;
+    const bool                  PreferredPolyline       = Knife.PreferredPolylineCondition;
+    const bool                  PreferredImprint        = Knife.PreferredImprintCondition;
+    Knife                  = {};
+    Knife.PreferredPolylineCondition = PreferredPolyline;
+    Knife.PreferredImprintCondition  = PreferredImprint;
+    Knife.PreferredMode    = PreferredMode;
+    Knife.PreferredShape   = PreferredShape;
+    Knife.PreferredSolidCondition = PreferredSolidCondition;
+    Knife.PreferredSolid          = PreferredSolid;
+    Knife.Commits          = Commits;
+    Knife.Insert           = Insert;
+    Knife.ThroughCondition = Through;
+    Knife.Library          = std::move(Library);
+    Knife.LibraryCondition = Assembled;
+    Knife.ActiveCondition  = true;
+    State.Sweep.ActiveCondition     = false;
+    State.Sweep.Preview.reset();
+    State.Trim.ActiveCondition      = false;
+    State.Fill.ActiveCondition      = false;
+    State.Constrain.ActiveCondition = false;
+    State.Transform.ActiveCondition = false;
+    State.Boolean.ActiveCondition   = false;
+    State.Drawing.ActiveCondition   = false;
+    std::string Sketch = FocusedSketchCondition(State) ? State.FocusedStep : std::string{};
+    if (Sketch.empty())
+        for (const std::string& Label : SelectedSketchLabels(State.Document)) { Sketch = Label; break; }
+    if (State.Document.Selection.Bodies.size() >= 2) { ChooseKnifeMode(State, SolidArcKnifeMode::Object); return; }
+    if (!Sketch.empty())
+    {
+        Knife.Sketch = Sketch;
+        if (Knife.PreferredImprintCondition && !Knife.PreferredSolidCondition && Knife.PreferredMode == SolidArcKnifeMode::Sketch)
+        {
+            Knife.Mode = SolidArcKnifeMode::Sketch;
+            ImprintKnifeSketch(State, Sketch);                                               // 2D cutter on the picked sketch
+            return;
+        }
+        ChooseKnifeMode(State, SolidArcKnifeMode::Sketch);
+        return;
+    }
+    // One picked body among others: it is the cutter, carried by the pointer (KitOps cutter object).
+    if (State.Document.Selection.Bodies.size() == 1 && State.Scene.Bodies.size() >= 2) { ChooseKnifeMode(State, SolidArcKnifeMode::Object); return; }
+    if (Knife.PreferredMode == SolidArcKnifeMode::Insert) { ChooseKnifeMode(State, SolidArcKnifeMode::Insert); return; }
+    if (Knife.PreferredMode == SolidArcKnifeMode::Object) { ChooseKnifeMode(State, SolidArcKnifeMode::Object); return; }
+    if (Knife.PreferredSolidCondition) { DrawKnifeSolid(State, Knife.PreferredSolid); return; }
+    DrawKnifeShape(State, Knife.PreferredShape, Knife.PreferredPolylineCondition);
+    if (Knife.PreferredImprintCondition) { AnnounceImprintShape(State); return; }
+    Announce(State, std::string("Knife · draw a ") + KnifeShapeLabel(Knife.PreferredShape, Knife.PreferredPolylineCondition) + " on a face (toolbar menu or card: Circle / Rectangle / Polygon / Slot / Line / Polyline) · then pull along the normal for the depth · Tab: Insert library · Esc cancels");
+}
+
+// Toolbar tool menu: remembers the cutter and opens (or switches) the knife on it.
+void ChooseKnifeTool(SolidArcWorkspaceState& State, SolidArcKnifeMode Mode, SolidArcDrawingKind Shape, int Insert, bool PolylineCondition = false, bool ImprintCondition = false)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.PreferredMode  = Mode;
+    Knife.PreferredShape = Shape;
+    Knife.PreferredImprintCondition = Mode == SolidArcKnifeMode::Sketch && ImprintCondition;
+    if (Mode == SolidArcKnifeMode::Sketch) Knife.PreferredPolylineCondition = PolylineCondition && Shape == SolidArcDrawingKind::Line;
+    if (Mode == SolidArcKnifeMode::Sketch || Mode == SolidArcKnifeMode::Insert) Knife.PreferredSolidCondition = false;
+    if (Insert >= 0) { Knife.Insert = Insert; Knife.Aspect = 1.0; }
+    if (!Knife.ActiveCondition) OpenKnifeSession(State);
+    if (!Knife.ActiveCondition) return;
+    if (Mode == SolidArcKnifeMode::Sketch)
+    {
+        const bool Same = Knife.DrawPendingCondition && State.Drawing.ActiveCondition && State.Drawing.Kind == Shape && State.Drawing.Points.empty()
+                       && (Shape != SolidArcDrawingKind::Line || State.Drawing.SegmentCondition != Knife.PreferredPolylineCondition);
+        if (!Same) DrawKnifeShape(State, Shape, Knife.PreferredPolylineCondition);
+        if (Knife.PreferredImprintCondition) AnnounceImprintShape(State);
+        else if (Knife.PreferredPolylineCondition)
+            Announce(State, "Knife · Polyline · click points across the body (Ctrl snaps) · Enter / right-click ends the chain · it slices the body along every segment");
+        else
+            Announce(State, std::string("Knife · ") + SolidArcDrawingLabel(Shape) + " · draw it on a face (live W / H / R dimensions), then pull along the normal for the depth (T through)");
+        return;
+    }
+    if (Knife.Mode != Mode || Mode == SolidArcKnifeMode::Insert) ChooseKnifeMode(State, Mode);
+}
+
+// Toolbar menu / card: a Construct primitive as the cutter (remembered, as the 2D shapes are).
+void ChooseKnifeSolid(SolidArcWorkspaceState& State, SolidArcConstructKind Kind)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.PreferredMode           = SolidArcKnifeMode::Sketch;
+    Knife.PreferredSolidCondition = true;
+    Knife.PreferredSolid          = Kind;
+    Knife.PreferredImprintCondition = false;
+    if (!Knife.ActiveCondition) { OpenKnifeSession(State); return; }
+    if (!(KnifeSolidCondition(State) && State.Drawing.Solid == Kind && State.Drawing.Points.empty())) DrawKnifeSolid(State, Kind);
+}
+
+// Toolbar caption of the cutter the knife uses (or opens with).
+[[nodiscard]] std::string KnifeToolLabel(SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    const SolidArcKnifeMode Mode = Knife.ActiveCondition ? Knife.Mode : Knife.PreferredMode;
+    if (Mode == SolidArcKnifeMode::Object) return "Objects";
+    if (Mode == SolidArcKnifeMode::Insert)
+        return KnifeLibraryEntryName(Knife, Knife.Insert);
+    if (KnifeSolidCondition(State)) return SolidArcConstructLabel(State.Drawing.Solid);
+    if (!Knife.ActiveCondition && Knife.PreferredSolidCondition) return SolidArcConstructLabel(Knife.PreferredSolid);
+    const bool                Drawing = Knife.ActiveCondition && Knife.DrawPendingCondition && State.Drawing.ActiveCondition;
+    const SolidArcDrawingKind Shape   = Drawing ? State.Drawing.Kind : Knife.PreferredShape;
+    const std::string         Caption = KnifeShapeLabel(Shape, Drawing ? !State.Drawing.SegmentCondition : Knife.PreferredPolylineCondition);
+    return Knife.PreferredImprintCondition ? "2D " + Caption : Caption;
+}
+
+void CloseKnifeSession(SolidArcWorkspaceState& State, const std::string& Message)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.DrawPendingCondition) State.Drawing.ActiveCondition = false;
+    Knife.ActiveCondition      = false;
+    Knife.DrawPendingCondition = false;
+    Knife.Blends.clear();
+    Knife.BlendFocus           = -1;
+    DropKnifePreview(Knife);
+    if (!Message.empty()) Announce(State, Message);
+}
+
+void AnnounceImprintShape(SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    Announce(State, std::string("2D cutter · ") + KnifeShapeLabel(Knife.PreferredShape, Knife.PreferredPolylineCondition)
+                        + (Knife.PreferredPolylineCondition ? " · click points across the face (Ctrl snaps), Enter / right-click ends · an open chain splits edge to edge"
+                                                            : " · draw it on a face (live dimensions)")
+                        + " · it imprints into the face (nothing is cut) · then pick the new face and E pushes it in / pulls it out · Esc cancels");
+}
+
+// 💡 2D cutter: the outline (drawn, or the picked sketch) is imprinted into the faces of the body it lies on — split,
+//    not cut; the volume stays. The knife closes into face picking so the new region can be clicked and E dragged.
+//    Refused (off the body, a branching chain): the drawn sketch stays and the shape is armed again.
+void ImprintKnifeSketch(SolidArcWorkspaceState& State, const std::string& Sketch)
+{
+    SolidArcKnifeSession&        Knife   = State.Knife;
+    const std::string            Target  = KnifeSketchTarget(State, Sketch);
+    const SolidArcCommandOutcome Outcome = ImprintSolidArcSketch(State.Document, Sketch, Target);
+    Conclude(State, Outcome);
+    if (!Outcome.AcceptedCondition)
+    {
+        Knife.Refusal = Legible(Outcome.Refusal);
+        Knife.Sketch.clear();
+        if (State.Scene.Bodies.empty()) { CloseKnifeSession(State, "Refused: " + Outcome.Refusal); return; }
+        DrawKnifeShape(State, Knife.PreferredShape, Knife.PreferredPolylineCondition);
+        Announce(State, "2D cutter refused: " + Outcome.Refusal + " · draw the shape on a face of the body (Esc cancels)");
+        return;
+    }
+    ++Knife.Commits;
+    Knife.Removed = 0.0;
+    CloseKnifeSession(State, {});
+    State.FocusedStep = {};
+    State.PickMode    = SolidArcPickMode::Face;
+    Announce(State, Outcome.Label + " · " + std::to_string(State.Document.Summary.Faces) + " faces · click the new region and E: drag in to push it down, out to pull it up");
+}
+
+// FinishDrawingSession / CancelDrawingSession: the shape drawn for the knife (empty Sketch: refused or aborted).
+void AdoptKnifeSketch(SolidArcWorkspaceState& State, const std::string& Sketch, const std::string& Face)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (!Knife.ActiveCondition || !Knife.DrawPendingCondition) return;
+    Knife.DrawPendingCondition = false;
+    if (Sketch.empty()) { CloseKnifeSession(State, "Knife cancelled (document untouched)"); return; }
+    Knife.Sketch = Sketch;
+    Knife.Face   = Face;
+    if (Knife.PreferredImprintCondition) { ImprintKnifeSketch(State, Sketch); return; }   // 2D cutter: no depth stage
+    Knife.Drift  = Knife.Depth;
+    Knife.Blends.clear();
+    Knife.BlendFocus = -1;
+    DropKnifePreview(Knife);
+    if (KnifeSliceCondition(State))
+        Announce(State, "Knife · " + CaptionOf(State.Document, Sketch) + " slices " + SolidArcBodyCaption(State.Document, KnifeSketchTarget(State, Sketch)) +
+                            " through (two bodies) · click edges of the pieces to fillet / chamfer them (D / C, type a size) · right-click / Enter splits it · Esc cancels");
+    else
+        Announce(State, "Knife · " + CaptionOf(State.Document, Sketch) + " into " + SolidArcBodyCaption(State.Document, KnifeSketchTarget(State, Sketch)) +
+                            " · pull along the face normal for the depth (Ctrl free) or type it · T through · Q add · W cut · E intersect · R separate · click / right-click / Enter applies");
+}
+
+void ApplyKnifeSession(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.DrawPendingCondition) { Announce(State, "Knife: finish the shape first"); return; }
+    // The preview on screen is the cut: adopted (no second run) when it was staged from exactly this knife.
+    const bool Adoptable = Knife.Preview && Knife.PreviewOutcome.AcceptedCondition && Knife.StagedKey == KnifeStageKey(State);
+    if (Adoptable) State.ReadyScene = std::move(Knife.PreviewScene);
+    const double                 Before  = State.Document.Summary.Volume;                    // [len³]
+    SolidArcCommandOutcome Outcome;
+    if (Adoptable) Outcome = AdoptSolidArcPreview(State.Document, std::move(*Knife.Preview), Knife.PreviewOutcome);
+    else if (!Knife.Blends.empty())
+    {
+        // The slice and its edge blends are several steps: run them on a clone, adopt it whole (one undo entry).
+        SolidArcDocument             Scratch = CloneSolidArcDocument(State.Document);
+        const SolidArcCommandOutcome Staged  = RunKnife(State, Scratch);
+        Outcome = Staged.AcceptedCondition ? AdoptSolidArcPreview(State.Document, std::move(Scratch), Staged) : Staged;
+    }
+    else Outcome = RunKnife(State, State.Document);
+    if (Outcome.AcceptedCondition)
+    {
+        ++Knife.Commits;
+        Knife.Removed = Before - State.Document.Summary.Volume;
+        CloseKnifeSession(State, {});
+        State.FocusedStep        = {};
+        State.PickMode           = SolidArcPickMode::Solid;
+        if (Knife.Mode == SolidArcKnifeMode::Object && !Knife.LiveCondition) State.Document.Selection = {}; // Live Boolean keeps the cutter picked for immediate gizmo drag
+    }
+    else Knife.Refusal = Legible(Outcome.Refusal);
+    Conclude(State, Outcome);
+}
+
+// Insert hover: the face under the pointer gives the spot (the hit carried onto its plane) and the body it cuts.
+void HoverKnifeSpot(SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, ImVec2 Local)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.HoverCondition = false;
+    const OrbitRay                    Ray  = CastOrbitRay(Frame, Local.x, Local.y);
+    const std::optional<SolidArcPick> Pick = PickSolidArcScene(State.Scene, Ray, 0.0, false, ActiveSectionClip(State));
+    const std::string                 Body = PickedSceneBody(State.Scene, Pick);
+    std::string      Name;
+    OrthonormalFrame Plane;
+    if (Body.empty() || !ResolveHoveredFacePlane(State, Frame, Local, Name, Plane)) return;
+    const Vector3 Hit = Vector3{ Ray.Origin[0], Ray.Origin[1], Ray.Origin[2] } + Vector3{ Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] } * Pick->Distance;
+    Plane.Origin = Hit - Plane.ZAxis * Dot(Hit - Plane.Origin, Plane.ZAxis);
+    Knife.HoverCondition = true;
+    Knife.Spot           = Plane;
+    if (Body != Knife.SpotBody && !Knife.SizedCondition)
+    {
+        Vector3 Low, High;
+        if (MeasureSceneBody(State.Scene, Body, Low, High))
+            Knife.Size = std::max(0.01, std::round(0.25 * std::max({ High.X - Low.X, High.Y - Low.Y, High.Z - Low.Z }) / 0.01) * 0.01);
+        Knife.Aspect = 1.0;
+    }
+    Knife.SpotBody = Body;
+}
+
+// Placement hover: the face under the pointer (not the cutter's own) carries the cutter; Ctrl aligns it to the normal.
+void HoverKnifeCutterSpot(SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, ImVec2 Local)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Vector3     Hit, Normal;
+    std::string Body;
+    Knife.AlignCondition = ImGui::GetIO().KeyCtrl;
+    if (!PickKnifeTargetFace(State.Scene, CastOrbitRay(Frame, Local.x, Local.y), State.Document.Selection.Bodies.front(), Hit, Normal, Body)) { Knife.HoverCondition = false; return; }
+    Knife.HoverCondition = true;
+    Knife.Spot.Origin    = Hit;
+    Knife.Spot.ZAxis     = Normal;
+    Knife.Spot.XAxis     = Normalize(std::abs(Normal.X) < 0.9 ? Cross(Normal, Cross(Vector3{ 1.0, 0.0, 0.0 }, Normal)) : Cross(Normal, Cross(Vector3{ 0.0, 1.0, 0.0 }, Normal)));
+    Knife.Spot.YAxis     = Cross(Knife.Spot.ZAxis, Knife.Spot.XAxis);
+    Knife.SpotBody       = Body;
+}
+
+void PlaceKnifeCutter(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (!Knife.HoverCondition) { Announce(State, "Knife: point at a face of the body to cut (the picked body follows the pointer)"); return; }
+    Knife.PlacedCondition = true;
+    Knife.Typed.clear();
+    Announce(State, Compose("Knife · %s placed on %s · move the pointer along the normal to push it in / pull it out (Ctrl free) or type a depth · click / right-click / Enter cuts · Esc lifts it",
+                            SolidArcBodyCaption(State.Document, State.Document.Selection.Bodies.front()).c_str(), SolidArcBodyCaption(State.Document, Knife.SpotBody).c_str()));
+}
+
+// 💡 Multi-stage Compound Cutter & non-stretching user insert gesture:
+//    Compound Cutters (0..5): Stage 0 click face centre → Stage 1 radial circle/profile → Stage 2 normal extrude →
+//                             Stage 3 radial inner circle/profile → Stage 4 normal inner extrude (T through) → click applies.
+//    User STEP inserts (≥ 6): Stage 0 click face centre → Stage 1 uniform width (Aspect = 1.0) → Stage 2 normal depth → click applies.
+void PressKnifeInsert(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.PlacedCondition) return;
+    if (!Knife.HoverCondition || Knife.Insert < 0 || Knife.Insert >= KnifeLibraryCount(Knife))
+    {
+        Announce(State, "Knife: point at a body face to place the cutter");
+        return;
+    }
+    Knife.PlacedCondition     = true;
+    Knife.CompoundStage       = 1;
+    Knife.SizingCondition     = true;
+    Knife.SizeByMoveCondition = false;
+    Knife.Aspect              = 1.0;
+    Knife.Corner              = Knife.Spot.Origin;
+    Knife.Typed.clear();
+    Announce(State, Compose("Knife · %s Stage 1 on %s · move radially from centre for outer Ø / width (uniform, Ctrl free) · click / release for Stage 1 extrude",
+                            KnifeLibraryEntryName(Knife, Knife.Insert).c_str(), SolidArcBodyCaption(State.Document, Knife.SpotBody).c_str()));
+}
+
+// Footprint of an insert in its own frame (x across, y along; inserts are normalized to unit width, centred).
+void MeasureInsertFootprint(const SolidArcInsert& Insert, Vector2& Low, Vector2& High)
+{
+    Low  = { -0.5, -0.5 };
+    High = { 0.5, 0.5 };
+    if (Insert.Segments.empty()) return;
+    Low  = { 1.0e300, 1.0e300 };
+    High = { -1.0e300, -1.0e300 };
+    for (const std::array<Vector3, 2>& Segment : Insert.Segments)
+        for (const Vector3& Point : Segment)
+        {
+            Low  = { std::min(Low.X, Point.X), std::min(Low.Y, Point.Y) };
+            High = { std::max(High.X, Point.X), std::max(High.Y, Point.Y) };
+        }
+    if (!(High.X - Low.X > 1.0e-9)) { Low.X = -0.5; High.X = 0.5; }
+    if (!(High.Y - Low.Y > 1.0e-9)) { Low.Y = -0.5; High.Y = 0.5; }
+}
+
+[[nodiscard]] std::optional<double> MeasurePlaneRadialDistance(const OrbitCameraFrame& Frame, ImVec2 Local, Vector3 PlaneOrigin, Vector3 PlaneNormal)
+{
+    const OrbitRay Ray       = CastOrbitRay(Frame, Local.x, Local.y);
+    const Vector3  Origin    = { Ray.Origin[0], Ray.Origin[1], Ray.Origin[2] };
+    const Vector3  Direction = { Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+    const Vector3  Normal    = Normalize(PlaneNormal);
+    const double   Facing    = Dot(Direction, Normal);
+    if (std::abs(Facing) < 1.0e-6) return std::nullopt;
+    const double Travel = Dot(PlaneOrigin - Origin, Normal) / Facing;
+    if (!(Travel > 0.0)) return std::nullopt;
+    const Vector3 Hit    = Origin + Direction * Travel;
+    const Vector3 InPlane = Hit - PlaneOrigin - Normal * Dot(Hit - PlaneOrigin, Normal);
+    return Length(InPlane);
+}
+
+void DragKnifeInsert(SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, ImVec2 Local)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    const std::optional<double> Radial = MeasurePlaneRadialDistance(Frame, Local, Knife.Spot.Origin, Knife.Spot.ZAxis);
+    if (!Radial || !(*Radial > 1.0e-5)) return;
+    const bool Free = ImGui::GetIO().KeyCtrl;
+    const auto Snap = [&](double Value) { return Free ? std::max(0.002, Value) : std::max(0.005, std::round(Value / (0.5 * SweepSnap)) * (0.5 * SweepSnap)); };
+    Knife.Aspect = 1.0;                                                                      // Strictly uniform: never stretch cutters
+    if (KnifeCompoundCondition(Knife))
+    {
+        const double Ratio  = Knife.OuterRadius > 1.0e-6 ? std::clamp(Knife.InnerRadius / Knife.OuterRadius, 0.25, 0.85) : 0.5;
+        Knife.OuterRadius   = Snap(*Radial);
+        Knife.InnerRadius   = std::clamp(Snap(Knife.OuterRadius * Ratio), 0.001, 0.90 * Knife.OuterRadius);
+        Knife.Size          = 2.0 * Knife.OuterRadius;
+    }
+    else
+    {
+        Knife.Size = std::max(0.01, 2.0 * Snap(*Radial));
+    }
+    Knife.SizedCondition = true;
+}
+
+void ReleaseKnifeInsert(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    Knife.SizingCondition     = false;
+    Knife.SizeByMoveCondition = false;
+    Knife.Aspect              = 1.0;
+    Knife.CompoundStage       = 2;
+    Knife.Drift               = KnifeCompoundCondition(Knife) ? Knife.OuterDepth : Knife.InsertDepth;
+    Knife.Typed.clear();
+    if (KnifeCompoundCondition(Knife))
+        Announce(State, Compose("Knife · %s Stage 1 Ø %s m · pull along normal for Stage 1 extrude depth · click for Stage 2 inner circle",
+                                KnifeLibraryEntryName(Knife, Knife.Insert).c_str(), FormatLength(2.0 * Knife.OuterRadius).c_str()));
+    else
+        Announce(State, Compose("Knife · %s width %s m (uniform) · pull along normal for depth (T through) · click / Enter cuts",
+                                KnifeLibraryEntryName(Knife, Knife.Insert).c_str(), FormatLength(Knife.Size).c_str()));
+}
+
+// 📝 The knife's drawn cutter as the Construct primitives show theirs: the profile's plane and its sampled outline
+//    (one polyline per profile curve, construction curves skipped). Empty when no sketch cutter is drawn yet.
+struct KnifeCutterOutline
+{
+    OrthonormalFrame                  Plane    = {};                                         // [len] - Elevated sketch plane
+    std::vector<std::vector<Vector2>> Chains   = {};                                         // [len] - Outline samples per curve
+    Vector2                           Low      = {};                                         // [len] - Plane bounding box
+    Vector2                           High     = {};                                         // [len]
+    Vector2                           Centre   = {};                                         // [len] - Sample centroid
+    double                            Diameter = 0.0;                                        // [len] - Lone circle: its Ø (else 0)
+};
+
+[[nodiscard]] bool MeasureKnifeCutter(const SolidArcWorkspaceState& State, KnifeCutterOutline& Outline)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.Sketch.empty()) return false;
+    const FeatureStep* Step   = FindSketchStepByLabel(State.Document, Knife.Sketch);
+    const auto         Solved = State.Document.Regeneration.Sketches.find(Knife.Sketch);
+    if (!Step || Solved == State.Document.Regeneration.Sketches.end()) return false;
+    Outline.Plane = ElevatedSketchPlane(State.Document, *Step);
+    Outline.Low   = { std::numeric_limits<double>::infinity(), std::numeric_limits<double>::infinity() };
+    Outline.High  = { -std::numeric_limits<double>::infinity(), -std::numeric_limits<double>::infinity() };
+    Vector2 Sum{};
+    int     Count = 0, Profiles = 0, Circles = 0;
+    double  Radius = 0.0;
+    for (const SketchCurve& Curve : Solved->second.Curves)
+    {
+        if (Curve.Construction) continue;
+        ++Profiles;
+        if (Curve.Kind == SketchCurveKind::Circle) { ++Circles; Radius = Curve.Radius; }
+        std::vector<Vector2> Chain = SampleSketchCurve(Solved->second, Curve);
+        for (const Vector2& Sample : Chain)
+        {
+            Outline.Low  = { std::min(Outline.Low.X, Sample.X), std::min(Outline.Low.Y, Sample.Y) };
+            Outline.High = { std::max(Outline.High.X, Sample.X), std::max(Outline.High.Y, Sample.Y) };
+            Sum = Sum + Sample;
+            ++Count;
+        }
+        Outline.Chains.push_back(std::move(Chain));
+    }
+    if (Count == 0) return false;
+    Outline.Centre   = Sum * (1.0 / Count);
+    Outline.Diameter = Profiles == 1 && Circles == 1 ? 2.0 * Radius : 0.0;
+    return true;
+}
+
+void DriveKnifeSession(SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, ImVec2 Local, bool HoveredCondition)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    ImGuiIO& Io = ImGui::GetIO();
+    const bool Moving = Io.MouseDelta.x != 0.0f || Io.MouseDelta.y != 0.0f;
+    if (Moving) Knife.QuietSince = KnifeClock();
+    double Typed = 0.0;
+    const bool TypedCondition = ParseTypedAmount(Knife.Typed, Typed) && Typed > 0.0;
+    const double Drift = HoveredCondition && !ImGui::IsAnyMouseDown() ? Io.MouseDelta.x * Frame.WorldPerPixel * (Io.KeyShift ? 0.1 : 1.0) * 0.5 : 0.0;
+    const auto Snapped = [&](double Value) { return Io.KeyCtrl ? Value : std::round(Value / SweepSnap) * SweepSnap; };
+    // A slice has no depth: typed digits size the focused edge treatment.
+    if (Knife.Mode == SolidArcKnifeMode::Sketch && KnifeSliceCondition(State) && TypedCondition && Knife.BlendFocus >= 0 && Knife.BlendFocus < int(Knife.Blends.size()))
+    {
+        if (Knife.Blends[Knife.BlendFocus].Size != Typed) { Knife.Blends[Knife.BlendFocus].Size = Typed; Knife.BlendSize = Typed; }
+    }
+    if (Knife.Mode == SolidArcKnifeMode::Sketch)
+    {
+        // 💡 As the Construct primitives' height: the depth follows the pointer along the face normal through the
+        //    profile's centre (pull into the body to cut deeper; out of it for a Q boss). A view straight down the
+        //    normal has no such line, so there horizontal motion sizes it as before.
+        KnifeCutterOutline Outline;
+        std::optional<double> Along;
+        if (!TypedCondition && Moving && HoveredCondition && !ImGui::IsAnyMouseDown() && !Knife.DrawPendingCondition && MeasureKnifeCutter(State, Outline))
+        {
+            const OrbitRay Ray    = CastOrbitRay(Frame, Local.x, Local.y);
+            const Vector3  Facing = { Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+            if (std::abs(Dot(Facing, Outline.Plane.ZAxis)) < 0.97) Along = ApproachSolidArcLine(Ray, PlacePlanePoint(Outline.Plane, Outline.Centre), Outline.Plane.ZAxis);
+        }
+        if (TypedCondition) Knife.Depth = Typed;
+        else if (Along)
+        {
+            const double Pulled = Knife.Combination == FeatureCombination::Union ? *Along : -*Along;   // [len] - Into the body (out of it for Q)
+            Knife.Drift = std::max(0.001, Pulled);
+            Knife.Depth = std::max(0.001, Snapped(Knife.Drift));
+        }
+        else
+        {
+            Knife.Drift += Drift;
+            Knife.Depth  = std::max(0.001, Snapped(Knife.Drift));
+        }
+    }
+    else if (KnifePlacementCondition(State))
+    {
+        if (!Knife.PlacedCondition)
+        {
+            if (HoveredCondition) HoverKnifeCutterSpot(State, Frame, Local);
+        }
+        else if (TypedCondition) Knife.Sink = Typed;
+        else if (Moving && HoveredCondition && !ImGui::IsMouseDown(ImGuiMouseButton_Right) && !ImGui::IsMouseDown(ImGuiMouseButton_Middle))
+        {
+            // As a Construct height: the pointer's closest point on the normal through the spot (a pointer drag too).
+            const OrbitRay Ray    = CastOrbitRay(Frame, Local.x, Local.y);
+            const Vector3  Facing = { Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+            const Vector3  Normal = Normalize(Knife.Spot.ZAxis);
+            std::optional<double> Along;
+            if (std::abs(Dot(Facing, Normal)) < 0.97) Along = ApproachSolidArcLine(Ray, Knife.Spot.Origin, Normal);
+            if (Along) Knife.Sink = Snapped(-*Along);
+            else Knife.Sink = Snapped(Knife.Sink + Io.MouseDelta.x * Frame.WorldPerPixel * (Io.KeyShift ? 0.1 : 1.0) * 0.5);
+        }
+    }
+    else if (Knife.Mode == SolidArcKnifeMode::Insert)
+    {
+        Knife.Aspect = 1.0;
+        const Vector3 Normal = Length(Knife.Spot.ZAxis) > 1.0e-9 ? Normalize(Knife.Spot.ZAxis) : Vector3{ 0.0, 0.0, 1.0 };
+        const Vector3 Plunge = Knife.Combination == FeatureCombination::Union ? Normal : (Normal * -1.0);
+        if (!Knife.PlacedCondition)
+        {
+            Knife.CompoundStage = 0;
+            if (HoveredCondition) HoverKnifeSpot(State, Frame, Local);
+            if (Moving && Knife.Preview) DropKnifePreview(Knife);
+            if (TypedCondition)
+            {
+                if (KnifeCompoundCondition(Knife)) { Knife.OuterRadius = 0.5 * Typed; Knife.InnerRadius = std::min(Knife.InnerRadius, 0.90 * Knife.OuterRadius); }
+                else Knife.Size = Typed;
+                Knife.SizedCondition = true;
+            }
+        }
+        else if (Knife.SizingCondition || Knife.CompoundStage == 1)
+        {
+            if (TypedCondition)
+            {
+                if (KnifeCompoundCondition(Knife)) { Knife.OuterRadius = 0.5 * Typed; Knife.InnerRadius = std::min(Knife.InnerRadius, 0.90 * Knife.OuterRadius); }
+                else Knife.Size = Typed;
+                Knife.SizedCondition = true;
+            }
+            else if (ImGui::IsMouseDown(ImGuiMouseButton_Left) ? Io.MouseDragMaxDistanceSqr[ImGuiMouseButton_Left] > ClickTolerance * ClickTolerance
+                                                               : Knife.SizeByMoveCondition && Moving && HoveredCondition)
+                DragKnifeInsert(State, Frame, Local);
+        }
+        else if (KnifeCompoundCondition(Knife) && Knife.CompoundStage == 2)
+        {
+            if (TypedCondition) Knife.OuterDepth = std::max(0.001, Typed);
+            else if (Moving && HoveredCondition && !ImGui::IsAnyMouseDown())
+            {
+                const OrbitRay Ray    = CastOrbitRay(Frame, Local.x, Local.y);
+                const Vector3  Facing = { Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+                std::optional<double> Along;
+                if (std::abs(Dot(Facing, Normal)) < 0.97) Along = ApproachSolidArcLine(Ray, Knife.Spot.Origin, Plunge);
+                if (Along) Knife.Drift = *Along;
+                else Knife.Drift += Drift;
+                Knife.OuterDepth = std::max(0.002, Snapped(Knife.Drift));
+            }
+        }
+        else if (KnifeCompoundCondition(Knife) && Knife.CompoundStage == 3)
+        {
+            if (TypedCondition) Knife.InnerRadius = std::clamp(0.5 * Typed, 0.001, 0.94 * Knife.OuterRadius);
+            else if (Moving && HoveredCondition && !ImGui::IsAnyMouseDown())
+            {
+                const Vector3 Floor = Knife.Spot.Origin + Plunge * Knife.OuterDepth;
+                if (const std::optional<double> Radial = MeasurePlaneRadialDistance(Frame, Local, Floor, Normal); Radial && *Radial > 1.0e-5)
+                {
+                    const double SnapStep = Io.KeyCtrl ? 1.0e-4 : 0.5 * SweepSnap;
+                    const double Raw      = std::round(*Radial / SnapStep) * SnapStep;
+                    Knife.InnerRadius     = std::clamp(Raw, 0.001, 0.94 * Knife.OuterRadius);
+                }
+            }
+        }
+        else if (KnifeCompoundCondition(Knife))
+        {
+            if (TypedCondition) { Knife.InnerDepth = std::max(0.002, Typed); Knife.InsertThroughCondition = false; }
+            else if (Moving && HoveredCondition && !ImGui::IsAnyMouseDown())
+            {
+                const OrbitRay Ray    = CastOrbitRay(Frame, Local.x, Local.y);
+                const Vector3  Facing = { Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+                const Vector3  Floor  = Knife.Spot.Origin + Plunge * Knife.OuterDepth;
+                std::optional<double> Along;
+                if (std::abs(Dot(Facing, Normal)) < 0.97) Along = ApproachSolidArcLine(Ray, Floor, Plunge);
+                if (Along) Knife.Drift = *Along;
+                else Knife.Drift += Drift;
+                Knife.InnerDepth = std::max(0.002, Snapped(Knife.Drift));
+            }
+        }
+        else
+        {
+            const double Shallow = KnifeInsertShallow(Knife);
+            if (TypedCondition) { Knife.InsertDepth = std::max(Shallow, Typed); Knife.DepthChosenCondition = true; }
+            else if (Moving && HoveredCondition && !ImGui::IsAnyMouseDown())
+            {
+                const OrbitRay Ray    = CastOrbitRay(Frame, Local.x, Local.y);
+                const Vector3  Facing = { Ray.Direction[0], Ray.Direction[1], Ray.Direction[2] };
+                std::optional<double> Along;
+                if (std::abs(Dot(Facing, Normal)) < 0.97) Along = ApproachSolidArcLine(Ray, Knife.Spot.Origin, Plunge);
+                if (Along) Knife.Drift = *Along;
+                else Knife.Drift += Drift;
+                Knife.InsertDepth          = std::max(Shallow, Snapped(Knife.Drift));
+                Knife.DepthChosenCondition = true;
+            }
+            if (!Knife.DepthChosenCondition && KnifeInsert(Knife)) Knife.InsertDepth = KnifeInsert(Knife)->Depth * Knife.Size;
+        }
+    }
+    const SolidArcSelection& Selection = State.Document.Selection;
+    const std::string        Key       = KnifeStageKey(State);
+    const bool               Placement = KnifePlacementCondition(State);
+    if (Placement && Knife.GhostKey != Key)
+    {
+        // The carried cutter leads at once (its triangles moved, no kernel); the Boolean follows at rest once placed.
+        Knife.GhostKey = Key;
+        Knife.Preview.reset();
+        Knife.StagedKey.clear();
+        Knife.Refusal.clear();
+        Knife.RigidCondition = Knife.HoverCondition || Knife.PlacedCondition;
+        if (Knife.RigidCondition) Knife.PreviewScene = MapSceneBodies(State.Scene, { Selection.Bodies.front() }, KnifePlacementMap(State));
+        Knife.Target = Knife.SpotBody;
+    }
+    if (Key == Knife.StagedKey || Knife.DrawPendingCondition) return;
+    const double Quiet = KnifeClock() - Knife.QuietSince;
+    if (Placement && (!Knife.PlacedCondition || Quiet < 0.3)) return;                                   // Placement: the cut stages at rest
+    if (Knife.Mode == SolidArcKnifeMode::Insert && !Knife.PlacedCondition && Quiet < 0.3) return;   // Hover: stage at rest only
+    if (Knife.Mode == SolidArcKnifeMode::Insert && Knife.PlacedCondition && Quiet < 0.15) return;  // Drag / depth: the ghost leads
+    if (Knife.StageMilliseconds > 120.0 && Quiet < 0.25) return;                                  // Slow stage: wait for a pause
+    Knife.StagedKey = Key;
+    Knife.Refusal.clear();
+    if (Knife.Mode == SolidArcKnifeMode::Insert && !Knife.PlacedCondition && !Knife.HoverCondition) { Knife.Preview.reset(); return; }
+    SolidArcPhaseClock Clock(State.Profile, "viewport · knife stage");
+    const double Start = KnifeClock();
+    Knife.Target  = Knife.Mode == SolidArcKnifeMode::Sketch ? KnifeSketchTarget(State, Knife.Sketch)
+                  : Knife.Mode == SolidArcKnifeMode::Insert || Placement ? Knife.SpotBody : (Selection.Bodies.empty() ? std::string{} : Selection.Bodies.front());
+    Knife.Preview = std::make_unique<SolidArcDocument>(CloneSolidArcDocument(State.Document));
+    const SolidArcCommandOutcome Outcome = RunKnife(State, *Knife.Preview);
+    Knife.PreviewOutcome = Outcome;
+    // A refused edge blend keeps the sliced pieces on screen (more edges can still be picked, the refusal says which).
+    const bool SlicedCondition = !Outcome.AcceptedCondition && !Knife.Blends.empty() && Knife.Preview->Regeneration.Bodies.size() > State.Document.Regeneration.Bodies.size();
+    if (!Outcome.AcceptedCondition) Knife.Refusal = Legible(Outcome.Refusal);
+    if (!Outcome.AcceptedCondition && !SlicedCondition) Knife.Preview.reset();
+    else
+    {
+        Knife.PreviewScene   = BuildSolidArcScene(*Knife.Preview);
+        Knife.RigidCondition = false;
+    }
+    Knife.StageMilliseconds = (KnifeClock() - Start) * 1.0e3;
+}
+
+// 3D cutter: the cut stages live while its size is drawn (at rest once a stage is slow), as the 2D knife's depth does.
+void StageKnifeSolid(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    SolidArcConstructRequest Request;
+    std::string              Target;
+    if (!ComposeKnifeSolid(State, true, Request, Target).empty())
+    {
+        if (Knife.Preview || !Knife.StagedKey.empty()) DropKnifePreview(Knife);
+        return;
+    }
+    const std::string Key = KnifeSolidKey(State, Request, Target);
+    if (Key == Knife.StagedKey) return;
+    const double Quiet = KnifeClock() - Knife.QuietSince;
+    if (Knife.StageMilliseconds > 120.0 && Quiet < 0.25) return;                                  // Slow stage: wait for a pause
+    SolidArcPhaseClock Clock(State.Profile, "viewport · knife solid stage");
+    const double Start = KnifeClock();
+    Knife.StagedKey = Key;
+    Knife.Target    = Target;
+    Knife.Refusal.clear();
+    Knife.RigidCondition = false;
+    Knife.Preview = std::make_unique<SolidArcDocument>(CloneSolidArcDocument(State.Document));
+    Knife.PreviewOutcome = KnifeSolidArcPrimitive(*Knife.Preview, Request, Target, Knife.Combination, Knife.KeepCondition);
+    if (!Knife.PreviewOutcome.AcceptedCondition) { Knife.Refusal = Legible(Knife.PreviewOutcome.Refusal); Knife.Preview.reset(); }
+    else Knife.PreviewScene = BuildSolidArcScene(*Knife.Preview);
+    Knife.StageMilliseconds = (KnifeClock() - Start) * 1.0e3;
+}
+
+// FinishSolidSession for a knife's 3D cutter: the staged cut is adopted when it shows exactly this cutter, else run. A
+// refusal keeps the drawing open with the reason (as Construct does).
+void FinishKnifeSolid(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession&   Knife   = State.Knife;
+    SolidArcDrawingSession& Drawing = State.Drawing;
+    SolidArcConstructRequest Request;
+    std::string              Target;
+    if (const std::string Refusal = ComposeKnifeSolid(State, false, Request, Target); !Refusal.empty())
+    {
+        Drawing.Refusal = Legible(Refusal);
+        Announce(State, Drawing.Refusal);
+        return;
+    }
+    const bool Adoptable = Knife.Preview && Knife.PreviewOutcome.AcceptedCondition && Knife.StagedKey == KnifeSolidKey(State, Request, Target);
+    SolidArcScene Staged;
+    if (Adoptable) Staged = std::move(Knife.PreviewScene);
+    const SolidArcCommandOutcome Outcome = Adoptable ? AdoptSolidArcPreview(State.Document, std::move(*Knife.Preview), Knife.PreviewOutcome)
+                                                     : KnifeSolidArcPrimitive(State.Document, Request, Target, Knife.Combination, Knife.KeepCondition);
+    if (!Outcome.AcceptedCondition)
+    {
+        DropKnifePreview(Knife);
+        Drawing.Refusal = Legible(Outcome.Refusal);
+        Knife.Refusal   = Drawing.Refusal;
+        Conclude(State, Outcome);
+        return;
+    }
+    if (Adoptable) State.ReadyScene = std::move(Staged);
+    Knife.Target = Target;
+    ++Knife.Commits;
+    CloseKnifeSession(State, {});
+    State.FocusedStep = {};
+    State.PickMode    = SolidArcPickMode::Solid;
+    Conclude(State, Outcome);
+}
+
+// Slice knife: the edge of a staged piece under the pointer (8 px) becomes an edge treatment (the next profile and size),
+// or, already one, takes the focus. False when no piece edge is there (the click then applies).
+bool PickKnifeBlendEdge(SolidArcWorkspaceState& State, ImVec2 Local)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (!Knife.Preview || Knife.PreviewScene.Edges.empty()) return false;
+    const OrbitCameraFrame            Frame = ViewportFrame(State);
+    const OrbitRay                    Ray   = CastOrbitRay(Frame, Local.x, Local.y);
+    const std::optional<SolidArcPick> Pick  = PickSolidArcScene(Knife.PreviewScene, Ray, 8.0 * Frame.WorldPerPixel, State.Style.XRayEnabled, ActiveSectionClip(State));
+    if (!Pick || !(Pick->Identity & IdentityEdgeBit)) return false;
+    const uint32_t Index = (Pick->Identity & ~IdentityEdgeBit) - 1u;
+    if (Index >= Knife.PreviewScene.Edges.size()) return false;
+    const SolidArcSceneEdge& Edge = Knife.PreviewScene.Edges[Index];
+    if (Edge.Body >= Knife.PreviewScene.Bodies.size()) return false;
+    const std::string Body = Knife.PreviewScene.Bodies[Edge.Body].Key;
+    for (size_t Existing = 0; Existing < Knife.Blends.size(); ++Existing)
+    {
+        if (Knife.Blends[Existing].Edge != Edge.Name || Knife.Blends[Existing].Body != Body) continue;
+        Knife.BlendFocus = int(Existing);
+        Knife.Typed.clear();
+        Announce(State, Compose("Knife · edge blend %d focused · D fillet · C chamfer · type a size · Delete removes it", int(Existing) + 1));
+        return true;
+    }
+    Knife.Blends.push_back({ Edge.Name, Body, Knife.BlendShape, Knife.BlendSize });
+    Knife.BlendFocus = int(Knife.Blends.size()) - 1;
+    Knife.Typed.clear();
+    Knife.StagedKey.clear();
+    Announce(State, Compose("Knife · %s %s m on %s of %s (edge blend %d) · D fillet · C chamfer · type a size · more edges, then right-click / Enter",
+                            Knife.BlendShape == BlendProfile::Fillet ? "fillet" : "chamfer", FormatLength(Knife.BlendSize).c_str(), Edge.Name.c_str(),
+                            SolidArcBodyCaption(*Knife.Preview, Body).c_str(), int(Knife.Blends.size())));
+    return true;
+}
+
+// Left-click: Insert places (then applies), Object picks bodies, Sketch applies (a slice: an edge of a piece is treated).
+void ClickKnifeSession(SolidArcWorkspaceState& State, ImVec2 Local)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
+    if (Knife.Mode == SolidArcKnifeMode::Object)
+    {
+        // One picked body: the click places it, the next cuts (Shift-click still adds bodies: in-place cutters).
+        if (KnifePlacementCondition(State) && !ImGui::GetIO().KeyShift)
+        {
+            if (!Knife.PlacedCondition) PlaceKnifeCutter(State);
+            else ApplyKnifeSession(State);
+            return;
+        }
+        PickAtPointer(State, Local, PickIntentOf(ImGui::GetIO()));
+        return;
+    }
+    if (Knife.Mode == SolidArcKnifeMode::Sketch && KnifeSliceCondition(State))
+    {
+        // A slice: clicks pick edges of the pieces to blend; right-click / Enter / Apply split it (a stray click never does).
+        if (!PickKnifeBlendEdge(State, Local))
+            Announce(State, Knife.Preview ? "Knife · no piece edge there · click an edge to fillet / chamfer it · right-click / Enter applies"
+                                          : "Knife · the pieces are still staging · click an edge once they show · right-click / Enter applies");
+        return;
+    }
+    if (Knife.Mode == SolidArcKnifeMode::Insert)
+    {
+        if (!Knife.PlacedCondition)
+        {
+            if (!Knife.HoverCondition) { Announce(State, "Knife: point at a body face to place the cutter"); return; }
+            Knife.PlacedCondition = true;
+            ReleaseKnifeInsert(State);
+            return;
+        }
+        if (KnifeCompoundCondition(Knife))
+        {
+            if (Knife.CompoundStage <= 1)
+            {
+                ReleaseKnifeInsert(State);
+                return;
+            }
+            if (Knife.CompoundStage == 2)
+            {
+                Knife.CompoundStage = 3;
+                Knife.Typed.clear();
+                Announce(State, Compose("Knife · %s Stage 1 depth %s m · move radially for Stage 2 inner Ø / width (< %s m) · click for Stage 2 extrude",
+                                        KnifeLibraryEntryName(Knife, Knife.Insert).c_str(), FormatLength(Knife.OuterDepth).c_str(), FormatLength(2.0 * Knife.OuterRadius).c_str()));
+                return;
+            }
+            if (Knife.CompoundStage == 3)
+            {
+                Knife.CompoundStage = 4;
+                Knife.Drift         = Knife.InnerDepth;
+                Knife.Typed.clear();
+                Announce(State, Compose("Knife · %s Stage 2 Ø %s m · pull along normal for Stage 2 extrude depth (T through · L live boolean) · click / Enter cuts",
+                                        KnifeLibraryEntryName(Knife, Knife.Insert).c_str(), FormatLength(2.0 * Knife.InnerRadius).c_str()));
+                return;
+            }
+        }
+        else if (Knife.CompoundStage <= 1)
+        {
+            ReleaseKnifeInsert(State);
+            return;
+        }
+    }
+    ApplyKnifeSession(State);
+}
+
+// Sketch cutter, drawn like a Construct primitive: the profile on the face, the same outline at the depth (or through
+// the body, or out of it for a Q boss), the side lines at the outline's extremes, and dimension lines: Ø for a lone
+// circle else W / H of its box, and the depth along the normal ("through" with T).
+void DrawKnifeCutter(SolidArcWorkspaceState& State, ImDrawList* Canvas, const OrbitCameraFrame& Frame)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    if (!Knife.ActiveCondition || Knife.Mode != SolidArcKnifeMode::Sketch || Knife.DrawPendingCondition) return;
+    KnifeCutterOutline Outline;
+    if (!MeasureKnifeCutter(State, Outline)) return;
+    const bool   Slice   = KnifeSliceCondition(State);
+    const bool   Boss    = Knife.Combination == FeatureCombination::Union && !Slice;
+    const bool   Through = (Knife.ThroughCondition && !Boss) || Slice;
+    double Top = 0.0, Bottom = 0.0;
+    if (Through) KnifeSketchSpan(State, KnifeSketchTarget(State, Knife.Sketch), Top, Bottom);
+    const double Far    = Boss ? Knife.Depth : Through ? Bottom : -Knife.Depth;                // [len] - Far outline along the plane normal
+    const ImU32  Ink    = Boss ? IM_COL32(0x4c, 0xd9, 0x7b, 0xff) : IM_COL32(0xff, 0xc8, 0x3d, 0xff);
+    const ImU32  Faint  = Boss ? IM_COL32(0x4c, 0xd9, 0x7b, 0x90) : IM_COL32(0xff, 0xc8, 0x3d, 0x90);
+    const auto   World  = [&](Vector2 Point, double Height) { return PlacePlanePoint(Outline.Plane, Point) + Outline.Plane.ZAxis * Height; };
+    const auto   Stroke = [&](const std::vector<Vector2>& Chain, double Height, ImU32 Colour, float Width)
+    {
+        std::vector<ImVec2> Pixels;
+        for (const Vector2& Point : Chain) { ImVec2 Out; if (ProjectWorldPoint(State, Frame, World(Point, Height), Out)) Pixels.push_back(Out); }
+        if (Pixels.size() >= 2) Canvas->AddPolyline(Pixels.data(), int(Pixels.size()), Colour, 0, Width);
+    };
+    for (const std::vector<Vector2>& Chain : Outline.Chains)
+    {
+        Stroke(Chain, 0.0, Ink, 2.0f);
+        Stroke(Chain, Far, Faint, 1.5f);
+    }
+    // Side lines at the outline's extreme samples along the plane axes.
+    std::vector<Vector2> Extremes;
+    for (const std::vector<Vector2>& Chain : Outline.Chains)
+        for (const Vector2& Point : Chain)
+        {
+            const bool Edge = std::abs(Point.X - Outline.Low.X) < 1.0e-9 || std::abs(Point.X - Outline.High.X) < 1.0e-9 || std::abs(Point.Y - Outline.Low.Y) < 1.0e-9 ||
+                              std::abs(Point.Y - Outline.High.Y) < 1.0e-9;
+            if (Edge && std::none_of(Extremes.begin(), Extremes.end(), [&](const Vector2& Kept) { return Distance(Kept, Point) < 1.0e-6; })) Extremes.push_back(Point);
+        }
+    for (const Vector2& Point : Extremes)
+    {
+        ImVec2 Near, Deep;
+        if (ProjectWorldPoint(State, Frame, World(Point, 0.0), Near) && ProjectWorldPoint(State, Frame, World(Point, Far), Deep)) Canvas->AddLine(Near, Deep, Faint, 1.0f);
+    }
+    // Dimension lines.
+    const Vector2 Low = Outline.Low, High = Outline.High;
+    const double  Gap = 0.08 * std::max(High.X - Low.X, High.Y - Low.Y) + 0.02;              // [len] - Off the outline
+    if (Slice && !Outline.Chains.empty() && Outline.Chains.front().size() >= 2)
+    {
+        // A slice line: its length, beside it.
+        const Vector2 Start = Outline.Chains.front().front(), End = Outline.Chains.back().back();
+        const Vector2 Along = End - Start;
+        const double  Span  = Length(Along);
+        if (Span > 0.0)
+        {
+            const Vector2 Side = Vector2{ -Along.Y, Along.X } * (Gap / Span);
+            DrawDimensionLine(State, Frame, Canvas, World(Start + Side, 0.0), World(End + Side, 0.0), DimensionText("L", Span));
+        }
+    }
+    else if (Outline.Diameter > 0.0)
+    {
+        const double Half = 0.5 * Outline.Diameter;
+        DrawDimensionLine(State, Frame, Canvas, World({ Outline.Centre.X - Half, Low.Y - Gap }, 0.0), World({ Outline.Centre.X + Half, Low.Y - Gap }, 0.0),
+                          DimensionText("Ø", Outline.Diameter));
+    }
+    else
+    {
+        DrawDimensionLine(State, Frame, Canvas, World({ Low.X, Low.Y - Gap }, 0.0), World({ High.X, Low.Y - Gap }, 0.0), DimensionText("W", High.X - Low.X));
+        DrawDimensionLine(State, Frame, Canvas, World({ High.X + Gap, Low.Y }, 0.0), World({ High.X + Gap, High.Y }, 0.0), DimensionText("H", High.Y - Low.Y));
+    }
+    const Vector2     Foot = { Low.X - Gap, Low.Y - Gap };
+    const std::string Text = Slice ? std::string("slice · splits the body") : Through ? std::string("through") : DimensionText(Boss ? "height" : "depth", Knife.Depth);
+    DrawConstructionLine(State, Frame, Canvas, World({ Low.X, Low.Y }, 0.0), World(Foot, 0.0));
+    DrawDimensionLine(State, Frame, Canvas, World(Foot, 0.0), World(Foot, Far), Text, ImVec2(-18.0f, 0.0f));
+}
+
+// Compound cutter / user STEP ghost: Stage 1 + Stage 2 wireframe at the spot (amber on hover; cyan once placed) plus
+// live radial Ø₁ / Ø₂ and axial D₁ / D₂ dimension lines for the multi-stage interactive workflow.
+void DrawKnifeGhost(SolidArcWorkspaceState& State, ImDrawList* Canvas, const OrbitCameraFrame& Frame)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    if (!Knife.ActiveCondition || Knife.Mode != SolidArcKnifeMode::Insert || !(Knife.HoverCondition || Knife.PlacedCondition)) return;
+    const bool    Raised = Knife.Combination == FeatureCombination::Union;
+    const ImU32   Colour = Knife.PlacedCondition ? IM_COL32(0x4d, 0xd2, 0xff, 0xff) : IM_COL32(0xff, 0xc8, 0x3d, 0xff);
+    const Vector3 Normal = Normalize(Knife.Spot.ZAxis);
+    const Vector3 Plunge = Raised ? Normal : (Normal * -1.0);
+    const Vector3 Across = Knife.Spot.XAxis * std::cos(Knife.Turn) + Knife.Spot.YAxis * std::sin(Knife.Turn);
+    const Vector3 Along  = Knife.Spot.YAxis * std::cos(Knife.Turn) - Knife.Spot.XAxis * std::sin(Knife.Turn);
+
+    if (KnifeCompoundCondition(Knife))
+    {
+        const SolidArcCompoundCutterSpec Spec = ComposeKnifeCompoundSpec(State);
+        for (const std::array<Vector3, 2>& Segment : BuildSolidArcCompoundCutterSegments(Spec))
+        {
+            ImVec2 Start, End;
+            if (ProjectWorldPoint(State, Frame, Segment[0], Start) && ProjectWorldPoint(State, Frame, Segment[1], End))
+                Canvas->AddLine(Start, End, Colour, 1.6f);
+        }
+        ImVec2 Centre;
+        if (ProjectWorldPoint(State, Frame, Knife.Spot.Origin, Centre)) Canvas->AddCircle(Centre, 4.0f, Colour, 16, 1.5f);
+        const double  R1    = Spec.OuterRadius;
+        const double  R2    = Spec.InnerRadius;
+        const double  D1    = Spec.OuterDepth;
+        const double  D2    = Spec.InnerDepth;
+        const Vector3 Below = Knife.Spot.Origin - Along * (R1 + 0.08 * (2.0 * R1) + 0.02);
+        DrawDimensionLine(State, Frame, Canvas, Below - Across * R1, Below + Across * R1, DimensionText("Ø1", 2.0 * R1));
+        if (Knife.PlacedCondition && Knife.CompoundStage >= 2)
+        {
+            const Vector3 Side1 = Knife.Spot.Origin + Across * (R1 + 0.08 * (2.0 * R1) + 0.02);
+            DrawDimensionLine(State, Frame, Canvas, Side1, Side1 + Plunge * D1, DimensionText("D1", D1));
+        }
+        if (Knife.PlacedCondition && Knife.CompoundStage >= 3)
+        {
+            const Vector3 Floor = Knife.Spot.Origin + Plunge * D1;
+            const Vector3 InnerRef = Floor + Along * (R2 + 0.05 * (2.0 * R1) + 0.015);
+            DrawDimensionLine(State, Frame, Canvas, InnerRef - Across * R2, InnerRef + Across * R2, DimensionText("Ø2", 2.0 * R2));
+        }
+        if (Knife.PlacedCondition && Knife.CompoundStage >= 4)
+        {
+            const Vector3 Side2   = Knife.Spot.Origin - Across * (R1 + 0.08 * (2.0 * R1) + 0.02) + Plunge * D1;
+            const bool    Through = Knife.InsertThroughCondition && !Raised;
+            DrawDimensionLine(State, Frame, Canvas, Side2, Side2 + Plunge * D2, Through ? std::string("through") : DimensionText("D2", D2));
+        }
+        if (std::abs(Knife.Turn) > 1.0e-9 && ProjectWorldPoint(State, Frame, Knife.Spot.Origin, Centre))
+            DrawDimensionPill(Canvas, ImVec2(Centre.x, Centre.y - 22.0f), Compose("%.1f°", Knife.Turn * 180.0 / std::numbers::pi), AngleInk);
+        return;
+    }
+
+    const SolidArcInsert* Insert = KnifeInsert(Knife);
+    if (!Insert) return;
+    const double    Depth  = KnifeInsertDepth(State);
+    const double    Reach  = Depth / std::max(1.0e-9, Knife.Size);
+    const AffineMap Map    = PlaceSolidArcInsert(Knife.Spot, Knife.Size, Knife.Turn, Raised, 1.0, 1.0);
+    const auto      Carry  = [&](Vector3 Point) { return Map.ColumnX * Point.X + Map.ColumnY * Point.Y + Map.ColumnZ * Point.Z + Map.Shift; };
+    for (const std::array<Vector3, 2>& Segment : Insert->Segments)
+    {
+        ImVec2 Start, End;
+        if (ProjectWorldPoint(State, Frame, Carry(ReachSolidArcInsertPoint(*Insert, Segment[0], Reach)), Start) &&
+            ProjectWorldPoint(State, Frame, Carry(ReachSolidArcInsertPoint(*Insert, Segment[1], Reach)), End))
+            Canvas->AddLine(Start, End, Colour, 1.5f);
+    }
+    ImVec2 Centre;
+    if (ProjectWorldPoint(State, Frame, Knife.Spot.Origin, Centre)) Canvas->AddCircle(Centre, 4.0f, Colour, 16, 1.5f);
+    Vector2 Low, High;
+    MeasureInsertFootprint(*Insert, Low, High);
+    const double  Width  = Knife.Size * (High.X - Low.X), Height = Knife.Size * (High.Y - Low.Y);
+    const Vector3 Below  = Knife.Spot.Origin - Along * (0.5 * Height + 0.08 * Knife.Size + 0.02);
+    DrawDimensionLine(State, Frame, Canvas, Below - Across * (0.5 * Width), Below + Across * (0.5 * Width), DimensionText("W", Width));
+    if (Knife.PlacedCondition && Knife.CompoundStage >= 2)
+    {
+        const Vector3 Side    = Knife.Spot.Origin + Across * (0.5 * Width + 0.08 * Knife.Size + 0.02);
+        const bool    Through = Knife.InsertThroughCondition && !Raised;
+        DrawDimensionLine(State, Frame, Canvas, Side, Side + Plunge * Depth, Through ? std::string("through") : DimensionText(Raised ? "H" : "D", Depth));
+    }
+    if (std::abs(Knife.Turn) > 1.0e-9 && ProjectWorldPoint(State, Frame, Knife.Spot.Origin, Centre))
+        DrawDimensionPill(Canvas, ImVec2(Centre.x, Centre.y - 22.0f), Compose("%.1f°", Knife.Turn * 180.0 / std::numbers::pi), AngleInk);
+}
+
+// 📝 Bevel handles under the pointer: a press on one starts its drag — the grip follows the pointer along the handle's
+//    bisector (the closest point of the pointer ray to that line) and the bevel follows the grip, snapped to 1 mm (Ctrl
+//    free, Shift fine). The
+//    uniform handle sets the size; a corner handle gives its corner its own size. True while a handle owns the pointer.
+// Screen base and tip of a handle. A bisector that points (nearly) at the camera would project to a dot, so its tip
+// stands straight up from the base on screen instead (ScreenCondition: the drag then sizes by pointer x).
+[[nodiscard]] bool ProjectBevelHandle(const SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, int Index, double Lead, ImVec2& Base, ImVec2& Tip,
+                                      bool& ScreenCondition)
+{
+    const SolidArcBevelSession& Bevel = State.Bevel;
+    if (!ProjectWorldPoint(State, Frame, BevelHandleBase(Bevel, Index), Base) || !ProjectWorldPoint(State, Frame, BevelHandleTip(Bevel, Index, Lead), Tip)) return false;
+    const float Reach = float(Lead / Frame.WorldPerPixel);                                   // [px] - Unforeshortened stick length
+    ScreenCondition   = std::hypot(Tip.x - Base.x, Tip.y - Base.y) < 0.35f * Reach;
+    if (ScreenCondition) Tip = ImVec2(Base.x, Base.y - std::max(Reach, BevelHandleLead + 8.0f));
+    return true;
+}
+
+bool DriveBevelHandles(SolidArcWorkspaceState& State, const OrbitCameraFrame& Frame, ImVec2 Local, bool PointerCondition)
+{
+    SolidArcBevelSession& Bevel = State.Bevel;
+    Bevel.HoverHandle = -1;
+    if (Bevel.Handles.empty()) { Bevel.DragHandle = -1; return false; }
+    const ImGuiIO& Io   = ImGui::GetIO();
+    const double   Lead = BevelHandleLead * Frame.WorldPerPixel;
+    const OrbitRay Ray  = CastOrbitRay(Frame, Local.x, Local.y);
+    if (Bevel.DragHandle >= 0 && Bevel.DragHandle < int(Bevel.Handles.size()))
+    {
+        const SolidArcBlendHandle& Handle = Bevel.Handles[size_t(Bevel.DragHandle)];
+        const std::optional<double> Parameter = Bevel.DragScreenCondition ? std::optional<double>((Io.MousePos.x - Bevel.DragLast) * Frame.WorldPerPixel)
+                                                                          : MeasureAxisParameter(Ray, Handle.Position, Handle.Direction);
+        if (Parameter)
+        {
+            // Along the bisector the grip stays under the pointer: the bevel's mid-line moves with it, so pushing the
+            // grip into the body deepens the bevel (depth / rate = size); a grip facing the camera sizes by pointer x.
+            const double Moved = (*Parameter - Bevel.DragOrigin) * (Io.KeyShift ? 0.1 : 1.0);   // [len] - Grip travel
+            double Size = Bevel.DragScreenCondition ? Bevel.DragSize + Moved : Bevel.DragSize - Moved / BevelHandleDepthRate(Bevel, Bevel.DragHandle);
+            Size = std::max(1.0e-3, Io.KeyCtrl ? std::round(Size * 1.0e6) * 1.0e-6 : std::round(Size * 1.0e3) * 1.0e-3);
+            // Detent (the report "when we bevel and edges / vertices come close together they must merge"): within a few
+            // pixels of a size where the rails meet a neighbour edge or each other, the size sits exactly on it, so the
+            // modeller fuses them (one ridge, one apex) instead of leaving a sliver face. Ctrl drags free.
+            if (Bevel.DragHandle == 0 && !Io.KeyCtrl && Bevel.Verb == SolidArcSessionVerb::Blend)
+            {
+                const double Rate = Bevel.DragScreenCondition ? 1.0 : std::max(0.2, BevelHandleDepthRate(Bevel, 0));
+                const double Band = BevelMergeBand * Frame.WorldPerPixel / Rate;            // [len] - Size caught
+                for (const double Merge : Bevel.Shape == BlendProfile::Chamfer ? Bevel.Fit.ChamferMerges : Bevel.Fit.FilletMerges)
+                {
+                    if (std::abs(Size - Merge) > Band) continue;
+                    if (Size != Merge) ++Bevel.MergeSnaps;
+                    Size = Merge;
+                    break;
+                }
+            }
+            Size = BoundBevelValue(State, Bevel.DragHandle, Size);                           // Stops at the largest accepted size
+            if (Bevel.DragHandle == 0) Bevel.Size = Size;
+            else Bevel.CornerSizes[size_t(Bevel.DragHandle)] = Size;
+            WriteBevelText(Bevel);
+            if (Bevel.DragHandle > 0) std::snprintf(Bevel.CornerText.data(), Bevel.CornerText.size(), "%.4g", Size);
+        }
+        Bevel.HoverHandle = Bevel.DragHandle;
+        if (!ImGui::IsMouseDown(ImGuiMouseButton_Left))
+        {
+            Announce(State, Bevel.DragHandle == 0 ? Compose("Bevel size %s m (handle)", FormatLength(Bevel.Size).c_str())
+                                                  : Compose("Corner %d: %s m (variable · %d corner size(s))", Bevel.DragHandle, FormatLength(Bevel.CornerSizes[size_t(Bevel.DragHandle)]).c_str(), CountBevelCorners(Bevel)));
+            Bevel.DragHandle = -1;
+        }
+        return true;
+    }
+    Bevel.DragHandle = -1;
+    if (!PointerCondition) return false;
+    const ImVec2 Pointer(State.ViewportRect[0] + Local.x, State.ViewportRect[1] + Local.y);
+    float Nearest = BevelHandleReach;
+    bool Facing = false;                                                                     // [-] - Hovered handle's axis faces the camera
+    for (int Index = int(Bevel.Handles.size()) - 1; Index >= 0; --Index)                     // Corners first, the uniform handle wins a tie
+    {
+        ImVec2 Base, Tip;
+        bool   Screen = false;
+        if (!ProjectBevelHandle(State, Frame, Index, Lead, Base, Tip, Screen)) continue;
+        const float Distance = std::hypot(Tip.x - Pointer.x, Tip.y - Pointer.y);
+        if (Distance <= Nearest) { Nearest = Distance; Bevel.HoverHandle = Index; Facing = Screen; }
+    }
+    if (Bevel.HoverHandle >= 0 && ImGui::IsMouseClicked(ImGuiMouseButton_Left))
+    {
+        const SolidArcBlendHandle& Handle = Bevel.Handles[size_t(Bevel.HoverHandle)];
+        Bevel.DragHandle          = Bevel.HoverHandle;
+        Bevel.DragScreenCondition = Facing;
+        Bevel.DragLast            = Io.MousePos.x;
+        Bevel.DragOrigin          = Facing ? 0.0 : MeasureAxisParameter(Ray, Handle.Position, Handle.Direction).value_or(0.0);
+        Bevel.DragSize        = BevelHandleSize(Bevel, Bevel.HoverHandle);
+        Bevel.PinnedCondition = true;                                                        // The handles drive the size from now on
+        if (Bevel.DragHandle > 0)
+        {
+            Bevel.VariableEnabled = false;                                                   // Corner sizes replace the V taper
+            Bevel.FocusCorner     = Bevel.DragHandle;
+        }
+    }
+    return Bevel.HoverHandle >= 0;
+}
+
+// Handles: a stick from the bevel's mid-line to the grip; the uniform grip a cyan ring, corner grips diamonds (amber
+// once they carry their own size). The size shows beside a hovered, dragged or sized handle. Tips register as
+// widgets BevelHandle0 (uniform), BevelHandle1 … for scripts.
+void DrawBevelHandles(SolidArcWorkspaceState& State, ImDrawList* Canvas, const OrbitCameraFrame& Frame)
+{
+    const SolidArcBevelSession& Bevel = State.Bevel;
+    if (!Bevel.ActiveCondition || Bevel.Verb != SolidArcSessionVerb::Blend || Bevel.Handles.empty()) return;
+    const double Lead = BevelHandleLead * Frame.WorldPerPixel;
+    for (int Index = int(Bevel.Handles.size()) - 1; Index >= 0; --Index)
+    {
+        ImVec2 Base, Tip;
+        bool   Screen = false;
+        if (!ProjectBevelHandle(State, Frame, Index, Lead, Base, Tip, Screen)) continue;
+        const bool  Lit    = Index == Bevel.HoverHandle || Index == Bevel.DragHandle;
+        const bool  Sized  = Index > 0 && Bevel.CornerSizes[size_t(Index)] > 0.0;
+        const ImU32 Colour = Lit ? IM_COL32(0xff, 0xff, 0xff, 0xff) : Index == 0 ? IM_COL32(0x4d, 0xd2, 0xff, 0xff) : Sized ? IM_COL32(0xff, 0xc8, 0x3d, 0xff) : IM_COL32(0xc8, 0xc8, 0xc8, 0xe0);
+        Canvas->AddLine(Base, Tip, Colour, 1.5f);
+        if (Index == 0)
+        {
+            Canvas->AddCircleFilled(Tip, 5.5f, Colour, 20);
+            Canvas->AddCircle(Tip, 9.0f, Colour, 24, 1.5f);
+        }
+        else
+        {
+            const float Half = Lit ? 6.5f : 5.0f;
+            Canvas->AddQuadFilled(ImVec2(Tip.x, Tip.y - Half), ImVec2(Tip.x + Half, Tip.y), ImVec2(Tip.x, Tip.y + Half), ImVec2(Tip.x - Half, Tip.y), Colour);
+        }
+        if (Lit || Sized) Canvas->AddText(ImVec2(Tip.x + 12.0f, Tip.y - 8.0f), Colour, (FormatLength(BevelHandleSize(Bevel, Index)) + " m").c_str());
+        State.Widgets.Record("BevelHandle" + std::to_string(Index), ImVec2(Tip.x - 4.0f, Tip.y - 4.0f), ImVec2(Tip.x + 4.0f, Tip.y + 4.0f));
+    }
+}
+
+[[nodiscard]] std::string KnifeReadout(const SolidArcWorkspaceState& State)
+{
+    const SolidArcKnifeSession& Knife = State.Knife;
+    const std::string Typed = Knife.Typed.empty() ? std::string{} : " · typed " + Knife.Typed;
+    if (Knife.Mode == SolidArcKnifeMode::Sketch)
+    {
+        if (Knife.Sketch.empty()) return "Knife · draw a closed shape";
+        if (KnifeSliceCondition(State))
+            return Compose("Knife %s slices %s · through (two bodies)", CaptionOf(State.Document, Knife.Sketch).c_str(),
+                           Knife.Target.empty() ? "?" : SolidArcBodyCaption(State.Document, Knife.Target).c_str());
+        return Compose("Knife %s into %s · %s · %s%s", CaptionOf(State.Document, Knife.Sketch).c_str(), Knife.Target.empty() ? "?" : SolidArcBodyCaption(State.Document, Knife.Target).c_str(),
+                       KnifeCombinationLabel(Knife.Combination), Knife.ThroughCondition && Knife.Combination != FeatureCombination::Union ? "through" : ("depth " + FormatLength(Knife.Depth) + " m").c_str(),
+                       Typed.c_str());
+    }
+    if (Knife.Mode == SolidArcKnifeMode::Insert)
+    {
+        if (KnifeLibraryCount(Knife) == 0) return "Knife · the boolean library is empty";
+        const std::string Name = KnifeLibraryEntryName(Knife, Knife.Insert);
+        if (KnifeCompoundCondition(Knife))
+        {
+            static const char* StageNames[] = { "place centre", "Stage 1 Ø", "Stage 1 extrude", "Stage 2 Ø", "Stage 2 extrude" };
+            const char* StageName = StageNames[std::clamp(Knife.CompoundStage, 0, 4)];
+            const std::string D2Text = Knife.InsertThroughCondition && Knife.Combination != FeatureCombination::Union ? std::string("through") : (FormatLength(Knife.InnerDepth) + " m");
+            return Compose("Knife %s · %s · Ø1 %s × D1 %s m → Ø2 %s × D2 %s · %s%s", Name.c_str(), KnifeCombinationLabel(Knife.Combination),
+                           FormatLength(2.0 * Knife.OuterRadius).c_str(), FormatLength(Knife.OuterDepth).c_str(),
+                           FormatLength(2.0 * Knife.InnerRadius).c_str(), D2Text.c_str(), StageName, Typed.c_str());
+        }
+        const std::string Depth = Knife.InsertThroughCondition && Knife.Combination != FeatureCombination::Union ? std::string("through") : "depth " + FormatLength(KnifeInsertDepth(State)) + " m";
+        return Compose("Knife %s · %s · width %s m (uniform) · %.0f° · %s%s", Name.c_str(), KnifeCombinationLabel(Knife.Combination), FormatLength(Knife.Size).c_str(),
+                       Knife.Turn * 180.0 / std::numbers::pi, Depth.c_str(), Typed.c_str());
+    }
+    const std::vector<std::string>& Picked = State.Document.Selection.Bodies;
+    if (KnifePlacementCondition(State))
+        return Compose("Knife %s · %s · %s · sink %s m%s%s", SolidArcBodyCaption(State.Document, Picked.front()).c_str(), KnifeCombinationLabel(Knife.Combination),
+                       Knife.PlacedCondition ? ("placed on " + SolidArcBodyCaption(State.Document, Knife.SpotBody)).c_str()
+                       : Knife.HoverCondition ? ("over " + SolidArcBodyCaption(State.Document, Knife.SpotBody)).c_str() : "point at a face",
+                       FormatLength(Knife.Sink).c_str(), Knife.AlignCondition ? " · on the normal" : "", Typed.c_str());
+    return Compose("Knife %s · %s · %d cutter(s)%s", Picked.empty() ? "?" : SolidArcBodyCaption(State.Document, Picked.front()).c_str(), KnifeCombinationLabel(Knife.Combination),
+                   std::max(0, int(Picked.size()) - 1), Knife.KeepCondition ? " · kept" : "");
+}
+
+// Slice knife edge treatments: the next profile, then one row per picked edge (focus, fillet / chamfer, size, remove).
+void DrawKnifeBlendRows(SolidArcWorkspaceState& State)
+{
+    SolidArcKnifeSession& Knife = State.Knife;
