+OrbitCamera MakePresetPaneCamera(const OrbitCamera& Reference, OrbitViewPreset Preset, bool Orthographic) noexcept
+{
+    OrbitCamera Cam        = Reference;
+    Cam.OrthographicEnabled = Orthographic;
+    PresentOrbitView(Cam, Preset);
+    return Cam;
+}
