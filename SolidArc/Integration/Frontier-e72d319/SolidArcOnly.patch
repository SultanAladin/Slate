+frames 12
+expect bevel-refusal == 0
+expect bevel-size < 0.5
+expect bevel-size > 0.01
+expect bevel-limit-stops > 0
+capture 297BevelBound
+click @BevelMouse
+frames 1
+move viewport 0.5 0.5
+frames 2
