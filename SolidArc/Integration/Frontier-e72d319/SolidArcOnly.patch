+// 🧩 SolidArc document: feature tree, atomic commands with undo / redo, selection by persistent name, regeneration
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "UI/SolidArc/Document/SolidArcImagePlane.h"
