index 0000000000000000000000000000000000000000..93e9c60bb762ee3797c00d5e53b9d7270151749a
--- /dev/null
+++ b/Exhibits/SolidArc/Code/Scripts/DeleteWalkthrough.txt
@@ -0,0 +1,131 @@
+# SolidArc delete walkthrough (W68) - X / Delete deletes whatever is picked, in the viewport and in the Outliner (the row
+# under the pointer): a plain box edge refuses (no closed solid without it, the pick stays), a free sketch row goes, the
+# box's own sketch row leaves the scene while the box keeps it, a mode 1 sketch point takes its two lines, the body row is
+# removed, and undo brings it back.
+# Run: SolidArcCapture --specimen --reset-files --recovery .../DeleteRecovery.solidarc
+#      --document .../Delete.solidarc --script Scripts/DeleteWalkthrough.txt
+# Closed forms: box 2 x 1.5 x 1 = 3.
+
+snap grid on
+
+# 1. a box drawn from the Construct menu (2 x 1.5 x 1, x in [-2, 0], y in [-1.5, 0], z in [0, 1]): Sketch#1 + Extrude#2
+key N Ctrl
+frames 3
+click @ConstructLauncher
+frames 2
+click @ConstructBlock
+frames 2
+click world -2.0 -1.5 0.0
+frames 2
+move world 0.0 0.0 0.0
+frames 2
+click world 0.0 0.0 0.0
+frames 2
+move world 0.0 0.0 1.0
+frames 2
+click world 0.0 0.0 1.0
+frames 3
+expect bodies == 1
+expect volume ~ 3
+expect steps == 2
+
+# 2. edge mode, the front-top edge picked, X: refused (two different planes), the box and the pick stay
+key 2
+frames 1
+move world -1.6 -1.5 1.0
+frames 1
+click world -1.6 -1.5 1.0
+frames 3
+expect selected-edges == 1
+key X
+frames 3
+expect volume ~ 3
+expect faces == 6
+expect steps == 2
+expect selected-edges == 1
+capture 337DeleteBoxEdgeRefused
+key Escape
+frames 2
+
+# 3. a free rectangle beside the box (Sketch#3); the pointer on its Outliner row and Delete: the row and the step go
+key Q Shift
+frames 2
+click world 1.0 -1.0 0.0
+frames 2
+click world 2.0 0.0 0.0
+frames 3
+expect steps == 3
+move @Figure:Sketch#3
+frames 2
+expect outliner-hover == 1
+capture 338DeleteOutlinerHover
+key Delete
+frames 3
+expect steps == 2
+expect bodies == 1
+capture 339DeleteOutlinerSketchGone
+
+# 4. the box's own sketch row and X: it leaves the scene (removed, off the Outliner), the box keeps it
+move @Figure:Sketch#1
+frames 2
+key X
+frames 3
+expect removed-curves == 1
+expect bodies == 1
+expect volume ~ 3
+expect steps == 2
+capture 340DeleteExtrudedSketch
+
+# 5. another rectangle (Sketch#3 again: the freed ordinal), mode 1, its first corner picked, X: the two lines through it go
+key Q Shift
+frames 2
+click world 1.0 -1.0 0.0
+frames 2
+click world 2.0 0.0 0.0
+frames 3
+expect steps == 3
+key 1
+frames 3
+move @SketchPointSketch3.0
+frames 1
+click @SketchPointSketch3.0
+frames 3
+expect picked-points == 1
+key X
+frames 3
+expect picked-points == 0
+expect steps == 3
+expect refused == 0
+capture 341DeleteSketchPoint
+
+# 6. the body row (Extrude#2) and X: the box is removed
+move @Figure:Extrude#2
+frames 2
+key X
+frames 3
+expect bodies == 0
+capture 342DeleteBodyFromOutliner
+
+# 7. undo: the box is back
+move viewport 0.5 0.5
+frames 1
+key Z Ctrl
+frames 3
+expect bodies == 1
+expect volume ~ 3
+capture 343DeleteUndone
+
+# 8. the body row picked, the sketch row Shift-picked, X over the sketch row: both picks go, not just the hovered row
+click @Figure:Extrude#2
+frames 2
+click @Figure:Sketch#3 Left Shift
+frames 2
+move @Figure:Sketch#3
+frames 2
+expect outliner-hover == Sketch#3
+key X
+frames 3
+expect bodies == 0
+expect sketches lacks Rectangle1
+expect removed-curves == 1
+capture 344DeleteOutlinerPicks
diff --git a/Exhibits/SolidArc/Code/Scripts/DrawingSheetWalkthrough.txt b/Exhibits/SolidArc/Code/Scripts/DrawingSheetWalkthrough.txt
new file mode 100644
index 0000000000000000000000000000000000000000..849ca8564a0394c38ccbf624368a6be25f1122b2
--- /dev/null
+++ b/Exhibits/SolidArc/Code/Scripts/DrawingSheetWalkthrough.txt
@@ -0,0 +1,104 @@
+# SolidArc drawing sheet walkthrough — Alt+D (Fusion Drawing; Plasticity has none) shows the shown solid bodies
+# as an ISO drawing (kernel views, hidden lines, automatic dimensions in millimetres, title block) in place of the
+# model; the card picks paper, angle, scale, views and title fields (saved with the document) and exports SVG / DXF R12
+# beside the document.
+# Run: SolidArcCapture --specimen --reset-files --recovery …/SheetRecovery.solidarc
+#      --document …/Sheet.solidarc --script Exhibits/SolidArc/Code/Scripts/DrawingSheetWalkthrough.txt
+# Bracket specimen: block 4 × 2.5 × 1 m, boss r 0.5 (z 1 … 1.75) at (1, 1.25), hole r 0.3 at (3, 1.25), Fillet1 r 0.25
+# on the right top edge, Chamfer1 0.2 on the left top edge.
+
+# Placement snapped to the 0.1 grid, as these checks were written for (free placement is the default since ⑮ of Snapping).
+snap grid on
+
+# ① Alt+D: A3, first angle (ISO / SANS 10111), the largest standard scale that fits; Front, Top below it, Right on its
+#    left, the isometric in the free corner; 4000 × 2500 × 1750 mm overall, ⌀1000 boss, ⌀600 hole
+frames 3
+expect drawing-sheet == 0
+key D Alt
+frames 2
+expect drawing-sheet == 1
+expect drawing-sheet contains A3
+expect drawing-sheet contains First
+expect drawing-sheet-views == 4
+expect drawing-sheet-views == Front Top Right Isometric
+expect drawing-sheet-dimensions contains 4000
+expect drawing-sheet-dimensions contains 2500
+expect drawing-sheet-dimensions contains 1750
+expect drawing-sheet-dimensions contains ⌀1000
+expect drawing-sheet-dimensions contains ⌀600
+expect drawing-sheet-texts contains Bracket
+expect drawing-sheet-refreshes == 1
+expect drawing-sheet-saved == 0
+capture 190DrawingSheetFirstAngle
+
+# ② Third angle: Top moves above Front, Right to its right, the symbol mirrors; the setting is saved with the document
+click @SheetThirdAngle
+frames 2
+expect drawing-sheet contains Third
+expect drawing-sheet-refreshes == 2
+expect drawing-sheet-saved == 1
+capture 191DrawingSheetThirdAngle
+
+# ③ Section A-A replaces the isometric: y through the scene centre (Section default) — the cap is the exact cut
+#    4.116587 m² (block profile − chamfer − fillet corner − hole + boss), hatched, with the cutting line on Top
+click @SheetSection
+frames 2
+expect drawing-sheet-views == Front Top Right Section A-A
+expect drawing-sheet-section-area ~ 4.116587
+capture 192DrawingSheetSection
+
+# ④ Title block fields (Enter applies): title and material print in the title block
+click @SheetTitle
+key A Ctrl
+type Bracket B-1
+key Enter
+frames 2
+click @SheetMaterial
+key A Ctrl
+type AlSi10Mg
+key Enter
+frames 2
+expect drawing-sheet-texts contains Bracket B-1
+expect drawing-sheet-texts contains AlSi10Mg
+
+# ⑤ Scale steps: − takes the next smaller ISO 5455 scale, Auto returns to the largest that fits
+click @SheetScaleSmaller
+frames 2
+expect drawing-sheet-scale < 0.02
+click @SheetScaleAuto
+frames 2
+expect drawing-sheet-scale == 0.02
+expect drawing-sheet contains 1:50
+
+# ⑥ The wheel zooms the paper about the pointer (3 notches = 1.2³), double-click fits again
+wheel @ViewportSurface 3
+frames 2
+expect drawing-sheet-zoom ~ 1.728
+capture 193DrawingSheetZoom
+click @SheetFit
+frames 2
+expect drawing-sheet-zoom == 1
+
+# ⑦ Export beside the document: Sheet.svg and Sheet.dxf (R12)
+click @SheetExportSvg
+frames 2
+expect drawing-sheet-export contains Sheet.svg
+expect drawing-sheet-export > 20000
+click @SheetExportDxf
+frames 2
+expect drawing-sheet-export contains Sheet.dxf
+expect drawing-sheet-export > 20000
+capture 194DrawingSheetExport
+
+# ⑧ Esc returns to the model; Alt+D again shows the saved settings (third angle, section A-A, title)
+key Escape
+frames 2
+expect drawing-sheet == 0
+key D Alt
+frames 2
+expect drawing-sheet contains Third
+expect drawing-sheet-views contains Section A-A
+expect drawing-sheet-texts contains AlSi10Mg
+key D Alt
+frames 2
+expect drawing-sheet == 0
diff --git a/Exhibits/SolidArc/Code/Scripts/EdgePathWalkthrough.txt b/Exhibits/SolidArc/Code/Scripts/EdgePathWalkthrough.txt
new file mode 100644
index 0000000000000000000000000000000000000000..d622967fabae37fda18c35dc7d5e70b20b285338
--- /dev/null
+++ b/Exhibits/SolidArc/Code/Scripts/EdgePathWalkthrough.txt
@@ -0,0 +1,117 @@
+# SolidArc edge path walkthrough — Ctrl+click an unpicked edge while edges are picked (Blender's pick shortest path):
+# the edges from the active (last picked) edge to the clicked one join. Inspector › Edge path: Along loop keeps to a
+# loop holding both edges (an edge loop, a face rim or a tangent chain) and never cuts across the body, Other side takes
+# the far way round a closed loop, Whole loop the whole loop, Shortest the least total length over any edges.
+# Ctrl+click on a picked edge still removes it (Plasticity).
+# Run: SolidArcCapture --specimen --reset-files --recovery …/EdgePathRecovery.solidarc
+#      --document …/EdgePath.solidarc --script Exhibits/SolidArc/Code/Scripts/EdgePathWalkthrough.txt
+# Closed forms on the 2 × 1 × 1 box: front-top → back-top round the top rim 2 + 1 + 2 = 5 (either side), the whole
+# rim 6; front-top → right-bottom shares no loop (refused along a loop), shortest 2 + 1 + 1 = 4 down the front-right edge.
+
+snap grid on
+
+# ① empty document, Top view: a 2 × 1 rectangle, filled, extruded 1
+key N Ctrl
+frames 2
+expect steps == 0
+key Keypad7
+frames 2
+key Q Shift
+frames 2
+click world 0.0 0.0 0.0
+frames 2
+click world 2.0 1.0 0.0
+frames 2
+key F
+frames 2
+key E
+frames 2
+click @BevelSize
+key A Ctrl
+type 1
+key Enter
+frames 2
+key Enter
+frames 2
+expect steps == 2
+expect volume ~ 2
+
+# ② edge mode: click the front-top edge, Ctrl+click the back-top edge → the path round the top rim (3 edges, 5)
+key 2
+frames 2
+move world 1.0 0.0 1.0
+frames 2
+click world 1.0 0.0 1.0
+frames 2
+expect selected-edges == 1
+move world 1.0 1.0 1.0
+frames 2
+click world 1.0 1.0 1.0 Left Ctrl
+frames 2
+expect path-picks == 1
+expect path-refused == 0
+expect path-edges == 3
+expect path-length > 4.999
+expect path-length < 5.001
+expect selected-edges == 3
+expect status contains Along loop
+capture 321EdgePathAlong
+
+# ③ Inspector › Edge path: Other side (the far short edge), Whole loop (the rim, 4 edges, 6), Shortest (3 edges, 5)
+click @PathOtherSide
+frames 2
+expect path-edges == 3
+expect selected-edges == 3
+expect status contains far side
+click @PathWhole
+frames 2
+expect path-mode == 1
+expect path-edges == 4
+expect path-length > 5.999
+expect path-length < 6.001
+expect selected-edges == 4
+capture 322EdgePathWhole
+click @PathShortest
+frames 2
+expect path-mode == 2
+expect path-edges == 3
+expect selected-edges == 3
+click @PathAlong
+frames 2
+expect path-mode == 0
+
+# ④ no loop holds both: front-top, then (bottom view) Ctrl+click the right-bottom edge → refused along a loop,
+#    the front-top edge stays picked; Shortest then goes down the front-right edge (3 edges, 4)
+move world 1.0 0.0 1.0
+frames 2
+click world 1.0 0.0 1.0
+frames 2
+expect selected-edges == 1
+key Keypad7 Ctrl
+frames 2
+move world 2.0 0.5 0.0
+frames 2
+click world 2.0 0.5 0.0 Left Ctrl
+frames 2
+expect path-picks == 2
+expect path-refused == 1
+expect selected-edges == 1
+expect status contains share no edge loop
+capture 323EdgePathRefused
+click @PathShortest
+frames 2
+expect path-refused == 0
+expect path-edges == 3
+expect path-length > 3.999
+expect path-length < 4.001
+expect selected-edges == 3
+capture 324EdgePathShortest
+
+# ⑤ Ctrl+click a picked edge removes it (Plasticity); Along loop again for the next session
+click world 2.0 0.5 0.0 Left Ctrl
+frames 2
+expect selected-edges == 2
+expect path-picks == 2
+click @PathAlong
+frames 2
+expect path-mode == 0
