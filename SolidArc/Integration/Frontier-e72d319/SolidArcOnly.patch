+            if (Promoted.Refusal.empty())
+            {
+                // 📝 Closed form: box − (edge strips)·(1 − π/4)·r² per unit length + corners (sphere octants vs cubes).
+                const double r = 0.2, Edges = 4.0 * ((2.0 - 2 * r) + (1.5 - 2 * r) + (1.0 - 2 * r));
