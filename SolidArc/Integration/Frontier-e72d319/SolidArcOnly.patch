+frames 2
+click world 0.0 -0.1 0.2
+frames 2
+expect selected-edges == 1
+key B
+frames 8
+expect bevel-active == 1
+expect bevel-span ~ 0.2
+expect bevel-size ~ 0.02
+expect bevel-refusal == 0
+expect bevel-handles == 3
+capture 279BevelFitted
