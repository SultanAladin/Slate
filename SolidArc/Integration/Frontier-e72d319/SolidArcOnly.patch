+std::vector<DetailRow> Details;
+std::string            FileFolder;                                                           // --files: write the exports here
+#ifdef FRONTIER_STEP_FIXTURES
+std::string FixtureFolder = FRONTIER_STEP_FIXTURES;                                          // --fixtures: OpenCascade-authored STEP files
