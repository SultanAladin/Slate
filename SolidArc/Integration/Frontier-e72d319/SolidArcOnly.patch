+    }
+    std::printf("\n## Exact recovery (S3)\n\n| | Case | Measured | Limit |\n|---|---|---|---|\n");
+    for (const RecoveryRow& Row : RecoveryRows) std::printf("| %s | %s | %.2e | %s |\n", Row.PassedCondition ? "🟢" : "🔴", Row.Name.c_str(), Row.Error, Row.Limit.c_str());
