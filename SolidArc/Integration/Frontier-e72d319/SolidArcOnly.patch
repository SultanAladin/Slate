+// 📝 HTML .viewport-instructions (bottom 12, left 17, 9 px, gap 12, wrapping): the first group #8f9297, the rest #747b84.
+//    The native hint's " · " groups wrap upwards inside Width; returns the top of the lines (the toolbar sits above).
+float DrawViewportInstructions(SolidArcSheet& Sheet, float Left, float Bottom, float Width, const std::string& Hint)
+{
+    std::vector<std::string> Groups;
+    for (size_t Start = 0; Start <= Hint.size();)
+    {
+        const size_t Split = Hint.find(" · ", Start);
+        Groups.push_back(Hint.substr(Start, Split == std::string::npos ? std::string::npos : Split - Start));
+        if (Split == std::string::npos) break;
+        Start = Split + std::strlen(" · ");
+    }
+    // A group wider than the room breaks after its commas (a narrow viewport must not run the hint under the cube).
+    for (size_t Index = 0; Index < Groups.size(); ++Index)
+    {
+        if (Sheet.Measure(Groups[Index].c_str(), 9.0f) <= Width) continue;
+        size_t Comma = Groups[Index].find(", ");
+        size_t Fit   = std::string::npos;
+        while (Comma != std::string::npos && Sheet.Measure(Groups[Index].substr(0, Comma + 1).c_str(), 9.0f) <= Width)
+        {
+            Fit   = Comma;
+            Comma = Groups[Index].find(", ", Comma + 2);
+        }
+        if (Fit == std::string::npos) Fit = Groups[Index].find(", ");
+        if (Fit == std::string::npos) continue;
+        Groups.insert(Groups.begin() + std::ptrdiff_t(Index) + 1, Groups[Index].substr(Fit + 2));
+        Groups[Index].resize(Fit + 1);
+    }
+    std::vector<std::vector<size_t>> Lines(1);
+    float Run = 0.0f;
+    for (size_t Index = 0; Index < Groups.size(); ++Index)
+    {
+        const float Extent = Sheet.Measure(Groups[Index].c_str(), 9.0f);
+        if (!Lines.back().empty() && Run + 12.0f + Extent > Width)
+        {
+            Lines.emplace_back();
+            Run = 0.0f;
+        }
+        Run += (Lines.back().empty() ? 0.0f : 12.0f) + Extent;
+        Lines.back().push_back(Index);
+    }
+    const float LineHeight = 9.0f * SolidArcStyleTokens::FontScale + 3.0f;
+    for (size_t Row = 0; Row < Lines.size(); ++Row)
+    {
+        const float Centre = Bottom - float(Lines.size() - 1 - Row) * LineHeight - 0.5f * 9.0f * SolidArcStyleTokens::FontScale;
+        float       Cursor = Left;
+        for (const size_t Index : Lines[Row])
+            Cursor += Sheet.Text(Cursor, Centre, 9.0f, SolidArcInk(Index == 0 ? 0x8f9297 : 0x747b84), Groups[Index].c_str()) + 12.0f;
+    }
+    return Bottom - float(Lines.size()) * LineHeight;                                       // [px] - Top of the wrapped lines
+}
