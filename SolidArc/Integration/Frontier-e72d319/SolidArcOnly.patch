+//------------------------------------------------------------------------------------------------------------------------
+
+std::vector<SegmentCrossing> IntersectProfileSegments(const ProfileSegment& Target, const ProfileSegment& Cutter, double Join)
+{
+    const SampledSegment TargetSamples = SampleSegment(Target);
+    const SampledSegment CutterSamples = SampleSegment(Cutter);
+    std::vector<SegmentCrossing> Found;
+    for (size_t First = 0; First + 1 < TargetSamples.Points.size(); ++First)
+    {
+        const Vector2 Origin = TargetSamples.Points[First];
+        const Vector2 Along  = TargetSamples.Points[First + 1] - Origin;
+        for (size_t Second = 0; Second + 1 < CutterSamples.Points.size(); ++Second)
+        {
+            const Vector2 Other   = CutterSamples.Points[Second];
+            const Vector2 Across  = CutterSamples.Points[Second + 1] - Other;
+            const double  Denominator = Cross(Along, Across);
+            if (std::fabs(Denominator) <= 1.0e-14 * Length(Along) * Length(Across)) continue;  // Parallel pieces: no isolated crossing
+            const double TargetShare = Cross(Other - Origin, Across) / Denominator;
+            const double CutterShare = Cross(Other - Origin, Along) / Denominator;
+            if (TargetShare < -SeedMargin || TargetShare > 1.0 + SeedMargin || CutterShare < -SeedMargin || CutterShare > 1.0 + SeedMargin) continue;
+            double TargetFraction = Settle(Target, TargetSamples.Fractions[First] + TargetShare * (TargetSamples.Fractions[First + 1] - TargetSamples.Fractions[First]));
+            double CutterFraction = Settle(Cutter, CutterSamples.Fractions[Second] + CutterShare * (CutterSamples.Fractions[Second + 1] - CutterSamples.Fractions[Second]));
+            if (RefineCrossing(Target, Cutter, TargetFraction, CutterFraction) > Join) continue;
+            Found.push_back({ TargetFraction, CutterFraction, EvaluateProfileSegment(Target, TargetFraction) });
+        }
+    }
+    std::sort(Found.begin(), Found.end(), [](const SegmentCrossing& Left, const SegmentCrossing& Right) { return Left.TargetFraction < Right.TargetFraction; });
+    std::vector<SegmentCrossing> Merged;
+    for (const SegmentCrossing& Crossing : Found)
+    {
+        const bool Repeat = std::any_of(Merged.begin(), Merged.end(), [&](const SegmentCrossing& Kept)
+        {
+            return std::fabs(Kept.TargetFraction - Crossing.TargetFraction) <= MergeFraction && Distance(Kept.Position, Crossing.Position) <= Join;
+        });
+        if (!Repeat) Merged.push_back(Crossing);
+    }
+    return Merged;
+}
+
+double LocateProfileFraction(const ProfileSegment& Segment, Vector2 Point)
+{
+    const SampledSegment Samples = SampleSegment(Segment);
+    double Best = 0.0, BestDistance = std::numeric_limits<double>::infinity();
+    for (size_t Index = 0; Index + 1 < Samples.Points.size(); ++Index)
+    {
+        const Vector2 Along  = Samples.Points[Index + 1] - Samples.Points[Index];
+        const double  Square = Dot(Along, Along);
+        const double  Share  = Square > 0.0 ? std::clamp(Dot(Point - Samples.Points[Index], Along) / Square, 0.0, 1.0) : 0.0;
+        const double  Gap    = Distance(Samples.Points[Index] + Along * Share, Point);
+        if (Gap < BestDistance)
+        {
+            BestDistance = Gap;
+            Best         = Samples.Fractions[Index] + Share * (Samples.Fractions[Index + 1] - Samples.Fractions[Index]);
+        }
+    }
+    for (int Iteration = 0; Iteration < NewtonIterations; ++Iteration)
+    {
+        const Vector2 Tangent = EvaluateProfileTangent(Segment, Best);
+        const double  Square  = Dot(Tangent, Tangent);
+        if (!(Square > 0.0)) break;
+        const double Next = Settle(Segment, Best + Dot(Point - EvaluateProfileSegment(Segment, Best), Tangent) / Square);
+        const bool   StillCondition = std::fabs(Next - Best) <= 1.0e-15;
+        Best = Next;
+        if (StillCondition) break;
+    }
+    return Best;
+}
+
+void EraseSketchCurve(SketchModel& Sketch, int CurveIndex)
+{
+    std::erase_if(Sketch.Constraints, [&](const SketchConstraint& Constraint) { return NamesCurve(Constraint, CurveIndex); });
+    for (SketchConstraint& Constraint : Sketch.Constraints)
+    {
+        const std::array<bool, 3> Slots = CurveSlots(Constraint.Kind);
+        if (Slots[0] && Constraint.First  > CurveIndex) --Constraint.First;
+        if (Slots[1] && Constraint.Second > CurveIndex) --Constraint.Second;
+        if (Slots[2] && Constraint.Third  > CurveIndex) --Constraint.Third;
+    }
+    Sketch.Curves.erase(Sketch.Curves.begin() + CurveIndex);
+}
+
+int EraseSketchPoints(SketchModel& Sketch, const std::vector<int>& Points)
+{
+    const std::set<int> Doomed(Points.begin(), Points.end());
+    auto Uses = [&](const SketchCurve& Curve, auto&& Test)
+    {
+        if (Test(Curve.Start) || Test(Curve.End) || Test(Curve.Centre)) return true;
+        return std::any_of(Curve.Points.begin(), Curve.Points.end(), [&](int Point) { return Test(Point); });
+    };
+    // ① The curves through a doomed point, last first (indices stay valid).
+    int Erased = 0;
+    for (int CurveIndex = static_cast<int>(Sketch.Curves.size()) - 1; CurveIndex >= 0; --CurveIndex)
+    {
+        if (!Uses(Sketch.Curves[CurveIndex], [&](int Point) { return Doomed.contains(Point); })) continue;
+        EraseSketchCurve(Sketch, CurveIndex);
+        ++Erased;
+    }
+    // ② Points no curve uses any more: dropped with their constraints, the rest renumbered.
+    std::vector<int> Renumber(Sketch.Points.size(), -1);
+    int              Kept = 0;
+    for (int Point = 0; Point < static_cast<int>(Sketch.Points.size()); ++Point)
+    {
+        const bool Used = std::any_of(Sketch.Curves.begin(), Sketch.Curves.end(), [&](const SketchCurve& Curve)
+                                      { return Uses(Curve, [&](int Other) { return Other == Point; }); });
+        if (Used) Renumber[Point] = Kept++;
+    }
+    auto Gone = [&](int Point) { return Point < 0 || Point >= static_cast<int>(Renumber.size()) || Renumber[Point] < 0; };
+    std::erase_if(Sketch.Constraints, [&](const SketchConstraint& Constraint)
+    {
+        const std::array<bool, 3> Slots = PointSlots(Constraint.Kind);
+        return (Slots[0] && Gone(Constraint.First)) || (Slots[1] && Gone(Constraint.Second)) || (Slots[2] && Gone(Constraint.Third));
+    });
+    for (SketchConstraint& Constraint : Sketch.Constraints)
+    {
+        const std::array<bool, 3> Slots = PointSlots(Constraint.Kind);
+        if (Slots[0]) Constraint.First  = Renumber[Constraint.First];
+        if (Slots[1]) Constraint.Second = Renumber[Constraint.Second];
+        if (Slots[2]) Constraint.Third  = Renumber[Constraint.Third];
+    }
+    auto Map = [&](int& Point) { if (Point >= 0) Point = Renumber[Point]; };
+    for (SketchCurve& Curve : Sketch.Curves)
+    {
+        Map(Curve.Start);
+        Map(Curve.End);
+        Map(Curve.Centre);
+        for (int& Point : Curve.Points) Map(Point);
+    }
+    std::vector<SketchPoint> Survivors;
+    for (int Point = 0; Point < static_cast<int>(Sketch.Points.size()); ++Point) if (Renumber[Point] >= 0) Survivors.push_back(Sketch.Points[Point]);
+    Sketch.Points = std::move(Survivors);
+    return Erased;
+}
+
+SketchTrimOutcome TrimSketchCurve(const SketchModel& Sketch, int CurveIndex, Vector2 Pick, const std::vector<ProfileSegment>& Foreign)
+{
+    SketchTrimOutcome Outcome;
+    Outcome.Sketch = Sketch;
+    if (CurveIndex < 0 || CurveIndex >= static_cast<int>(Sketch.Curves.size())) { Outcome.Refusal = "the sketch has no curve " + std::to_string(CurveIndex); return Outcome; }
+    const double Join = 1.0e-9 * MeasureScale(Sketch, Foreign);
+    std::string  Refusal;
+    const ProfileSegment Target = ResolveSketchCurveSegment(Sketch, CurveIndex, Join, Refusal);
+    if (!Refusal.empty()) { Outcome.Refusal = Refusal; return Outcome; }
+    // A circle, or a spline whose last point is its first (closed: first = last).
+    const bool Loop = ClosedCondition(Target) || (Target.Kind == ProfileSegmentKind::Spline && Sketch.Curves[CurveIndex].Points.size() >= 2
+                                                  && Sketch.Curves[CurveIndex].Points.front() == Sketch.Curves[CurveIndex].Points.back());
+    const std::string Name = SketchCurveName(Sketch.Curves[CurveIndex]);
+
+    // ① crossings with the sketch's other curves and the foreign ones, merged along the target.
+    std::vector<TrimCrossing> Crossings;
+    auto Gather = [&](const ProfileSegment& Cutter, int SketchCurve)
+    {
+        for (const SegmentCrossing& Crossing : IntersectProfileSegments(Target, Cutter, Join))
+            Crossings.push_back({ Loop ? Wrap(Crossing.TargetFraction) : Crossing.TargetFraction, Crossing.Position, SketchCurve });
+    };
+    for (int Other = 0; Other < static_cast<int>(Sketch.Curves.size()); ++Other)
+    {
+        if (Other == CurveIndex) continue;
+        std::string OtherRefusal;
+        const ProfileSegment Cutter = ResolveSketchCurveSegment(Sketch, Other, Join, OtherRefusal);
+        if (OtherRefusal.empty()) Gather(Cutter, Other);
+    }
+    for (const ProfileSegment& Cutter : Foreign) Gather(Cutter, -1);
+    std::sort(Crossings.begin(), Crossings.end(), [](const TrimCrossing& Left, const TrimCrossing& Right) { return Left.Fraction < Right.Fraction; });
+    std::vector<TrimCrossing> Distinct;
+    for (const TrimCrossing& Crossing : Crossings)
+    {
+        if (!Distinct.empty() && Crossing.Fraction - Distinct.back().Fraction <= MergeFraction) continue;
+        Distinct.push_back(Crossing);
+    }
+    if (Loop && Distinct.size() >= 2 && Distinct.front().Fraction + 1.0 - Distinct.back().Fraction <= MergeFraction) Distinct.pop_back();
+    if (!Loop)
+        std::erase_if(Distinct, [](const TrimCrossing& Crossing) { return Crossing.Fraction <= MergeFraction || Crossing.Fraction >= 1.0 - MergeFraction; });
+    Outcome.Crossings = static_cast<int>(Distinct.size());
+    const double Picked = LocateProfileFraction(Target, Pick);
+
+    // ② nothing to stop at: the whole curve goes.
+    const size_t Needed = Loop ? 2 : 1;
+    if (Distinct.size() < Needed)
+    {
+        Outcome.FromFraction = 0.0;
+        Outcome.ToFraction   = 1.0;
+        Outcome.Removed      = SamplePiece(Target, 0.0, 1.0);
+        Outcome.Pieces       = 0;
+        EraseSketchCurve(Outcome.Sketch, CurveIndex);
+        return Outcome;
+    }
+    if (Target.Kind == ProfileSegmentKind::Spline)
+    {
+        // ③′ a spline (Hermite, Bezier, NURBS, cubic): the kept pieces are exact pieces of its B-spline carrier (knot
+        //    insertion, the shape untouched), each a NURBS-form curve; constraints on the curve let go (their slots
+        //    change), an untouched end keeps its point.
+        SketchModel&             Edited  = Outcome.Sketch;
+        const SketchSplineCurve& Carrier = Target.Spline;
+        const double Low = Carrier.Knots.front(), High = Carrier.Knots.back();
+        const auto   At  = [&](double Fraction) { return Low + Fraction * (High - Low); };
+        const SketchCurve Original = Edited.Curves[CurveIndex];
+        const int StartSlot = Original.Points.empty() ? -1 : Original.Points.front();
+        const int EndSlot   = Original.Points.empty() ? -1 : Original.Points.back();
+        std::erase_if(Edited.Constraints, [&](const SketchConstraint& Constraint) { return NamesCurve(Constraint, CurveIndex); });
+        int Lower = -1, Upper = -1;
+        if (Loop)
+        {
+            Lower = static_cast<int>(Distinct.size()) - 1;
+            for (int Index = 0; Index < static_cast<int>(Distinct.size()); ++Index) if (Distinct[Index].Fraction <= Picked) Lower = Index;
+            Upper = (Lower + 1) % static_cast<int>(Distinct.size());
+            const bool WrapCondition = Upper == 0;                                           // The removed piece crosses the seam
+            Outcome.FromFraction = Distinct[Lower].Fraction;
+            Outcome.ToFraction   = Distinct[Upper].Fraction + (WrapCondition ? 1.0 : 0.0);
+            Outcome.Removed      = WrapCondition ? SamplePiece(Target, Outcome.FromFraction, 1.0) : SamplePiece(Target, Outcome.FromFraction, Outcome.ToFraction);
+            if (WrapCondition) { const std::vector<Vector2> Tail = SamplePiece(Target, 0.0, Distinct[Upper].Fraction); Outcome.Removed.insert(Outcome.Removed.end(), Tail.begin() + 1, Tail.end()); }
+            const SketchSplineCurve Kept = WrapCondition ? SplineCarrierPiece(Carrier, At(Distinct[Upper].Fraction), At(Distinct[Lower].Fraction))
+                                                         : JoinSplineCarriers(SplineCarrierPiece(Carrier, At(Distinct[Upper].Fraction), High),
+                                                                              SplineCarrierPiece(Carrier, Low, At(Distinct[Lower].Fraction)));
+            AssignSplinePiece(Edited, CurveIndex, Kept, { -1, -1 });
+            Outcome.Pieces = 1;
+        }
+        else
+        {
+            for (int Index = 0; Index < static_cast<int>(Distinct.size()); ++Index)
+            {
+                if (Distinct[Index].Fraction <= Picked) Lower = Index;
+                else { Upper = Index; break; }
+            }
+            Outcome.FromFraction = Lower < 0 ? 0.0 : Distinct[Lower].Fraction;
+            Outcome.ToFraction   = Upper < 0 ? 1.0 : Distinct[Upper].Fraction;
+            Outcome.Removed      = SamplePiece(Target, Outcome.FromFraction, Outcome.ToFraction);
+            if (Lower < 0) AssignSplinePiece(Edited, CurveIndex, SplineCarrierPiece(Carrier, At(Distinct[Upper].Fraction), High), { -1, EndSlot });
+            else if (Upper < 0) AssignSplinePiece(Edited, CurveIndex, SplineCarrierPiece(Carrier, Low, At(Distinct[Lower].Fraction)), { StartSlot, -1 });
+            else
+            {
+                AssignSplinePiece(Edited, CurveIndex, SplineCarrierPiece(Carrier, Low, At(Distinct[Lower].Fraction)), { StartSlot, -1 });
+                SketchCurve Second = Original;
+                Second.Identifier  = NextIdentifier(Edited, SketchCurveKind::Spline);
+                Edited.Curves.push_back(Second);
+                AssignSplinePiece(Edited, static_cast<int>(Edited.Curves.size()) - 1, SplineCarrierPiece(Carrier, At(Distinct[Upper].Fraction), High), { -1, EndSlot });
+            }
+            Outcome.Pieces = Lower >= 0 && Upper >= 0 ? 2 : 1;
+        }
+        // New ends made by a line / circle / arc of the same sketch stay on it; points no curve uses any more go.
+        const auto PinEnd = [&](int CurveSlot, bool LastCondition, int Crossing)
+        {
+            if (Crossing < 0) return;
+            const SketchCurve& Piece = Edited.Curves[CurveSlot];
+            PinToCutter(Edited, LastCondition ? Piece.Points.back() : Piece.Points.front(), Distinct[Crossing].SketchCurve);
+        };
+        if (Loop) { PinEnd(CurveIndex, false, Upper); PinEnd(CurveIndex, true, Lower); }
+        else if (Lower < 0) PinEnd(CurveIndex, false, Upper);
+        else if (Upper < 0) PinEnd(CurveIndex, true, Lower);
+        else { PinEnd(CurveIndex, true, Lower); PinEnd(static_cast<int>(Edited.Curves.size()) - 1, false, Upper); }
+        (void)EraseSketchPoints(Edited, {});
+        return Outcome;
+    }
+
+    // ③ the piece holding the pick: [Lower, Upper] between neighbouring crossings (or the curve ends).
+    SketchModel& Edited = Outcome.Sketch;
+    if (Loop)
+    {
+        size_t Lower = Distinct.size() - 1;
+        for (size_t Index = 0; Index < Distinct.size(); ++Index) if (Distinct[Index].Fraction <= Picked) Lower = Index;
+        const size_t Upper = (Lower + 1) % Distinct.size();
+        const bool   WrapCondition = Upper == 0;
+        Outcome.FromFraction = Distinct[Lower].Fraction;
+        Outcome.ToFraction   = Distinct[Upper].Fraction + (WrapCondition ? 1.0 : 0.0);
+        Outcome.Removed      = SamplePiece(Target, Outcome.FromFraction, Outcome.ToFraction);
+        const int StartPoint = AppendSketchPoint(Edited, Distinct[Upper].Position);          // The arc runs counter-clockwise
+        const int EndPoint   = AppendSketchPoint(Edited, Distinct[Lower].Position);          // from the removed end to its start
+        SketchCurve& Curve = Edited.Curves[CurveIndex];
+        Curve.Kind  = SketchCurveKind::Arc;
+        Curve.Start = StartPoint;
+        Curve.End   = EndPoint;
+        PinToCutter(Edited, StartPoint, Distinct[Upper].SketchCurve);
+        PinToCutter(Edited, EndPoint, Distinct[Lower].SketchCurve);
+        Outcome.Pieces = 1;
+        return Outcome;
+    }
+    int Lower = -1, Upper = -1;                                                              // Crossing indices (−1: curve end)
+    for (int Index = 0; Index < static_cast<int>(Distinct.size()); ++Index)
+    {
+        if (Distinct[Index].Fraction <= Picked) Lower = Index;
+        else { Upper = Index; break; }
+    }
+    Outcome.FromFraction = Lower < 0 ? 0.0 : Distinct[Lower].Fraction;
+    Outcome.ToFraction   = Upper < 0 ? 1.0 : Distinct[Upper].Fraction;
+    Outcome.Removed      = SamplePiece(Target, Outcome.FromFraction, Outcome.ToFraction);
+    const SketchCurveKind Kind = Edited.Curves[CurveIndex].Kind;
+    if (Kind == SketchCurveKind::Line) DropLengthConstraints(Edited, CurveIndex);
+    if (Lower < 0)                                                                           // The start piece comes off
+    {
+        const int Point = AppendSketchPoint(Edited, Distinct[Upper].Position);
+        Edited.Curves[CurveIndex].Start = Point;
+        PinToCutter(Edited, Point, Distinct[Upper].SketchCurve);
+        Outcome.Pieces = 1;
+        return Outcome;
+    }
+    if (Upper < 0)                                                                           // The end piece comes off
+    {
+        const int Point = AppendSketchPoint(Edited, Distinct[Lower].Position);
+        Edited.Curves[CurveIndex].End = Point;
+        PinToCutter(Edited, Point, Distinct[Lower].SketchCurve);
+        Outcome.Pieces = 1;
+        return Outcome;
+    }
+    const int FirstEnd    = AppendSketchPoint(Edited, Distinct[Lower].Position);             // A middle piece: split in two
+    const int SecondStart = AppendSketchPoint(Edited, Distinct[Upper].Position);
+    SketchCurve Second = Edited.Curves[CurveIndex];
+    Second.Identifier  = NextIdentifier(Edited, Kind);
+    Second.Start       = SecondStart;
+    Edited.Curves[CurveIndex].End = FirstEnd;
+    Edited.Curves.push_back(Second);
+    const int SecondIndex = static_cast<int>(Edited.Curves.size()) - 1;
+    CopyShapeConstraints(Edited, CurveIndex, SecondIndex, Kind);
+    PinToCutter(Edited, FirstEnd, Distinct[Lower].SketchCurve);
+    PinToCutter(Edited, SecondStart, Distinct[Upper].SketchCurve);
+    Outcome.Pieces = 2;
+    return Outcome;
+}
+
+SketchTrimOutcome SplitSketchCurve(const SketchModel& Sketch, int CurveIndex, Vector2 Pick, std::optional<Vector2> Partner)
+{
+    constexpr double EndGuard = 1.0e-3;                                                      // [-] - No split this close to an open end
+    SketchTrimOutcome Outcome;
+    Outcome.Sketch = Sketch;
+    if (CurveIndex < 0 || CurveIndex >= static_cast<int>(Sketch.Curves.size())) { Outcome.Refusal = "the sketch has no curve " + std::to_string(CurveIndex); return Outcome; }
+    const double Join = 1.0e-9 * MeasureScale(Sketch, {});
+    std::string  Refusal;
+    const ProfileSegment Target = ResolveSketchCurveSegment(Sketch, CurveIndex, Join, Refusal);
+    if (!Refusal.empty()) { Outcome.Refusal = Refusal; return Outcome; }
+    // A circle, or a spline whose last point is its first (closed: first = last).
+    const bool Loop = ClosedCondition(Target) || (Target.Kind == ProfileSegmentKind::Spline && Sketch.Curves[CurveIndex].Points.size() >= 2
+                                                  && Sketch.Curves[CurveIndex].Points.front() == Sketch.Curves[CurveIndex].Points.back());
+    const std::string Name = SketchCurveName(Sketch.Curves[CurveIndex]);
+    const double Picked = LocateProfileFraction(Target, Pick);
+    if (Target.Kind == ProfileSegmentKind::Spline)
+    {
+        // A spline: two exact pieces of its carrier meeting at the pick (closed: at the pick and the partner, else the
+        // pick and the point half the parameter range on); the shape is untouched.
+        if (!Loop && (Picked <= EndGuard || Picked >= 1.0 - EndGuard))
+        {
+            Outcome.Refusal = "the pointer is on an end of " + Name + ": Cut needs a point inside the curve";
+            return Outcome;
+        }
+        SketchModel&             Edited  = Outcome.Sketch;
+        const SketchSplineCurve& Carrier = Target.Spline;
+        const double Low = Carrier.Knots.front(), High = Carrier.Knots.back();
+        const auto   At  = [&](double Fraction) { return Low + Fraction * (High - Low); };
+        const SketchCurve Original = Edited.Curves[CurveIndex];
+        std::erase_if(Edited.Constraints, [&](const SketchConstraint& Constraint) { return NamesCurve(Constraint, CurveIndex); });
+        Outcome.FromFraction = Outcome.ToFraction = Picked;
+        SketchCurve Second = Original;
+        Second.Identifier  = NextIdentifier(Edited, SketchCurveKind::Spline);
+        Edited.Curves.push_back(Second);
+        const int SecondIndex = static_cast<int>(Edited.Curves.size()) - 1;
+        if (Loop)
+        {
+            double Across = 0.5;
+            if (Partner.has_value())
+            {
+                const double Gap = Wrap(LocateProfileFraction(Target, *Partner) - Picked);
+                if (Gap > EndGuard && Gap < 1.0 - EndGuard) Across = Gap;
+            }
+            const double First = Wrap(Picked), Other = Wrap(Picked + Across);
+            const double From = std::min(First, Other), To = std::max(First, Other);
+            const auto   Inner = [&](double Left, double Right) { return SplineCarrierPiece(Carrier, At(Left), At(Right)); };
+            const SketchSplineCurve Middle = From <= EndGuard ? Inner(0.0, To) : Inner(From, To);
+            const SketchSplineCurve Rest   = From <= EndGuard ? SplineCarrierPiece(Carrier, At(To), High)
+                                                              : JoinSplineCarriers(SplineCarrierPiece(Carrier, At(To), High), Inner(0.0, From));
+            AssignSplinePiece(Edited, CurveIndex, Middle, { -1, -1 });
+            AssignSplinePiece(Edited, SecondIndex, Rest, { Edited.Curves[CurveIndex].Points.back(), Edited.Curves[CurveIndex].Points.front() });
+            Outcome.SplitPositions = { EvaluateProfileSegment(Target, From), EvaluateProfileSegment(Target, To) };
+        }
+        else
+        {
+            const auto [Left, Right] = SplitSplineCarrier(Carrier, At(Picked));
+            AssignSplinePiece(Edited, CurveIndex, Left, { Original.Points.front(), -1 });
+            AssignSplinePiece(Edited, SecondIndex, Right, { Edited.Curves[CurveIndex].Points.back(), Original.Points.back() });
+            Outcome.SplitPositions = { EvaluateProfileSegment(Target, Picked) };
+        }
+        (void)EraseSketchPoints(Edited, {});
+        Outcome.Pieces = 2;
+        return Outcome;
+    }
+    Outcome.FromFraction = Picked;
+    Outcome.ToFraction   = Picked;
+    SketchModel& Edited = Outcome.Sketch;
+    if (Loop)
+    {
+        // ① a circle: two arcs (counter-clockwise like the circle) meeting at the pick and the partner (a second
+        //    crossing), else half arcs meeting at the pick and its opposite point.
+        double Across = 0.5;                                                                 // [-] - Second break, fraction past the pick
+        if (Partner.has_value())
+        {
+            const double Gap = Wrap(LocateProfileFraction(Target, *Partner) - Picked);
+            if (Gap > EndGuard && Gap < 1.0 - EndGuard) Across = Gap;
+        }
+        const Vector2 First  = EvaluateProfileSegment(Target, Wrap(Picked));
+        const Vector2 Second = EvaluateProfileSegment(Target, Wrap(Picked + Across));
+        const int     FirstPoint  = AppendSketchPoint(Edited, First);
+        const int     SecondPoint = AppendSketchPoint(Edited, Second);
+        SketchCurve& Curve = Edited.Curves[CurveIndex];
+        Curve.Kind  = SketchCurveKind::Arc;
+        Curve.Start = FirstPoint;
+        Curve.End   = SecondPoint;
+        SketchCurve Other = Curve;
+        Other.Identifier  = NextIdentifier(Edited, SketchCurveKind::Arc);
+        Other.Start       = SecondPoint;
+        Other.End         = FirstPoint;
+        Edited.Curves.push_back(Other);
+        CopyShapeConstraints(Edited, CurveIndex, static_cast<int>(Edited.Curves.size()) - 1, SketchCurveKind::Arc);
+        Outcome.SplitPositions = { First, Second };
+        Outcome.Pieces         = 2;
+        return Outcome;
+    }
+    if (Picked <= EndGuard || Picked >= 1.0 - EndGuard)
+    {
+        Outcome.Refusal = "the pointer is on an end of " + Name + ": Cut needs a point inside the curve";
+        return Outcome;
+    }
+
+    // ② a line or an arc: the curve keeps its start part, a new curve carries the rest; both share the new point.
+    const Vector2         Position = EvaluateProfileSegment(Target, Picked);
+    const SketchCurveKind Kind     = Edited.Curves[CurveIndex].Kind;
+    if (Kind == SketchCurveKind::Line) DropLengthConstraints(Edited, CurveIndex);
+    const int   Point  = AppendSketchPoint(Edited, Position);
+    SketchCurve Second = Edited.Curves[CurveIndex];
+    Second.Identifier  = NextIdentifier(Edited, Kind);
+    Second.Start       = Point;
+    Edited.Curves[CurveIndex].End = Point;
+    Edited.Curves.push_back(Second);
+    CopyShapeConstraints(Edited, CurveIndex, static_cast<int>(Edited.Curves.size()) - 1, Kind);
+    Outcome.SplitPositions = { Position };
+    Outcome.Pieces         = 2;
+    return Outcome;
+}
+
+
+SketchTrimOutcome InsertSketchCurvePoint(const SketchModel& Sketch, int CurveIndex, Vector2 Pick)
+{
+    constexpr double PointGuard = 1.0e-3;                                                    // [-] - Of a span: no new point this close to one
+    SketchTrimOutcome Outcome;
+    Outcome.Sketch = Sketch;
+    if (CurveIndex < 0 || CurveIndex >= static_cast<int>(Sketch.Curves.size())) { Outcome.Refusal = "the sketch has no curve " + std::to_string(CurveIndex); return Outcome; }
+    const SketchCurve& Original = Sketch.Curves[CurveIndex];
+    const std::string  Name     = SketchCurveName(Original);
+
+    // ① lines, arcs, circles: Cut's split, the line's direction constraints let go.
+    if (Original.Kind != SketchCurveKind::Spline)
+    {
+        const size_t PointsBefore = Sketch.Points.size();
+        Outcome = SplitSketchCurve(Sketch, CurveIndex, Pick);
+        if (!Outcome.Refusal.empty())
+        {
+            if (Outcome.Refusal.find("on an end") != std::string::npos) Outcome.Refusal = "the pointer is on an end of " + Name + ": there is a point already";
+            return Outcome;
+        }
+        Outcome.InsertedPoint = static_cast<int>(PointsBefore);                              // The first point the split appended
+        if (Original.Kind == SketchCurveKind::Line)
+        {
+            const int Second = static_cast<int>(Outcome.Sketch.Curves.size()) - 1;
+            std::erase_if(Outcome.Sketch.Constraints, [&](const SketchConstraint& Constraint)
+            {
+                using Kind = SketchConstraintKind;
+                const bool Direction = Constraint.Kind == Kind::Horizontal || Constraint.Kind == Kind::Vertical || Constraint.Kind == Kind::Parallel
+                                    || Constraint.Kind == Kind::Perpendicular || Constraint.Kind == Kind::Angle;
+                const bool Touches   = Constraint.First == CurveIndex || Constraint.First == Second || Constraint.Second == CurveIndex || Constraint.Second == Second;
+                return Direction && Touches;
+            });
+        }
+        return Outcome;
+    }
+
+    // ② splines: τ* nearest to Pick on the exact B-spline (span samples, then Newton on (C − P)·C′ = 0).
+    const SketchSplineOutcome Resolved = ResolveSketchCurveSpline(Sketch, Original);
+    if (!Resolved.Refusal.empty()) { Outcome.Refusal = Resolved.Refusal; return Outcome; }
+    const SketchSplineCurve&  Carrier = Resolved.Curve;
+    const std::vector<double> Breaks  = CollectSketchSplineBreaks(Carrier);
+    double Best = Breaks.front(), BestGap = std::numeric_limits<double>::infinity();
+    for (size_t Piece = 0; Piece + 1 < Breaks.size(); ++Piece)
+        for (int Sample = 0; Sample <= 32; ++Sample)
+        {
+            const double Tau = Breaks[Piece] + (Breaks[Piece + 1] - Breaks[Piece]) * Sample / 32.0;
+            const double Gap = Distance(EvaluateSketchSpline(Carrier, Tau).Position, Pick);
+            if (Gap < BestGap) { BestGap = Gap; Best = Tau; }
+        }
+    for (int Step = 0; Step < 12; ++Step)
+    {
+        const SketchSplineDerivatives At = EvaluateSketchSpline(Carrier, Best);
+        const Vector2 Offset = At.Position - Pick;
+        const double  Slope  = Dot(At.First, At.First) + Dot(Offset, At.Second);
+        if (!(std::fabs(Slope) > 0.0)) break;
+        Best = std::clamp(Best - Dot(Offset, At.First) / Slope, Breaks.front(), Breaks.back());
+    }
+    const Vector2 Position = EvaluateSketchSpline(Carrier, Best).Position;
+    SketchModel&  Edited   = Outcome.Sketch;
+    SketchCurve&  Curve    = Edited.Curves[CurveIndex];
+    const int     Count    = static_cast<int>(Curve.Points.size());
+
+    if (Original.Form == SketchSplineForm::CubicSpline)
+    {
+        // ③ cubic spline: a through-point at τ*, its parameter kept beside the others.
+        std::vector<double> Parameters = Curve.Knots;
+        if (Parameters.empty()) for (int Index = 0; Index < Count; ++Index) Parameters.push_back(static_cast<double>(Index));
+        int Span = 0;
+        while (Span + 2 < Count && Parameters[Span + 1] <= Best) ++Span;
+        const double Width = Parameters[Span + 1] - Parameters[Span];
+        if (Best - Parameters[Span] <= PointGuard * Width || Parameters[Span + 1] - Best <= PointGuard * Width)
+        {
+            Outcome.Refusal = "there is a point of " + Name + " there already";
+            return Outcome;
+        }
+        const int Point = AppendSketchPoint(Edited, Position);
+        Edited.Curves[CurveIndex].Points.insert(Edited.Curves[CurveIndex].Points.begin() + Span + 1, Point);
+        Parameters.insert(Parameters.begin() + Span + 1, Best);
+        Edited.Curves[CurveIndex].Knots = std::move(Parameters);
+        Outcome.InsertedPoint  = Point;
+        Outcome.SplitPositions = { Position };
+        Outcome.Pieces         = 1;
+        return Outcome;
+    }
+
+    // ④ Hermite / Bezier / NURBS: control points + knots of the exact B-spline (Hermite: its handles become points),
+    //    then one Boehm insertion (Piegl & Tiller A5.1, r = 1) of τ*.
+    const int Degree = Carrier.Degree;
+    std::vector<int> Slots;                                                                  // Sketch point per carrier pole
+    if (Original.Form == SketchSplineForm::Hermite)
+    {
+        for (size_t Pole = 0; Pole < Carrier.Poles.size(); ++Pole)
+            Slots.push_back(Pole % 3 == 0 ? Curve.Points[Pole / 3] : AppendSketchPoint(Edited, Carrier.Poles[Pole]));
+    }
+    else Slots = Curve.Points;
+    const std::vector<double>& Knots = Carrier.Knots;
+    const int Last = static_cast<int>(Carrier.Poles.size()) - 1;                            // n
+    int Span = Degree;                                                                       // k: Knots[k] ≤ τ* < Knots[k + 1]
+    while (Span < Last && Knots[Span + 1] <= Best) ++Span;
+    int Multiplicity = 0;
+    for (double Knot : Knots) if (std::fabs(Knot - Best) <= 1.0e-12 * std::max(1.0, std::fabs(Knots.back() - Knots.front()))) ++Multiplicity;
+    if (Multiplicity > 0) Best = Knots[Span];
+    const double Range = Knots.back() - Knots.front();
+    if (Best - Knots.front() <= PointGuard * Range * 1.0e-2 || Knots.back() - Best <= PointGuard * Range * 1.0e-2)
+    {
+        Outcome.Refusal = "the pointer is on an end of " + Name + ": there is a point already";
+        return Outcome;
+    }
+    if (Multiplicity >= Degree)
+    {
+        Outcome.Refusal = Name + " already has a corner there (a knot repeated " + std::to_string(Multiplicity) + " times)";
+        return Outcome;
+    }
+    std::vector<Vector2> Poles(Last + 2);
+    for (int Index = 0; Index <= Span - Degree; ++Index) Poles[Index] = Carrier.Poles[Index];
+    for (int Index = Span - Multiplicity; Index <= Last; ++Index) Poles[Index + 1] = Carrier.Poles[Index];
+    for (int Index = Span - Degree + 1; Index <= Span - Multiplicity; ++Index)
+    {
+        const double Share = (Best - Knots[Index]) / (Knots[Index + Degree] - Knots[Index]);
+        Poles[Index] = Carrier.Poles[Index] * Share + Carrier.Poles[Index - 1] * (1.0 - Share);
+    }
+    std::vector<double> Refined = Knots;
+    Refined.insert(Refined.begin() + Span + 1, Best);
+    // Points: the untouched poles keep theirs, the moved ones Span − p + 1 … Span − s − 1 keep theirs at the new place,
+    // pole Span − s is the new point.
+    std::vector<int> Points(Last + 2, -1);
+    for (int Index = 0; Index <= Span - Degree; ++Index) Points[Index] = Slots[Index];
+    for (int Index = Span - Degree + 1; Index < Span - Multiplicity; ++Index) Points[Index] = Slots[Index];
+    for (int Index = Span - Multiplicity; Index <= Last; ++Index) Points[Index + 1] = Slots[Index];
+    Points[Span - Multiplicity] = AppendSketchPoint(Edited, Poles[Span - Multiplicity]);
+    for (int Index = Span - Degree + 1; Index < Span - Multiplicity; ++Index) Edited.Points[Points[Index]].Position = Poles[Index];
+    Edited.Curves[CurveIndex].Form   = SketchSplineForm::Nurbs;
+    Edited.Curves[CurveIndex].Points = Points;
+    Edited.Curves[CurveIndex].Knots  = std::move(Refined);
+    Outcome.InsertedPoint  = Points[Span - Multiplicity];
+    Outcome.SplitPositions = { Position };
+    Outcome.Pieces         = 1;
+    return Outcome;
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Sketch/SketchTrim.h b/Engine/GeometryProcessing/Sketch/SketchTrim.h
new file mode 100644
index 0000000000000000000000000000000000000000..7cb19ecd545b5edffcfa620ff0c754ec25da1e81
--- /dev/null
+++ b/Engine/GeometryProcessing/Sketch/SketchTrim.h
@@ -0,0 +1,104 @@
+/*====================================================================================================================================
+                                                           SKETCHTRIM.H
+====================================================================================================================================*/
+// 🧩 Curve trim (Plasticity T): the piece of a sketch curve under the pointer, between its neighbouring crossings, is removed;
+//    curve cut: the curve breaks in two at the pointer
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Sketch/SketchProfile.h"
+#include "Engine/GeometryProcessing/Sketch/SketchSolver.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 One crossing of two oriented segments: fractions on both (EvaluateProfileSegment), and the meeting point.
+struct SegmentCrossing
+{
+    double  TargetFraction = 0.0;                                                            // [-]   - On the trimmed segment
+    double  CutterFraction = 0.0;                                                            // [-]   - On the cutting segment
+    Vector2 Position       = {};                                                             // [len] - Where they meet
+};
+
+// 📝 The trimmed sketch and what came off. Pieces counts what is left of the curve: 0 (erased whole: nothing crossed it,
+//    or a circle crossed once), 1 (an end piece came off, or a circle became an arc) or 2 (a middle piece came off, the
+//    curve keeps the first part and a new curve carries the second). Removed samples the piece that came off.
+struct SketchTrimOutcome
+{
+    SketchModel          Sketch        = {};                                                 // [-]   - After the trim
+    int                  Pieces        = 0;                                                  // [-]   - Left of the curve (0, 1, 2)
+    int                  Crossings     = 0;                                                  // [-]   - Distinct crossings found on the curve
+    double               FromFraction  = 0.0;                                                // [-]   - Removed piece start (target fraction)
+    double               ToFraction    = 1.0;                                                // [-]   - Removed piece end (circle: may exceed 1)
+    std::vector<Vector2> Removed       = {};                                                 // [len] - Removed piece polyline
+    std::vector<Vector2> SplitPositions = {};                                                // [len] - Split: where the curve now breaks
+    std::string          Refusal       = {};                                                 // [-]   - Why nothing changed (empty: trimmed)
+    int                  InsertedPoint = -1;                                                 // [-]   - Insert point: the new defining point
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 Every crossing of Target with Cutter: polyline seeds (knot spans / ≤ 45° arc pieces, 24 samples each) refined by
+//    Newton on Target(s) − Cutter(t) = 0 over the exact curves, kept within Join; touching ends count. Sorted by
+//    TargetFraction, duplicates (≤ 10⁻⁹) merged. Overlapping collinear pieces have no isolated crossing and are skipped.
+[[nodiscard]] std::vector<SegmentCrossing> IntersectProfileSegments(const ProfileSegment& Target, const ProfileSegment& Cutter, double Join);
+
+// Fraction of the point of Segment nearest to Point (dense samples, then Newton on the tangent).
+[[nodiscard]] double LocateProfileFraction(const ProfileSegment& Segment, Vector2 Point);
+
+// 💡 Plasticity T on curve CurveIndex of a solved sketch: the crossings come from the sketch's other curves (all, also
+//    construction) and from Foreign (curves of coplanar sketches, already in this sketch's plane coordinates). The piece
+//    holding Pick between neighbouring crossings comes off:
+//      line / arc → shortened, or split in two (the second part is a new curve with the next identifier);
+//      circle     → the complementary arc (needs ≥ 2 crossings);
+//      no crossing on an open curve, or < 2 on a circle → the curve is erased (Plasticity behaviour);
+//      spline with crossings → refused (the point-defined forms have no exact split).
+//    Constraints: those on an erased curve drop and later curve references shift; a shortened line drops Length,
+//    EqualLength, Midpoint and Symmetric; a split line copies Horizontal, Vertical, Parallel, Perpendicular and Angle to
+//    its new part, a split arc copies Radius and EqualRadius. A new end made by a line, circle or arc of the same sketch
+//    is pinned to it (PointOnLine / PointOnCircle) so later solves keep the trim.
+[[nodiscard]] SketchTrimOutcome TrimSketchCurve(const SketchModel& Sketch, int CurveIndex, Vector2 Pick, const std::vector<ProfileSegment>& Foreign = {});
+
+// 💡 Plasticity Cut on curve CurveIndex at the point nearest to Pick: nothing comes off, the curve breaks there.
+//      line / arc → two curves meeting at one shared new point (the second part gets the next identifier);
+//      circle     → two arcs, from the pick to Partner and back (same centre and radius); without Partner (or with one
+//                   at the pick) two half arcs, the second break at the opposite point;
+//      spline, or a pick on an open curve's end → refused.
+//    A split line drops Length, EqualLength, Midpoint and Symmetric and copies Horizontal, Vertical, Parallel,
+//    Perpendicular and Angle to its second part; a split arc / circle copies Radius and EqualRadius.
+[[nodiscard]] SketchTrimOutcome SplitSketchCurve(const SketchModel& Sketch, int CurveIndex, Vector2 Pick, std::optional<Vector2> Partner = std::nullopt);
+
+// 💡 Insert point: a new defining point on curve CurveIndex nearest to Pick, the shape unchanged (to be dragged next).
+//      line / arc / circle → split there as Cut does (a circle also at the opposite point); a split line drops its
+//                            direction constraints (H, V, parallel, perpendicular, angle) so the new point moves freely;
+//      cubic spline        → a through-point at its parameter τ*: the curve keeps one τ per point (SketchCurve::Knots), and
+//                            the natural C² interpolant on the refined parameters is the same cubic pieces (exact);
+//      Hermite / Bezier / NURBS → the curve becomes a NURBS on its own knot vector with τ* inserted once (Boehm): one more
+//                            control point, the neighbours moved so the curve stays the same (exact; Hermite through-points
+//                            stay as control points on the curve, their handles become control points too).
+//    Refused: the pick on an open end, on an existing point, or where a NURBS already has a corner knot.
+[[nodiscard]] SketchTrimOutcome InsertSketchCurvePoint(const SketchModel& Sketch, int CurveIndex, Vector2 Pick);
+
+// Curve CurveIndex erased: constraints on it dropped, later curve references shifted down. Points stay.
+void EraseSketchCurve(SketchModel& Sketch, int CurveIndex);
+
+// 💡 Delete on sketch points (mode 1 X): every curve through one of Points goes (EraseSketchCurve), then every point no
+//    remaining curve uses is dropped with the constraints naming it (Coincident, Fixed, distances, point-on, midpoint,
+//    symmetric); later point references shift down. Returns the number of curves erased.
+int EraseSketchPoints(SketchModel& Sketch, const std::vector<int>& Points);
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Surfacing/CarrierApproximation.cpp b/Engine/GeometryProcessing/Surfacing/CarrierApproximation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..447bf78656ebc7cf96d7c238b4f68b9579ef7626
--- /dev/null
+++ b/Engine/GeometryProcessing/Surfacing/CarrierApproximation.cpp
@@ -0,0 +1,411 @@
+/*====================================================================================================================================
+                                                   CARRIERAPPROXIMATION.CPP
+====================================================================================================================================*/
+// 🧩 Certified cubic B-spline stand-ins for procedural carriers: Greville interpolation, triple knots at C¹ breaks
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Surfacing/CarrierApproximation.h"
+
+#include "Engine/GeometryProcessing/Surfacing/LinearSystem.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <functional>
+#include <limits>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    constexpr int                   SplineDegree = 3;                                        // [-] - Cubic
+    constexpr std::array<double, 6> CellProbes   = { 0.0, 0.1, 0.3, 0.5, 0.7, 0.9 };         // [-] - Fractions per span (start included)
+    constexpr int                   BundleCount  = 17;                                       // [-] - Iso-curves per direction for knot choice
+    constexpr int                   TensorRounds = 12;                                       // [-] - Cell refinement rounds
+
+    // 📝 Span layout of one direction: sorted breaks Low … High. Carrier C¹ breaks (spine / basis knots) are seeded as
+    //    boundaries with multiplicity 2 (C¹ in the spline, matching the carrier: a traced spine's chart speed kinks by a
+    //    few per cent of curvature at every trace knot, which a C² spline could only smooth with tiny spans); every
+    //    other interior break has multiplicity 1 (C²). Measured on the r 0.2 rim at 10⁻⁶: 222 spans seeded vs 266 split
+    //    on demand.
+    struct SpanLayout
+    {
+        std::vector<double> Breaks     = {};                                                 // [-] - Span boundaries
+        std::vector<double> Structural = {};                                                 // [-] - Carrier breaks, sorted
+    };
+
+    [[nodiscard]] SpanLayout OpenLayout(double Low, double High, const std::vector<double>& Breakpoints, int Pieces)
+    {
+        SpanLayout Layout;
+        const double Margin = 1.0e-9 * (High - Low);                                          // [-] - Breaks this close to an end are the end
+        for (double Break : Breakpoints)
+            if (Break > Low + Margin && Break < High - Margin && (Layout.Structural.empty() || Break > Layout.Structural.back() + Margin)) Layout.Structural.push_back(Break);
+        for (int Piece = 0; Piece < Pieces; ++Piece) Layout.Breaks.push_back(Low + (High - Low) * Piece / Pieces);
+        Layout.Breaks.insert(Layout.Breaks.end(), Layout.Structural.begin(), Layout.Structural.end());
+        Layout.Breaks.push_back(High);
+        std::sort(Layout.Breaks.begin(), Layout.Breaks.end());
+        Layout.Breaks.erase(std::unique(Layout.Breaks.begin(), Layout.Breaks.end(), [&](double First, double Second) { return Second - First <= Margin; }), Layout.Breaks.end());
+        return Layout;
+    }
+
+    [[nodiscard]] bool StructuralCondition(const SpanLayout& Layout, double Value) { return std::binary_search(Layout.Structural.begin(), Layout.Structural.end(), Value); }
+
+    [[nodiscard]] std::vector<double> AssembleKnots(const SpanLayout& Layout)
+    {
+        std::vector<double> Knots(SplineDegree + 1, Layout.Breaks.front());
+        for (size_t Index = 1; Index + 1 < Layout.Breaks.size(); ++Index)
+        {
+            const int Multiplicity = StructuralCondition(Layout, Layout.Breaks[Index]) ? 2 : 1;
+            Knots.insert(Knots.end(), Multiplicity, Layout.Breaks[Index]);
+        }
+        Knots.insert(Knots.end(), SplineDegree + 1, Layout.Breaks.back());
+        return Knots;
+    }
+
+    [[nodiscard]] int PoleCount(const std::vector<double>& Knots) { return static_cast<int>(Knots.size()) - SplineDegree - 1; }
+
+    // Greville abscissae ξᵢ = (tᵢ₊₁ + … + tᵢ₊ₚ)/p: one per pole, interpolation there is well posed (Schoenberg–Whitney).
+    [[nodiscard]] std::vector<double> GrevilleAbscissae(const std::vector<double>& Knots)
+    {
+        std::vector<double> Abscissae(static_cast<size_t>(PoleCount(Knots)));
+        for (size_t Index = 0; Index < Abscissae.size(); ++Index)
+        {
+            double Sum = 0.0;
+            for (int Offset = 1; Offset <= SplineDegree; ++Offset) Sum += Knots[Index + Offset];
+            Abscissae[Index] = Sum / SplineDegree;
+        }
+        return Abscissae;
+    }
+
+    [[nodiscard]] DenseMatrix CollocationMatrix(const std::vector<double>& Knots, const std::vector<double>& Abscissae)
+    {
+        const int   Count = PoleCount(Knots);
+        DenseMatrix Matrix(Count, Count);
+        for (int Row = 0; Row < Count; ++Row)
+        {
+            const NurbsBasisSample Basis = EvaluateNurbsBasis(Knots, SplineDegree, Count, Abscissae[Row]);
+            for (size_t Offset = 0; Offset < Basis.Values[0].size(); ++Offset) Matrix.At(Row, Basis.First + static_cast<int>(Offset)) = Basis.Values[0][Offset];
+        }
+        return Matrix;
+    }
+
+    // Solves Matrix · X = Samples for Bundle columns of points at once (Samples[member][row]); nullopt when singular.
+    [[nodiscard]] std::optional<std::vector<std::vector<Vector3>>> SolveBundle(const DenseMatrix& Matrix, const std::vector<std::vector<Vector3>>& Samples)
+    {
+        const int   Count = Matrix.Rows;
+        const int   Members = static_cast<int>(Samples.size());
+        DenseMatrix Sides(Count, 3 * Members);
+        for (int Member = 0; Member < Members; ++Member)
+            for (int Row = 0; Row < Count; ++Row)
+            {
+                Sides.At(Row, 3 * Member + 0) = Samples[Member][Row].X;
+                Sides.At(Row, 3 * Member + 1) = Samples[Member][Row].Y;
+                Sides.At(Row, 3 * Member + 2) = Samples[Member][Row].Z;
+            }
+        const std::optional<DenseMatrix> Solution = SolveDenseSystem(Matrix, Sides);
+        if (!Solution) return std::nullopt;
+        std::vector<std::vector<Vector3>> Poles(static_cast<size_t>(Members), std::vector<Vector3>(static_cast<size_t>(Count)));
+        for (int Member = 0; Member < Members; ++Member)
+            for (int Row = 0; Row < Count; ++Row) Poles[Member][Row] = { Solution->At(Row, 3 * Member + 0), Solution->At(Row, 3 * Member + 1), Solution->At(Row, 3 * Member + 2) };
+        return Poles;
+    }
+
+    [[nodiscard]] Vector3 EvaluateSpline(const std::vector<double>& Knots, const std::vector<Vector3>& Poles, double τ)
+    {
+        const NurbsBasisSample Basis = EvaluateNurbsBasis(Knots, SplineDegree, static_cast<int>(Poles.size()), τ);
+        Vector3 Position = {};
+        for (size_t Offset = 0; Offset < Basis.Values[0].size(); ++Offset) Position = Position + Poles[Basis.First + Offset] * Basis.Values[0][Offset];
+        return Position;
+    }
+
+    [[nodiscard]] Vector3 EvaluateSplineDerivative(const std::vector<double>& Knots, const std::vector<Vector3>& Poles, double τ)
+    {
+        const NurbsBasisSample Basis = EvaluateNurbsBasis(Knots, SplineDegree, static_cast<int>(Poles.size()), τ);
+        Vector3 Derivative = {};
+        for (size_t Offset = 0; Offset < Basis.Values[1].size(); ++Offset) Derivative = Derivative + Poles[Basis.First + Offset] * Basis.Values[1][Offset];
+        return Derivative;
+    }
+
+    // Angle between two directions as lines (0 when either vanishes: a collapsed row has no direction to keep).
+    [[nodiscard]] double LineAngle(Vector3 First, Vector3 Second) noexcept
+    {
+        const double Scale = Length(First) * Length(Second);
+        return Scale > 0.0 ? std::asin(std::min(1.0, Length(Cross(First, Second)) / Scale)) : 0.0;
+    }
+
+    [[nodiscard]] bool FiniteCondition(Vector3 Position) noexcept { return std::isfinite(Position.X) && std::isfinite(Position.Y) && std::isfinite(Position.Z); }
+
+    // Each span flagged in Split is halved — at the carrier break nearest its middle when one lies well inside it.
+    void SplitSpans(SpanLayout& Layout, const std::vector<char>& Split)
+    {
+        std::vector<double> Breaks = { Layout.Breaks.front() };
+        for (size_t Span = 0; Span + 1 < Layout.Breaks.size(); ++Span)
+        {
+            const double Low = Layout.Breaks[Span], High = Layout.Breaks[Span + 1], Middle = 0.5 * (Low + High);
+            if (Split[Span])
+            {
+                double Cut = Middle;
+                const double Margin = 1.0e-3 * (High - Low);                                  // [-] - Keep both halves real
+                const auto   First  = std::upper_bound(Layout.Structural.begin(), Layout.Structural.end(), Low + Margin);
+                for (auto Break = First; Break != Layout.Structural.end() && *Break < High - Margin; ++Break)
+                    if (Cut == Middle || std::fabs(*Break - Middle) < std::fabs(Cut - Middle)) Cut = *Break;
+                Breaks.push_back(Cut);
+            }
+            Breaks.push_back(High);
+        }
+        Layout.Breaks = std::move(Breaks);
+    }
+
+    // 📝 Adaptive 1D interpolation of a bundle of curves sharing one knot vector: fit, probe each span against the exact
+    //    bundle (position within Tolerance, tangent line within AngularTolerance), halve the failing spans, repeat.
+    //    Sample fills one position and one derivative per member (false = not finite).
+    struct BundleFit
+    {
+        SpanLayout                        Layout    = {};                                    // [-]
+        std::vector<double>               Knots     = {};                                    // [-]
+        std::vector<std::vector<Vector3>> Poles     = {};                                    // [len] - Per member
+        double                            Deviation = 0.0;                                   // [len]
+        std::string                       Refusal   = {};                                    // [-]
+    };
+
+    using BundleSample = std::function<bool(double, std::vector<Vector3>&, std::vector<Vector3>&)>;
+
+    [[nodiscard]] BundleFit FitBundle(const BundleSample& Sample, SpanLayout Layout, double Tolerance, double AngularTolerance, int MaximumSpans)
+    {
+        BundleFit Fit;
+        std::vector<Vector3> Exact, Tangents;
+        while (true)
+        {
+            const int Spans = static_cast<int>(Layout.Breaks.size()) - 1;
+            if (Spans > MaximumSpans) { Fit.Refusal = "approximation: more than " + std::to_string(MaximumSpans) + " spans needed for the tolerance"; return Fit; }
+            const std::vector<double> Knots     = AssembleKnots(Layout);
+            const std::vector<double> Abscissae = GrevilleAbscissae(Knots);
+            std::vector<std::vector<Vector3>> Samples;
+            for (size_t Row = 0; Row < Abscissae.size(); ++Row)
+            {
+                if (!Sample(Abscissae[Row], Exact, Tangents)) { Fit.Refusal = "approximation: the carrier is not finite on the window"; return Fit; }
+                if (Samples.empty()) Samples.assign(Exact.size(), std::vector<Vector3>(Abscissae.size()));
+                for (size_t Member = 0; Member < Exact.size(); ++Member) Samples[Member][Row] = Exact[Member];
+            }
+            const std::optional<std::vector<std::vector<Vector3>>> Poles = SolveBundle(CollocationMatrix(Knots, Abscissae), Samples);
+            if (!Poles) { Fit.Refusal = "approximation: singular collocation system"; return Fit; }
+            std::vector<char> Split(static_cast<size_t>(Spans), 0);
+            double Deviation = 0.0;
+            for (int Span = 0; Span < Spans; ++Span)
+            {
+                const double Low = Layout.Breaks[Span], High = Layout.Breaks[Span + 1];
+                for (double Fraction : CellProbes)
+                {
+                    const double τ = Low + (High - Low) * Fraction;
+                    if (!Sample(τ, Exact, Tangents)) { Fit.Refusal = "approximation: the carrier is not finite on the window"; return Fit; }
+                    for (size_t Member = 0; Member < Exact.size(); ++Member)
+                    {
+                        const double Gap   = Distance(Exact[Member], EvaluateSpline(Knots, (*Poles)[Member], τ));
+                        const double Angle = LineAngle(Tangents[Member], EvaluateSplineDerivative(Knots, (*Poles)[Member], τ));
+                        Deviation = std::max(Deviation, Gap);
+                        if (!(Gap <= Tolerance) || !(Angle <= AngularTolerance)) Split[Span] = 1;
+                    }
+                }
+            }
+            if (std::none_of(Split.begin(), Split.end(), [](char Flag) { return Flag != 0; }))
+            {
+                Fit.Layout = std::move(Layout);
+                Fit.Knots = Knots;
+                Fit.Poles = *Poles;
+                Fit.Deviation = Deviation;
+                return Fit;
+            }
+            SplitSpans(Layout, Split);
+        }
+    }
+
+    [[nodiscard]] bool UsableSettings(const ApproximationSettings& Settings) noexcept
+    {
+        return std::isfinite(Settings.Tolerance) && Settings.Tolerance > 0.0 && std::isfinite(Settings.AngularTolerance) && Settings.AngularTolerance > 0.0 && Settings.MaximumSpans >= 1;
+    }
+
+    // The span holding Value in a sorted break list (last span for the end).
+    [[nodiscard]] size_t LocateSpan(const std::vector<double>& Breaks, double Value)
+    {
+        const size_t Upper = static_cast<size_t>(std::upper_bound(Breaks.begin(), Breaks.end(), Value) - Breaks.begin());
+        return std::min(Upper == 0 ? 0 : Upper - 1, Breaks.size() - 2);
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+SurfaceApproximation ApproximateDeformedSurface(const SurfaceGeometry& Exact,
+                                                const std::function<SurfaceSample(const SurfaceSample&)>& Deform,
+                                                Vector2 Low, Vector2 High, const ApproximationSettings& Settings)
+{
+    SurfaceApproximation Outcome;
+    if (!UsableSettings(Settings)) { Outcome.Refusal = "approximation: the tolerance must be positive and finite"; return Outcome; }
+    if (!(std::isfinite(Low.X) && std::isfinite(Low.Y) && std::isfinite(High.X) && std::isfinite(High.Y) && High.X > Low.X && High.Y > Low.Y))
+    {
+        Outcome.Refusal = "approximation: empty or non-finite parameter window";
+        return Outcome;
+    }
+    const auto EvaluateMapped = [&](double U, double V) { return Deform ? Deform(EvaluateSurface(Exact, { U, V })) : EvaluateSurface(Exact, { U, V }); };
+    const auto Position       = [&](double U, double V) { return EvaluateMapped(U, V).Position; };
+    const auto Bundle         = [&](const std::vector<double>& Across, bool AlongU)
+    {
+        return [&EvaluateMapped, &Across, AlongU](double Value, std::vector<Vector3>& Positions, std::vector<Vector3>& Tangents)
+        {
+            Positions.resize(Across.size());
+            Tangents.resize(Across.size());
+            for (size_t Member = 0; Member < Across.size(); ++Member)
+            {
+                const SurfaceSample Sample = EvaluateMapped(AlongU ? Value : Across[Member], AlongU ? Across[Member] : Value);
+                Positions[Member] = Sample.Position;
+                Tangents[Member]  = AlongU ? Sample.DerivativeU : Sample.DerivativeV;
+                if (!FiniteCondition(Positions[Member]) || !FiniteCondition(Tangents[Member])) return false;
+            }
+            return true;
+        };
+    };
+
+    // ① Carrier breaks, then knots per direction from iso-curve bundles.
+    SpanLayout LayoutU = OpenLayout(Low.X, High.X, CollectSurfaceBreakpoints(Exact, Low.X, High.X), 4);
+    SpanLayout LayoutV = OpenLayout(Low.Y, High.Y, CollectSurfaceBreakpointsAlongV(Exact, Low.Y, High.Y), 4);
+    const auto Across = [](double First, double Last)
+    {
+        std::vector<double> Values;
+        for (int Index = 0; Index < BundleCount; ++Index) Values.push_back(First + (Last - First) * Index / (BundleCount - 1));
+        return Values;
+    };
+    const std::vector<double> AcrossV = Across(Low.Y, High.Y), AcrossU = Across(Low.X, High.X);
+    const BundleFit FitU = FitBundle(Bundle(AcrossV, true), LayoutU, 0.25 * Settings.Tolerance, 0.25 * Settings.AngularTolerance, Settings.MaximumSpans);
+    if (!FitU.Refusal.empty()) { Outcome.Refusal = FitU.Refusal + " (along u)"; return Outcome; }
+    const BundleFit FitV = FitBundle(Bundle(AcrossU, false), LayoutV, 0.25 * Settings.Tolerance, 0.25 * Settings.AngularTolerance, Settings.MaximumSpans);
+    if (!FitV.Refusal.empty()) { Outcome.Refusal = FitV.Refusal + " (along v)"; return Outcome; }
+    LayoutU = FitU.Layout;
+    LayoutV = FitV.Layout;
+
+    // ② Tensor interpolation at the Greville lattice (u solve, then v solve) and certification per knot cell.
+    for (int Round = 1; Round <= TensorRounds; ++Round)
+    {
+        Outcome.Rounds = Round;
+        const int SpansU = static_cast<int>(LayoutU.Breaks.size()) - 1, SpansV = static_cast<int>(LayoutV.Breaks.size()) - 1;
+        if (SpansU > Settings.MaximumSpans || SpansV > Settings.MaximumSpans)
+        {
+            Outcome.Refusal = "approximation: more than " + std::to_string(Settings.MaximumSpans) + " spans needed for the tolerance";
+            return Outcome;
+        }
+        const std::vector<double> KnotsU = AssembleKnots(LayoutU), KnotsV = AssembleKnots(LayoutV);
+        const std::vector<double> GrevilleU = GrevilleAbscissae(KnotsU), GrevilleV = GrevilleAbscissae(KnotsV);
+        const int CountU = PoleCount(KnotsU), CountV = PoleCount(KnotsV);
+        std::vector<std::vector<Vector3>> Columns(static_cast<size_t>(CountV), std::vector<Vector3>(static_cast<size_t>(CountU)));
+        for (int I = 0; I < CountU; ++I)
+            for (int J = 0; J < CountV; ++J)
+            {
+                Columns[J][I] = Position(GrevilleU[I], GrevilleV[J]);
+                if (!FiniteCondition(Columns[J][I])) { Outcome.Refusal = "approximation: the carrier is not finite on the window"; return Outcome; }
+            }
+        const std::optional<std::vector<std::vector<Vector3>>> Intermediate = SolveBundle(CollocationMatrix(KnotsU, GrevilleU), Columns);
+        if (!Intermediate) { Outcome.Refusal = "approximation: singular collocation system"; return Outcome; }
+        std::vector<std::vector<Vector3>> Rows(static_cast<size_t>(CountU), std::vector<Vector3>(static_cast<size_t>(CountV)));
+        for (int I = 0; I < CountU; ++I)
+            for (int J = 0; J < CountV; ++J) Rows[I][J] = (*Intermediate)[J][I];
+        const std::optional<std::vector<std::vector<Vector3>>> Final = SolveBundle(CollocationMatrix(KnotsV, GrevilleV), Rows);
+        if (!Final) { Outcome.Refusal = "approximation: singular collocation system"; return Outcome; }
+        std::vector<Vector3> Poles;
+        Poles.reserve(static_cast<size_t>(CountU) * CountV);
+        for (int I = 0; I < CountU; ++I)
+            for (int J = 0; J < CountV; ++J) Poles.push_back((*Final)[I][J]);
+        std::optional<NurbsSurface> Surface = ConstructNurbsSurface(SplineDegree, SplineDegree, CountU, CountV, KnotsU, KnotsV, Poles, std::vector<double>(Poles.size(), 1.0));
+        if (!Surface) { Outcome.Refusal = "approximation: the spline could not be constructed"; return Outcome; }
+
+        std::vector<char> SplitU(static_cast<size_t>(SpansU), 0), SplitV(static_cast<size_t>(SpansV), 0);
+        double Deviation = 0.0, Drift = 0.0;
+        std::vector<double> ProbesU, ProbesV;
+        for (int Span = 0; Span < SpansU; ++Span)
+            for (double Fraction : CellProbes) ProbesU.push_back(LayoutU.Breaks[Span] + (LayoutU.Breaks[Span + 1] - LayoutU.Breaks[Span]) * Fraction);
+        for (int Span = 0; Span < SpansV; ++Span)
+            for (double Fraction : CellProbes) ProbesV.push_back(LayoutV.Breaks[Span] + (LayoutV.Breaks[Span + 1] - LayoutV.Breaks[Span]) * Fraction);
+        ProbesU.push_back(High.X);
+        ProbesV.push_back(High.Y);
+        for (double U : ProbesU)
+            for (double V : ProbesV)
+            {
+                const SurfaceSample Reference = EvaluateMapped(U, V);
+                const SurfaceSample Spline    = EvaluateNurbsSurface(*Surface, { U, V });
+                const double Gap   = Distance(Reference.Position, Spline.Position);
+                const double Angle = LineAngle(Cross(Reference.DerivativeU, Reference.DerivativeV), Cross(Spline.DerivativeU, Spline.DerivativeV));
+                Deviation = std::max(Deviation, Gap);
+                Drift     = std::max(Drift, Angle);
+                if (!(Gap <= Settings.Tolerance) || !(Angle <= 0.5 * Settings.AngularTolerance)) { SplitU[LocateSpan(LayoutU.Breaks, U)] = 1; SplitV[LocateSpan(LayoutV.Breaks, V)] = 1; }
+            }
+        Outcome.SpansU = SpansU;
+        Outcome.SpansV = SpansV;
+        Outcome.Deviation = Deviation;
+        Outcome.Drift     = Drift;
+        if (Deviation <= Settings.Tolerance && Drift <= 0.5 * Settings.AngularTolerance)
+        {
+            Outcome.Surface = std::move(Surface);
+            return Outcome;
+        }
+        SplitSpans(LayoutU, SplitU);
+        SplitSpans(LayoutV, SplitV);
+    }
+    Outcome.Refusal = "approximation: the tensor fit did not certify within " + std::to_string(TensorRounds) + " rounds";
+    return Outcome;
+}
+
+SurfaceApproximation ApproximateSurfaceAsNurbs(const SurfaceGeometry& Exact, Vector2 Low, Vector2 High, const ApproximationSettings& Settings)
+{
+    return ApproximateDeformedSurface(Exact, {}, Low, High, Settings);
+}
+
+CurveApproximation ApproximateDeformedCurve(const CurveGeometry& Exact,
+                                            const std::function<Vector3(Vector3)>& Deform,
+                                            double Low, double High, const ApproximationSettings& Settings)
+{
+    CurveApproximation Outcome;
+    if (!UsableSettings(Settings)) { Outcome.Refusal = "approximation: the tolerance must be positive and finite"; return Outcome; }
+    if (!(std::isfinite(Low) && std::isfinite(High) && High > Low)) { Outcome.Refusal = "approximation: empty or non-finite interval"; return Outcome; }
+    const auto EvaluatePoint = [&](double τ)
+    {
+        const Vector3 Point = EvaluateCurve(Exact, τ).Position;
+        return Deform ? Deform(Point) : Point;
+    };
+    SpanLayout Layout = OpenLayout(Low, High, CollectCurveBreakpoints(Exact, Low, High), 2);
+    const BundleFit Fit = FitBundle([&](double τ, std::vector<Vector3>& Point, std::vector<Vector3>& Tangent)
+    {
+        Point.assign(1, EvaluatePoint(τ));
+        Tangent.assign(1, Vector3{});
+        return FiniteCondition(Point[0]);
+    }, Layout, 0.5 * Settings.Tolerance, std::numeric_limits<double>::infinity(), Settings.MaximumSpans);
+    if (!Fit.Refusal.empty()) { Outcome.Refusal = Fit.Refusal; return Outcome; }
+    std::optional<NurbsCurve> Curve = ConstructNurbsCurve(SplineDegree, Fit.Knots, Fit.Poles[0], std::vector<double>(Fit.Poles[0].size(), 1.0));
+    if (!Curve) { Outcome.Refusal = "approximation: the spline could not be constructed"; return Outcome; }
+    double Deviation = 0.0;
+    for (size_t Span = 0; Span + 1 < Fit.Layout.Breaks.size(); ++Span)
+        for (int Probe = 0; Probe <= 16; ++Probe)
+        {
+            const double τ = Fit.Layout.Breaks[Span] + (Fit.Layout.Breaks[Span + 1] - Fit.Layout.Breaks[Span]) * Probe / 16.0;
+            Deviation = std::max(Deviation, Distance(EvaluatePoint(τ), EvaluateCurve(*Curve, τ).Position));
+        }
+    if (!(Deviation <= Settings.Tolerance)) { Outcome.Refusal = "approximation: the curve did not certify"; return Outcome; }
+    Outcome.Curve     = std::move(Curve);
+    Outcome.Deviation = Deviation;
+    Outcome.Spans     = static_cast<int>(Fit.Layout.Breaks.size()) - 1;
+    return Outcome;
+}
+
+CurveApproximation ApproximateCurveAsNurbs(const CurveGeometry& Exact, double Low, double High, const ApproximationSettings& Settings)
+{
+    return ApproximateDeformedCurve(Exact, {}, Low, High, Settings);
+}
+
+}
diff --git a/Engine/GeometryProcessing/Surfacing/CarrierApproximation.h b/Engine/GeometryProcessing/Surfacing/CarrierApproximation.h
new file mode 100644
index 0000000000000000000000000000000000000000..9b7db8bf4b4a69f0d1110bc146d14bc10260d9ed
--- /dev/null
+++ b/Engine/GeometryProcessing/Surfacing/CarrierApproximation.h
@@ -0,0 +1,83 @@
+/*====================================================================================================================================
+                                                    CARRIERAPPROXIMATION.H
+====================================================================================================================================*/
+// 🧩 Certified NURBS approximation of procedural carriers (rolling ball, parallel offset, traced curves) — option A of the
+//    blend plan: the exact procedural surface stays the reference, the cubic B-spline is its exchangeable stand-in
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Geometry/CurveGeometry.h"
+#include "Engine/GeometryProcessing/Geometry/NurbsCarrier.h"
+#include "Engine/GeometryProcessing/Geometry/SurfaceGeometry.h"
+
+#include <functional>
+#include <optional>
+#include <string>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 Tolerance bounds the PARAMETRIC deviation |S(𝑢, 𝑣) − A(𝑢, 𝑣)| (same chart, so it also bounds the geometric
+//    Hausdorff distance). AngularTolerance bounds the normal-line drift of surface stand-ins (G1 across blend
+//    boundaries survives within it; the default 10⁻³ rad is far inside the usual ½° CAD G1 tolerance). MaximumSpans caps each direction; past it the approximation is refused, never
+//    loosened.
+struct ApproximationSettings
+{
+    double Tolerance        = 1.0e-6;                                                        // [len] - Deviation bound
+    double AngularTolerance = 1.0e-3;                                                        // [rad] - Normal drift bound (surfaces), 0.057°
+    int    MaximumSpans     = 512;                                                           // [-]   - Spans per direction
+};
+
+struct SurfaceApproximation
+{
+    std::optional<NurbsSurface> Surface   = std::nullopt;                                    // [-]   - Cubic, non-rational
+    double                      Deviation = 0.0;                                             // [len] - Max |S − A| on the certification lattice
+    double                      Drift     = 0.0;                                             // [rad] - Max normal-line angle there
+    int                         SpansU    = 0;                                               // [-]
+    int                         SpansV    = 0;                                               // [-]
+    int                         Rounds    = 0;                                               // [-]   - Tensor refinement rounds
+    std::string                 Refusal   = {};                                              // [-]   - Empty on success
+};
+
+struct CurveApproximation
+{
+    std::optional<NurbsCurve> Curve     = std::nullopt;                                      // [-]   - Cubic, non-rational
+    double                    Deviation = 0.0;                                               // [len] - Max |C − A| on the certification lattice
+    int                       Spans     = 0;                                                 // [-]
+    std::string               Refusal   = {};                                                // [-]   - Empty on success
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 Cubic tensor B-spline over [Low, High] in the carrier's OWN parameterisation, so SP-curves, vertices and face
+//    charts carry over unchanged. ① The carrier's C¹ breaks (traced-spine / basis knots: the chart's speed kinks
+//    there even where the geometry is smooth) are seeded as double knots; knots per direction then come from adaptive
+//    1D interpolation of a bundle of 17 iso-curves (Greville abscissae, Schoenberg–Whitney safe) to a quarter of the
+//    tolerance.
+//    ② The tensor interpolant is certified on a 6 × 6 lattice per knot cell (cell edges included) for position and
+//    normal; failing cells are split both ways and refitted. Deviation / Drift are the certified maxima — never above
+//    Tolerance / ½ AngularTolerance.
+[[nodiscard]] SurfaceApproximation ApproximateSurfaceAsNurbs(const SurfaceGeometry& Exact, Vector2 Low, Vector2 High, const ApproximationSettings& Settings = {});
+
+// The same for a curve over [Low, High] with τ kept (an edge's interval maps onto itself, its vertices exactly).
+[[nodiscard]] CurveApproximation   ApproximateCurveAsNurbs(const CurveGeometry& Exact, double Low, double High, const ApproximationSettings& Settings = {});
+
+// Certified cubic B-spline approximation of a smooth spatial deformation Φ applied to Exact over its own chart / interval.
+[[nodiscard]] SurfaceApproximation ApproximateDeformedSurface(const SurfaceGeometry& Exact,
+                                                              const std::function<SurfaceSample(const SurfaceSample&)>& Deform,
+                                                              Vector2 Low, Vector2 High, const ApproximationSettings& Settings = {});
+[[nodiscard]] CurveApproximation   ApproximateDeformedCurve(const CurveGeometry& Exact,
+                                                            const std::function<Vector3(Vector3)>& Deform,
+                                                            double Low, double High, const ApproximationSettings& Settings = {});
+
+}
diff --git a/Engine/GeometryProcessing/Surfacing/CurveFitting.cpp b/Engine/GeometryProcessing/Surfacing/CurveFitting.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..828de2e68bf2c2abbf5d80300b20838a0274a1ca
--- /dev/null
+++ b/Engine/GeometryProcessing/Surfacing/CurveFitting.cpp
@@ -0,0 +1,575 @@
+/*====================================================================================================================================
+                                                           CURVEFITTING.CPP
+====================================================================================================================================*/
+// 🧩 Space-curve fitting: centripetal parameters, faired least squares, foot-point correction, knot refinement
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Surfacing/CurveFitting.h"
+#include "Engine/GeometryProcessing/Surfacing/LinearSystem.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <optional>
+#include <set>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PRIVATE FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    constexpr double DuplicateGap = 1.0e-12;                                                 // [len] - Consecutive points closer than this merge
+    constexpr std::array<double, 4> GaussAbscissae = { -0.8611363115940526, -0.3399810435848563, 0.3399810435848563, 0.8611363115940526 };
+    constexpr std::array<double, 4> GaussWeights   = {  0.3478548451374538,  0.6521451548625461, 0.6521451548625461, 0.3478548451374538 };
+
+    // Consecutive duplicates removed; Source maps each kept point back to its input index.
+    [[nodiscard]] std::vector<Vector3> MergeDuplicates(const std::vector<Vector3>& Points, std::vector<int>& Source)
+    {
+        std::vector<Vector3> Kept;
+        for (size_t Index = 0; Index < Points.size(); ++Index)
+        {
+            if (!Kept.empty() && Length(Points[Index] - Kept.back()) <= DuplicateGap) continue;
+            Kept.push_back(Points[Index]);
+            Source.push_back(static_cast<int>(Index));
+        }
+        return Kept;
+    }
+
+    // 𝑡ₖ ∝ Σ √|Qᵢ − Qᵢ₋₁| (Lee 1989), normalised onto [0, 1].
+    [[nodiscard]] std::vector<double> CentripetalParameters(const std::vector<Vector3>& Points)
+    {
+        std::vector<double> Parameters(Points.size(), 0.0);
+        for (size_t Index = 1; Index < Points.size(); ++Index) Parameters[Index] = Parameters[Index - 1] + std::sqrt(Length(Points[Index] - Points[Index - 1]));
+        const double Total = Parameters.back();
+        for (double& Parameter : Parameters) Parameter /= Total;
+        Parameters.back() = 1.0;
+        return Parameters;
+    }
+
+    [[nodiscard]] std::vector<double> ClampedKnots(int Degree, const std::vector<double>& Interior)
+    {
+        std::vector<double> Knots(Degree + 1, 0.0);
+        Knots.insert(Knots.end(), Interior.begin(), Interior.end());
+        Knots.insert(Knots.end(), Degree + 1, 1.0);
+        return Knots;
+    }
+
+    // 📝 Normal equations for the interior poles P₁ … Pₙ₋₁ (P₀ = Q₀, Pₙ = Qₘ fixed):
+    //    (NᵀN + λ·G)·P = Nᵀ·R − λ·G_boundary·P_boundary, Gᵢⱼ = ∫ Nᵢ″ Nⱼ″ d𝑡 (4-point Gauss per span: exact to degree 5).
+    [[nodiscard]] std::optional<std::vector<Vector3>> SolvePoles(const std::vector<Vector3>& Points, const std::vector<double>& Parameters, int Degree,
+                                                                 const std::vector<double>& Knots, double Fairing)
+    {
+        const int Count = static_cast<int>(Knots.size()) - Degree - 1;
+        std::vector<Vector3> Poles(Count);
+        Poles.front() = Points.front();
+        Poles.back()  = Points.back();
+        const int Unknowns = Count - 2;
+        if (Unknowns <= 0) return Poles;
+        DenseMatrix Matrix(Unknowns, Unknowns), RightSides(Unknowns, 3);
+        auto Interior = [&](int Pole) { return Pole >= 1 && Pole <= Count - 2; };
+        for (size_t Point = 0; Point < Points.size(); ++Point)
+        {
+            const NurbsBasisSample Basis = EvaluateNurbsBasis(Knots, Degree, Count, Parameters[Point]);
+            Vector3 Target = Points[Point];
+            for (int Row = 0; Row <= Degree; ++Row)
+            {
+                const int Pole = Basis.First + Row;
+                if (!Interior(Pole)) Target = Target - Poles[Pole] * Basis.Values[0][Row];
+            }
+            for (int Row = 0; Row <= Degree; ++Row)
+            {
+                const int Pole = Basis.First + Row;
+                if (!Interior(Pole)) continue;
+                const double Value = Basis.Values[0][Row];
+                RightSides.At(Pole - 1, 0) += Value * Target.X;
+                RightSides.At(Pole - 1, 1) += Value * Target.Y;
+                RightSides.At(Pole - 1, 2) += Value * Target.Z;
+                for (int Column = 0; Column <= Degree; ++Column)
+                {
+                    const int Other = Basis.First + Column;
+                    if (Interior(Other)) Matrix.At(Pole - 1, Other - 1) += Value * Basis.Values[0][Column];
+                }
+            }
+        }
+        const double λ = Fairing * static_cast<double>(Points.size());
+        if (λ > 0.0 && Degree >= 2)
+        {
+            for (int Span = Degree; Span < Count; ++Span)
+            {
+                const double Low = Knots[Span], High = Knots[Span + 1];
+                if (!(High > Low)) continue;
+                for (size_t Abscissa = 0; Abscissa < GaussAbscissae.size(); ++Abscissa)
+                {
+                    const double Parameter = 0.5 * (Low + High) + 0.5 * (High - Low) * GaussAbscissae[Abscissa];
+                    const double Weight    = 0.5 * (High - Low) * GaussWeights[Abscissa] * λ;
+                    const NurbsBasisSample Basis = EvaluateNurbsBasis(Knots, Degree, Count, Parameter);
+                    for (int Row = 0; Row <= Degree; ++Row)
+                    {
+                        const int Pole = Basis.First + Row;
+                        if (!Interior(Pole)) continue;
+                        for (int Column = 0; Column <= Degree; ++Column)
+                        {
+                            const int    Other = Basis.First + Column;
+                            const double Term  = Weight * Basis.Values[2][Row] * Basis.Values[2][Column];
+                            if (Interior(Other)) { Matrix.At(Pole - 1, Other - 1) += Term; continue; }
+                            RightSides.At(Pole - 1, 0) -= Term * Poles[Other].X;
+                            RightSides.At(Pole - 1, 1) -= Term * Poles[Other].Y;
+                            RightSides.At(Pole - 1, 2) -= Term * Poles[Other].Z;
+                        }
+                    }
+                }
+            }
+        }
+        const std::optional<DenseMatrix> Solution = SolveDenseSystem(std::move(Matrix), std::move(RightSides));
+        if (!Solution) return std::nullopt;
+        for (int Pole = 1; Pole <= Count - 2; ++Pole) Poles[Pole] = { Solution->At(Pole - 1, 0), Solution->At(Pole - 1, 1), Solution->At(Pole - 1, 2) };
+        return Poles;
+    }
+
+    // 📝 End-tangent constrained solve: each interior pole is Fixed + Σ zₐ·Dirₐ (three axes when free, one direction when
+    //    P₁ / Pₙ₋₁ is tied to its end point), and the residual + fairing normal equations are written in z.
+    struct EndTangents
+    {
+        std::optional<Vector3> Start = {};                                                   // [-] - d at P₀
+        std::optional<Vector3> End   = {};                                                   // [-] - d at Pₙ
+    };
+
+    [[nodiscard]] std::optional<std::vector<Vector3>> SolveTangentPoles(const std::vector<Vector3>& Points, const std::vector<double>& Parameters, int Degree,
+                                                                        const std::vector<double>& Knots, double Fairing, const EndTangents& Tangents)
+    {
+        const int Count = static_cast<int>(Knots.size()) - Degree - 1;
+        if (Count < 4) return std::nullopt;
+        struct PoleForm { Vector3 Fixed = {}; std::vector<std::pair<int, Vector3>> Terms = {}; };
+        std::vector<PoleForm> Forms(Count);
+        Forms.front().Fixed = Points.front();
+        Forms.back().Fixed  = Points.back();
+        int Unknowns = 0;
+        for (int Pole = 1; Pole <= Count - 2; ++Pole)
+        {
+            if (Pole == 1 && Tangents.Start) { Forms[Pole].Fixed = Points.front(); Forms[Pole].Terms.push_back({ Unknowns++, *Tangents.Start }); continue; }
+            if (Pole == Count - 2 && Tangents.End) { Forms[Pole].Fixed = Points.back(); Forms[Pole].Terms.push_back({ Unknowns++, *Tangents.End }); continue; }
+            Forms[Pole].Terms = { { Unknowns, { 1.0, 0.0, 0.0 } }, { Unknowns + 1, { 0.0, 1.0, 0.0 } }, { Unknowns + 2, { 0.0, 0.0, 1.0 } } };
+            Unknowns += 3;
+        }
+        DenseMatrix Matrix(Unknowns, Unknowns), RightSides(Unknowns, 1);
+        // One row of the model: Σₖ cₖ·Pₖ ≈ Target with weight w.
+        auto Accumulate = [&](const NurbsBasisSample& Basis, int Order, Vector3 Target, double Weight)
+        {
+            Vector3 Offset = Target * -1.0;
+            std::vector<std::pair<int, Vector3>> Jacobian;
+            for (int Row = 0; Row <= Degree; ++Row)
+            {
+                const PoleForm& Form = Forms[Basis.First + Row];
+                const double Value = Basis.Values[Order][Row];
+                Offset = Offset + Form.Fixed * Value;
+                for (const auto& [Unknown, Direction] : Form.Terms) Jacobian.push_back({ Unknown, Direction * Value });
+            }
+            for (const auto& [First, FirstVector] : Jacobian)
+            {
+                RightSides.At(First, 0) -= Weight * Dot(FirstVector, Offset);
+                for (const auto& [Second, SecondVector] : Jacobian) Matrix.At(First, Second) += Weight * Dot(FirstVector, SecondVector);
+            }
+        };
+        for (size_t Point = 0; Point < Points.size(); ++Point) Accumulate(EvaluateNurbsBasis(Knots, Degree, Count, Parameters[Point]), 0, Points[Point], 1.0);
+        const double λ = Fairing * static_cast<double>(Points.size());
+        if (λ > 0.0 && Degree >= 2)
+        {
+            for (int Span = Degree; Span < Count; ++Span)
+            {
+                const double Low = Knots[Span], High = Knots[Span + 1];
+                if (!(High > Low)) continue;
+                for (size_t Abscissa = 0; Abscissa < GaussAbscissae.size(); ++Abscissa)
+                {
+                    const double Parameter = 0.5 * (Low + High) + 0.5 * (High - Low) * GaussAbscissae[Abscissa];
+                    Accumulate(EvaluateNurbsBasis(Knots, Degree, Count, Parameter), 2, {}, 0.5 * (High - Low) * GaussWeights[Abscissa] * λ);
+                }
+            }
+        }
+        const std::optional<DenseMatrix> Solution = SolveDenseSystem(std::move(Matrix), std::move(RightSides));
+        if (!Solution) return std::nullopt;
+        std::vector<Vector3> Poles(Count);
+        for (int Pole = 0; Pole < Count; ++Pole)
+        {
+            Poles[Pole] = Forms[Pole].Fixed;
+            for (const auto& [Unknown, Direction] : Forms[Pole].Terms) Poles[Pole] = Poles[Pole] + Direction * Solution->At(Unknown, 0);
+        }
+        return Poles;
+    }
+
+    [[nodiscard]] NurbsCurveDefinition MakeDefinition(int Degree, const std::vector<double>& Knots, const std::vector<Vector3>& Poles)
+    {
+        NurbsCurveDefinition Definition;
+        Definition.Degree  = Degree;
+        Definition.Knots   = Knots;
+        Definition.Poles   = Poles;
+        Definition.Weights = std::vector<double>(Poles.size(), 1.0);
+        return Definition;
+    }
+
+    // Hoschek correction: each interior 𝑡ₖ moves to the foot point of Qₖ (Newton on (C − Q)·C′ = 0), ends stay 0 and 1.
+    void CorrectParameters(const NurbsCurveDefinition& Definition, const std::vector<Vector3>& Points, std::vector<double>& Parameters)
+    {
+        for (size_t Point = 1; Point + 1 < Points.size(); ++Point)
+        {
+            double Parameter = Parameters[Point];
+            for (int Iteration = 0; Iteration < 4; ++Iteration)
+            {
+                const NurbsCurveDerivatives Sample = EvaluateNurbsCurveDerivatives(Definition, Parameter);
+                const Vector3 Gap      = Sample.Position - Points[Point];
+                const double  Slope    = Dot(Gap, Sample.First);
+                const double  Steepness = Dot(Sample.First, Sample.First) + Dot(Gap, Sample.Second);
+                if (!(Steepness > 0.0)) break;
+                Parameter = std::clamp(Parameter - Slope / Steepness, 0.0, 1.0);
+            }
+            Parameters[Point] = Parameter;
+        }
+    }
+
+    struct FitAttempt
+    {
+        std::vector<Vector3> Poles      = {};                                                // [len] - Solved poles
+        std::vector<double>  Parameters = {};                                                // [-]   - Corrected 𝑡ₖ
+        double               Worst      = 0.0;                                               // [len] - max |Qₖ − C(𝑡ₖ)|
+    };
+
+    [[nodiscard]] double MeasureWorst(const NurbsCurveDefinition& Definition, const std::vector<Vector3>& Points, const std::vector<double>& Parameters)
+    {
+        double Worst = 0.0;
+        for (size_t Point = 0; Point < Points.size(); ++Point) Worst = std::max(Worst, Length(EvaluateNurbsCurveDerivatives(Definition, Parameters[Point]).Position - Points[Point]));
+        return Worst;
+    }
+
+    // Solve, then alternate foot-point correction and re-solve (Rounds times) — one fit on fixed knots and λ.
+    [[nodiscard]] std::optional<std::vector<Vector3>> SolveAnyPoles(const std::vector<Vector3>& Points, const std::vector<double>& Parameters, int Degree,
+                                                                    const std::vector<double>& Knots, double Fairing, const EndTangents& Tangents)
+    {
+        if (Tangents.Start || Tangents.End) return SolveTangentPoles(Points, Parameters, Degree, Knots, Fairing, Tangents);
+        return SolvePoles(Points, Parameters, Degree, Knots, Fairing);
+    }
+
+    [[nodiscard]] std::optional<FitAttempt> SolveCorrected(const std::vector<Vector3>& Points, std::vector<double> Parameters, int Degree,
+                                                           const std::vector<double>& Knots, double Fairing, int Rounds, const EndTangents& Tangents)
+    {
+        std::optional<std::vector<Vector3>> Poles = SolveAnyPoles(Points, Parameters, Degree, Knots, Fairing, Tangents);
+        if (!Poles) return std::nullopt;
+        for (int Round = 0; Round < Rounds; ++Round)
+        {
+            std::vector<double> Candidate = Parameters;
+            CorrectParameters(MakeDefinition(Degree, Knots, *Poles), Points, Candidate);
+            // 📝 Foot points must keep the points' order: on a rough curve a point's nearest foot can sit on another hump
+            //    (a wiggle), and a scrambled order would fit the scrambled curve — such a round is dropped.
+            if (std::adjacent_find(Candidate.begin(), Candidate.end(), std::greater<double>()) != Candidate.end()) break;
+            std::optional<std::vector<Vector3>> Corrected = SolveAnyPoles(Points, Candidate, Degree, Knots, Fairing, Tangents);
+            if (!Corrected) break;
+            Poles      = std::move(Corrected);
+            Parameters = std::move(Candidate);
+        }
+        FitAttempt Attempt;
+        Attempt.Poles      = std::move(*Poles);
+        Attempt.Parameters = std::move(Parameters);
+        // Final foot points on the final curve, so the reported deviation is a true distance.
+        const NurbsCurveDefinition Definition = MakeDefinition(Degree, Knots, Attempt.Poles);
+        CorrectParameters(Definition, Points, Attempt.Parameters);
+        Attempt.Worst = MeasureWorst(Definition, Points, Attempt.Parameters);
+        return Attempt;
+    }
+
+    void MeasureDeviation(const NurbsCurveDefinition& Definition, const std::vector<Vector3>& Points, const std::vector<double>& Parameters,
+                          const std::vector<int>& Source, CurveFitOutcome& Outcome)
+    {
+        Outcome.WorstDeviation = 0.0;
+        Outcome.MeanDeviation  = 0.0;
+        for (size_t Point = 0; Point < Points.size(); ++Point)
+        {
+            const double Deviation = Length(EvaluateNurbsCurveDerivatives(Definition, Parameters[Point]).Position - Points[Point]);
+            Outcome.MeanDeviation += Deviation;
+            if (Deviation >= Outcome.WorstDeviation) { Outcome.WorstDeviation = Deviation; Outcome.WorstPoint = Source[Point]; }
+        }
+        Outcome.MeanDeviation /= static_cast<double>(Points.size());
+    }
+
+    // Interior maxima of κ = |C′ × C″| / |C′|³ on 400 samples, ignoring ripples below 10⁻⁶ of the largest κ.
+    [[nodiscard]] int CountExtrema(const NurbsCurveDefinition& Definition)
+    {
+        constexpr int Samples = 400;
+        std::vector<double> Curvature(Samples + 1, 0.0);
+        double Largest = 0.0;
+        for (int Index = 0; Index <= Samples; ++Index)
+        {
+            const NurbsCurveDerivatives Sample = EvaluateNurbsCurveDerivatives(Definition, static_cast<double>(Index) / Samples);
+            const double Speed = Length(Sample.First);
+            Curvature[Index] = Speed > 0.0 ? Length(Cross(Sample.First, Sample.Second)) / (Speed * Speed * Speed) : 0.0;
+            Largest = std::max(Largest, Curvature[Index]);
+        }
+        int Extrema = 0;
+        for (int Index = 1; Index < Samples; ++Index)
+        {
+            if (Curvature[Index] > Curvature[Index - 1] && Curvature[Index] >= Curvature[Index + 1] && Curvature[Index] > 1.0e-6 * Largest) ++Extrema;
+        }
+        return Extrema;
+    }
+
+    void Finish(CurveFitOutcome& Outcome, const NurbsCurveDefinition& Definition)
+    {
+        Outcome.Curve            = NurbsCurve{ std::make_shared<NurbsCurveDefinition>(Definition) };
+        Outcome.Spans            = static_cast<int>(Definition.Poles.size()) - Definition.Degree;
+        Outcome.Extrema = CountExtrema(Definition);
+    }
+
+    [[nodiscard]] std::string FormatLength(double Value)
+    {
+        char Text[48];
+        std::snprintf(Text, sizeof Text, "%.3g mm", Value * 1000.0);
+        return Text;
+    }
+
+    // Best plane (centre, unit normal): eigenvector of the smallest eigenvalue of the point covariance (cyclic Jacobi).
+    // Normals within 10⁻¹² of a coordinate axis snap onto it, so axis-aligned sections stay exactly axis-aligned.
+    [[nodiscard]] std::optional<std::pair<Vector3, Vector3>> FitBestPlane(const std::vector<Vector3>& Points, std::optional<Vector3> Within)
+    {
+        Vector3 Centre = {};
+        for (const Vector3& Point : Points) Centre = Centre + Point * (1.0 / Points.size());
+        double Matrix[3][3] = {}, Vectors[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+        for (const Vector3& Point : Points)
+        {
+            const double Offset[3] = { Point.X - Centre.X, Point.Y - Centre.Y, Point.Z - Centre.Z };
+            for (int Row = 0; Row < 3; ++Row) for (int Column = 0; Column < 3; ++Column) Matrix[Row][Column] += Offset[Row] * Offset[Column];
+        }
+        if (Within)
+        {
+            // The plane must contain direction d (a mirror tangent): its normal lies in span{e₁, e₂} ⊥ d — a 2 × 2
+            // eigenproblem. e₁ = d × r, e₂ = d × e₁ keep a zero component exactly where d is a coordinate axis.
+            const Vector3 Direction = *Within * (1.0 / Length(*Within));
+            const Vector3 Reference = std::abs(Direction.X) < 0.9 ? Vector3{ 1.0, 0.0, 0.0 } : Vector3{ 0.0, 1.0, 0.0 };
+            Vector3 First = Cross(Direction, Reference);
+            First = First * (1.0 / Length(First));
+            const Vector3 Second = Cross(Direction, First);
+            auto Quadratic = [&](Vector3 A, Vector3 B)
+            {
+                const double VA[3] = { A.X, A.Y, A.Z }, VB[3] = { B.X, B.Y, B.Z };
+                double Sum = 0.0;
+                for (int Row = 0; Row < 3; ++Row) for (int Column = 0; Column < 3; ++Column) Sum += VA[Row] * Matrix[Row][Column] * VB[Column];
+                return Sum;
+            };
+            const double A = Quadratic(First, First), B = Quadratic(First, Second), C = Quadratic(Second, Second);
+            const double Smallest = 0.5 * (A + C) - std::sqrt(0.25 * (A - C) * (A - C) + B * B);
+            // Eigenvector of [[A, B], [B, C]] for the smallest eigenvalue.
+            const double CoefficientFirst = std::abs(B) > 1.0e-300 ? B : (A <= C ? 1.0 : 0.0);
+            const double CoefficientSecond = std::abs(B) > 1.0e-300 ? Smallest - A : (A <= C ? 0.0 : 1.0);
+            Vector3 Normal = First * CoefficientFirst + Second * CoefficientSecond;
+            if (!(Length(Normal) > 0.0)) return std::nullopt;
+            Normal = Normal * (1.0 / Length(Normal));
+            for (Vector3 Axis : { Vector3{ 1.0, 0.0, 0.0 }, Vector3{ 0.0, 1.0, 0.0 }, Vector3{ 0.0, 0.0, 1.0 } })
+            {
+                if (Length(Cross(Normal, Axis)) <= 1.0e-12) Normal = Axis * (Dot(Normal, Axis) < 0.0 ? -1.0 : 1.0);
+            }
+            if (!(Quadratic(Normal, Normal) < std::max(A, C))) return std::nullopt;          // Degenerate spread in the plane
+            return std::pair{ Centre, Normal };
+        }
+        for (int Sweep = 0; Sweep < 50; ++Sweep)
+        {
+            const double OffDiagonal = std::abs(Matrix[0][1]) + std::abs(Matrix[0][2]) + std::abs(Matrix[1][2]);
+            if (OffDiagonal < 1.0e-30) break;
+            for (int P = 0; P < 2; ++P)
+            {
+                for (int Q = P + 1; Q < 3; ++Q)
+                {
+                    if (std::abs(Matrix[P][Q]) < 1.0e-300) continue;
+                    const double Theta = 0.5 * std::atan2(2.0 * Matrix[P][Q], Matrix[Q][Q] - Matrix[P][P]);
+                    const double C = std::cos(Theta), S = std::sin(Theta);
+                    for (int K = 0; K < 3; ++K)
+                    {
+                        const double KP = Matrix[K][P], KQ = Matrix[K][Q];
+                        Matrix[K][P] = C * KP - S * KQ;
+                        Matrix[K][Q] = S * KP + C * KQ;
+                    }
+                    for (int K = 0; K < 3; ++K)
+                    {
+                        const double PK = Matrix[P][K], QK = Matrix[Q][K];
+                        Matrix[P][K] = C * PK - S * QK;
+                        Matrix[Q][K] = S * PK + C * QK;
+                    }
+                    for (int K = 0; K < 3; ++K)
+                    {
+                        const double KP = Vectors[K][P], KQ = Vectors[K][Q];
+                        Vectors[K][P] = C * KP - S * KQ;
+                        Vectors[K][Q] = S * KP + C * KQ;
+                    }
+                }
+            }
+        }
+        int Smallest = 0;
+        for (int Index = 1; Index < 3; ++Index) if (Matrix[Index][Index] < Matrix[Smallest][Smallest]) Smallest = Index;
+        double Eigenvalues[3] = { Matrix[0][0], Matrix[1][1], Matrix[2][2] };
+        std::sort(Eigenvalues, Eigenvalues + 3);
+        if (!(Eigenvalues[1] > 1.0e-24 * Eigenvalues[2])) return std::nullopt;               // Collinear: two vanishing spreads
+        Vector3 Normal = { Vectors[0][Smallest], Vectors[1][Smallest], Vectors[2][Smallest] };
+        Normal = Normal * (1.0 / Length(Normal));
+        for (Vector3 Axis : { Vector3{ 1.0, 0.0, 0.0 }, Vector3{ 0.0, 1.0, 0.0 }, Vector3{ 0.0, 0.0, 1.0 } })
+        {
+            if (Length(Cross(Normal, Axis)) <= 1.0e-12) Normal = Axis * (Dot(Normal, Axis) < 0.0 ? -1.0 : 1.0);
+        }
+        return std::pair{ Centre, Normal };
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+CurveFitOutcome FitSpaceCurve(const std::vector<Vector3>& Points, const CurveFitSettings& Settings)
+{
+    CurveFitOutcome Outcome;
+    std::vector<int> Source;
+    std::vector<Vector3> Kept = MergeDuplicates(Points, Source);
+    if (Kept.size() < 2) { Outcome.Refusal = "Fit: fewer than 2 distinct points"; return Outcome; }
+    if (!(Settings.Tolerance > 0.0)) { Outcome.Refusal = "Fit: tolerance must be positive"; return Outcome; }
+    const int Degree = std::clamp(Settings.Degree, 1, std::min(NurbsDegreeLimit, static_cast<int>(Kept.size()) - 1));
+    if (Settings.PlanarCondition)
+    {
+        if (Kept.size() < 3) { Outcome.Refusal = "Fit: a planar curve needs at least 3 distinct points"; return Outcome; }
+        const std::optional<std::pair<Vector3, Vector3>> Plane = FitBestPlane(Kept, Settings.StartTangent ? Settings.StartTangent : Settings.EndTangent);
+        if (!Plane) { Outcome.Refusal = "Fit: the points are collinear (no plane)"; return Outcome; }
+        const auto& [Centre, Normal] = *Plane;
+        for (const Vector3& Point : Kept) Outcome.PlanarOffset = std::max(Outcome.PlanarOffset, std::abs(Dot(Point - Centre, Normal)));
+        if (Outcome.PlanarOffset > Settings.Tolerance)
+        {
+            Outcome.Refusal = "Fit: the points are " + FormatLength(Outcome.PlanarOffset) + " off their best plane (tolerance " + FormatLength(Settings.Tolerance) + ")";
+            return Outcome;
+        }
+        for (Vector3& Point : Kept) Point = Point - Normal * Dot(Point - Centre, Normal);
+        Outcome.PlaneNormal = Normal;
+    }
+    EndTangents Tangents;
+    auto Unit = [](const std::optional<Vector3>& Direction) -> std::optional<Vector3>
+    {
+        if (!Direction || !(Length(*Direction) > 0.0)) return std::nullopt;
+        return *Direction * (1.0 / Length(*Direction));
+    };
+    Tangents.Start = Unit(Settings.StartTangent);
+    Tangents.End   = Unit(Settings.EndTangent);
+    if ((Tangents.Start || Tangents.End) && Degree < 2) { Outcome.Refusal = "Fit: end tangents need degree ≥ 2 (at least 3 points)"; return Outcome; }
+    std::vector<double> Parameters = CentripetalParameters(Kept);
+    std::vector<double> Interior;
+    // Tied end poles need P₁ and Pₙ₋₁ distinct from the ends and from each other: at least 4 poles from the start.
+    while ((Tangents.Start || Tangents.End) && Degree + 1 + static_cast<int>(Interior.size()) < 4)
+    {
+        Interior.push_back((Interior.size() + 1.0) / (5.0 - Degree));
+    }
+    for (;;)
+    {
+        // ① Faired solve on the current knots (with foot-point correction); accept when every point is within tolerance.
+        const std::vector<double> Knots = ClampedKnots(Degree, Interior);
+        std::optional<FitAttempt> Faired = SolveCorrected(Kept, Parameters, Degree, Knots, Settings.Fairing, Settings.CorrectionRounds, Tangents);
+        if (!Faired) { Outcome.Refusal = "Fit: singular system at " + std::to_string(Interior.size() + 1) + " spans (too few points per span)"; return Outcome; }
+        auto Accept = [&](const FitAttempt& Attempt, double Fairing)
+        {
+            const NurbsCurveDefinition Definition = MakeDefinition(Degree, Knots, Attempt.Poles);
+            MeasureDeviation(Definition, Kept, Attempt.Parameters, Source, Outcome);
+            Outcome.Parameters.assign(Points.size(), 0.0);
+            size_t KeptIndex = 0;                                                            // Merged duplicates share their survivor's 𝑡
+            for (size_t Index = 0; Index < Points.size(); ++Index)
+            {
+                if (KeptIndex + 1 < Kept.size() && Source[KeptIndex + 1] == static_cast<int>(Index)) ++KeptIndex;
+                Outcome.Parameters[Index] = Attempt.Parameters[KeptIndex];
+            }
+            Outcome.Fairing = Fairing;
+            Finish(Outcome, Definition);
+            return Outcome;
+        };
+        if (Faired->Worst <= Settings.Tolerance) return Accept(*Faired, Settings.Fairing);
+
+        // ② Fairing must never cost the tolerance: when the unfaired fit passes on these knots, λ drops by decades until
+        //    it passes too (the fairest curve that still honours the tolerance); knots are added only when λ = 0 fails.
+        std::optional<FitAttempt> Plain = Settings.Fairing > 0.0 ? SolveCorrected(Kept, Parameters, Degree, Knots, 0.0, Settings.CorrectionRounds, Tangents) : Faired;
+        if (Plain && Plain->Worst <= Settings.Tolerance)
+        {
+            for (double Fairing = 0.1 * Settings.Fairing; Fairing >= 1.0e-8 * Settings.Fairing; Fairing *= 0.1)
+            {
+                const std::optional<FitAttempt> Lighter = SolveCorrected(Kept, Parameters, Degree, Knots, Fairing, Settings.CorrectionRounds, Tangents);
+                if (Lighter && Lighter->Worst <= Settings.Tolerance) return Accept(*Lighter, Fairing);
+            }
+            return Accept(*Plain, 0.0);
+        }
+        // 📝 The closer attempt guides the split and carries its foot points on: an unfaired solve can swing wild in spans
+        //    holding few points, and its corrupted parameters would derail every later round (dense wrapped wiggles).
+        const FitAttempt& Guide = Plain && Plain->Worst <= Faired->Worst ? *Plain : *Faired;
+        const NurbsCurveDefinition Definition = MakeDefinition(Degree, Knots, Guide.Poles);
+        MeasureDeviation(Definition, Kept, Guide.Parameters, Source, Outcome);
+        if (std::adjacent_find(Guide.Parameters.begin(), Guide.Parameters.end(), std::greater<double>()) == Guide.Parameters.end()) Parameters = Guide.Parameters;
+
+        // ③ Split every span holding a point beyond tolerance at its middle.
+        std::set<int> Offending;
+        for (size_t Point = 0; Point < Kept.size(); ++Point)
+        {
+            if (Length(EvaluateNurbsCurveDerivatives(Definition, Parameters[Point]).Position - Kept[Point]) <= Settings.Tolerance) continue;
+            const int Span = static_cast<int>(std::upper_bound(Knots.begin() + Degree, Knots.end() - Degree - 1, Parameters[Point]) - Knots.begin()) - 1;
+            Offending.insert(std::clamp(Span, Degree, static_cast<int>(Knots.size()) - Degree - 2));
+        }
+        const int Spans = static_cast<int>(Interior.size()) + 1;
+        if (Spans + static_cast<int>(Offending.size()) > Settings.SpanLimit || Degree + Spans + static_cast<int>(Offending.size()) > static_cast<int>(Kept.size()))
+        {
+            Outcome.Refusal = "Fit: point " + std::to_string(Outcome.WorstPoint) + " stays " + FormatLength(Outcome.WorstDeviation) + " away at "
+                            + std::to_string(Spans) + " spans (limit " + std::to_string(Settings.SpanLimit) + ", tolerance " + FormatLength(Settings.Tolerance) + ")";
+            return Outcome;
+        }
+        for (int Span : Offending) Interior.push_back(0.5 * (Knots[Span] + Knots[Span + 1]));
+        std::sort(Interior.begin(), Interior.end());
+    }
+}
+
+CurveFitOutcome FitSpaceCurveOnKnots(const std::vector<Vector3>& Points, const std::vector<double>& Parameters, int Degree,
+                                     const std::vector<double>& Knots, double Fairing)
+{
+    CurveFitOutcome Outcome;
+    if (Points.size() < 2 || Parameters.size() != Points.size()) { Outcome.Refusal = "Fit: points and parameters differ in count"; return Outcome; }
+    const std::optional<std::vector<Vector3>> Poles = SolvePoles(Points, Parameters, Degree, Knots, Fairing);
+    if (!Poles) { Outcome.Refusal = "Fit: singular system"; return Outcome; }
+    const NurbsCurveDefinition Definition = MakeDefinition(Degree, Knots, *Poles);
+    std::vector<int> Source(Points.size());
+    for (size_t Index = 0; Index < Points.size(); ++Index) Source[Index] = static_cast<int>(Index);
+    MeasureDeviation(Definition, Points, Parameters, Source, Outcome);
+    Outcome.Parameters = Parameters;
+    Finish(Outcome, Definition);
+    return Outcome;
+}
+
+std::vector<int> FindCurveCorners(const std::vector<Vector3>& Points, double Angle)
+{
+    std::vector<int> Corners;
+    for (size_t Index = 1; Index + 1 < Points.size(); ++Index)
+    {
+        const Vector3 Before = Points[Index] - Points[Index - 1], After = Points[Index + 1] - Points[Index];
+        const double  Lengths = Length(Before) * Length(After);
+        if (!(Lengths > 0.0)) continue;
+        const double Turning = std::acos(std::clamp(Dot(Before, After) / Lengths, -1.0, 1.0));
+        if (Turning > Angle) Corners.push_back(static_cast<int>(Index));
+    }
+    return Corners;
+}
+
+std::vector<CurveFitOutcome> FitSpaceCurveRuns(const std::vector<Vector3>& Points, const CurveFitSettings& Settings)
+{
+    std::vector<int> Cuts = FindCurveCorners(Points, Settings.CornerAngle);
+    Cuts.insert(Cuts.begin(), 0);
+    Cuts.push_back(static_cast<int>(Points.size()) - 1);
+    std::vector<CurveFitOutcome> Runs;
+    for (size_t Index = 0; Index + 1 < Cuts.size(); ++Index)
+    {
+        const std::vector<Vector3> Run(Points.begin() + Cuts[Index], Points.begin() + Cuts[Index + 1] + 1);
+        CurveFitOutcome Outcome = FitSpaceCurve(Run, Settings);
+        if (Outcome.WorstPoint >= 0) Outcome.WorstPoint += Cuts[Index];
+        Runs.push_back(std::move(Outcome));
+    }
+    return Runs;
+}
+
+}
