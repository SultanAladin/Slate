+void DrawModifierStackCard(SolidArcWorkspaceState& State)
+{
+    BeginCard("Modifiers", State.Document.Tree.Modifiers.empty() ? "stack" : Compose("%d active", int(State.Document.Tree.Modifiers.size())).c_str());
+    static const char* KindTitles[] = {
+        "Live Boolean", "Bevel Edges", "Linear Array", "Circular Array", "Array Along Curve", "Array On Surface", "Bend Along Curve"
+    };
+    State.AddModifierKind = std::clamp(State.AddModifierKind, 0, 6);
+    ImGui::SetNextItemWidth(155);
+    if (ImGui::BeginCombo("###AddModCombo", KindTitles[State.AddModifierKind]))
+    {
+        for (int KindIdx = 0; KindIdx < 7; ++KindIdx)
+            if (ImGui::Selectable(KindTitles[KindIdx], State.AddModifierKind == KindIdx)) State.AddModifierKind = KindIdx;
+        ImGui::EndCombo();
+    }
+    RegisterWidget(State, "AddModCombo");
+    ImGui::SameLine();
+    const bool HasBody = !State.Document.Regeneration.Bodies.empty();
+    if (PressButton(State, "+ Add###ModifierAdd", ImVec2(62, 0), HasBody))
+    {
+        FeatureModifier Mod;
+        Mod.Kind = static_cast<ModifierKind>(State.AddModifierKind);
+        const SolidArcSelection& Sel = State.Document.Selection;
+        Mod.Target = !Sel.Bodies.empty() ? Sel.Bodies.front() : (!Sel.PickedBody.empty() ? Sel.PickedBody : State.Document.Regeneration.Active);
+
+        auto PickDefaultCurve = [&]() -> std::string
+        {
+            if (!Sel.Curves.empty()) return Sel.Curves.front();
+            if (!State.FocusedStep.empty())
+            {
+                for (const FeatureStep& Step : State.Document.Tree.Steps)
+                    if (Step.Label == State.FocusedStep && (Step.Kind == FeatureStepKind::Sketch || Step.Kind == FeatureStepKind::SpaceCurve)) return Step.Label;
+            }
+            for (auto It = State.Document.Tree.Steps.rbegin(); It != State.Document.Tree.Steps.rend(); ++It)
+                if (It->Kind == FeatureStepKind::SpaceCurve || (It->Kind == FeatureStepKind::Sketch && !SolidArcSketchConsumedCondition(State.Document, It->Label)))
+                    return It->Label;
+            return {};
+        };
+
+        switch (Mod.Kind)
+        {
+        case ModifierKind::LinearArray:
+            Mod.Count     = FeatureValue{ 3.0 };
+            Mod.Distance  = FeatureValue{ 1.2 };
+            Mod.Direction = { 1.0, 0.0, 0.0 };
+            break;
+        case ModifierKind::CircularArray:
+            Mod.Count         = FeatureValue{ 6.0 };
+            Mod.Angle         = FeatureValue{ 2.0 * std::numbers::pi };
+            Mod.AxisDirection = { 0.0, 0.0, 1.0 };
+            break;
+        case ModifierKind::CurveArray:
+            Mod.Curve          = PickDefaultCurve();
+            Mod.Count          = FeatureValue{ 4.0 };
+            Mod.Distance       = FeatureValue{ 0.0 };
+            Mod.AlignCondition = true;
+            break;
+        case ModifierKind::SurfaceArray:
+            Mod.Count          = FeatureValue{ 3.0 };
+            Mod.SecondaryCount = FeatureValue{ 3.0 };
+            Mod.Margin         = FeatureValue{ 0.12 };
+            if (!Sel.Faces.empty())
+            {
+                Mod.Tool       = SolidArcBodyOfName(State.Document, SolidArcSelectionKind::Face, Sel.Faces.front());
+                Mod.References = { { ReferenceKind::Face, Sel.Faces.front(), {} } };
+            }
+            break;
+        case ModifierKind::CurveBend:
+            Mod.Curve            = PickDefaultCurve();
+            Mod.DeformAxis       = -1;
+            Mod.StretchCondition = true;
+            break;
+        case ModifierKind::Bevel:
+            Mod.Size  = FeatureValue{ 0.05 };
+            Mod.Shape = BlendProfile::Fillet;
+            if (!State.Document.Tree.EdgeGroups.empty())
+            {
+                Mod.LimitMode = BevelLimitMode::EdgeGroup;
+                Mod.EdgeGroup = State.Document.Tree.EdgeGroups.front().Name;
+            }
+            else if (!Sel.Edges.empty())
+            {
+                Mod.LimitMode = BevelLimitMode::Picked;
+                for (const std::string& EdgeName : Sel.Edges) Mod.References.push_back({ ReferenceKind::Edge, EdgeName, {} });
+            }
+            else
+            {
+                Mod.LimitMode = BevelLimitMode::Angle;
+                Mod.Angle     = FeatureValue{ std::numbers::pi / 6.0 };
+            }
+            break;
+        case ModifierKind::Boolean:
+            Mod.Combination       = FeatureCombination::Difference;
+            Mod.KeepToolCondition = true;
+            if (Sel.Bodies.size() >= 2) { Mod.Target = Sel.Bodies[0]; Mod.Tool = Sel.Bodies[1]; }
+            else
+            {
+                for (const RegeneratedBody& Body : State.Document.Regeneration.Bodies)
+                    if (Body.Key != Mod.Target && Body.Body.PresentCondition()) { Mod.Tool = Body.Key; break; }
+            }
+            break;
+        }
+        Conclude(State, AddSolidArcModifier(State.Document, std::move(Mod)));
+    }
+
+    for (size_t Index = 0; Index < State.Document.Tree.Modifiers.size(); ++Index)
+    {
+        FeatureModifier Copy = State.Document.Tree.Modifiers[Index];
+        const std::string ModLabel = Copy.Label;
+        ImGui::Separator();
+        bool Enabled = Copy.EnabledCondition;
+        if (ImGui::Checkbox((CaptionOf(State.Document, ModLabel) + " (" + ModifierKindLabel(Copy.Kind) + ")###ModEnable:" + ModLabel).c_str(), &Enabled))
+        {
+            Conclude(State, ToggleSolidArcModifier(State.Document, ModLabel));
+            break;
+        }
+        RegisterWidget(State, ("ModEnable:" + ModLabel).c_str());
+
+        if (PressButton(State, ("▲###ModUp:" + ModLabel).c_str(), ImVec2(26, 0), Index > 0))
+        {
+            Conclude(State, MoveSolidArcModifier(State.Document, ModLabel, -1));
+            break;
+        }
+        ImGui::SameLine();
+        if (PressButton(State, ("▼###ModDown:" + ModLabel).c_str(), ImVec2(26, 0), Index + 1 < State.Document.Tree.Modifiers.size()))
+        {
+            Conclude(State, MoveSolidArcModifier(State.Document, ModLabel, 1));
+            break;
+        }
+        ImGui::SameLine();
+        if (PressButton(State, ("Apply###ModApply:" + ModLabel).c_str(), ImVec2(52, 0)))
+        {
+            Conclude(State, ApplySolidArcModifier(State.Document, ModLabel));
+            break;
+        }
+        ImGui::SameLine();
+        if (PressButton(State, ("✕###ModRemove:" + ModLabel).c_str(), ImVec2(26, 0)))
+        {
+            Conclude(State, RemoveSolidArcModifier(State.Document, ModLabel));
+            break;
+        }
+
+        for (const FeatureModifierReport& Rep : State.Document.Regeneration.Modifiers)
+        {
+            if (Rep.Label == ModLabel && Rep.Status == FeatureStepStatus::Refused)
+            {
+                ImGui::PushStyleColor(ImGuiCol_Text, Tint(RefusalColour));
+                ImGui::TextWrapped("Refused: %s", Legible(Rep.Refusal).c_str());
+                ImGui::PopStyleColor();
+            }
+        }
+
+        bool Edited = false;
+        ImGui::TextDisabled("Target: %s", SolidArcBodyCaption(State.Document, Copy.Target.empty() ? State.Document.Regeneration.Active : Copy.Target).c_str());
+
+        if (Copy.Kind == ModifierKind::LinearArray)
+        {
+            Edited |= DrawModifierValueRow(State, "Count X", ModLabel + ":Count", Copy.Count, true);
+            Edited |= DrawModifierValueRow(State, "Step X (m)", ModLabel + ":Dist", Copy.Distance);
