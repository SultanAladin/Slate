+            if (ToggleButton(State, ("Chamfer###ModChamfer:" + ModLabel).c_str(), Copy.Shape == BlendProfile::Chamfer, RowSpan(2)))
+            {
+                Copy.Shape = BlendProfile::Chamfer;
+                Edited     = true;
+            }
+            Edited |= DrawModifierValueRow(State, "Radius / Size", ModLabel + ":Size", Copy.Size);
+            ImGui::SetNextItemWidth(135);
+            const std::string GrpPreview = Copy.LimitMode == BevelLimitMode::EdgeGroup ? (Copy.EdgeGroup.empty() ? std::string("[Edge Group]") : Copy.EdgeGroup)
+                                         : (Copy.LimitMode == BevelLimitMode::Picked ? std::string("[Picked Edges]") : std::string("[By Angle]"));
+            if (ImGui::BeginCombo(("Edges###ModGrp:" + ModLabel).c_str(), GrpPreview.c_str()))
+            {
+                if (ImGui::Selectable("[Picked Edges]", Copy.LimitMode == BevelLimitMode::Picked)) { Copy.LimitMode = BevelLimitMode::Picked; Copy.EdgeGroup.clear(); Edited = true; }
+                if (ImGui::Selectable("[By Angle]", Copy.LimitMode == BevelLimitMode::Angle)) { Copy.LimitMode = BevelLimitMode::Angle; Copy.EdgeGroup.clear(); Edited = true; }
+                for (const FeatureEdgeGroup& Grp : State.Document.Tree.EdgeGroups)
+                    if (ImGui::Selectable(Grp.Name.c_str(), Copy.LimitMode == BevelLimitMode::EdgeGroup && Copy.EdgeGroup == Grp.Name))
