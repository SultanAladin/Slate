+/*====================================================================================================================================
+                                                     TOPOLOGICALNAMING.CPP
+====================================================================================================================================*/
+// 🧩 Persistent names from operation histories (research § L 🥇) and reference resolution: exact → source → geometric
+
+#include "Engine/GeometryProcessing/Feature/TopologicalNaming.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <regex>
+#include <set>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INTERNAL FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+namespace
+{
+    [[nodiscard]] double MeasureEdgeLength(const ModelPartition& Partition, EdgeToken Edge)
+    {
+        static constexpr double Nodes[4]   = { 0.1834346424956498, 0.5255324099163290, 0.7966664774136267, 0.9602898564975363 };
+        static constexpr double Weights[4] = { 0.3626837833783620, 0.3137066458778873, 0.2223810344533745, 0.1012285362903763 };
+        const EdgeProfile&   Record = Partition.Edges.Resolve(Edge);
+        const CurveGeometry& Curve  = Partition.Curves.Resolve(Record.Curve);
+        double Arc = 0.0;
+        constexpr int Pieces = 8;
+        for (int Piece = 0; Piece < Pieces; ++Piece)
+        {
+            const double Low  = Record.IntervalLow + (Record.IntervalHigh - Record.IntervalLow) * Piece / Pieces;
+            const double High = Record.IntervalLow + (Record.IntervalHigh - Record.IntervalLow) * (Piece + 1) / Pieces;
+            for (int GaussIndex = 0; GaussIndex < 8; ++GaussIndex)
+            {
+                const double Abscissa = GaussIndex < 4 ? -Nodes[3 - GaussIndex] : Nodes[GaussIndex - 4];
+                const double Weight   = (GaussIndex < 4 ? Weights[3 - GaussIndex] : Weights[GaussIndex - 4]) * 0.5 * (High - Low);
+                Arc += Weight * Length(EvaluateCurve(Curve, Low + (Abscissa + 1.0) * 0.5 * (High - Low)).Derivative);
+            }
+        }
+        return Arc;
+    }
+
+    [[nodiscard]] CurveSample EdgeMiddle(const ModelPartition& Partition, EdgeToken Edge)
+    {
+        const EdgeProfile& Record = Partition.Edges.Resolve(Edge);
+        return EvaluateCurve(Partition.Curves.Resolve(Record.Curve), 0.5 * (Record.IntervalLow + Record.IntervalHigh));
+    }
+
+    [[nodiscard]] double MeasureBodyScale(const ModelPartition& Partition, const BodyInventory& Inventory)
+    {
+        Vector3 Low{ 1e300, 1e300, 1e300 }, High{ -1e300, -1e300, -1e300 };
+        for (VertexToken Vertex : Inventory.Vertices)
+        {
+            const Vector3 Point = Partition.Vertices.Resolve(Vertex).Position;
+            Low  = { std::min(Low.X, Point.X), std::min(Low.Y, Point.Y), std::min(Low.Z, Point.Z) };
+            High = { std::max(High.X, Point.X), std::max(High.Y, Point.Y), std::max(High.Z, Point.Z) };
+        }
+        return Inventory.Vertices.empty() ? 1.0 : std::max(1.0e-12, Distance(Low, High));
+    }
+
+    // 📝 Stable ordinal key: position quantised at 10⁻⁶·L, compared x, then y, then z.
+    struct OrdinalKey
+    {
+        long long X = 0, Y = 0, Z = 0;                                                       // [-] - Quantised coordinates
+        bool operator<(const OrdinalKey& Other) const noexcept { return X != Other.X ? X < Other.X : Y != Other.Y ? Y < Other.Y : Z < Other.Z; }
+    };
+
+    [[nodiscard]] OrdinalKey QuantiseKey(Vector3 Position, double Scale)
+    {
+        const double Step = 1.0e-6 * Scale;
+        return { std::llround(Position.X / Step), std::llround(Position.Y / Step), std::llround(Position.Z / Step) };
+    }
+
+    // Gives every member of a group of equal names a suffix (Separator + ordinal) ordered by its key; singletons keep
+    // the bare name. ⚠️ All members are suffixed, so a bare reference never silently picks one of them.
+    void Disambiguate(std::map<uint32_t, std::string>& Names, const std::map<uint32_t, Vector3>& Positions, double Scale, const char* Separator, int FirstOrdinal)
+    {
+        std::map<std::string, std::vector<uint32_t>> Groups;
+        for (const auto& [Slot, Name] : Names) Groups[Name].push_back(Slot);
+        for (auto& [Name, Slots] : Groups)
+        {
+            if (Slots.size() < 2) continue;
+            std::sort(Slots.begin(), Slots.end(), [&](uint32_t First, uint32_t Second)
+            {
+                const OrdinalKey FirstKey = QuantiseKey(Positions.at(First), Scale), SecondKey = QuantiseKey(Positions.at(Second), Scale);
+                if (FirstKey < SecondKey) return true;
+                if (SecondKey < FirstKey) return false;
+                return First < Second;
+            });
+            for (size_t Index = 0; Index < Slots.size(); ++Index) Names[Slots[Index]] = Name + Separator + std::to_string(FirstOrdinal + static_cast<int>(Index));
+        }
+    }
+
+    void DisambiguateFaces(const ModelPartition& Partition, BodyToken Body, BodyNaming& Naming)
+    {
+        const BodyInventory Inventory = Partition.CollectInventory(Body);
+        std::map<uint32_t, Vector3> Positions;
+        for (FaceToken Face : Inventory.Faces) Positions[Face.Slot] = MeasureFaceBoundaryCentre(Partition, Face);
+        Disambiguate(Naming.Faces, Positions, MeasureBodyScale(Partition, Inventory), "/", 1);
+    }
+
+    [[nodiscard]] std::string Lookup(const std::map<uint32_t, std::string>& Names, uint32_t Slot)
+    {
+        const auto Found = Names.find(Slot);
+        return Found == Names.end() ? std::string("Unnamed") : Found->second;
+    }
+
+    [[nodiscard]] const std::map<uint32_t, std::string>& NamesOf(const BodyNaming& Naming, ReferenceKind Kind)
+    {
+        return Kind == ReferenceKind::Face ? Naming.Faces : Kind == ReferenceKind::Edge ? Naming.Edges : Naming.Vertices;
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    NAMING
+//------------------------------------------------------------------------------------------------------------------------
+
+void CompleteNaming(const ModelPartition& Partition, BodyToken Body, BodyNaming& Naming)
+{
+    const BodyInventory Inventory = Partition.CollectInventory(Body);
+    const double        Scale     = MeasureBodyScale(Partition, Inventory);
+    Naming.Edges.clear();
+    Naming.Vertices.clear();
+
+    // Edges: sorted names of the faces around the radial ring.
+    std::map<uint32_t, Vector3> EdgePositions;
+    for (EdgeToken Edge : Inventory.Edges)
+    {
+        std::vector<std::string> Around;
+        const FinToken Entry = Partition.Edges.Resolve(Edge).RadialFin;
+        FinToken Fin = Entry;
+        do
+        {
+            Around.push_back(Lookup(Naming.Faces, Partition.Loops.Resolve(Partition.Fins.Resolve(Fin).Loop).Face.Slot));
+            Fin = Partition.Fins.Resolve(Fin).RadialSuccessor;
+        } while (Fin.PresentCondition() && !(Fin == Entry) && Around.size() < 16);
+        if (Around.size() == 1) Around.push_back("∅");
+        std::sort(Around.begin(), Around.end());
+        std::string Name = "Edge(";
+        for (size_t Index = 0; Index < Around.size(); ++Index) Name += (Index ? "|" : "") + Around[Index];
+        Naming.Edges[Edge.Slot] = Name + ")";
+        EdgePositions[Edge.Slot] = EdgeMiddle(Partition, Edge).Position;
+    }
+    Disambiguate(Naming.Edges, EdgePositions, Scale, "#", 0);
+
+    // Vertices: sorted set of incident face names.
+    std::map<uint32_t, std::set<std::string>> Incident;
+    for (FinToken Fin : Inventory.Fins)
+    {
+        const VertexToken Start = Partition.FinStart(Fin);
+        Incident[Start.Slot].insert(Lookup(Naming.Faces, Partition.Loops.Resolve(Partition.Fins.Resolve(Fin).Loop).Face.Slot));
+    }
+    std::map<uint32_t, Vector3> VertexPositions;
+    for (VertexToken Vertex : Inventory.Vertices)
+    {
+        std::string Name = "Vertex(";
+        bool First = true;
+        for (const std::string& Face : Incident[Vertex.Slot]) { Name += (First ? "" : "|") + Face; First = false; }
+        Naming.Vertices[Vertex.Slot] = Name + ")";
+        VertexPositions[Vertex.Slot] = Partition.Vertices.Resolve(Vertex).Position;
+    }
+    Disambiguate(Naming.Vertices, VertexPositions, Scale, "#", 0);
+}
+
+BodyNaming NameSweptBody(const ModelPartition& Partition, const SweepOutcome& Sweep, const std::string& Prefix)
+{
+    BodyNaming Naming;
+    for (size_t Index = 0; Index < Sweep.Faces.size(); ++Index) Naming.Faces[Sweep.Faces[Index].Slot] = Prefix + "." + SweepRoleName(Sweep.Roles[Index]);
+    DisambiguateFaces(Partition, Sweep.Body, Naming);
+    CompleteNaming(Partition, Sweep.Body, Naming);
+    return Naming;
+}
+
+BodyNaming NamePanelBody(const ModelPartition& Partition, BodyToken Body, const std::vector<FaceToken>& Faces, const std::vector<std::string>& FaceNames)
+{
+    BodyNaming Naming;
+    for (size_t Index = 0; Index < Faces.size() && Index < FaceNames.size(); ++Index) Naming.Faces[Faces[Index].Slot] = FaceNames[Index];
+    DisambiguateFaces(Partition, Body, Naming);
+    CompleteNaming(Partition, Body, Naming);
+    return Naming;
+}
+
+BodyNaming NameBooleanBody(const ModelPartition& Partition, BodyToken Body, const BooleanOutcome& Boolean, const BodyNaming& First, const BodyNaming& Second)
+{
+    BodyNaming Naming;
+    for (const FaceHistory& History : Boolean.FaceHistories)
+    {
+        Naming.Faces[History.Result.Slot] = Lookup(History.Argument == 0 ? First.Faces : Second.Faces, History.Source.Slot);
+    }
+    DisambiguateFaces(Partition, Body, Naming);
+    CompleteNaming(Partition, Body, Naming);
+    return Naming;
+}
+
+BodyNaming NameBlendedBody(const ModelPartition& Partition, BodyToken Body, const BlendOutcome& Blend, const BodyNaming& Source, const std::string& Prefix)
+{
+    BodyNaming Naming;
+    for (const BlendFaceHistory& History : Blend.FaceHistories)
+    {
+        std::string Name;
+        switch (History.Origin)
+        {
+        case BlendFaceOrigin::Modified: Name = Lookup(Source.Faces, History.Face.Slot); break;
+        case BlendFaceOrigin::Edge:     Name = Prefix + ".Strip(" + Lookup(Source.Edges, History.Edge.Slot) + ")"; break;
+        case BlendFaceOrigin::Vertex:   Name = Prefix + ".Corner(" + Lookup(Source.Vertices, History.Vertex.Slot) + ")"; break;
+        }
+        Naming.Faces[History.Result.Slot] = Name;
+    }
+    DisambiguateFaces(Partition, Body, Naming);
+    CompleteNaming(Partition, Body, Naming);
+    return Naming;
+}
+
+BodyNaming NameChangedBody(const ModelPartition& Partition, BodyToken Body, const FaceOperationOutcome& Change, const BodyNaming& Source, const std::string& Prefix)
+{
+    BodyNaming Naming;
+    for (const FaceChangeHistory& History : Change.FaceHistories)
+    {
+        if (History.Origin != FaceChangeOrigin::Generated) { Naming.Faces[History.Result.Slot] = Lookup(Source.Faces, History.Face.Slot); continue; }
+        const std::string Cause = History.Edge.PresentCondition() ? Lookup(Source.Edges, History.Edge.Slot) : History.Face.PresentCondition() ? Lookup(Source.Faces, History.Face.Slot) : std::string();
+        Naming.Faces[History.Result.Slot] = Prefix + ".Generated(" + Cause + ")";
+    }
+    DisambiguateFaces(Partition, Body, Naming);
+    CompleteNaming(Partition, Body, Naming);
+    return Naming;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    RESOLUTION
+//------------------------------------------------------------------------------------------------------------------------
+
+std::string StripDisambiguators(const std::string& Name)
+{
+    static const std::regex Disambiguator(R"((/\d+|#\d+)(?=$|[|)]))");
+    return std::regex_replace(Name, Disambiguator, "");
+}
+
+ReferenceSignature CaptureSignature(const ModelPartition& Partition, ReferenceKind Kind, uint32_t Slot)
+{
+    ReferenceSignature Signature;
+    Signature.CapturedCondition = true;
+    if (Kind == ReferenceKind::Face)
+    {
+        const FaceToken    Face   = Partition.Faces.TokenAt(Slot);
+        const FaceProfile& Record = Partition.Faces.Resolve(Face);
+        Signature.Position = MeasureFaceBoundaryCentre(Partition, Face);
+        Signature.Category = SurfaceCategoryLabel(Partition.Surfaces.Resolve(Record.Surface));
+        for (LoopToken Loop : Record.Loops) Partition.EnumerateLoopFins(Loop, [&](FinToken Fin) { Signature.Size += MeasureEdgeLength(Partition, Partition.Fins.Resolve(Fin).Edge); });
+        return Signature;
+    }
+    if (Kind == ReferenceKind::Edge)
+    {
+        const EdgeToken   Edge   = Partition.Edges.TokenAt(Slot);
+        const CurveSample Middle = EdgeMiddle(Partition, Edge);
+        Signature.Position  = Middle.Position;
+        Signature.Direction = Normalize(Middle.Derivative);
+        Signature.Category  = CurveCategoryLabel(Partition.Curves.Resolve(Partition.Edges.Resolve(Edge).Curve));
+        Signature.Size      = MeasureEdgeLength(Partition, Edge);
+        return Signature;
+    }
+    Signature.Position = Partition.Vertices.Resolve(Partition.Vertices.TokenAt(Slot)).Position;
+    Signature.Category = "Vertex";
+    return Signature;
+}
+
+ResolvedReference ResolveReference(const ModelPartition& Partition, BodyToken Body, const BodyNaming& Naming, const TopologyReference& Reference)
+{
+    ResolvedReference Resolved;
+    const std::map<uint32_t, std::string>& Names = NamesOf(Naming, Reference.Kind);
+
+    // ① Exact.
+    for (const auto& [Slot, Name] : Names)
+    {
+        if (Name != Reference.Name) continue;
+        Resolved.Method = ResolutionMethod::Exact; Resolved.Slot = Slot; Resolved.Matched = Name;
+        return Resolved;
+    }
+
+    // ② Same sources: names equal once split / ordinal disambiguators are removed.
+    const std::string Stripped = StripDisambiguators(Reference.Name);
+    std::vector<uint32_t> SameSource;
+    for (const auto& [Slot, Name] : Names) if (StripDisambiguators(Name) == Stripped) SameSource.push_back(Slot);
+    if (SameSource.size() == 1)
+    {
+        Resolved.Method = ResolutionMethod::Source; Resolved.Slot = SameSource[0]; Resolved.Matched = Names.at(SameSource[0]);
+        return Resolved;
+    }
+
+    // ③ Geometric rebind with a ratio test.
+    if (!Reference.Signature.CapturedCondition)
+    {
+        Resolved.Refusal = SameSource.empty() ? "reference " + Reference.Name + " not found (no signature to rebind)" : "reference " + Reference.Name + " is ambiguous (no signature to rebind)";
+        for (uint32_t Slot : SameSource) Resolved.Candidates.push_back(Names.at(Slot));
+        return Resolved;
+    }
+    std::vector<uint32_t> Pool = SameSource;
+    if (Pool.empty()) for (const auto& [Slot, Name] : Names) Pool.push_back(Slot);
+    struct Candidate { uint32_t Slot; double Separation; };
+    std::vector<Candidate> Ranked;
+    const ReferenceSignature& Wanted = Reference.Signature;
+    for (uint32_t Slot : Pool)
+    {
+        const ReferenceSignature Present = CaptureSignature(Partition, Reference.Kind, Slot);
+        if (Present.Category != Wanted.Category) continue;
+        if (Reference.Kind != ReferenceKind::Vertex && (Present.Size < 0.5 * Wanted.Size || Present.Size > 2.0 * Wanted.Size)) continue;
+        double Separation = Distance(Present.Position, Wanted.Position);
+        if (Reference.Kind == ReferenceKind::Edge) Separation += Wanted.Size * (1.0 - std::fabs(Dot(Present.Direction, Wanted.Direction)));
+        Ranked.push_back({ Slot, Separation });
+    }
+    std::sort(Ranked.begin(), Ranked.end(), [](const Candidate& First, const Candidate& Second) { return First.Separation < Second.Separation; });
+    const BodyInventory Inventory = Partition.CollectInventory(Body);
+    const double Reach = Reference.Kind == ReferenceKind::Vertex ? 0.25 * MeasureBodyScale(Partition, Inventory) : Wanted.Size;   // [len] - Max rebind distance
+    const double Floor = 1.0e-9 * MeasureBodyScale(Partition, Inventory);
+    if (!Ranked.empty() && Ranked[0].Separation <= Reach && (Ranked.size() == 1 || Ranked[1].Separation >= 2.0 * Ranked[0].Separation + Floor))
+    {
+        Resolved.Method = ResolutionMethod::Geometric; Resolved.Slot = Ranked[0].Slot; Resolved.Matched = Names.at(Ranked[0].Slot);
+        return Resolved;
+    }
+    for (size_t Index = 0; Index < Ranked.size() && Index < 4; ++Index) Resolved.Candidates.push_back(Names.at(Ranked[Index].Slot));
+    if (Ranked.empty()) Resolved.Refusal = "reference " + Reference.Name + " not found: nothing with its sources or its shape remains";
+    else if (Ranked[0].Separation > Reach) Resolved.Refusal = "reference " + Reference.Name + " not found: nearest look-alike is too far to rebind";
+    else Resolved.Refusal = "reference " + Reference.Name + " is ambiguous: " + std::to_string(Ranked.size()) + " equally plausible candidates";
+    return Resolved;
+}
+
+const char* ResolutionMethodLabel(ResolutionMethod Method) noexcept
+{
+    switch (Method)
+    {
+    case ResolutionMethod::Exact:     return "Exact";
+    case ResolutionMethod::Source:    return "Source";
+    case ResolutionMethod::Geometric: return "Geometric";
+    case ResolutionMethod::Refused:   return "Refused";
+    }
+    return "?";
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Feature/TopologicalNaming.h b/Engine/GeometryProcessing/Feature/TopologicalNaming.h
new file mode 100644
index 0000000000000000000000000000000000000000..8aa049edb90c8db13aee5668ca2e8700c4f8e29b
--- /dev/null
+++ b/Engine/GeometryProcessing/Feature/TopologicalNaming.h
@@ -0,0 +1,120 @@
+/*====================================================================================================================================
+                                                      TOPOLOGICALNAMING.H
+====================================================================================================================================*/
+// 🧩 Persistent names from operation histories (research § L 🥇) and reference resolution: exact → source → geometric
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Blend/EdgeBlend.h"
+#include "Engine/GeometryProcessing/Boolean/GeneralFuse.h"
+#include "Engine/GeometryProcessing/Feature/ProfileSweep.h"
+#include "Engine/GeometryProcessing/Local/FaceOperations.h"
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    STRUCTS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 Names are keyed by record slot. Faces are named from the history of the operation that made them; edges and
+//    vertices are named from their incident faces (realthunder's lower-element rule), so they follow automatically:
+//      face   ·  Extrude#2.Side(Line3) · Extrude#2.Cap(End) · Extrude#4.Side(Circle1)/1 (split piece) · Blend#5.Strip(…)
+//      edge   ·  Edge(A|B)            (sorted face names; A|∅ laminar, A|A seam; #k when one face pair has several)
+//      vertex ·  Vertex(A|B|C)        (sorted incident face set; #k when repeated)
+struct BodyNaming
+{
+    std::map<uint32_t, std::string> Faces    = {};                                           // [-] - Face slot → name
+    std::map<uint32_t, std::string> Edges    = {};                                           // [-] - Edge slot → name
+    std::map<uint32_t, std::string> Vertices = {};                                           // [-] - Vertex slot → name
+};
+
+enum class ReferenceKind : uint8_t
+{
+    Face   = 0,                                                                              // A face of the current body
+    Edge   = 1,                                                                              // An edge
+    Vertex = 2,                                                                              // A vertex
+};
+
+// 📝 What a reference looked like when it was authored, for geometric rebinding when its name no longer resolves.
+struct ReferenceSignature
+{
+    bool        CapturedCondition = false;                                                   // [-]   - Filled at authoring
+    Vector3     Position          = {};                                                      // [len] - Boundary centre / midpoint / point
+    Vector3     Direction         = {};                                                      // [-]   - Edge tangent at the midpoint (faces: unused)
+    std::string Category          = {};                                                      // [-]   - Surface / curve category label
+    double      Size              = 0.0;                                                     // [len] - Boundary length / edge length
+};
+
+struct TopologyReference
+{
+    ReferenceKind      Kind      = ReferenceKind::Edge;                                      // [-] - What it names
+    std::string        Name      = {};                                                       // [-] - Persistent name
+    ReferenceSignature Signature = {};                                                       // [-] - Authoring-time geometry
+};
+
+enum class ResolutionMethod : uint8_t
+{
+    Exact     = 0,                                                                           // Name found as is
+    Source    = 1,                                                                           // Unique subject with the same sources (split / renumbered)
+    Geometric = 2,                                                                           // Signature rebinding with a ratio test
+    Refused   = 3,                                                                           // Missing or ambiguous: nothing chosen
+};
+
+struct ResolvedReference
+{
+    ResolutionMethod         Method     = ResolutionMethod::Refused;                         // [-] - How it resolved
+    uint32_t                 Slot       = UINT32_MAX;                                        // [-] - Record slot when resolved
+    std::string              Matched    = {};                                                // [-] - Name of the subject chosen
+    std::string              Refusal    = {};                                                // [-] - Why not, when refused
+    std::vector<std::string> Candidates = {};                                                // [-] - Ambiguous candidates (refusals)
+};
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    PUBLIC FUNCTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// Face names of a swept body: Prefix + "." + role ("Extrude#2.Side(Line3)"); edges and vertices completed.
+[[nodiscard]] BodyNaming NameSweptBody(const ModelPartition& Partition, const SweepOutcome& Sweep, const std::string& Prefix);
+
+// Boolean result: every face keeps its source face's name; pieces of one split source get /1, /2, … ordered by a stable
+// geometric key (boundary centre, lexicographic at 10⁻⁶·L).
+[[nodiscard]] BodyNaming NameBooleanBody(const ModelPartition& Partition, BodyToken Body, const BooleanOutcome& Boolean, const BodyNaming& First, const BodyNaming& Second);
+
+// Blend result: Modified keeps its name; Prefix.Strip(edge name) and Prefix.Corner(vertex name) for new faces.
+[[nodiscard]] BodyNaming NameBlendedBody(const ModelPartition& Partition, BodyToken Body, const BlendOutcome& Blend, const BodyNaming& Source, const std::string& Prefix);
+
+// Face-operation result: Unchanged / Trimmed / Replaced keep their name; Generated → Prefix.Generated(edge or face name).
+[[nodiscard]] BodyNaming NameChangedBody(const ModelPartition& Partition, BodyToken Body, const FaceOperationOutcome& Change, const BodyNaming& Source, const std::string& Prefix);
+
+// Assembled panels (vehicle plan V7): Faces[k] takes FaceNames[k] ("Loft#4.Side(Surface)", "Mirror#5.Image(…)",
+// "Close#6.Cap(0)"); duplicates get /1, /2, …; edges and vertices completed.
+[[nodiscard]] BodyNaming NamePanelBody(const ModelPartition& Partition, BodyToken Body, const std::vector<FaceToken>& Faces, const std::vector<std::string>& FaceNames);
+
+// Recomputes edge and vertex names of Body from its face names (called by every Name… function).
+void CompleteNaming(const ModelPartition& Partition, BodyToken Body, BodyNaming& Naming);
+
+// Signature of a named subject as it is now (authoring capture).
+[[nodiscard]] ReferenceSignature CaptureSignature(const ModelPartition& Partition, ReferenceKind Kind, uint32_t Slot);
+
+// 💡 Resolution order (plan § 4): ① exact name; ② the unique subject whose name equals the reference with split /k and
+//    #k ordinals removed (same sources); ③ geometric rebind among the same-source candidates (else every subject of the
+//    same category and comparable size): nearest signature position, accepted only if it is within the reference size
+//    and the runner-up is ≥ 2× farther; ④ otherwise refused with the candidates listed — never a silent best guess.
+[[nodiscard]] ResolvedReference ResolveReference(const ModelPartition& Partition, BodyToken Body, const BodyNaming& Naming, const TopologyReference& Reference);
+
+// Name with split (/k) and ordinal (#k) disambiguators removed, recursively inside Edge(…|…) / Vertex(…).
+[[nodiscard]] std::string StripDisambiguators(const std::string& Name);
+
+[[nodiscard]] const char* ResolutionMethodLabel(ResolutionMethod Method) noexcept;
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Geometry/CurveGeometry.cpp b/Engine/GeometryProcessing/Geometry/CurveGeometry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..728152b5190072149faddaeb2ac5fef345dcb32f
--- /dev/null
+++ b/Engine/GeometryProcessing/Geometry/CurveGeometry.cpp
@@ -0,0 +1,161 @@
+/*====================================================================================================================================
+                                                       CURVEGEOMETRY.CPP
+====================================================================================================================================*/
+// 🧩 Analytic 3D curves (line, circle, ellipse) and 2D parameter-space curves (SP-curves on faces) with exact inversion
+
+#include "Engine/GeometryProcessing/Geometry/CurveGeometry.h"
+
+#include "Engine/GeometryProcessing/Geometry/NurbsCarrier.h"
+#include "Engine/GeometryProcessing/Geometry/RollingBallCarrier.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    3D CURVES
+//------------------------------------------------------------------------------------------------------------------------
+
+std::optional<ConicForm> ResolveConicForm(const CurveGeometry& Curve) noexcept
+{
+    if (const auto* Arc = std::get_if<CircularArc>(&Curve))
+    {
+        return ConicForm{ Arc->Frame.Origin, Arc->Frame.XAxis * Arc->Radius, Arc->Frame.YAxis * Arc->Radius, Arc->Frame.ZAxis };
+    }
+    if (const auto* Ellipse = std::get_if<EllipticalArc>(&Curve))
+    {
+        return ConicForm{ Ellipse->Frame.Origin, Ellipse->Frame.XAxis * Ellipse->MajorRadius, Ellipse->Frame.YAxis * Ellipse->MinorRadius, Ellipse->Frame.ZAxis };
+    }
+    return std::nullopt;
+}
+
+CurveSample EvaluateCurve(const CurveGeometry& Curve, double τ) noexcept
+{
+    if (const auto* Line = std::get_if<StraightLine>(&Curve))
+    {
+        return { Line->Origin + Line->Direction * τ, Line->Direction };
+    }
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve)) return EvaluateIntersectionCurve(*Traced->Trace, τ);
+    if (const auto* Contact = std::get_if<ContactCurve>(&Curve)) return EvaluateContactCurve(*Contact->Definition, τ);
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve)) return EvaluateNurbsCurve(*Spline->Definition, τ);
+    const ConicForm Conic  = *ResolveConicForm(Curve);
+    const double    Cosine = std::cos(τ);                                                    // [-] - cos τ
+    const double    Sine   = std::sin(τ);                                                    // [-] - sin τ
+    return { Conic.Centre + Conic.CosineAxis * Cosine + Conic.SineAxis * Sine, Conic.SineAxis * Cosine - Conic.CosineAxis * Sine };
+}
+
+double ProjectOntoCurve(const CurveGeometry& Curve, Vector3 Position, double IntervalLow) noexcept
+{
+    if (const auto* Line = std::get_if<StraightLine>(&Curve))
+    {
+        return Dot(Position - Line->Origin, Line->Direction);
+    }
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve)) return ProjectOntoIntersectionCurve(*Traced->Trace, Position, IntervalLow);
+    if (const auto* Contact = std::get_if<ContactCurve>(&Curve)) return ProjectOntoContactCurve(*Contact->Definition, Position, IntervalLow);
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve)) return ProjectOntoNurbsCurve(*Spline->Definition, Position, IntervalLow);
+    const ConicForm Conic  = *ResolveConicForm(Curve);
+    const Vector3   Offset = Position - Conic.Centre;                                        // [len] - From the centre
+    const double    Major  = Length(Conic.CosineAxis);                                       // [len] - a
+    const double    Minor  = Length(Conic.SineAxis);                                         // [len] - b
+    const double    Abscissa = Dot(Offset, Conic.CosineAxis) / Major;                        // [len] - x in the conic plane
+    const double    Ordinate = Dot(Offset, Conic.SineAxis) / Minor;                          // [len] - y in the conic plane
+    double τ = std::atan2(Ordinate * Major, Abscissa * Minor);                               // [rad] - Exact for a circle
+    if (std::fabs(Major - Minor) > 1.0e-14 * Major)
+    {
+        // 📝 Ellipse foot point: g(τ) = (a² − b²)·sin τ·cos τ − x·a·sin τ + y·b·cos τ = 0, Newton from the affine angle;
+        //    the affine seed lies in the correct quadrant, where g is monotone between its roots.
+        const double Excess = Major * Major - Minor * Minor;                                 // [len²] - a² − b²
+        for (int Iteration = 0; Iteration < 40; ++Iteration)
+        {
+            const double Cosine = std::cos(τ), Sine = std::sin(τ);                           // [-] - cos τ, sin τ
+            const double Value  = Excess * Sine * Cosine - Abscissa * Major * Sine + Ordinate * Minor * Cosine;
+            const double Slope  = Excess * (Cosine * Cosine - Sine * Sine) - Abscissa * Major * Cosine - Ordinate * Minor * Sine;
+            if (std::fabs(Slope) < 1.0e-300) break;
+            const double Step = Value / Slope;                                               // [rad] - Newton correction
+            τ -= std::clamp(Step, -0.5, 0.5);
+            if (std::fabs(Step) < 1.0e-15) break;
+        }
+    }
+    constexpr double Period = 2.0 * std::numbers::pi;                                        // [rad] - Full turn
+    // 📝 Fold into [IntervalLow, IntervalLow + 2π); a hair below the low end maps to the low end, not to the high end.
+    τ = IntervalLow + std::fmod(std::fmod(τ - IntervalLow, Period) + Period, Period);
+    if (τ - IntervalLow > Period - 1.0e-12) τ = IntervalLow;
+    return τ;
+}
+
+bool PeriodicCondition(const CurveGeometry& Curve) noexcept
+{
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve)) return IntersectionCurveClosedCondition(*Traced->Trace);
+    if (const auto* Contact = std::get_if<ContactCurve>(&Curve)) return Contact->Definition->Period > 0.0;
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve)) return Spline->Definition->Period > 0.0;
+    return !std::holds_alternative<StraightLine>(Curve);
+}
+
+const char* CurveCategoryLabel(const CurveGeometry& Curve) noexcept
+{
+    if (std::holds_alternative<StraightLine>(Curve))      return "Line";
+    if (std::holds_alternative<IntersectionCurve>(Curve)) return "Intersection";
+    if (std::holds_alternative<ContactCurve>(Curve))      return "Contact";
+    if (std::holds_alternative<NurbsCurve>(Curve))        return "Nurbs";
+    return std::holds_alternative<CircularArc>(Curve) ? "Circle" : "Ellipse";
+}
+
+double MeasureCurveBulge(const CurveGeometry& Curve, double Low, double High, int Pieces) noexcept
+{
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve)) return MeasureIntersectionCurveBulge(*Traced->Trace, Low, High, Pieces);
+    if (const auto* Contact = std::get_if<ContactCurve>(&Curve)) return MeasureContactCurveBulge(*Contact->Definition, Low, High, Pieces);
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve)) return MeasureNurbsCurveBulge(*Spline->Definition, Low, High, Pieces);
+    const std::optional<ConicForm> Conic = ResolveConicForm(Curve);
+    if (!Conic) return 0.0;
+    const double Largest = std::max(Length(Conic->CosineAxis), Length(Conic->SineAxis));    // [len] - Largest semi-axis
+    const double Smallest = std::min(Length(Conic->CosineAxis), Length(Conic->SineAxis));   // [len] - Smallest semi-axis
+    // 📝 Curvature ≤ a/b² on an ellipse; the sagitta of a piece of sweep Δτ is ≤ κ_max·(a·Δτ)²/8.
+    const double Sweep = (High - Low) / std::max(Pieces, 1);                                // [rad] - Δτ per piece
+    if (Largest - Smallest <= 1.0e-14 * Largest) return Largest * (1.0 - std::cos(0.5 * Sweep));
+    return Largest / (Smallest * Smallest) * (Largest * Sweep) * (Largest * Sweep) / 8.0;
+}
+
+double MeasureParameterScale(const CurveGeometry& Curve) noexcept
+{
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve)) return MeasureIntersectionCurveScale(*Traced->Trace);
+    if (const auto* Contact = std::get_if<ContactCurve>(&Curve)) return MeasureParameterScale(Contact->Definition->Spine);
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve)) return MeasureNurbsCurveScale(*Spline->Definition);
+    const std::optional<ConicForm> Conic = ResolveConicForm(Curve);
+    return Conic ? std::max(Length(Conic->CosineAxis), Length(Conic->SineAxis)) : 1.0;
+}
+
+std::vector<double> CollectCurveBreakpoints(const CurveGeometry& Curve, double Low, double High)
+{
+    if (const auto* Traced = std::get_if<IntersectionCurve>(&Curve)) return CollectIntersectionCurveKnots(*Traced->Trace, std::min(Low, High), std::max(Low, High));
+    if (const auto* Contact = std::get_if<ContactCurve>(&Curve)) return CollectContactCurveBreakpoints(*Contact->Definition, Low, High);
+    if (const auto* Spline = std::get_if<NurbsCurve>(&Curve)) return CollectNurbsCurveKnots(*Spline->Definition, Low, High);
+    return {};
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    2D PARAMETER-SPACE CURVES
+//------------------------------------------------------------------------------------------------------------------------
+
+ParameterSample EvaluateParameterCurve(const ParameterCurve& Curve, double τ) noexcept
+{
+    if (const auto* Line = std::get_if<ParameterLine>(&Curve))
+    {
+        return { Line->Origin + Line->Direction * τ, Line->Direction };
+    }
+    if (const auto* Projected = std::get_if<ParameterProjection>(&Curve))
+    {
+        return EvaluateProjectedParameterCurve(*Projected->Projection, τ);
+    }
+    const auto&  Ellipse = std::get<ParameterEllipse>(Curve);
+    const double Cosine  = std::cos(τ);                                                      // [-] - cos τ
+    const double Sine    = std::sin(τ);                                                      // [-] - sin τ
+    return {
+        Ellipse.Centre + (Ellipse.FirstAxis * Cosine + Ellipse.SecondAxis * Sine) * Ellipse.Radius,
+        (Ellipse.FirstAxis * -Sine + Ellipse.SecondAxis * Cosine) * Ellipse.Radius,
+    };
+}
+
+} // namespace Frontier::GeometryProcessing
diff --git a/Engine/GeometryProcessing/Geometry/CurveGeometry.h b/Engine/GeometryProcessing/Geometry/CurveGeometry.h
new file mode 100644
index 0000000000000000000000000000000000000000..50c741d4ba6e2aef4f2f54b1840ebf76b4ff87ff
--- /dev/null
+++ b/Engine/GeometryProcessing/Geometry/CurveGeometry.h
@@ -0,0 +1,173 @@
+/*====================================================================================================================================
+                                                        CURVEGEOMETRY.H
+====================================================================================================================================*/
+// 🧩 Analytic 3D curves (line, circle, ellipse), exact intersection curves and 2D parameter-space curves (SP-curves on faces) with exact inversion
+
+#pragma once
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    INCLUDES
+//------------------------------------------------------------------------------------------------------------------------
+
+#include "Engine/GeometryProcessing/Geometry/VectorAlgebra.h"
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <variant>
+#include <vector>
+
+namespace Frontier::GeometryProcessing
+{
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    3D CURVES
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 P(τ) = Origin + τ·Direction, Direction unit length, so τ is arc length.
+struct StraightLine
+{
+    Vector3 Origin    = {};                                                                  // [len] - Point at τ = 0
+    Vector3 Direction = { 1.0, 0.0, 0.0 };                                                   // [-]   - Unit direction
+};
+
+// 📝 P(τ) = Centre + r·(cos τ·XAxis + sin τ·YAxis); the circle's axis is Frame.ZAxis (counter-clockwise about it).
+struct CircularArc
+{
+    OrthonormalFrame Frame  = {};                                                            // [-]   - Origin is the centre
+    double           Radius = 1.0;                                                           // [len] - Circle radius
+};
+
+// 📝 P(τ) = Centre + a·cos τ·XAxis + b·sin τ·YAxis (a = MajorRadius along XAxis, b = MinorRadius along YAxis) — the exact
+//    section of a cylinder by an oblique plane, and the mitre between two equal-radius blend cylinders with meeting axes.
+struct EllipticalArc
+{
+    OrthonormalFrame Frame       = {};                                                       // [-]   - Origin is the centre
+    double           MajorRadius = 2.0;                                                      // [len] - a, semi-axis along XAxis
+    double           MinorRadius = 1.0;                                                      // [len] - b, semi-axis along YAxis
+};
+
+// 📝 Exact intersection of two surfaces, evaluated by Newton onto both from a marched guide. The body lives in
+//    Intersection/IntersectionCurve.h (it needs SurfaceGeometry; this header must not). Closed curves have period 2π.
+struct TracedIntersection;
+
+struct IntersectionCurve
+{
+    std::shared_ptr<const TracedIntersection> Trace = {};                                    // [-] - Shared, immutable
+};
+
+// 📝 Contact rail of a procedural rolling-ball blend: P(τ) = foot of the spine point C(s·τ) on an analytic support
+//    (closed-form foot, so exact to the spine's precision); s = ±1 records reversal. Geometry/RollingBallCarrier.h.
+struct ContactDefinition;
+struct ContactCurve
+{
+    std::shared_ptr<const ContactDefinition> Definition = {};                                // [-] - Shared, immutable
+};
+
+// 📝 Rational B-spline curve (Geometry/NurbsCarrier.h): exact conics, affine images and freeform rims; τ is the knot
+//    parameter, periodic when the curve closes with matching derivatives.
+struct NurbsCurveDefinition;
+struct NurbsCurve
+{
+    std::shared_ptr<const NurbsCurveDefinition> Definition = {};                             // [-] - Shared, immutable
+};
+
+using CurveGeometry = std::variant<StraightLine, CircularArc, EllipticalArc, IntersectionCurve, ContactCurve, NurbsCurve>;
+
+// 📝 Common form of the periodic carriers: P(τ) = Centre + cos τ·CosineAxis + sin τ·SineAxis (axes orthogonal).
+struct ConicForm
+{
+    Vector3 Centre     = {};                                                                 // [len] - Centre
+    Vector3 CosineAxis = {};                                                                 // [len] - Semi-axis at τ = 0
+    Vector3 SineAxis   = {};                                                                 // [len] - Semi-axis at τ = π/2
+    Vector3 Normal     = {};                                                                 // [-]   - Unit plane normal (Frame.ZAxis)
+};
+
+struct CurveSample
+{
+    Vector3 Position   = {};                                                                 // [len] - P(τ)
+    Vector3 Derivative = {};                                                                 // [len] - dP/dτ
+};
+
+[[nodiscard]] CurveSample EvaluateCurve(const CurveGeometry& Curve, double τ) noexcept;
+
+// Closest-point inversion; the result is folded into [IntervalLow, IntervalLow + period) for periodic curves.
+[[nodiscard]] double ProjectOntoCurve(const CurveGeometry& Curve, Vector3 Position, double IntervalLow) noexcept;
+
+[[nodiscard]] bool PeriodicCondition(const CurveGeometry& Curve) noexcept;
+
+[[nodiscard]] const char* CurveCategoryLabel(const CurveGeometry& Curve) noexcept;
+
+// Circle and ellipse in the common conic form; empty for a straight line.
+[[nodiscard]] std::optional<ConicForm> ResolveConicForm(const CurveGeometry& Curve) noexcept;
+
+// Largest distance of the curve from its chord over [Low, High] (sagitta bound used by bounding boxes); 0 for lines.
+[[nodiscard]] double MeasureCurveBulge(const CurveGeometry& Curve, double Low, double High, int Pieces) noexcept;
+
+// Characteristic length of one unit of τ (1 for lines, the radius for circles, the major radius for ellipses).
+[[nodiscard]] double MeasureParameterScale(const CurveGeometry& Curve) noexcept;
+
+// τ values strictly inside (Low, High) where the carrier is only C¹ (guide knots of an intersection curve, repeated per
+// period); empty for analytic carriers. Quadrature splits there, so every panel integrates an analytic function.
+[[nodiscard]] std::vector<double> CollectCurveBreakpoints(const CurveGeometry& Curve, double Low, double High);
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                    2D PARAMETER-SPACE CURVES
+//------------------------------------------------------------------------------------------------------------------------
+
+// 💡 SP-curves are parameterised by the SAME τ as their edge (same-parameter rule), so a fin can be sampled in 3D and
+//    in (𝑢, 𝑣) at identical τ and the two compared directly — that comparison is the audit's p-curve check.
+
+// 📝 q(τ) = Origin + τ·Direction (Direction need not be unit).
+struct ParameterLine
+{
+    Vector2 Origin    = {};                                                                  // [-] - (𝑢, 𝑣) at τ = 0
+    Vector2 Direction = { 1.0, 0.0 };                                                        // [-] - d(𝑢, 𝑣)/dτ
+};
+
+// 📝 q(τ) = Centre + r·(cos τ·FirstAxis + sin τ·SecondAxis) — the image of a circle on a plane's (𝑢, 𝑣) chart.
+struct ParameterEllipse
+{
+    Vector2 Centre     = {};                                                                 // [-] - Chart centre
+    Vector2 FirstAxis  = { 1.0, 0.0 };                                                       // [-] - Image of the circle XAxis
+    Vector2 SecondAxis = { 0.0, 1.0 };                                                       // [-] - Image of the circle YAxis
+    double  Radius     = 1.0;                                                                // [-] - Scale applied to both axes
+};
+
+// 📝 q(τ) = projection of a 3D curve onto a surface chart — exact for a curve lying on the surface (closed-form inversion,
+//    periodic image chosen by an unwrap table). Used for section circles that are not iso-lines (plane ∩ sphere off-axis).
+//    The body lives in Geometry/ProjectedCurve.h (it needs SurfaceGeometry; this header must not).
+struct ProjectedParameterCurve;
+
+struct ParameterProjection
+{
+    std::shared_ptr<const ProjectedParameterCurve> Projection = {};                         // [-] - Shared, immutable
+};
+
+using ParameterCurve = std::variant<ParameterLine, ParameterEllipse, ParameterProjection>;
+
+struct ParameterSample
+{
+    Vector2 Position   = {};                                                                 // [-] - q(τ)
+    Vector2 Derivative = {};                                                                 // [-] - dq/dτ
