+    struct GateTally
+    {
+        const char* Code     = "";                                                           // [-] - M1 …
+        const char* Subject  = "";                                                           // [-] - What it measures
+        const char* Limit    = "";                                                           // [-] - Acceptance rule
+        double      Worst    = 0.0;                                                          // [-] - Largest measured value
+        long        Checks   = 0;                                                            // [-]
+        long        Failures = 0;                                                            // [-]
