@@ -0,0 +1,222 @@
+# SolidArc responsiveness walkthrough — the reported slow scene, drawn: a cylinder r 1.7 h 0.6, a circle r 0.2 drawn on
+# its curved side (the exact tangent plane) extruded 0.3 and joined (the start sinks below the plane so the Union closes),
+# a chamfer on the junction with the pointer sweeping (a slow preview waits for the pointer to rest), a chamfer on the
+# boss rim, four gizmo moves and a G move (rigid previews). Run with --trace to read the slow-frame lines.
+# Run: SolidArcCapture --reset-files --recovery …/ResponsivenessRecovery.solidarc --document …/Responsiveness.solidarc
+#      --script Scripts/ResponsivenessWalkthrough.txt --trace …/ResponsivenessTrace.log
+# Closed form after the Union: π·1.7²·0.6 + π·0.2²·0.3 + cap (∫ (R − √(R² − y²))·2√(r² − y²) dy) = W51.
+
+# Placement snapped to the 0.1 grid, as these checks were written for (free placement is the default since ⑮ of Snapping).
+snap grid on
+
+# ① cylinder r 1.7, h 0.6 (Shift+W circle, F fill, E 0.6)
+key N Ctrl
+frames 3
+key W Shift
+frames 2
+click world 0.0 0.0 0.0
+frames 2
+click world 1.7 0.0 0.0
+frames 3
+key F
+frames 2
+key E
+frames 2
+click @BevelSize
+key A Ctrl
+type 0.6
+key Enter
+frames 2
+key Enter
+frames 3
+expect bodies == 1
+expect refused == 0
+
+# ② isometric view; circle r 0.2 on the −y side: the sketch plane is the exact tangent plane (n̂ = −y, 1.7 from the axis)
+click @ViewMenu
+frames 2
+click @ViewIsometric
+frames 3
+key W Shift
+frames 2
+move world 0.0 -1.7 0.3
+frames 2
+expect face-plane == 1
+click world 0.0 -1.7 0.3
+frames 2
+click world 0.2 -1.7 0.3
+frames 3
+expect refused == 0
+expect plane-normal-y < -0.9999
+expect plane-offset ~ 1.7
+
+# ③ F, E: the Union starts sunk by the measured profile depth (≥ R − √(R² − r²) = 0.011806), 0.3 typed
+key F
+frames 2
+key E
+frames 2
+expect profile-sink > 0.011806
+expect profile-sink < 0.03
+click @BevelSize
+key A Ctrl
+type 0.3
+key Enter
+frames 2
+key Enter
+frames 3
+expect bodies == 1
+expect refused == 0
+expect sound == 1
+expect extrude-start < -0.011806
+expect volume ~ 5.485591014531
+capture 262UnionOnSide
+
+# ④ edge mode, the junction at its top (0, −1.7, 0.5), B → C; the pointer sweeps 30 frames (a slow preview waits for
+#    it to rest: at most a few previews, not 30; the sweep turns it into a fillet, Plasticity-style), C again, 0.02 typed
+key 2
+frames 1
+move world 0.0 -1.7 0.5
+frames 2
+click world 0.0 -1.7 0.5
+frames 2
+expect selected-edges == 1
+key B
+frames 2
+key C
+frames 2
+expect bevel-chamfer == 1
+expect bevel-active == 1
+expect bevel-stages == 2
+move viewport 0.45 0.70 offset -30 0
+move viewport 0.45 0.70 offset -28 0
+move viewport 0.45 0.70 offset -26 0
+move viewport 0.45 0.70 offset -24 0
+move viewport 0.45 0.70 offset -22 0
+move viewport 0.45 0.70 offset -20 0
+move viewport 0.45 0.70 offset -18 0
+move viewport 0.45 0.70 offset -16 0
+move viewport 0.45 0.70 offset -14 0
+move viewport 0.45 0.70 offset -12 0
+move viewport 0.45 0.70 offset -10 0
+move viewport 0.45 0.70 offset -8 0
+move viewport 0.45 0.70 offset -6 0
+move viewport 0.45 0.70 offset -4 0
+move viewport 0.45 0.70 offset -2 0
+move viewport 0.45 0.70 offset 0 0
+move viewport 0.45 0.70 offset 2 0
+move viewport 0.45 0.70 offset 4 0
+move viewport 0.45 0.70 offset 6 0
+move viewport 0.45 0.70 offset 8 0
+move viewport 0.45 0.70 offset 10 0
+move viewport 0.45 0.70 offset 12 0
+move viewport 0.45 0.70 offset 14 0
+move viewport 0.45 0.70 offset 16 0
+move viewport 0.45 0.70 offset 18 0
+move viewport 0.45 0.70 offset 20 0
+move viewport 0.45 0.70 offset 22 0
+move viewport 0.45 0.70 offset 24 0
+move viewport 0.45 0.70 offset 26 0
+move viewport 0.45 0.70 offset 28 0
+expect bevel-stages < 5
+frames 10
+expect bevel-stages < 6
+capture 263ChamferSweep
+key C
+frames 2
+expect bevel-chamfer == 1
+click @BevelSize
+key A Ctrl
+type 0.02
+key Enter
+frames 2
+key Enter
+frames 3
+expect bevel-active == 0
+expect refused == 0
+expect sound == 1
+
+# ⑤ the boss rim (0, −2.0, 0.5): chamfer 0.05
+move world 0.0 -2.0 0.5
+frames 2
+click world 0.0 -2.0 0.5
+frames 2
+expect selected-edges == 1
+key B
+frames 2
+key C
+frames 2
+expect bevel-chamfer == 1
+click @BevelSize
+key A Ctrl
+type 0.05
+key Enter
+frames 2
+key Enter
+frames 3
+expect bevel-active == 0
+expect refused == 0
+expect sound == 1
+
+# ⑥ body mode, pick it, four gizmo moves along x
+key 4
+frames 1
+click world 0.0 0.0 0.6
+frames 3
+expect selected-bodies == 1
+drag left @GizmoTranslateX by 40 0 12
+frames 3
+drag left @GizmoTranslateX by 40 0 12
+frames 3
+drag left @GizmoTranslateX by 40 0 12
+frames 3
+drag left @GizmoTranslateX by 40 0 12
+frames 3
+expect refused == 0
+expect gizmo-commits == 4
+expect volume ~ 5.484407611
+capture 264MovedFourTimes
+
+# ⑦ G (Plasticity move) shows the rigid preview: the shown triangles carried, no regeneration until the click commits
+move viewport 0.50 0.50
+frames 2
+key G
+frames 2
+expect transform == 1
+key Y
+frames 2
+move viewport 0.50 0.50 offset 0 -60
+frames 3
+expect transform-rigid == 1
+click viewport 0.50 0.50 offset 0 -60
+frames 3
+expect transform == 0
+expect transform-commits == 1
+expect refused == 0
+capture 265RigidMove
+
+# ⑧ right-click commits like Enter (the Plasticity habit): G · Y · move · right-click, the move is kept
+key G
+frames 2
+expect transform == 1
+key Y
+frames 2
+move viewport 0.50 0.50 offset 0 -40
+frames 3
+click viewport 0.50 0.50 offset 0 -40 Right
+frames 3
+expect transform == 0
+expect transform-commits == 2
+expect refused == 0
+expect volume ~ 5.484407611
+
+# ⑨ Esc still cancels: G · move · Esc leaves the commits at 2
+key G
+frames 2
+expect transform == 1
+move viewport 0.50 0.50 offset 30 0
+frames 3
+key Escape
+frames 2
+expect transform == 0
+expect transform-commits == 2
+capture 266RightClickCommit
diff --git a/Exhibits/SolidArc/Code/Scripts/RevolveSweepWalkthrough.txt b/Exhibits/SolidArc/Code/Scripts/RevolveSweepWalkthrough.txt
