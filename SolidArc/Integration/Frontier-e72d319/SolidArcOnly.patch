+                       + " · audit " + (Blended.Audit.SoundCondition() ? "sound" : "UNSOUND") + " · " + std::to_string(static_cast<int>(Blended.Statistics.Milliseconds)) + " ms", Error, Error <= 1.0e-9 && Blended.Audit.SoundCondition());
