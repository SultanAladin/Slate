+move world 0.4 -0.8 2.0
+frames 2
+click world 0.4 -0.8 2.0
+frames 2
+move world 0.8 -0.4 2.0
+frames 2
+click world 0.8 -0.4 2.0
+frames 3
+expect knife-pending == 0
+expect knife-through == 1
+key T
+frames 2
+expect knife-through == 0
+type 0.1
+frames 6
+expect knife-depth ~ 0.1
+key Enter
+frames 3
+expect refused == 0
+expect knife-commits == 7
+expect volume ~ 7.525828330588459
+key K Shift
+frames 2
+expect knife-mode == Sketch
+expect drawing == Rectangle
+click @SketchKnifeTool
+frames 3
+click @KnifeToolInsert0
+frames 3
+expect knife-mode == Insert
+expect knife-insert == Square pocket
+click @SketchKnifeTool
+frames 3
+click @KnifeToolCircle
+frames 3
+expect knife-mode == Sketch
+expect drawing == Circle
+key Escape
+frames 2
+expect knife == 0
+key K Shift
+frames 2
+expect drawing == Circle
+key Escape
+frames 2
+
+# ⑨ drawn as the Construct primitives are: live R / Ø dimension lines while the circle is drawn, then the cutter's
+#    outline at the depth with its Ø and depth dimension lines; the depth follows the pointer along the face normal
+#    (the pointer over (−0.5, 0.5, 1.4) on the axis → depth ≈ 0.6, whole-pixel pointer); Esc leaves the body untouched
+click @SketchKnifeTool
+frames 3
+click @KnifeToolCircle
+frames 3
+move world -0.5 0.5 2.0
+frames 2
+click world -0.5 0.5 2.0
+frames 2
+move world -0.25 0.5 2.0
+frames 2
+expect drawing == Circle
+capture 281KnifeDrawingDimensions
+click world -0.25 0.5 2.0
+frames 3
+expect knife-pending == 0
+expect knife-through == 0
+move world -0.5 0.5 1.7
+frames 2
