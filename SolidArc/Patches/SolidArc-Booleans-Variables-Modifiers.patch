+        Canvas->AddLine(ImVec2(PixCentre.x, PixCentre.y - 5.0f), ImVec2(PixCentre.x, PixCentre.y + 5.0f), WitnessColour, 1.3f);
+        Canvas->AddLine(PixA, PixLeader, HaloColour, 3.4f);
