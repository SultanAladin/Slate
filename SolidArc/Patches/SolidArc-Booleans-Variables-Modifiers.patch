+void DrawEdgeWeightsCard(SolidArcWorkspaceState& State)
+{
+    if (State.Document.Selection.Edges.empty() && State.Document.Tree.EdgeGroups.empty()) return;
+    BeginCard("Edge Weights", Compose("%d group(s)", int(State.Document.Tree.EdgeGroups.size())).c_str());
+    ImGui::SetNextItemWidth(105);
+    ImGui::InputText("Group###EdgeGroupName", State.EdgeGroupNameText.data(), State.EdgeGroupNameText.size());
+    RegisterWidget(State, "EdgeGroupName");
+    ImGui::SetNextItemWidth(95);
+    ImGui::InputDouble("Weight###EdgeGroupWeight", &State.EdgeGroupWeight, 0.0, 0.0, "%.3f");
+    RegisterWidget(State, "EdgeGroupWeight");
+    std::vector<std::string> UserVars;
+    for (const FeatureParameter& Param : State.Document.Tree.Parameters)
+        if (SolidArcUserVariableCondition(Param)) UserVars.push_back(Param.Name);
+    if (!UserVars.empty())
+    {
+        ImGui::SameLine();
+        ImGui::SetNextItemWidth(85);
+        const std::string Label = State.EdgeGroupVariable.empty() ? std::string("[Literal]") : ("=" + State.EdgeGroupVariable);
+        if (ImGui::BeginCombo("###EdgeGroupVar", Label.c_str()))
+        {
+            if (ImGui::Selectable("[Literal]", State.EdgeGroupVariable.empty())) State.EdgeGroupVariable.clear();
+            for (const std::string& Var : UserVars)
+                if (ImGui::Selectable(("=" + Var).c_str(), State.EdgeGroupVariable == Var)) State.EdgeGroupVariable = Var;
+            ImGui::EndCombo();
+        }
+    }
+    const bool HasEdges = !State.Document.Selection.Edges.empty();
+    if (PressButton(State, "Paint Selected###EdgeGroupAssign", RowSpan(2), HasEdges))
+    {
+        FeatureValue Weight = State.EdgeGroupVariable.empty() ? FeatureValue{ State.EdgeGroupWeight } : ParameterValue(State.EdgeGroupVariable);
+        Weight.Literal      = State.EdgeGroupWeight;
+        Conclude(State, AssignSolidArcEdgeWeights(State.Document, State.EdgeGroupNameText.data(), {}, Weight));
+    }
+    ImGui::SameLine();
+    if (PressButton(State, "Erase Selected###EdgeGroupErase", RowSpan(2), HasEdges))
+        Conclude(State, AssignSolidArcEdgeWeights(State.Document, State.EdgeGroupNameText.data(), {}, FeatureValue{ 0.0 }));
+
+    for (const FeatureEdgeGroup& Group : State.Document.Tree.EdgeGroups)
+    {
+        ImGui::Text("%s · %d edge(s)", Group.Name.c_str(), int(Group.Entries.size()));
+        ImGui::SameLine();
+        if (PressButton(State, ("Select###SelEdgeGrp:" + Group.Name).c_str(), ImVec2(52, 0)))
+        {
+            SelectSolidArcEdgeGroup(State.Document, Group.Name);
+            State.PickMode = SolidArcPickMode::Edge;
+            RefreshSolidArcScene(State, false);
+        }
+        ImGui::SameLine();
+        if (PressButton(State, ("✕###DelEdgeGrp:" + Group.Name).c_str(), ImVec2(24, 0)))
+        {
+            Conclude(State, RemoveSolidArcEdgeGroup(State.Document, Group.Name));
+            break;
