+                const int Planes = CountVisible(State.Gizmo, SolidArcGizmoHandle::PlaneYZ);
+                if (Arrows != (View.FlatCondition ? 2 : 3) || Planes != (View.FlatCondition ? 1 : 3) || !VerifyShownArrowsPickable(State.Gizmo, Frame))
