+namespace
+{
+    bool DrawModifierValueRow(SolidArcWorkspaceState& State, const char* Caption, const std::string& IdKey,
+                              FeatureValue& Val, bool IntegerCondition = false, const char* Format = "%.4f")
+    {
+        bool Changed = false;
+        std::vector<std::string> UserVars;
+        for (const FeatureParameter& Param : State.Document.Tree.Parameters)
+            if (SolidArcUserVariableCondition(Param)) UserVars.push_back(Param.Name);
+
+        const double Evaluated = EvaluateFeatureValue(State.Document.Tree, Val);
+        if (Val.Parameter.empty())
+        {
+            ImGui::SetNextItemWidth(115);
+            if (IntegerCondition)
+            {
+                int IntVal = std::max(1, static_cast<int>(std::llround(Val.Literal)));
+                if (ImGui::InputInt((std::string(Caption) + "###ModVal:" + IdKey).c_str(), &IntVal))
+                    Val.Literal = static_cast<double>(std::max(1, IntVal));
+                if (ImGui::IsItemDeactivatedAfterEdit()) Changed = true;
+            }
+            else
+            {
+                double Num = Val.Literal;
+                if (ImGui::InputDouble((std::string(Caption) + "###ModVal:" + IdKey).c_str(), &Num, 0.0, 0.0, Format) && ImGui::IsItemDeactivatedAfterEdit())
+                {
+                    Val.Literal = Num;
+                    Changed     = true;
+                }
+            }
+            RegisterWidget(State, ("ModVal:" + IdKey).c_str());
+        }
+        else
+        {
+            ImGui::Text("%s  =%s (%.4g)", Caption, Val.Parameter.c_str(), Evaluated);
+        }
+        if (!UserVars.empty() || !Val.Parameter.empty())
+        {
+            ImGui::SameLine();
+            ImGui::SetNextItemWidth(82);
+            const std::string Preview = Val.Parameter.empty() ? std::string("var…") : ("=" + Val.Parameter);
+            if (ImGui::BeginCombo(("###ModBind:" + IdKey).c_str(), Preview.c_str()))
+            {
+                if (ImGui::Selectable("[Literal]", Val.Parameter.empty()))
+                {
+                    Val = FeatureValue{ std::isfinite(Evaluated) ? Evaluated : Val.Literal };
+                    Changed = true;
+                }
+                for (const std::string& Var : UserVars)
+                {
+                    if (ImGui::Selectable(("=" + Var).c_str(), Val.Parameter == Var))
+                    {
+                        Val = ParameterValue(Var);
+                        Val.Literal = std::isfinite(Evaluated) ? Evaluated : 0.0;
+                        Changed = true;
+                    }
+                }
+                ImGui::EndCombo();
+            }
+        }
+        return Changed;
+    }
