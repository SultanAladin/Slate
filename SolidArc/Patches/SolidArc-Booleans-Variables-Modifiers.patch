+            else if (const auto* Cone = std::get_if<ConeSurface>(&Surface)) { MixVec(Cone->Frame.Origin); MixVec(Cone->Frame.ZAxis); MixReal(Cone->OriginRadius); MixReal(Cone->RadialSlope); }
