+                     BendDoc.Summary.SoundCondition ? 1 : 0, BendDoc.Summary.Volume, ExactBentVol, BentErr, AuditWhy.c_str()));
+
+        // Stack a LinearArray AFTER CurveBend (2 bent arches = 2 × V), then test Move, Toggle, Undo/Redo, and TOML round-trip!
