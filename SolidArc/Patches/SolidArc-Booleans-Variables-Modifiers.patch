+void DrawVariablesCard(SolidArcWorkspaceState& State)
+{
+    std::vector<FeatureParameter> Variables;
+    for (const FeatureParameter& Param : State.Document.Tree.Parameters)
+        if (SolidArcUserVariableCondition(Param)) Variables.push_back(Param);
+
+    BeginCard("Variables", Variables.empty() ? "parametric" : Compose("%d defined", int(Variables.size())).c_str());
+    for (const FeatureParameter& Var : Variables)
+    {
+        SolidArcParameterDrag& Drag    = State.ParameterDrag;
+        const bool             Mine    = Drag.Parameter == Var.Name;
+        double                 Dragged = Mine ? Drag.Value : Var.Value;
+        ImGui::SetNextItemWidth(135);
+        const std::string SliderKey = Var.Name + "###Variable:" + Var.Name;
+        const bool Edited = ImGui::DragScalar(SliderKey.c_str(), ImGuiDataType_Double, &Dragged, 0.005f, nullptr, nullptr, "%.4f");
+        RegisterWidget(State, ("Variable:" + Var.Name).c_str());
+        if (Edited && Dragged != (Mine ? Drag.Value : Var.Value))
+        {
+            Drag.Parameter = Var.Name;
+            Drag.Value     = Dragged;
+            Drag.Preview   = std::make_unique<SolidArcDocument>(CloneSolidArcDocument(State.Document));
+            const SolidArcCommandOutcome Staged = AssignSolidArcParameter(*Drag.Preview, Var.Name, Dragged);
+            if (Staged.AcceptedCondition) { Drag.PreviewScene = BuildSolidArcScene(*Drag.Preview); ++Drag.Stagings; }
+            else { Drag.Preview.reset(); Announce(State, Staged.Refusal); }
+        }
+        if (ImGui::IsItemDeactivated() && Drag.Parameter == Var.Name)
+        {
+            const double Final = Drag.Value;
+            Drag.Parameter.clear();
+            Drag.Preview.reset();
+            if (Final != Var.Value) { Conclude(State, AssignSolidArcParameter(State.Document, Var.Name, Final)); break; }
+        }
+        ImGui::SameLine();
+        if (PressButton(State, ("✕###DelVar:" + Var.Name).c_str(), ImVec2(24, 0)))
+        {
+            Conclude(State, DeleteSolidArcVariable(State.Document, Var.Name));
+            break;
+        }
+    }
+    ImGui::SetNextItemWidth(95);
+    ImGui::InputText("###NewVarName", State.VariableNameText.data(), State.VariableNameText.size());
+    RegisterWidget(State, "NewVarName");
+    ImGui::SameLine();
+    ImGui::SetNextItemWidth(72);
+    ImGui::InputDouble("###NewVarValue", &State.VariableValueInit, 0.0, 0.0, "%.3f");
+    RegisterWidget(State, "NewVarValue");
+    ImGui::SameLine();
+    if (PressButton(State, "+ Add###AddVariable", ImVec2(54, 0)))
+    {
+        const double Span = std::max(10.0, std::abs(State.VariableValueInit) * 4.0);
+        Conclude(State, CreateSolidArcVariable(State.Document, State.VariableNameText.data(), State.VariableValueInit,
+                                               State.VariableValueInit < 0.0 ? State.VariableValueInit - Span : 0.0,
+                                               State.VariableValueInit + Span));
+    }
+    EndCard();
+}
